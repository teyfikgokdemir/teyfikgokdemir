NODE_ENV=development
WEB_PORT=3000
API_PORT=4000
DATABASE_URL=postgresql://growth:growth@postgres:5432/growth_os
REDIS_URL=redis://redis:6379
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:4000
OPENAI_API_KEY=

# Google Connector
# Production example: https://growth.teyfikgokdemir.com/api/growth/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/growth/oauth/google/callback
GOOGLE_ADS_API_VERSION=v22

# Use a long random secret (32+ chars). Tokens are AES-256-GCM encrypted at rest.
INTEGRATION_ENCRYPTION_KEY=
