---
import { locales, type Locale } from '../i18n/locales';
import type { SiteContent } from '../i18n/content';
import { site } from '../data/site';

interface Props {
  locale: Locale;
  copy: SiteContent;
}

const { locale, copy } = Astro.props;
const canonical = site.origin + '/' + locale + '/';
const profileImage = site.origin + site.images.profile.path;
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': site.origin + '/#person',
      name: site.name,
      url: site.origin,
      jobTitle: 'Founder, Digital Commerce & Growth Operator',
      email: 'mailto:' + site.email,
      image: profileImage,
      address: {
        '@type': 'PostalAddress',
        addressLocality: 'İstanbul',
        addressCountry: 'TR',
      },
      knowsAbout: [
        'E-commerce Strategy',
        'Digital Commerce',
        'Digital Growth',
        'Operations Management',
        'Shopify',
        'WooCommerce',
        'Search Engine Optimization',
        'Generative Engine Optimization',
        'Answer Engine Optimization',
        'AI Optimization',
        'Conversion Rate Optimization',
        'Supply Chain',
        'Logistics',
        'AI Automation',
        'Sales Intelligence',
        'Digital Operations',
      ],
      sameAs: [site.links.github, site.links.linkedin],
    },
    {
      '@type': 'Organization',
      '@id': site.links.qctStudio + '/#organization',
      name: 'QCT Studio',
      url: site.links.qctStudio,
      founder: { '@id': site.origin + '/#person' },
      areaServed: ['Albania', 'North Macedonia', 'Balkans'],
    },
    {
      '@type': 'Organization',
      '@id': site.links.qctCommerce + '/#organization',
      name: 'QCT Commerce',
      url: site.links.qctCommerce,
      founder: { '@id': site.origin + '/#person' },
      areaServed: 'Türkiye',
    },
    {
      '@type': 'WebSite',
      '@id': site.origin + '/#website',
      name: site.name,
      url: site.origin,
      author: { '@id': site.origin + '/#person' },
    },
    {
      '@type': 'WebPage',
      '@id': canonical + '#webpage',
      url: canonical,
      name: copy.seo.title,
      description: copy.seo.description,
      inLanguage: locale,
      isPartOf: { '@id': site.origin + '/#website' },
      about: { '@id': site.origin + '/#person' },
      primaryImageOfPage: {
        '@type': 'ImageObject',
        url: profileImage,
        width: site.images.profile.width,
        height: site.images.profile.height,
      },
    },
  ],
};
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#09111d" />
    <meta name="robots" content="index,follow" />
    <title>{copy.seo.title}</title>
    <meta name="description" content={copy.seo.description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {locales.map((item) => (
      <link rel="alternate" hreflang={item} href={site.origin + '/' + item + '/'} />
    ))}
    <link rel="alternate" hreflang="x-default" href={site.origin + '/'} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={copy.seo.title} />
    <meta property="og:description" content={copy.seo.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={profileImage} />
    <meta property="og:image:width" content={String(site.images.profile.width)} />
    <meta property="og:image:height" content={String(site.images.profile.height)} />
    <meta property="og:image:alt" content={copy.images.profile} />
    <meta property="og:locale" content={locale} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={copy.seo.title} />
    <meta name="twitter:description" content={copy.seo.description} />
    <meta name="twitter:image" content={profileImage} />
    <meta name="twitter:image:alt" content={copy.images.profile} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">{copy.a11y.skip}</a>
    <slot />
  </body>
</html>

<style is:global>
  :root {
    color-scheme: dark;
    --bg: #09111d;
    --bg-deep: #070d16;
    --panel: #101c2b;
    --panel-soft: #142235;
    --text: #f4f1e9;
    --muted: #aab7c9;
    --accent: #e27662;
    --accent-soft: #f2aa8f;
    --line: #26374d;
    --line-strong: #3a506b;
    --max: 1180px;
    --radius: 22px;
    --header-height: 76px;
  }

  * { box-sizing: border-box; }
  html { background: var(--bg); }
  body {
    margin: 0;
    background:
      radial-gradient(circle at 78% 4%, rgba(35, 67, 103, .34), transparent 30rem),
      linear-gradient(180deg, var(--bg), var(--bg-deep) 58%, var(--bg));
    color: var(--text);
    font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    line-height: 1.5;
    text-rendering: optimizeLegibility;
  }
  img { display: block; max-width: 100%; }
  a { color: inherit; text-decoration: none; }
  button { font: inherit; }
  :focus-visible { outline: 3px solid var(--accent-soft); outline-offset: 4px; }
  .skip-link {
    position: fixed;
    z-index: 100;
    left: 1rem;
    top: 1rem;
    transform: translateY(-180%);
    background: var(--text);
    color: var(--bg);
    padding: .8rem 1rem;
    border-radius: .6rem;
    font-weight: 800;
  }
  .skip-link:focus { transform: translateY(0); }
  .shell { width: min(var(--max), calc(100% - 3rem)); margin-inline: auto; }
  #main-content, section[id] { scroll-margin-top: calc(var(--header-height) + 1rem); }
  .section { padding: clamp(4rem, 6vw, 6.5rem) 0; border-top: 1px solid var(--line); }
  .section-heading { max-width: 820px; margin-bottom: 2.25rem; }
  .section-label {
    margin: 0 0 .9rem;
    color: var(--accent-soft);
    font-size: .74rem;
    font-weight: 800;
    letter-spacing: .16em;
    text-transform: uppercase;
  }
  p { overflow-wrap: anywhere; }
  h1, h2, h3 { overflow-wrap: normal; text-wrap: balance; }
  h2 {
    margin: 0 0 1.25rem;
    font-size: clamp(2.15rem, 5vw, 4.65rem);
    line-height: 1.02;
    letter-spacing: -.045em;
  }
  .section-lead {
    margin: 0;
    max-width: 720px;
    color: var(--muted);
    font-size: clamp(1rem, 1.6vw, 1.22rem);
    line-height: 1.75;
  }

  .site-header {
    position: sticky;
    z-index: 50;
    top: 0;
    min-height: var(--header-height);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding: .75rem max(1.25rem, calc((100vw - var(--max)) / 2));
    border-bottom: 1px solid rgba(58, 80, 107, .72);
    background: rgba(9, 17, 29, .9);
    backdrop-filter: blur(18px);
  }
  .brand { display: inline-flex; align-items: center; gap: .75rem; min-height: 48px; }
  .brand span {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border: 1px solid var(--accent);
    border-radius: 50%;
    color: var(--accent-soft);
    font-size: .78rem;
    letter-spacing: .08em;
  }
  .brand strong { font-size: .82rem; letter-spacing: .1em; text-transform: uppercase; }
  .header-panel { display: flex; align-items: center; gap: 1.5rem; }
  .header-panel nav { display: flex; align-items: center; gap: 1.25rem; }
  .header-panel nav a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--muted);
    font-size: .9rem;
    font-weight: 650;
  }
  .header-panel nav a:hover { color: var(--text); }
  .language-switcher {
    display: flex;
    align-items: center;
    padding: .2rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--panel);
  }
  .language-switcher a {
    display: grid;
    place-items: center;
    min-width: 42px;
    min-height: 42px;
    border-radius: 50%;
    color: var(--muted);
    font-size: .72rem;
    font-weight: 800;
  }
  .language-switcher a[aria-current="page"] { background: var(--text); color: var(--bg); }
  .menu-toggle {
    display: none;
    width: 48px;
    height: 48px;
    padding: 12px;
    border: 1px solid var(--line);
    border-radius: 50%;
    background: var(--panel);
  }
  .menu-toggle span { display: block; height: 2px; margin: 5px 0; background: var(--text); }

  .hero {
    min-height: calc(100svh - var(--header-height));
    display: grid;
    grid-template-columns: minmax(0, 1.08fr) minmax(330px, .72fr);
    align-items: center;
    gap: clamp(2rem, 7vw, 6rem);
    padding-block: clamp(2.5rem, 4vw, 4.5rem);
  }
  .hero-copy { position: relative; z-index: 2; }
  .hero h1 {
    max-width: 900px;
    margin: 1rem 0 1.6rem;
    font-size: clamp(3rem, 5.7vw, 5.45rem);
    line-height: .98;
    letter-spacing: -.062em;
  }
  .hero-description {
    max-width: 740px;
    margin: 0;
    color: #d6dce5;
    font-size: clamp(1.08rem, 1.8vw, 1.4rem);
    line-height: 1.65;
  }
  .hero-actions { display: flex; flex-wrap: wrap; gap: .8rem; margin-top: 2rem; }
  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    padding: .85rem 1.25rem;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    font-weight: 800;
  }
  .button.primary { border-color: var(--accent); background: var(--accent); color: #fff; }
  .button:hover { transform: translateY(-2px); border-color: var(--accent-soft); }
  .hero-summary {
    max-width: 700px;
    margin: 2rem 0 0;
    padding-left: 1rem;
    border-left: 2px solid var(--accent);
    color: var(--muted);
    font-size: .92rem;
  }
  .hero-media { position: relative; align-self: stretch; min-height: 520px; }
  .hero-media::before {
    content: "";
    position: absolute;
    inset: 6% -4% 0 8%;
    border: 1px solid var(--line);
    border-radius: 15rem 15rem var(--radius) var(--radius);
    background: linear-gradient(145deg, #192b42, #0d1724);
  }
  .hero-media img {
    position: absolute;
    inset: 0 0 0 auto;
    width: min(100%, 480px);
    height: 100%;
    object-fit: cover;
    object-position: 50% 18%;
    border-radius: 15rem 15rem var(--radius) var(--radius);
    filter: saturate(.88) contrast(1.03);
  }

  .intro-grid, .regional-grid {
    display: grid;
    grid-template-columns: minmax(0, .8fr) minmax(0, 1.2fr);
    gap: clamp(2rem, 6vw, 5rem);
    align-items: center;
  }
  .editorial-image {
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--panel);
  }
  .editorial-image img { width: 100%; height: clamp(400px, 38vw, 500px); object-fit: cover; object-position: 50% 22%; }
  .focus-list { display: grid; grid-template-columns: 1fr 1fr; gap: .75rem; margin-top: 1.5rem; }
  .focus-list span {
    padding: 1rem;
    border: 1px solid var(--line);
    border-radius: .8rem;
    background: rgba(16, 28, 43, .7);
    font-weight: 750;
  }

  .venture-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1rem, 2vw, 1.4rem);
  }

  .venture-card {
    position: relative;
    min-width: 0;
    min-height: 0;
    display: flex;
    flex-direction: column;
    padding: clamp(1.5rem, 3vw, 2.2rem);
    overflow: hidden;
    isolation: isolate;
    border: 1px solid rgba(74, 101, 136, .62);
    border-radius: calc(var(--radius) + 4px);
    background:
      radial-gradient(circle at 100% 0%, rgba(226, 118, 98, .15), transparent 18rem),
      linear-gradient(145deg, rgba(22, 39, 60, .98), rgba(8, 17, 28, .99));
    box-shadow:
      0 1px 0 rgba(255, 255, 255, .05) inset,
      0 22px 55px rgba(0, 0, 0, .22);
    transition:
      transform .35s cubic-bezier(.2, .8, .2, 1),
      border-color .35s ease,
      box-shadow .35s ease;
  }

  .venture-card::before {
    content: "";
    position: absolute;
    z-index: 0;
    inset: 0;
    pointer-events: none;
    background:
      linear-gradient(120deg, rgba(255, 255, 255, .07), transparent 28%),
      linear-gradient(180deg, transparent 55%, rgba(4, 9, 16, .42));
    opacity: .75;
  }

  .venture-card::after {
    content: "";
    position: absolute;
    z-index: 1;
    right: -4rem;
    bottom: -5rem;
    width: 12rem;
    height: 12rem;
    border: 1px solid rgba(242, 170, 143, .18);
    border-radius: 50%;
    box-shadow:
      0 0 0 2rem rgba(242, 170, 143, .035),
      0 0 0 4rem rgba(242, 170, 143, .02);
    pointer-events: none;
  }

  .venture-card.has-image {
    min-height: 460px;
    padding: 0;
    justify-content: flex-start;
  }

  .venture-card > * {
    position: relative;
    z-index: 2;
  }

  .venture-card.has-image > img {
    position: relative;
    z-index: 1;
    width: 100%;
    height: 215px;
    object-fit: cover;
    object-position: 50% 34%;
    filter: saturate(.78) contrast(1.06);
    transition:
      transform .55s cubic-bezier(.2, .8, .2, 1),
      filter .4s ease;
  }

  .venture-card.has-image::before {
    z-index: 2;
    background:
      linear-gradient(180deg, transparent 24%, rgba(8, 17, 28, .18) 48%, rgba(8, 17, 28, .98) 100%),
      linear-gradient(120deg, rgba(255, 255, 255, .08), transparent 32%);
  }

  .venture-card.has-image .venture-meta {
    margin: 1.35rem 1.6rem 0;
  }

  .venture-card.has-image h3 {
    margin: 1.4rem 1.6rem .85rem;
  }

  .venture-card.has-image p {
    margin-inline: 1.6rem;
  }

  .venture-card.has-image .venture-arrow {
    margin-inline: 1.6rem;
    padding-bottom: 1.6rem;
  }

  .venture-card:hover {
    transform: translateY(-8px);
    border-color: rgba(242, 170, 143, .72);
    box-shadow:
      0 1px 0 rgba(255, 255, 255, .08) inset,
      0 30px 70px rgba(0, 0, 0, .34),
      0 0 0 1px rgba(226, 118, 98, .08);
  }

  .venture-card.has-image:hover > img {
    transform: scale(1.045);
    filter: saturate(.96) contrast(1.08);
  }

  .venture-meta {
    display: flex;
    flex-wrap: wrap;
    gap: .5rem;
  }

  .tag {
    padding: .42rem .72rem;
    border: 1px solid rgba(242, 170, 143, .32);
    border-radius: 999px;
    background: rgba(226, 118, 98, .07);
    color: var(--accent-soft);
    font-size: .68rem;
    font-weight: 850;
    letter-spacing: .075em;
    text-transform: uppercase;
    backdrop-filter: blur(8px);
  }

  .venture-card h3 {
    margin: 1.85rem 0 .9rem;
    font-size: clamp(1.7rem, 3vw, 2.35rem);
    line-height: 1.03;
    letter-spacing: -.035em;
  }

  .venture-card p {
    margin: 0;
    max-width: 42rem;
    color: #b8c3d1;
    line-height: 1.75;
  }

  .venture-arrow {
    display: inline-flex;
    align-items: center;
    width: fit-content;
    margin-top: auto;
    padding-top: 1.6rem;
    color: var(--accent-soft);
    font-size: 1.45rem;
    transition: transform .3s ease;
  }

  .venture-card:hover .venture-arrow {
    transform: translateX(.35rem);
  }

  .expertise-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(.9rem, 1.8vw, 1.25rem);
  }

  .expertise-card {
    position: relative;
    min-width: 0;
    min-height: 0;
    padding: clamp(1.4rem, 2.4vw, 1.8rem);
    overflow: hidden;
    border: 1px solid rgba(58, 80, 107, .72);
    border-radius: calc(var(--radius) - 2px);
    background:
      linear-gradient(150deg, rgba(22, 38, 58, .92), rgba(10, 19, 31, .96));
    box-shadow:
      0 1px 0 rgba(255, 255, 255, .045) inset,
      0 16px 40px rgba(0, 0, 0, .15);
    transition:
      transform .3s cubic-bezier(.2, .8, .2, 1),
      border-color .3s ease,
      background-color .3s ease,
      box-shadow .3s ease;
  }

  .expertise-card::before {
    content: "";
    position: absolute;
    top: 0;
    left: 1.5rem;
    right: 1.5rem;
    height: 2px;
    background: linear-gradient(90deg, var(--accent), rgba(242, 170, 143, .18));
  }

  .expertise-card::after {
    content: "";
    position: absolute;
    right: -3.5rem;
    top: -3.5rem;
    width: 8rem;
    height: 8rem;
    border-radius: 50%;
    background: rgba(226, 118, 98, .055);
    filter: blur(2px);
    pointer-events: none;
  }

  .expertise-card:hover {
    transform: translateY(-6px);
    border-color: rgba(242, 170, 143, .55);
    box-shadow:
      0 1px 0 rgba(255, 255, 255, .06) inset,
      0 24px 55px rgba(0, 0, 0, .26);
  }

  .expertise-card h3 {
    position: relative;
    margin: .25rem 0 1.35rem;
    padding-bottom: 1rem;
    font-size: clamp(1.18rem, 1.7vw, 1.38rem);
    line-height: 1.15;
    letter-spacing: -.025em;
  }

  .expertise-card h3::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: 0;
    width: 2.25rem;
    height: 1px;
    background: rgba(242, 170, 143, .42);
  }

  .expertise-card ul {
    display: grid;
    gap: .78rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .expertise-card li {
    position: relative;
    padding-left: 1.05rem;
    color: #b5c0ce;
    font-size: .91rem;
    line-height: 1.5;
  }

  .expertise-card li::before {
    content: "";
    position: absolute;
    left: 0;
    top: .62em;
    width: .34rem;
    height: .34rem;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 4px rgba(226, 118, 98, .08);
  }

  .definitions {
    margin: 1.75rem 0 0;
    padding: 1rem 1.15rem;
    border: 1px solid rgba(58, 80, 107, .5);
    border-radius: .9rem;
    background: rgba(8, 16, 27, .5);
    color: var(--muted);
    font-size: .82rem;
    line-height: 1.75;
  }

  .journey-layout { display: grid; grid-template-columns: minmax(280px, .7fr) minmax(0, 1.3fr); gap: clamp(2rem, 6vw, 5rem); align-items: start; }
  .journey-image { position: sticky; top: 100px; }
  .journey-image img { width: 100%; max-height: 600px; object-fit: cover; object-position: 50% 20%; border: 1px solid var(--line); border-radius: var(--radius); }
  .timeline { margin: 0; padding: 0; list-style: none; }
  .timeline li { display: grid; grid-template-columns: 80px 1fr; gap: 1rem; padding: 0; }
  .timeline time { color: var(--accent-soft); font-weight: 850; }
  .timeline-content { position: relative; padding: 0 0 1.5rem 1.25rem; border-left: 1px solid var(--line-strong); }
  .timeline-content::before { content: ""; position: absolute; left: -5px; top: .35rem; width: 9px; height: 9px; border-radius: 50%; background: var(--accent); }
  .timeline h3 { margin: 0 0 .5rem; font-size: 1.25rem; }
  .timeline p { margin: 0; color: var(--muted); }

  .method-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1rem; counter-reset: method; }
  .method-card { min-height: 210px; padding: 1.5rem; border: 1px solid var(--line); border-radius: var(--radius); background: var(--panel); counter-increment: method; }
  .method-card::before { content: "0" counter(method); color: var(--accent-soft); font-size: .75rem; font-weight: 850; letter-spacing: .12em; }
  .method-card h3 { margin: 2rem 0 .7rem; font-size: 1.35rem; }
  .method-card p { margin: 0; color: var(--muted); line-height: 1.7; }

  .regional-grid .editorial-image img { object-position: 50% 28%; }
  .contact-section { text-align: center; }
  .contact-card { max-width: 980px; margin-inline: auto; padding: clamp(2rem, 5vw, 4rem); border: 1px solid var(--line-strong); border-radius: var(--radius); background: linear-gradient(135deg, #13243a, #0d1826); }
  .contact-card .section-lead { margin-inline: auto; }
  .contact-card .button { margin-top: 1.5rem; }

  .site-footer {
    width: min(var(--max), calc(100% - 3rem));
    margin-inline: auto;
    display: flex;
    justify-content: space-between;
    gap: 2rem;
    padding: 2.5rem 0;
    border-top: 1px solid var(--line);
  }
  .footer-brand { font-size: 1.05rem; font-weight: 850; }
  .site-footer p { margin: .5rem 0 0; color: var(--muted); font-size: .82rem; }
  .site-footer nav { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: .3rem .8rem; }
  .site-footer nav a { display: inline-flex; align-items: center; gap: .3rem; min-height: 44px; color: var(--muted); font-size: .85rem; }
  .site-footer nav a:hover { color: var(--text); }

  .button, .venture-card, .header-panel a, .skip-link { transition: color .2s ease, background-color .2s ease, border-color .2s ease, transform .2s ease; }

  @media (min-width: 1200px) {
    .venture-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }

