---
const title='Cansu · Güvenli Erişim';
---
<!doctype html>
<html lang="tr">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="robots" content="noindex,nofollow"><title>{title}</title>
<style>
:root{color-scheme:dark}*{box-sizing:border-box}body{margin:0;min-height:100vh;display:grid;place-items:center;background:#030712;color:#f8fafc;font-family:system-ui,-apple-system,sans-serif}
main{width:min(440px,calc(100% - 32px));padding:32px;border:1px solid #263247;border-radius:22px;background:linear-gradient(145deg,#0f172a,#070b14);box-shadow:0 30px 90px #0009}
.badge{display:inline-flex;padding:6px 10px;border:1px solid #244c43;border-radius:999px;color:#5eead4;font-size:12px}h1{font-size:28px;margin:18px 0 8px}p{color:#94a3b8;line-height:1.55;margin:0 0 22px}
button,input{width:100%;min-height:48px;border-radius:12px;font:inherit}button{border:1px solid #28516c;background:#0c2940;color:#e0f2fe;font-weight:750;cursor:pointer}button:disabled{opacity:.55;cursor:wait}
form{display:grid;gap:12px;margin-top:18px}input{border:1px solid #334155;background:#020617;color:white;padding:0 16px;text-align:center;font-size:22px;letter-spacing:.25em}
#status{min-height:22px;margin-top:14px;font-size:13px;color:#94a3b8}.hidden{display:none}
</style>
</head>
<body><main>
<span class="badge">Cansu Operations Center · Özel erişim</span>
<h1>Yetkilendirme gerekli</h1>
<p>Panel dış erişime kapalıdır. Erişim talebi oluşturduğunuzda tek kullanımlık kod panel sahibine gönderilir.</p>
<button id="request">Erişim kodu talep et</button>
<form id="verify" class="hidden"><input id="code" inputmode="numeric" autocomplete="one-time-code" maxlength="6" placeholder="••••••" aria-label="6 haneli erişim kodu"><button type="submit">Kodla giriş yap</button></form>
<div id="status" role="status"></div>
</main>
<script>
const request=document.querySelector('#request'), form=document.querySelector('#verify'), code=document.querySelector('#code'), status=document.querySelector('#status');
request.addEventListener('click',async()=>{request.disabled=true;status.textContent='Talep gönderiliyor…';try{const r=await fetch('/api/access/request',{method:'POST'});const d=await r.json();if(!r.ok)throw new Error(d.error||'request_failed');status.textContent='Talep alındı. Kod panel sahibine gönderildi ve 10 dakika geçerli.';form.classList.remove('hidden');code.focus();}catch(e){status.textContent='Talep gönderilemedi. Sistem yapılandırmasını kontrol edin.';}finally{request.disabled=false;}});
form.addEventListener('submit',async(e)=>{e.preventDefault();const value=code.value.trim();if(!/^\d{6}$/.test(value)){status.textContent='6 haneli kodu girin.';return;}status.textContent='Kod doğrulanıyor…';const r=await fetch('/api/access/verify',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({code:value})});if(r.ok){location.replace('/');return;}status.textContent='Kod geçersiz, kullanılmış veya süresi dolmuş.';});
</script></body></html>