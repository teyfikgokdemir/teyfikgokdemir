---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PersonalHomePage from '../../components/PersonalHomePage.astro';
import { content } from '../../i18n/content';
import type { Locale } from '../../i18n/locales';
const locale = 'mk' as Locale;
const copy = content[locale] || content.en;
---
<BaseLayout locale={locale} copy={copy}>
  <PersonalHomePage locale={locale} />
</BaseLayout>
