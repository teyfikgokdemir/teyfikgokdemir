---
import ContentPage from '../components/ContentPage.astro';

const locale = 'tr';
const title = 'Teyfik Gökdemir | Markalar, Ticaret ve Dijital Büyüme';
const description = 'Teyfik Gökdemir’in Instagram profilinden CTSEG, QCT Commerce, QCT Studio, Phiaderm ve Mythborn çalışmalarına ulaşın.';
const campaign = 'founder_profile';

const tracked = (url: string, content: string) => {
  const target = new URL(url);
  target.searchParams.set('utm_source', 'instagram');
  target.searchParams.set('utm_medium', 'bio');
  target.searchParams.set('utm_campaign', campaign);
  target.searchParams.set('utm_content', content);
  return target.toString();
};

const destinations = [
  {
    key: 'qct-commerce',
    eyebrow: 'DİJİTAL SATIŞ SİSTEMLERİ',
    title: 'QCT Commerce',
    text: 'E-ticaret, çok dilli web, görünürlük ve satış otomasyonu için Türkiye odaklı ticari sistemler.',
    cta: 'Dijital projen için yaz',
    href: tracked('https://qctcommerce.com/iletisim/', 'qct-commerce'),
    tone: 'commerce',
  },
  {
    key: 'ctseg',
    eyebrow: 'ULUSLARARASI TİCARET',
    title: 'CTSEG',
    text: 'Ürün, tedarikçi, alıcı ve hedef pazar değerlendirmesini doğrulanabilir ticari verilerle yapılandıran koordinasyon platformu.',
    cta: 'Ticari talep gönder',
    href: tracked('https://ctseg.com.tr/tr/iletisim/', 'ctseg'),
    tone: 'trade',
  },
  {
    key: 'qct-studio',
    eyebrow: 'BALKANLARDA DİJİTAL BÜYÜME',
    title: 'QCT Studio',
    text: 'Balkanlar’daki işletmeler için web, e-ticaret, WhatsApp Commerce, SEO ve AI destekli dijital sistemler.',
    cta: 'Projeni paylaş',
    href: tracked('https://qctstudio.com/contact/', 'qct-studio'),
    tone: 'studio',
  },
  {
    key: 'phiaderm',
    eyebrow: 'PORTFÖY · GÜZELLİK MARKASI',
    title: 'Phiaderm',
    text: 'Daha sade ve premium bir alışveriş deneyimi için hazırlanan güzellik markası. Açılış ve erken erişim duyuruları burada.',
    cta: 'Erken erişime katıl',
    href: tracked('https://www.phiaderm.com.tr/password', 'phiaderm'),
    tone: 'beauty',
  },
  {
    key: 'mythborn',
    eyebrow: 'PORTFÖY · DİJİTAL ÜRÜN',
    title: 'Mythborn',
    text: 'Tarot, astroloji ve sembolik farkındalık için çok dilli bir dijital keşif alanı.',
    cta: 'Mythborn’u keşfet',
    href: tracked('https://mythborn.co/', 'mythborn'),
    tone: 'myth',
  },
];

const pageSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: title,
  description,
  url: 'https://teyfikgokdemir.com/instagram/',
  isPartOf: { '@id': 'https://teyfikgokdemir.com/#website' },
  about: { '@id': 'https://teyfikgokdemir.com/#person' },
};
---

<ContentPage
  locale={locale}
  title={title}
  description={description}
  pathname="/instagram/"
  eyebrow="Instagram’dan gelenler için"
  heading="Ticaret, dijital satış ve kurucu projelerim."
  lead="Uluslararası ticaret, dijital büyüme ve marka geliştirme çalışmalarımı aşağıdaki başlıklardan keşfedebilirsin. Her bağlantı, ilgili proje ve iletişim yoluna yönlendirir."
  pageSchema={pageSchema}
  alternates={{}}
>
  <div class="instagram-hub">
    <section class="instagram-hub-intro" aria-labelledby="instagram-hub-title">
      <p class="instagram-hub-kicker">TEYFİK GÖKDEMİR · KURUCUNUN ÇALIŞMA MASASI</p>
      <h2 id="instagram-hub-title">Tek bir profil, farklı ticari yollar.</h2>
      <p>
        Bu sayfa, Instagram’da gördüğün içerikleri ilgili projeye bağlar. Dijital satış ve e-ticaret için QCT Commerce’e; tedarik, alıcı ve pazar arayışı için CTSEG’e; Balkanlar’daki dijital projeler için QCT Studio’ya ulaşabilirsin.
      </p>
    </section>

    <div class="instagram-hub-grid" aria-label="Projeler ve iletişim yolları">
      {destinations.map((item, index) => (
        <a
          class:list={['instagram-hub-card', `instagram-hub-card--${item.tone}`, { 'instagram-hub-card--featured': index === 0 }]}
          href={item.href}
          data-instagram-route={item.key}
        >
          <span class="instagram-hub-card__eyebrow">{item.eyebrow}</span>
          <h3>{item.title}</h3>
          <p>{item.text}</p>
          <span class="instagram-hub-card__cta">{item.cta} <span aria-hidden="true">↗</span></span>
        </a>
      ))}
    </div>

    <section class="instagram-hub-contact" aria-labelledby="instagram-hub-contact-title">
      <p class="instagram-hub-kicker">DOĞRUDAN İLETİŞİM</p>
      <h2 id="instagram-hub-contact-title">Ne üzerine konuşmak istersin?</h2>
      <p>
        Kısa bir mesaj yeterli. Mevcut işini, hedef pazarını veya çözmek istediğin dijital darboğazı yaz; doğru başlangıç noktasını birlikte netleştirelim.
      </p>
      <a
        class="instagram-hub-contact__button"
        href="https://wa.me/905456782655?text=Merhaba%20Teyfik%2C%20Instagram%20profilinden%20ula%C5%9F%C4%B1yorum.%20Konum%3A%20"
        data-instagram-route="whatsapp"
      >
        WhatsApp’tan yaz
      </a>
    </section>

    <p class="instagram-hub-note">Bağlantılar, Instagram bio trafiğini ve hangi projenin ilgi çektiğini anlamaya yardımcı olacak şekilde ölçümlenir.</p>
  </div>
</ContentPage>

<script is:inline>
  document.querySelectorAll('[data-instagram-route]').forEach((link) => {
    link.addEventListener('click', () => {
      const destination = link.getAttribute('data-instagram-route') || 'unknown';
      if (typeof window.gtag === 'function') {
        window.gtag('event', 'instagram_hub_click', {
          destination,
          source: 'instagram',
          medium: 'bio',
          campaign: 'founder_profile',
        });
      }
    });
  });
</script>

<style>
  :global(.instagram-hub) {
    display: grid;
    gap: clamp(2.5rem, 6vw, 5rem);
  }

  :global(.instagram-hub-intro) {
    max-width: 760px;
  }

  :global(.instagram-hub-kicker) {
    margin: 0 0 .9rem;
    color: #8a432c;
    font-size: .74rem;
    font-weight: 850;
    letter-spacing: .16em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  :global(.instagram-hub h2) {
    margin: 0 0 1.1rem;
    color: var(--text);
    font-size: clamp(2rem, 4vw, 3.25rem);
  }

  :global(.instagram-hub-intro p:not(.instagram-hub-kicker)),
  :global(.instagram-hub-contact p:not(.instagram-hub-kicker)) {
    margin: 0;
    color: var(--muted);
    font-size: 1.05rem;
    line-height: 1.8;
  }

  :global(.instagram-hub-grid) {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  :global(.instagram-hub-card) {
    display: flex;
    min-height: 270px;
    flex-direction: column;
    padding: clamp(1.4rem, 3vw, 2rem);
    border: 1px solid rgba(67, 78, 72, .55);
    border-radius: 1.15rem;
    background: var(--scene-mineral);
    color: var(--text);
    text-decoration: none !important;
    transition: transform .25s ease, border-color .25s ease, box-shadow .25s ease;
  }

  :global(.instagram-hub-card:hover) {
    transform: translateY(-5px);
    border-color: var(--accent);
    box-shadow: 0 18px 42px rgba(33, 28, 24, .12);
  }

  :global(.instagram-hub-card--featured) {
    border-color: var(--accent);
    background: var(--scene-olive);
    color: #f3eee6;
  }

  :global(.instagram-hub-card--featured .instagram-hub-card__eyebrow),
  :global(.instagram-hub-card--featured p) {
    color: #d9cfc3;
  }

  :global(.instagram-hub-card--featured .instagram-hub-card__cta) {
    color: var(--accent-coral);
  }

  :global(.instagram-hub-card--trade) { background: #e8dfd2; }
  :global(.instagram-hub-card--studio) { background: #e1e6df; }
  :global(.instagram-hub-card--beauty) { background: #eadbd4; }
  :global(.instagram-hub-card--myth) { background: #dddbe5; }

  :global(.instagram-hub-card__eyebrow) {
    color: #7b746b;
    font-size: .7rem;
    font-weight: 850;
    letter-spacing: .12em;
    line-height: 1.45;
  }

  :global(.instagram-hub-card h3) {
    margin: 1.7rem 0 .7rem;
    font-size: clamp(1.55rem, 3vw, 2.25rem);
    line-height: 1.05;
  }

  :global(.instagram-hub-card p) {
    margin: 0;
    color: #625c54;
    font-size: .96rem;
    line-height: 1.7;
  }

  :global(.instagram-hub-card__cta) {
    display: inline-flex;
    align-items: center;
    gap: .35rem;
    margin-top: auto;
    padding-top: 1.4rem;
    color: var(--accent);
    font-size: .9rem;
    font-weight: 850;
  }

  :global(.instagram-hub-contact) {
    padding: clamp(2rem, 5vw, 3.5rem);
    border-radius: 1rem;
    background: var(--surface-dark);
    color: #f3eee6;
  }

  :global(.instagram-hub-contact h2) { color: #f3eee6; }
  :global(.instagram-hub-contact p:not(.instagram-hub-kicker)) { color: #d2c8bc; max-width: 700px; }
  :global(.instagram-hub-contact .instagram-hub-kicker) { color: var(--accent-coral); }

  :global(.instagram-hub-contact__button) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    margin-top: 1.5rem;
    padding: .85rem 1.3rem;
    border: 1px solid var(--accent-coral);
    border-radius: 999px;
    background: var(--accent-coral);
    color: #211c18 !important;
    font-weight: 850;
    text-decoration: none !important;
  }

  :global(.instagram-hub-contact__button:hover) { background: #e69a7c; }

  :global(.instagram-hub-note) {
    margin: -1.5rem 0 0;
    color: var(--muted);
    font-size: .82rem;
    line-height: 1.65;
  }

  @media (max-width: 680px) {
    :global(.instagram-hub-grid) { grid-template-columns: 1fr; }
    :global(.instagram-hub-card) { min-height: 240px; }
    :global(.instagram-hub-contact__button) { width: 100%; }
  }
</style>
