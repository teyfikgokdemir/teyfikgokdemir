---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FounderPage from '../../components/FounderPage.astro';
import { content } from '../../i18n/content';
import { locales, type Locale } from '../../i18n/locales';
import { faqSchema } from '../../data/homeFaq';

export function getStaticPaths() {
  return locales
    .filter((lang) => lang !== 'tr' && lang !== 'en' && lang !== 'fa')
    .map((lang) => ({ params: { lang } }));
}

const locale = Astro.params.lang as Locale;
const copy = content[locale];
const pageSchema = faqSchema(locale);
---
<BaseLayout locale={locale} copy={copy} pageSchema={pageSchema}>
  <FounderPage locale={locale} />
</BaseLayout>