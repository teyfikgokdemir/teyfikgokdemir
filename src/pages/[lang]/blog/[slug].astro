---
import BlogPage from '../../../components/BlogPage.astro';
import { blogLocales, posts, postSupportsLocale } from '../../../data/blog';

export function getStaticPaths() {
  return blogLocales
    .filter((locale) => locale !== 'tr')
    .flatMap((locale) => posts.filter((post) => postSupportsLocale(post, locale)).map((post) => ({ params: { lang: locale, slug: post.slugs?.[locale] ?? post.slug }, props: { locale, post } })));
}
const { locale, post } = Astro.props;
---
<BlogPage locale={locale} post={post} />

<style is:global>
  .article-head {
    position: static !important;
    inset: auto !important;
    transform: none !important;
    z-index: auto !important;
    width: auto !important;
  }
</style>