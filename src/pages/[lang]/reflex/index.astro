---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ReflexLandingView from '../../../components/ReflexLandingView.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import { content } from '../../../i18n/content';
import { locales, type Locale } from '../../../i18n/locales';
import { site } from '../../../data/site';

export function getStaticPaths() {
  const languages: (Locale | 'fa')[] = ['tr', 'en', 'mk', 'sr', 'sq', 'fa'];
  return languages.map((lang) => ({ params: { lang } }));
}

const locale = Astro.params.lang as Locale | 'fa';
const copy = content[locale as Locale] || content.tr;

const seoTitles: Record<string, string> = {
  tr: 'Reflex Plastik Eldiven Çözümleri | Teyfik Gökdemir B2B Portföyü',
  en: 'Reflex Disposable Glove Solutions | Teyfik Gökdemir B2B Portfolio',
  mk: 'Reflex Ракавици За Еднократна Употреба | Тејфик Ѓокдемир B2B',
  sr: 'Reflex Rukavice Za Jednokratnu Upotrebu | Teyfik Gökdemir B2B',
  sq: 'Doreza Njëpërdorimëshe Reflex | Teyfik Gökdemir B2B',
  fa: 'دستکش‌های یک‌بارمصرف رفلکس | تیفیک گوکدمیر',
};

const seoDescriptions: Record<string, string> = {
  tr: 'Reflex Plastik profesyonel eldiven ürün grupları: Flex Hi-Tech, Flex Kids, Winlyex Pudrasız, Winlyex Termo Vinil, Medilex, Florex ve Slimfit Copolymer.',
  en: 'Reflex professional disposable glove product lines: Flex Hi-Tech, Flex Kids, Winlyex Powder-Free, Winlyex Thermo Vinyl, Medilex, Florex, and Slimfit Copolymer.',
  mk: 'Професионални ракавици Reflex: Flex Hi-Tech, Flex Kids, Winlyex Без Пудра, Winlyex Термо Винил, Medilex, Florex и Slimfit Copolymer.',
  sr: 'Profesionalne rukavice Reflex: Flex Hi-Tech, Flex Kids, Winlyex Bez Pudera, Winlyex Termo Vinil, Medilex, Florex i Slimfit Copolymer.',
  sq: 'Doreza profesionale Reflex: Flex Hi-Tech, Flex Kids, Winlyex Pa Pluhur, Winlyex Termo Vinil, Medilex, Florex dhe Slimfit Copolymer.',
  fa: 'محصولات دستکش رفلکس شامل Flex Hi-Tech، Flex Kids، Winlyex، Medilex، Florex و Slimfit Copolymer.',
};

const pagePath = `/${locale}/reflex/`;
const alternates: Record<string, string> = {
  tr: `${site.origin}/tr/reflex/`,
  en: `${site.origin}/en/reflex/`,
  mk: `${site.origin}/mk/reflex/`,
  sr: `${site.origin}/sr/reflex/`,
  sq: `${site.origin}/sq/reflex/`,
  fa: `${site.origin}/fa/reflex/`,
  'x-default': `${site.origin}/tr/reflex/`,
};

const pageSchema = [
  {
    '@type': 'Brand',
    '@id': 'https://www.reflexplastik.com/#brand',
    name: 'Reflex Plastik',
    url: 'https://www.reflexplastik.com/',
    logo: 'https://www.reflexplastik.com/wp-content/themes/kurumsalv2/assets/img/logo.png',
  },
  {
    '@type': 'BreadcrumbList',
    '@id': `${site.origin}${pagePath}#breadcrumb`,
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: 'Home',
        item: `${site.origin}/${locale}/`,
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'Reflex',
        item: `${site.origin}${pagePath}`,
      },
    ],
  },
];
---

<BaseLayout
  locale={locale}
  copy={copy}
  title={seoTitles[locale] || seoTitles.tr}
  description={seoDescriptions[locale] || seoDescriptions.tr}
  pathname={pagePath}
  alternates={alternates}
  pageSchema={pageSchema}
>
  <Header locale={locale} copy={copy} />
  <main id="main-content">
    <ReflexLandingView locale={locale} />
  </main>
  <Footer locale={locale} copy={copy} />
</BaseLayout>
