---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ReflexDetailView from '../../../components/ReflexDetailView.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import { content } from '../../../i18n/content';
import { locales, type Locale } from '../../../i18n/locales';
import { reflexProducts, getReflexProductBySlug } from '../../../data/reflexProducts';
import { site } from '../../../data/site';

export function getStaticPaths() {
  const languages: (Locale | 'fa')[] = ['tr', 'en', 'mk', 'sr', 'sq', 'fa'];
  const paths = [];

  for (const lang of languages) {
    for (const prod of reflexProducts) {
      paths.push({
        params: { lang, slug: prod.slug },
        props: { product: prod },
      });
    }
  }

  return paths;
}

const { slug } = Astro.params;
const locale = Astro.params.lang as Locale | 'fa';
const product = Astro.props.product || getReflexProductBySlug(slug as string);

if (!product) {
  throw new Error(`Product not found for slug: ${slug}`);
}

const lang = (locale || 'tr') as 'tr' | 'en' | 'mk' | 'sr' | 'sq' | 'fa';
const i18n = product.i18n[lang] || product.i18n.tr;
const copy = content[locale as Locale] || content.tr;

const pagePath = `/${locale}/reflex/${product.slug}/`;
const alternates: Record<string, string> = {
  tr: `${site.origin}/tr/reflex/${product.slug}/`,
  en: `${site.origin}/en/reflex/${product.slug}/`,
  mk: `${site.origin}/mk/reflex/${product.slug}/`,
  sr: `${site.origin}/sr/reflex/${product.slug}/`,
  sq: `${site.origin}/sq/reflex/${product.slug}/`,
  fa: `${site.origin}/fa/reflex/${product.slug}/`,
  'x-default': `${site.origin}/tr/reflex/${product.slug}/`,
};

const langBrandTitles: Record<string, string> = {
  tr: 'Reflex Plastik B2B Portföyü',
  en: 'Reflex Plastik B2B Portfolio',
  mk: 'Reflex Plastik B2B Портфолио',
  sr: 'Reflex Plastik B2B Portfolio',
  sq: 'Portofoli B2B Reflex Plastik',
  fa: 'پرتفوی B2B رفلکس پلاستیک',
};

const brandTitle = langBrandTitles[locale] || langBrandTitles.tr;
const title = `${i18n.name} | ${brandTitle}`;
const description = locale === 'fa' 
  ? `${i18n.name}: ${i18n.tagline} اطلاعات فنی و سفارش عمده B2B.`
  : `${i18n.name}: ${i18n.tagline} ${i18n.features.slice(0, 3).join(', ')}.`;

const productSchema = {
  '@type': 'Product',
  '@id': `${site.origin}${pagePath}#product`,
  name: i18n.name,
  description: i18n.description,
  image: [site.origin + product.images.main, ...(product.images.packaging ? [site.origin + product.images.packaging] : [])],
  sku: product.variants[0]?.productCode || product.slug,
  gtin13: product.variants[0]?.boxBarcode,
  brand: {
    '@type': 'Brand',
    name: 'Reflex Plastik',
    url: 'https://www.reflexplastik.com/',
  },
  material: i18n.materialName || product.material,
  color: (i18n.colors || product.colors).join(', '),
  size: (i18n.sizes || product.sizes).join(', '),
  category: 'Disposable Protective Gloves',
};

const breadcrumbSchema = {
  '@type': 'BreadcrumbList',
  '@id': `${site.origin}${pagePath}#breadcrumb`,
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: `${site.origin}/${locale}/`,
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Reflex',
      item: `${site.origin}/${locale}/reflex/`,
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: i18n.name,
      item: `${site.origin}${pagePath}`,
    },
  ],
};

const faqSchema = i18n.faq && i18n.faq.length > 0 ? {
  '@type': 'FAQPage',
  '@id': `${site.origin}${pagePath}#faq`,
  mainEntity: i18n.faq.map(f => ({
    '@type': 'Question',
    name: f.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: f.answer,
    },
  })),
} : null;

const pageSchema = [productSchema, breadcrumbSchema, ...(faqSchema ? [faqSchema] : [])];

const reflexLanguageUrls: Record<string, string> = {
  tr: `/tr/reflex/${product.slug}/`,
  en: `/en/reflex/${product.slug}/`,
  mk: `/mk/reflex/${product.slug}/`,
  sr: `/sr/reflex/${product.slug}/`,
  sq: `/sq/reflex/${product.slug}/`,
  fa: `/fa/reflex/${product.slug}/`,
};
---

<BaseLayout
  locale={locale}
  copy={copy}
  title={title}
  description={description}
  pathname={pagePath}
  alternates={alternates}
  pageSchema={pageSchema}
>
  <Header locale={locale} copy={copy} languageUrls={reflexLanguageUrls} />
  <main id="main-content">
    <ReflexDetailView product={product} locale={locale} />
  </main>
  <Footer locale={locale} copy={copy} />
</BaseLayout>
