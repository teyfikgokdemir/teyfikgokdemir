---
const title = 'Stratejik Dijital Dönüşüm ve Ticari İş Ortaklığı Teklifi';
const description = 'Kurumsal web, e-ticaret, pazaryeri, ölçümleme ve uzun vadeli stratejik ticari iş ortaklığı teklifi.';
const canonical = 'https://teyfikgokdemir.com/stratejik-dijital-donusum-teklifi/';

const scopeItems = [
  { title: 'Premium Kurumsal Web Sitesi', icon: 'web' },
  { title: 'Premium Halı E‑Ticaret Platformu', icon: 'commerce' },
  { title: 'Premium Kuruyemiş E‑Ticaret Platformu', icon: 'commerce' },
  { title: 'Amazon USA, Amazon TR, Etsy, Trendyol ve Hepsiburada mağaza kurulumları', icon: 'market' },
  { title: 'Google Analytics 4, Search Console, Tag Manager, Merchant Center', icon: 'analytics' },
  { title: 'Google Ads, Meta Ads altyapısı', icon: 'ads' },
  { title: 'Cloudflare, güvenlik ve performans optimizasyonları', icon: 'shield' },
];

const marketplaces = ['Amazon USA', 'Amazon TR', 'Etsy', 'Trendyol', 'Hepsiburada'];
const measurement = ['Google Analytics 4', 'Search Console', 'Tag Manager', 'Merchant Center'];
---
<!doctype html>
<html lang="tr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#07111f" />
    <meta name="robots" content="noindex,nofollow,noarchive" />
    <title>{title} | Teyfik Gökdemir</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon-32x32.png?v=7" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=7" sizes="180x180" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'DigitalDocument',
      name: title,
      author: { '@type': 'Person', name: 'Teyfik Gökdemir', url: 'https://teyfikgokdemir.com/' },
      dateCreated: '2026-07',
      inLanguage: 'tr-TR',
      url: canonical,
    })}></script>
  </head>
  <body>
    <header class="topbar">
      <a class="brand" href="/" aria-label="Teyfik Gökdemir ana sayfa">
        <span class="brand-mark">TG</span>
        <span>
          <strong>Teyfik Gökdemir</strong>
          <small>Stratejik Teklif • Temmuz 2026</small>
        </span>
      </a>
      <a class="top-cta" href="#yatirim">Teklifi İncele</a>
    </header>

    <main>
      <section class="hero">
        <div class="hero-orbit hero-orbit-one"></div>
        <div class="hero-orbit hero-orbit-two"></div>
        <div class="container hero-inner">
          <p class="eyebrow">Stratejik Teklif</p>
          <h1>Stratejik Dijital Dönüşüm ve Ticari İş Ortaklığı Teklifi</h1>
          <p class="hero-lead">Kurumsal web, premium e‑ticaret altyapıları, uluslararası satış kanalları ve uzun vadeli stratejik iş ortaklığını tek modelde birleştiren kapsamlı dönüşüm projesi.</p>
          <div class="hero-meta">
            <div><span>Hazırlayan</span><strong>Teyfik Gökdemir</strong></div>
            <div><span>Tarih</span><strong>Temmuz 2026</strong></div>
            <div><span>Proje Modeli</span><strong>Kurulum + İş Ortaklığı</strong></div>
          </div>
          <a class="scroll-cue" href="#ozet">Aşağı kaydır <span>↓</span></a>
        </div>
      </section>

      <section id="ozet" class="section">
        <div class="container">
          <div class="section-head">
            <p class="eyebrow">01 / Yönetici Özeti</p>
            <h2>Tek bir web sitesi değil, ölçeklenebilir bir ticari ekosistem.</h2>
          </div>
          <div class="executive-grid">
            <div class="statement-card">
              <p>Bu teklif; kurumsal web sitesi, premium e‑ticaret altyapıları, marketplace entegrasyonları, SEO/GEO/AEO/AIO çalışmaları ve uzun vadeli stratejik iş ortaklığı modelini kapsamaktadır.</p>
            </div>
            <div class="pill-grid" aria-label="Projenin ana bileşenleri">
              <span>Kurumsal Web</span><span>E‑Ticaret</span><span>Marketplace</span><span>SEO / GEO / AEO / AIO</span>
            </div>
          </div>
        </div>
      </section>

      <section class="section section-deep">
        <div class="container">
          <div class="section-head">
            <p class="eyebrow">02 / Proje Kapsamı</p>
            <h2>Uçtan uca dijital yapılanma</h2>
          </div>
          <div class="scope-grid">
            {scopeItems.map((item, index) => (
              <article class="scope-card">
                <span class="scope-number">{String(index + 1).padStart(2, '0')}</span>
                <div class="icon-wrap" aria-hidden="true">
                  {item.icon === 'web' && <svg viewBox="0 0 24 24"><path d="M4 5h16v14H4zM4 9h16M8 5v4"/></svg>}
                  {item.icon === 'commerce' && <svg viewBox="0 0 24 24"><path d="M4 7h16l-1.5 10h-13zM8 7l1-3h6l1 3M9 20h.01M16 20h.01"/></svg>}
                  {item.icon === 'market' && <svg viewBox="0 0 24 24"><path d="M3 10h18M5 10v9h14v-9M4 10l2-5h12l2 5M9 19v-5h6v5"/></svg>}
                  {item.icon === 'analytics' && <svg viewBox="0 0 24 24"><path d="M5 19V9M12 19V5M19 19v-7M3 19h18"/></svg>}
                  {item.icon === 'ads' && <svg viewBox="0 0 24 24"><path d="M4 13v-2l13-5v12L4 13zM7 14l1 5h3l-1-4M17 10h3M18 6l2-2M18 18l2 2"/></svg>}
                  {item.icon === 'shield' && <svg viewBox="0 0 24 24"><path d="M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6zM8 12l2.5 2.5L16 9"/></svg>}
                </div>
                <h3>{item.title}</h3>
                <p>Proje kapsamında</p>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="section">
        <div class="container split">
          <div>
            <p class="eyebrow">03 / Marketplace</p>
            <h2>Ulusal ve uluslararası satış kanalları</h2>
          </div>
          <div class="number-list">
            {marketplaces.map((item, index) => <div><span>{index + 1}</span><strong>{item}</strong></div>)}
          </div>
        </div>
      </section>

      <section class="section section-deep">
        <div class="container">
          <div class="section-head">
            <p class="eyebrow">04 / Ölçümleme</p>
            <h2>Veriye dayalı yönetim altyapısı</h2>
          </div>
          <div class="metric-grid">
            {measurement.map((item, index) => <div class="metric-card"><span>0{index + 1}</span><strong>{item}</strong></div>)}
          </div>
        </div>
      </section>

      <section class="section">
        <div class="container">
          <div class="section-head">
            <p class="eyebrow">05 / Reklam Altyapısı</p>
            <h2>Google Ads • Meta Ads</h2>
          </div>
          <div class="platform-grid">
            <div><strong>Google Ads</strong><span>Arama, alışveriş ve yeniden pazarlama altyapısı</span></div>
            <div><strong>Meta Ads</strong><span>Instagram ve Facebook reklam altyapısı</span></div>
          </div>
        </div>
      </section>

      <section class="section section-deep">
        <div class="container split align-center">
          <div>
            <p class="eyebrow">06 / Güvenlik ve Performans</p>
            <h2>Cloudflare, güvenlik ve performans optimizasyonları</h2>
          </div>
          <div class="security-ring">
            <div><strong>Cloudflare</strong><span>Güvenlik</span><span>Performans</span></div>
          </div>
        </div>
      </section>

      <section class="section partnership">
        <div class="container">
          <div class="section-head">
            <p class="eyebrow">07 / Stratejik Ticari İş Ortaklığı</p>
            <h2>Ortak başarıya dayalı uzun vadeli model</h2>
          </div>
          <div class="share-grid">
            <article><strong>%25</strong><p>Halı ticaretinde birlikte geliştirilen operasyonlardan elde edilen net kârın %25'lik bölümünün paylaşılması öngörülmektedir.</p></article>
            <article><strong>%50</strong><p>Diğer ortak ticari faaliyetlerde elde edilen net kârın %50'lik bölümünün paylaşılması planlanmaktadır.</p></article>
            <article class="excluded"><strong>—</strong><p>Fiziksel mağaza ve showroom satışları bu modelin kapsamı dışındadır.</p></article>
          </div>
        </div>
      </section>

      <section class="section section-deep">
        <div class="container text-layout">
          <div>
            <p class="eyebrow">08 / Reklam ve Pazarlama Bütçesi</p>
            <h2>Bütçe ayrımı ve operasyon yönetimi</h2>
          </div>
          <div class="prose-card">
            <p>Dijital reklam faaliyetleri kapsamında kullanılacak reklam bütçeleri proje kurulum bedeline dahil değildir. Google Ads, Meta Ads, Amazon Sponsored Ads ve benzeri platformlarda gerçekleştirilecek tüm reklam harcamaları doğrudan şirket tarafından karşılanacaktır. Reklam hesaplarının planlanması ve optimizasyonu stratejik iş ortaklığı kapsamında yürütülecektir.</p>
          </div>
        </div>
      </section>

      <section class="section">
        <div class="container">
          <div class="section-head">
            <p class="eyebrow">09 / Aylık Dijital Yönetim</p>
            <h2>Süreklilik sağlayan operasyon modeli</h2>
          </div>
          <div class="management-table">
            <div class="table-row"><span>İş ortaklığı devam ettiği sürece</span><strong>İş ortaklığı devam ettiği sürece dijital yönetim hizmetleri ayrıca ücretlendirilmeyecektir.</strong></div>
            <div class="table-row"><span>İş ortaklığının sona ermesi halinde</span><strong>İş ortaklığının sona ermesi halinde referans aylık dijital yönetim hizmet bedeli 50.000 TL + KDV olarak uygulanabilecektir.</strong></div>
          </div>
        </div>
      </section>

      <section class="section conclusion section-deep">
        <div class="container">
          <p class="eyebrow">10 / Sonuç</p>
          <blockquote>Bu teklif yalnızca bir web sitesi veya yazılım projesi değil; şirketin uluslararası pazarlarda sürdürülebilir büyümesini hedefleyen uzun vadeli stratejik iş ortaklığı modelidir.</blockquote>
        </div>
      </section>

      <section id="yatirim" class="section investment">
        <div class="container">
          <div class="section-head">
            <p class="eyebrow">11 / Yatırım Karşılaştırması</p>
            <h2>Stratejik iş ortaklığına özel yatırım modeli</h2>
          </div>
          <div class="price-comparison">
            <div class="market-value"><span>Yaklaşık Piyasa Değeri</span><strong>655.000 TL</strong></div>
            <div class="offer-value"><span>Proje Kurulum Bedeli</span><strong>200.000 TL <small>+ KDV</small></strong><em>Stratejik İş Ortaklığına Özel Teklif</em></div>
          </div>
        </div>
      </section>

      <section class="section payment section-deep">
        <div class="container">
          <div class="section-head">
            <p class="eyebrow">12 / Ödeme Planı</p>
            <h2>İki aşamalı ödeme</h2>
          </div>
          <div class="payment-grid">
            <article><span>%50 Ön Ödeme</span><strong>100.000 TL + KDV</strong><p>Sözleşme ile</p></article>
            <article><span>%50 Bakiye</span><strong>100.000 TL + KDV</strong><p>10 Eylül 2026 tarihinde proje teslimiyle</p></article>
          </div>
        </div>
      </section>

      <section class="closing">
        <div class="container">
          <p>Stratejik Dijital Dönüşüm</p>
          <h2>Teyfik Gökdemir</h2>
          <span>Temmuz 2026</span>
          <a href="mailto:kurumsal@teyfikgokdemir.com?subject=Stratejik%20Dijital%20Dönüşüm%20Teklifi">Teklif Hakkında İletişime Geçin</a>
        </div>
      </section>
    </main>

    <footer><span>© 2026 Teyfik Gökdemir</span><span>Özel ve gizli teklif dokümanı</span></footer>
  </body>
</html>

<style>
  :root { --navy:#07111f; --navy-2:#0b1728; --navy-3:#101f34; --gold:#d7b56d; --gold-light:#f1d99a; --text:#f7f3e9; --muted:#aab7c8; --line:rgba(215,181,109,.24); --max:1180px; }
  *{box-sizing:border-box} html{scroll-behavior:smooth;background:var(--navy)} body{margin:0;background:var(--navy);color:var(--text);font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;line-height:1.6;-webkit-font-smoothing:antialiased} a{color:inherit;text-decoration:none} .container{width:min(var(--max),calc(100% - 40px));margin-inline:auto}.topbar{position:fixed;z-index:100;top:0;left:0;right:0;display:flex;align-items:center;justify-content:space-between;gap:20px;padding:12px max(20px,calc((100vw - var(--max))/2));border-bottom:1px solid rgba(215,181,109,.15);background:rgba(7,17,31,.82);backdrop-filter:blur(18px)}.brand{display:flex;align-items:center;gap:11px}.brand-mark{display:grid;place-items:center;width:42px;height:42px;border:1px solid var(--gold);border-radius:50%;color:var(--gold-light);font-size:12px;font-weight:800;letter-spacing:.08em}.brand strong,.brand small{display:block}.brand strong{font-size:13px;letter-spacing:.08em;text-transform:uppercase}.brand small{color:var(--muted);font-size:11px}.top-cta,.closing a{display:inline-flex;align-items:center;justify-content:center;min-height:44px;padding:0 20px;border:1px solid var(--gold);border-radius:999px;background:linear-gradient(135deg,var(--gold-light),var(--gold));color:#101520;font-size:13px;font-weight:800}.hero{position:relative;min-height:100svh;display:grid;align-items:center;overflow:hidden;padding:120px 0 70px;background:radial-gradient(circle at 78% 20%,rgba(215,181,109,.12),transparent 30rem),linear-gradient(145deg,#07111f,#0d1c31 60%,#07111f)}.hero::after{content:"";position:absolute;inset:0;background-image:linear-gradient(rgba(255,255,255,.018) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.018) 1px,transparent 1px);background-size:50px 50px;mask-image:linear-gradient(to bottom,black,transparent)}.hero-inner{position:relative;z-index:2}.hero-orbit{position:absolute;border:1px solid rgba(215,181,109,.18);border-radius:50%}.hero-orbit-one{right:-16vw;top:7%;width:55vw;height:55vw}.hero-orbit-two{right:-4vw;top:24%;width:30vw;height:30vw}.eyebrow{margin:0 0 18px;color:var(--gold-light);font-size:12px;font-weight:800;letter-spacing:.18em;text-transform:uppercase}.hero h1{max-width:970px;margin:0;font-family:Georgia,"Times New Roman",serif;font-size:clamp(44px,7.5vw,104px);font-weight:500;line-height:.96;letter-spacing:-.05em;text-wrap:balance}.hero-lead{max-width:760px;margin:30px 0 0;color:var(--muted);font-size:clamp(17px,2vw,23px);line-height:1.65}.hero-meta{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));max-width:880px;margin-top:50px;border-top:1px solid var(--line);border-bottom:1px solid var(--line)}.hero-meta div{padding:20px 22px}.hero-meta div+div{border-left:1px solid var(--line)}.hero-meta span,.hero-meta strong{display:block}.hero-meta span{color:var(--muted);font-size:11px;letter-spacing:.12em;text-transform:uppercase}.hero-meta strong{margin-top:5px;font-size:15px}.scroll-cue{display:inline-flex;gap:12px;margin-top:34px;color:var(--muted);font-size:13px}.scroll-cue span{color:var(--gold)}.section{padding:clamp(80px,10vw,140px) 0;border-top:1px solid rgba(215,181,109,.11)}.section-deep{background:var(--navy-2)}.section-head{max-width:820px;margin-bottom:50px}.section h2{margin:0;font-family:Georgia,"Times New Roman",serif;font-size:clamp(38px,5vw,70px);font-weight:500;line-height:1.03;letter-spacing:-.04em;text-wrap:balance}.executive-grid{display:grid;grid-template-columns:1.35fr .65fr;gap:24px}.statement-card,.prose-card{padding:clamp(28px,5vw,56px);border:1px solid var(--line);border-radius:28px;background:linear-gradient(145deg,rgba(255,255,255,.045),rgba(255,255,255,.012));box-shadow:0 25px 80px rgba(0,0,0,.18)}.statement-card p,.prose-card p{margin:0;font-size:clamp(20px,2.5vw,32px);line-height:1.55}.pill-grid{display:grid;gap:12px}.pill-grid span{display:flex;align-items:center;min-height:70px;padding:18px 22px;border:1px solid var(--line);border-radius:18px;color:var(--gold-light);font-weight:750;background:rgba(215,181,109,.04)}.scope-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px}.scope-card{position:relative;min-height:280px;padding:30px;border:1px solid var(--line);border-radius:24px;background:linear-gradient(150deg,rgba(255,255,255,.055),rgba(255,255,255,.015));overflow:hidden}.scope-card:last-child{grid-column:span 3;min-height:220px}.scope-number{position:absolute;right:22px;top:18px;color:rgba(215,181,109,.45);font-family:Georgia,serif;font-size:46px}.icon-wrap{display:grid;place-items:center;width:58px;height:58px;border:1px solid var(--gold);border-radius:18px;background:rgba(215,181,109,.06)}.icon-wrap svg{width:30px;height:30px;fill:none;stroke:var(--gold-light);stroke-width:1.5;stroke-linecap:round;stroke-linejoin:round}.scope-card h3{max-width:300px;margin:42px 0 10px;font-size:22px;line-height:1.25}.scope-card p{margin:0;color:var(--gold);font-size:11px;font-weight:800;letter-spacing:.14em;text-transform:uppercase}.split,.text-layout{display:grid;grid-template-columns:.9fr 1.1fr;gap:70px}.align-center{align-items:center}.number-list{border-top:1px solid var(--line)}.number-list div{display:grid;grid-template-columns:60px 1fr;align-items:center;min-height:78px;border-bottom:1px solid var(--line)}.number-list span{color:var(--gold);font-family:Georgia,serif;font-size:27px}.number-list strong{font-size:20px}.metric-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:16px}.metric-card{display:flex;flex-direction:column;justify-content:space-between;min-height:190px;padding:24px;border:1px solid var(--line);border-radius:22px;background:var(--navy-3)}.metric-card span{color:var(--gold);font-family:Georgia,serif;font-size:30px}.metric-card strong{font-size:18px}.platform-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:20px}.platform-grid div{min-height:240px;display:flex;flex-direction:column;justify-content:flex-end;padding:34px;border:1px solid var(--line);border-r