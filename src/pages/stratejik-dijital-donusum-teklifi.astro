---
<!doctype html>
<html lang="tr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="theme-color" content="#07111f" />
  <meta name="robots" content="noindex,nofollow,noarchive" />
  <title>{title} | Teyfik Gökdemir</title>
  <meta name="description" content="Kurumsal web, e-ticaret, pazaryeri ve uzun vadeli stratejik ticari iş ortaklığı teklifi." />
  <link rel="canonical" href={canonical} />
  <link rel="icon" href="/favicon-32x32.png?v=7" />
  <style is:global>
    :root{--bg:#07111f;--bg2:#0b1728;--panel:#101f34;--gold:#d7b56d;--gold2:#f1d99a;--text:#f7f3e9;--muted:#aab7c8;--line:rgba(215,181,109,.24);--max:1180px}
    *{box-sizing:border-box}html{scroll-behavior:smooth;background:var(--bg)}body{margin:0;background:var(--bg);color:var(--text);font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;line-height:1.6;-webkit-font-smoothing:antialiased}a{color:inherit;text-decoration:none}.container{width:min(var(--max),calc(100% - 40px));margin:auto}
    .topbar{position:fixed;z-index:50;inset:0 0 auto;display:flex;justify-content:space-between;align-items:center;gap:20px;padding:12px max(20px,calc((100vw - var(--max))/2));background:rgba(7,17,31,.88);border-bottom:1px solid var(--line);backdrop-filter:blur(18px)}.brand{display:flex;align-items:center;gap:12px}.mark{display:grid;place-items:center;width:42px;height:42px;border:1px solid var(--gold);border-radius:50%;color:var(--gold2);font-size:12px;font-weight:800}.brand strong,.brand small{display:block}.brand strong{font-size:13px;letter-spacing:.08em;text-transform:uppercase}.brand small{font-size:11px;color:var(--muted)}.cta{display:inline-flex;align-items:center;justify-content:center;min-height:44px;padding:0 20px;border-radius:999px;background:linear-gradient(135deg,var(--gold2),var(--gold));color:#101520;font-size:13px;font-weight:800}
    .hero{min-height:100svh;display:grid;align-items:center;padding:120px 0 70px;background:radial-gradient(circle at 80% 18%,rgba(215,181,109,.15),transparent 30rem),linear-gradient(145deg,#07111f,#0d1c31 60%,#07111f);position:relative;overflow:hidden}.hero:after{content:"";position:absolute;inset:0;background-image:linear-gradient(rgba(255,255,255,.018) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.018) 1px,transparent 1px);background-size:50px 50px}.hero .container{position:relative;z-index:2}.eyebrow{margin:0 0 18px;color:var(--gold2);font-size:12px;font-weight:800;letter-spacing:.18em;text-transform:uppercase}.hero h1,h2{font-family:Georgia,"Times New Roman",serif;font-weight:500;letter-spacing:-.045em;text-wrap:balance}.hero h1{max-width:1000px;margin:0;font-size:clamp(44px,7.5vw,104px);line-height:.96}.lead{max-width:760px;margin:30px 0 0;color:var(--muted);font-size:clamp(17px,2vw,23px);line-height:1.65}.meta{display:grid;grid-template-columns:repeat(3,1fr);max-width:900px;margin-top:48px;border-block:1px solid var(--line)}.meta div{padding:20px 22px}.meta div+div{border-left:1px solid var(--line)}.meta span,.meta strong{display:block}.meta span{color:var(--muted);font-size:11px;text-transform:uppercase;letter-spacing:.12em}.meta strong{margin-top:5px}.down{display:inline-flex;gap:10px;margin-top:30px;color:var(--muted)}
    section{padding:clamp(78px,10vw,140px) 0;border-top:1px solid rgba(215,181,109,.11)}.deep{background:var(--bg2)}.head{max-width:850px;margin-bottom:46px}h2{margin:0;font-size:clamp(38px,5vw,70px);line-height:1.04}.summary{display:grid;grid-template-columns:1.3fr .7fr;gap:22px}.statement,.prose{padding:clamp(28px,5vw,56px);border:1px solid var(--line);border-radius:28px;background:linear-gradient(145deg,rgba(255,255,255,.05),rgba(255,255,255,.012))}.statement p,.prose p{margin:0;font-size:clamp(20px,2.5vw,31px);line-height:1.55}.tags{display:grid;gap:12px}.tags span{display:flex;align-items:center;min-height:68px;padding:18px 22px;border:1px solid var(--line);border-radius:18px;color:var(--gold2);background:rgba(215,181,109,.04);font-weight:750}
    .scope{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}.card{position:relative;min-height:250px;padding:30px;border:1px solid var(--line);border-radius:24px;background:linear-gradient(150deg,rgba(255,255,255,.055),rgba(255,255,255,.015))}.card:last-child{grid-column:span 3;min-height:190px}.num{color:rgba(215,181,109,.5);font:42px Georgia,serif}.icon{display:grid;place-items:center;width:54px;height:54px;margin-top:22px;border:1px solid var(--gold);border-radius:16px;color:var(--gold2);font-size:22px}.card h3{max-width:310px;margin:28px 0 0;font-size:21px;line-height:1.3}
    .split{display:grid;grid-template-columns:.9fr 1.1fr;gap:70px;align-items:start}.list{border-top:1px solid var(--line)}.list div{display:grid;grid-template-columns:58px 1fr;align-items:center;min-height:76px;border-bottom:1px solid var(--line)}.list span{color:var(--gold);font:27px Georgia,serif}.list strong{font-size:20px}.metrics{display:grid;grid-template-columns:repeat(4,1fr);gap:16px}.metric{min-height:180px;padding:24px;border:1px solid var(--line);border-radius:22px;background:var(--panel);display:flex;flex-direction:column;justify-content:space-between}.metric span{color:var(--gold);font:30px Georgia,serif}.metric strong{font-size:18px}
    .platforms,.shares,.payments{display:grid;grid-template-columns:repeat(2,1fr);gap:20px}.platforms article,.shares article,.payments article{padding:34px;border:1px solid var(--line);border-radius:26px;background:linear-gradient(150deg,rgba(215,181,109,.1),rgba(255,255,255,.015))}.platforms article{min-height:220px;display:flex;flex-direction:column;justify-content:flex-end}.platforms strong{font:42px Georgia,serif}.platforms p,.shares p,.payments p{color:var(--muted)}.shares article{min-height:290px}.shares strong{display:block;color:var(--gold2);font:76px Georgia,serif;line-height:1}.shares .wide{grid-column:span 2;min-height:auto}.table{border:1px solid var(--line);border-radius:24px;overflow:hidden}.row{display:grid;grid-template-columns:.75fr 1.25fr;gap:35px;padding:34px}.row+.row{border-top:1px solid var(--line)}.row span{color:var(--gold2);font-weight:800}.row strong{font-size:18px;line-height:1.7}
    blockquote{max-width:1000px;margin:30px 0 0;padding-left:34px;border-left:3px solid var(--gold);font:clamp(32px,5vw,66px)/1.18 Georgia,serif;letter-spacing:-.035em}.prices{display:grid;grid-template-columns:.75fr 1.25fr;gap:20px}.price{min-height:310px;padding:36px;border:1px solid var(--line);border-radius:28px;display:flex;flex-direction:column;justify-content:flex-end}.price span{color:var(--muted);font-size:13px;font-weight:800;letter-spacing:.12em;text-transform:uppercase}.price strong{margin-top:20px;font:clamp(44px,6vw,76px)/1 Georgia,serif}.price small{font:18px Inter,sans-serif}.market strong{text-decoration:line-through;text-decoration-color:rgba(215,181,109,.55)}.offer{background:linear-gradient(145deg,rgba(215,181,109,.18),rgba(215,181,109,.03))}.offer em{margin-top:22px;color:var(--gold2);font-style:normal;font-weight:800}.payments article{background:var(--panel)}.payments span{color:var(--gold2);font-weight:800}.payments strong{display:block;margin-top:22px;font:clamp(34px,4vw,52px)/1.1 Georgia,serif}.closing{text-align:center;padding:120px 0}.closing h2{font-size:clamp(52px,8vw,90px)}.closing .cta{margin-top:30px}footer{display:flex;justify-content:space-between;padding:24px max(20px,calc((100vw - var(--max))/2));border-top:1px solid var(--line);color:var(--muted);font-size:12px}
    @media(max-width:900px){.summary,.split,.prices{grid-template-columns:1fr}.scope{grid-template-columns:repeat(2,1fr)}.card:last-child{grid-column:span 2}.metrics{grid-template-columns:repeat(2,1fr)}.meta{grid-template-columns:1fr}.meta div+div{border-left:0;border-top:1px solid var(--line)}.shares{grid-template-columns:1fr}.shares .wide{grid-column:auto}}
    @media(max-width:620px){.container{width:calc(100% - 28px)}.topbar{padding:10px 14px}.brand small{display:none}.brand strong{font-size:11px}.mark{width:38px;height:38px}.cta{min-height:40px;padding:0 14px;font-size:11px}.hero{padding-top:110px}.hero h1{font-size:clamp(42px,13vw,62px)}.lead{font-size:17px}section{padding:74px 0}.head{margin-bottom:30px}h2{font-size:clamp(35px,10vw,48px)}.scope,.metrics,.platforms,.payments{grid-template-columns:1fr}.card:last-child{grid-column:auto}.card{min-height:220px;padding:26px}.statement,.prose{padding:26px}.statement p,.prose p{font-size:20px}.shares article{min-height:auto;padding:28px}.shares strong{font-size:62px}.row{grid-template-columns:1fr;gap:12px;padding:26px}.row strong{font-size:16px}blockquote{padding-left:20px;font-size:35px}.price{min-height:240px;padding:28px}footer{flex-direction:column;text-align:center;gap:8px}}
  </style>
</head>
<body>
<header class="topbar"><a class="brand" href="/"><span class="mark">TG</span><span><strong>Teyfik Gökdemir</strong><small>Stratejik Teklif • Temmuz 2026</small></span></a><a class="cta" href="#yatirim">Teklifi İncele</a></header>
<main>
<section class="hero"><div class="container"><p class="eyebrow">Stratejik Teklif</p><h1>{title}</h1><p class="lead">Kurumsal web, premium e‑ticaret altyapıları, uluslararası satış kanalları ve uzun vadeli stratejik iş ortaklığını tek modelde birleştiren kapsamlı dönüşüm projesi.</p><div class="meta"><div><span>Hazırlayan</span><strong>Teyfik Gökdemir</strong></div><div><span>Tarih</span><strong>Temmuz 2026</strong></div><div><span>Proje Modeli</span><strong>Kurulum + İş Ortaklığı</strong></div></div><a class="down" href="#ozet">Aşağı kaydır ↓</a></div></section>
