---
const title = 'Teyfik Gökdemir | Otonom Büyüme & DevOps Paneli';
const description = 'Gizli Yönetici Paneli';
const canonical = 'https://teyfikgokdemir.com/cansu/';
---
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{title}</title>
    <meta name="description" content={description}>
    <link rel="canonical" href={canonical}>
    <meta name="robots" content="noindex, nofollow">
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body class="bg-slate-950 text-slate-100 min-h-screen font-sans">
    <!-- Auth Guard Modal -->
    <div id="auth-modal" class="fixed inset-0 bg-slate-950/90 z-50 flex items-center justify-center p-4">
        <div class="bg-slate-900 border border-slate-800 rounded-2xl p-8 max-w-md w-full shadow-2xl">
            <div class="text-center mb-6">
                <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-cyan-500/10 text-cyan-400 mb-4 text-2xl">
                    <i class="fa-solid fa-shield-halved"></i>
                </div>
                <h2 class="text-xl font-bold">Yetkili Yönetici Girişi</h2>
                <p class="text-sm text-slate-400 mt-1">Bu panel gizlidir. Lütfen erişim şifrenizi girin.</p>
            </div>
            <form onsubmit="handleAuth(event)" class="space-y-4">
                <div>
                    <input type="password" id="admin-pass" placeholder="Yönetici Şifresi" class="w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-3 text-slate-100 focus:outline-none focus:border-cyan-500 transition">
                </div>
                <button type="submit" class="w-full bg-cyan-500 hover:bg-cyan-400 text-slate-950 font-semibold py-3 rounded-xl transition shadow-lg shadow-cyan-500/20">
                    Sisteme Giriş Yap
                </button>
            </form>
            <p id="auth-error" class="text-red-400 text-xs text-center mt-3 hidden">Geçersiz şifre! Tekrar deneyin.</p>
        </div>
    </div>

    <!-- Main Dashboard -->
    <div id="dashboard-content" class="hidden max-w-7xl mx-auto px-4 py-8">
        <header class="flex flex-col md:flex-row justify-between items-start md:items-center mb-8 pb-6 border-b border-slate-800 gap-4">
            <div>
                <h1 class="text-2xl font-bold flex items-center gap-3">
                    <i class="fa-solid fa-server text-cyan-400"></i> Otonom Büyüme & DevOps Paneli
                </h1>
                <p class="text-sm text-slate-400 mt-1">Cloudflare & GitHub Actions Otomasyon Sağlık ve İzleme Merkezi</p>
            </div>
            <div class="flex items-center gap-3">
                <span class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-emerald-500/10 text-emerald-400 text-xs font-medium border border-emerald-500/20">
                    <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span> Sistem Aktif (0 Hata)
                </span>
                <button onclick="lockDashboard()" class="bg-slate-900 hover:bg-slate-800 border border-slate-800 text-slate-300 px-4 py-2 rounded-xl text-xs transition">
                    <i class="fa-solid fa-lock mr-2"></i> Kilitle
                </button>
            </div>
        </header>

        <!-- Stats Grid -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-8">
            <div class="bg-slate-900/60 border border-slate-800/80 rounded-2xl p-5">
                <div class="flex justify-between items-start">
                    <p class="text-slate-400 text-xs font-medium uppercase tracking-wider">Toplam Repolar</p>
                    <i class="fa-solid fa-code-branch text-cyan-400 text-lg"></i>
                </div>
                <h3 class="text-3xl font-bold mt-2">6</h3>
                <p class="text-emerald-400 text-xs mt-2"><i class="fa-solid fa-arrow-up mr-1"></i> %100 Senkronize</p>
            </div>
            <div class="bg-slate-900/60 border border-slate-800/80 rounded-2xl p-5">
                <div class="flex justify-between items-start">
                    <p class="text-slate-400 text-xs font-medium uppercase tracking-wider">Aktif Workflow</p>
                    <i class="fa-solid fa-bolt text-amber-400 text-lg"></i>
                </div>
                <h3 class="text-3xl font-bold mt-2">24+</h3>
                <p class="text-slate-400 text-xs mt-2">CI/CD, SEO, Security</p>
            </div>
            <div class="bg-slate-900/60 border border-slate-800/80 rounded-2xl p-5">
                <div class="flex justify-between items-start">
                    <p class="text-slate-400 text-xs font-medium uppercase tracking-wider">Büyüme Motorları</p>
                    <i class="fa-solid fa-robot text-purple-400 text-lg"></i>
                </div>
                <h3 class="text-3xl font-bold mt-2">3</h3>
                <p class="text-purple-400 text-xs mt-2">Lead Bot, Devlog, AI Content</p>
            </div>
            <div class="bg-slate-900/60 border border-slate-800/80 rounded-2xl p-5">
                <div class="flex justify-between items-start">
                    <p class="text-slate-400 text-xs font-medium uppercase tracking-wider">Güvenlik Zırhı</p>
                    <i class="fa-solid fa-shield text-emerald-400 text-lg"></i>
                </div>
                <h3 class="text-3xl font-bold mt-2">Aktif</h3>
                <p class="text-emerald-400 text-xs mt-2">WAF, Origin Pulls, Dependabot</p>
            </div>
        </div>

        <!-- Repositories & Workflows Table -->
        <div class="bg-slate-900/60 border border-slate-800/80 rounded-2xl overflow-hidden mb-8">
            <div class="px-6 py-5 border-b border-slate-800 flex justify-between items-center">
                <h3 class="font-bold text-lg">Proje Otomasyon Durumları</h3>
                <span class="text-xs text-slate-400">Canlı GitHub Actions Entegrasyonu</span>
            </div>
            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse">
                    <thead>
                        <tr class="border-b border-slate-800 text-xs text-slate-400 uppercase bg-slate-950/40">
                            <th class="px-6 py-4 font-semibold">Proje / Varlık</th>
                            <th class="px-6 py-4 font-semibold">Ana Otomasyonlar</th>
                            <th class="px-6 py-4 font-semibold">Çalışma Sıklığı</th>
                            <th class="px-6 py-4 font-semibold">Durum</th>
                            <th class="px-6 py-4 font-semibold text-right">Aksiyon</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-800/60 text-sm">
                        <tr class="hover:bg-slate-800/30 transition">
                            <td class="px-6 py-4 font-medium flex items-center gap-3">
                                <i class="fa-solid fa-globe text-cyan-400"></i> teyfikgokdemir
                            </td>
                            <td class="px-6 py-4 text-slate-300">Deploy, Security, Maintenance, SEO Ping, AI Content</td>
                            <td class="px-6 py-4 text-slate-400 text-xs">Push & Cron (Günlük)</td>
                            <td class="px-6 py-4"><span class="px-2.5 py-1 rounded-full bg-emerald-500/10 text-emerald-400 text-xs border border-emerald-500/20">Çalışıyor</span></td>
                            <td class="px-6 py-4 text-right">
                                <a href="https://github.com/teyfikgokdemir/teyfikgokdemir/actions" target="_blank" class="text-xs bg-slate-800 hover:bg-slate-700 px-3 py-1.5 rounded-lg transition border border-slate-700">Loglar <i class="fa-solid fa-external-link ml-1"></i></a>
                            </td>
                        </tr>
                        <tr class="hover:bg-slate-800/30 transition">
                            <td class="px-6 py-4 font-medium flex items-center gap-3">
                                <i class="fa-solid fa-chart-line text-amber-400"></i> ctseg
                            </td>
                            <td class="px-6 py-4 text-slate-300">Deploy, Security, B2B Lead Scraper Bot</td>
                            <td class="px-6 py-4 text-slate-400 text-xs">Push & Pazartesi 08:00</td>
                            <td class="px-6 py-4"><span class="px-2.5 py-1 rounded-full bg-emerald-500/10 text-emerald-400 text-xs border border-emerald-500/20">Çalışıyor</span></td>
                            <td class="px-6 py-4 text-right">
                                <a href="https://github.com/teyfikgokdemir/ctseg/actions" target="_blank" class="text-xs bg-slate-800 hover:bg-slate-700 px-3 py-1.5 rounded-lg transition border border-slate-700">Loglar <i class="fa-solid fa-external-link ml-1"></i></a>
                            </td>
                        </tr>
                        <tr class="hover:bg-slate-800/30 transition">
                            <td class="px-6 py-4 font-medium flex items-center gap-3">
                                <i class="fa-solid fa-gamepad text-purple-400"></i> mythborn
                            </td>
                            <td class="px-6 py-4 text-slate-300">Deploy, Security, Community & Devlog Sync</td>
                            <td class="px-6 py-4 text-slate-400 text-xs">Push & Çarşamba 12:00</td>
                            <td class="px-6 py-4"><span class="px-2.5 py-1 rounded-full bg-emerald-500/10 text-emerald-400 text-xs border border-emerald-500/20">Çalışıyor</span></td>
                            <td class="px-6 py-4 text-right">
                                <a href="https://github.com/teyfikgokdemir/mythborn/actions" target="_blank" class="text-xs bg-slate-800 hover:bg-slate-700 px-3 py-1.5 rounded-lg transition border border-slate-700">Loglar <i class="fa-solid fa-external-link ml-1"></i></a>
                            </td>
                        </tr>
                        <tr class="hover:bg-slate-800/30 transition">
                            <td class="px-6 py-4 font-medium flex items-center gap-3">
                                <i class="fa-solid fa-palette text-blue-400"></i> qct-studio
                            </td>
                            <td class="px-6 py-4 text-slate-300">Deploy, Security, Link Checker, SEO Ping</td>
                            <td class="px-6 py-4 text-slate-400 text-xs">Push & Haftalık</td>
                            <td class="px-6 py-4"><span class="px-2.5 py-1 rounded-full bg-emerald-500/10 text-emerald-400 text-xs border border-emerald-500/20">Çalışıyor</span></td>
                            <td class="px-6 py-4 text-right">
                                <a href="https://github.com/teyfikgokdemir/qct-studio/actions" target="_blank" class="text-xs bg-slate-800 hover:bg-slate-700 px-3 py-1.5 rounded-lg transition border border-slate-700">Loglar <i class="fa-solid fa-external-link ml-1"></i></a>
                            </td>
                        </tr>
                        <tr class="hover:bg-slate-800/30 transition">
                            <td class="px-6 py-4 font-medium flex items-center gap-3">
                                <i class="fa-solid fa-store text-emerald-400"></i> qct-commerce-tr
                            </td>
                            <td class="px-6 py-4 text-slate-300">Deploy, Security, Maintenance</td>
                            <td class="px-6 py-4 text-slate-400 text-xs">Push & Günlük</td>
                            <td class="px-6 py-4"><span class="px-2.5 py-1 rounded-full bg-emerald-500/10 text-emerald-400 text-xs border border-emerald-500/20">Çalışıyor</span></td>
                            <td class="px-6 py-4 text-right">
                                <a href="https://github.com/teyfikgokdemir/qct-commerce-tr/actions" target="_blank" class="text-xs bg-slate-800 hover:bg-slate-700 px-3 py-1.5 rounded-lg transition border border-slate-700">Loglar <i class="fa-solid fa-external-link ml-1"></i></a>
                            </td>
                        </tr>
                        <tr class="hover:bg-slate-800/30 transition">
                            <td class="px-6 py-4 font-medium flex items-center gap-3">
                                <i class="fa-solid fa-building text-rose-400"></i> iran-ahli
                            </td>
                            <td class="px-6 py-4 text-slate-300">Deploy, Security, Audit</td>
                            <td class="px-6 py-4 text-slate-400 text-xs">Push & Günlük</td>
                            <td class="px-6 py-4"><span class="px-2.5 py-1 rounded-full bg-emerald-500/10 text-emerald-400 text-xs border border-emerald-500/20">Çalışıyor</span></td>
                            <td class="px-6 py-4 text-right">
                                <a href="https://github.com/teyfikgokdemir/iran-ahli/actions" target="_blank" class="text-xs bg-slate-800 hover:bg-slate-700 px-3 py-1.5 rounded-lg transition border border-slate-700">Loglar <i class="fa-solid fa-external-link ml-1"></i></a>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <script>
        function handleAuth(event) {
            event.preventDefault();
            const pass = document.getElementById('admin-pass').value;
            if (pass === 'teyfik2026') {
                document.getElementById('auth-modal').style.display = 'none';
                document.getElementById('dashboard-content').classList.remove('hidden');
                localStorage.setItem('admin_auth', 'true');
            } else {
                document.getElementById('auth-error').classList.remove('hidden');
            }
        }

        function lockDashboard() {
            localStorage.removeItem('admin_auth');
            location.reload();
        }

        window.onload = function() {
            if (localStorage.getItem('admin_auth') === 'true') {
                document.getElementById('auth-modal').style.display = 'none';
                document.getElementById('dashboard-content').classList.remove('hidden');
            }
        }
    </script>
</body>
</html>
