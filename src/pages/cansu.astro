---
const title = 'Cansu Operations Center';
const description = 'Kaynak bazlı web operasyon, trafik, SEO ve deployment merkezi';
const canonical = 'https://cansu.teyfikgokdemir.com/';
---
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{title}</title>
    <meta name="description" content={description}>
    <link rel="canonical" href={canonical}>
    <meta name="robots" content="noindex, nofollow">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <style is:global>
        :root {
            color-scheme: dark;
            --bg-0: #060911;
            --bg-1: #0b101b;
            --bg-2: #111827;
            --bg-3: #172033;
            --line-subtle: rgba(148, 163, 184, 0.12);
            --line-strong: rgba(148, 163, 184, 0.24);
            --ink-1: #f8fafc;
            --ink-2: #cbd5e1;
            --ink-3: #8fa0b8;
            --ink-4: #64748b;
            --cyan: #38bdf8;
            --cyan-dim: rgba(56, 189, 248, 0.12);
            --emerald: #10b981;
            --emerald-dim: rgba(16, 185, 129, 0.12);
            --amber: #f59e0b;
            --amber-dim: rgba(245, 158, 11, 0.12);
            --rose: #f43f5e;
            --rose-dim: rgba(244, 63, 94, 0.12);
            --violet: #8b5cf6;
            --radius-xl: 18px;
            --radius-lg: 14px;
            --radius-md: 10px;
            --radius-sm: 8px;
            --shadow-card: 0 18px 48px rgba(0, 0, 0, 0.34), inset 0 1px 0 rgba(255, 255, 255, 0.04);
        }

        *, *::before, *::after { box-sizing: border-box; }

        body {
            margin: 0;
            min-height: 100vh;
            background:
                radial-gradient(1100px 420px at 18% -8%, rgba(56, 189, 248, 0.11), transparent 62%),
                radial-gradient(900px 380px at 86% -10%, rgba(16, 185, 129, 0.08), transparent 58%),
                var(--bg-0);
            color: var(--ink-1);
            font-family: 'Inter', ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
            -webkit-font-smoothing: antialiased;
            overflow-x: hidden;
        }

        .hidden, [hidden] { display: none !important; }
        .num { font-variant-numeric: tabular-nums; }
        button:focus-visible, a:focus-visible, select:focus-visible, input:focus-visible {
            outline: 2px solid var(--cyan);
            outline-offset: 2px;
        }

        .shell {
            max-width: 86rem;
            margin: 0 auto;
            padding: 1.5rem clamp(0.9rem, 2.5vw, 2.25rem) 4rem;
        }

        /* Command Header */
        .cmd-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 1rem;
            padding: 1.15rem 1.4rem;
            margin-bottom: 1rem;
            border: 1px solid var(--line-subtle);
            border-radius: var(--radius-xl);
            background: linear-gradient(145deg, rgba(15, 23, 42, 0.88), rgba(9, 13, 24, 0.94));
            box-shadow: var(--shadow-card);
        }
        .cmd-brand { display: flex; align-items: center; gap: 0.9rem; min-width: 0; }
        .cmd-mark {
            width: 2.75rem;
            height: 2.75rem;
            border-radius: 12px;
            display: grid;
            place-items: center;
            font-weight: 800;
            font-size: 1.1rem;
            letter-spacing: -0.04em;
            color: #e0f2fe;
            background: linear-gradient(135deg, rgba(14, 165, 233, 0.28), rgba(16, 185, 129, 0.22));
            border: 1px solid rgba(56, 189, 248, 0.38);
            box-shadow: 0 8px 24px rgba(14, 165, 233, 0.16);
            flex-shrink: 0;
        }
        .cmd-title {
            margin: 0;
            font-size: clamp(1.15rem, 2vw, 1.45rem);
            font-weight: 750;
            letter-spacing: -0.03em;
            color: var(--ink-1);
        }
        .cmd-sub {
            margin: 0.22rem 0 0;
            font-size: 0.78rem;
            color: var(--ink-3);
        }
        .cmd-actions { display: flex; align-items: center; gap: 0.6rem; flex-wrap: wrap; }

        .pill {
            display: inline-flex;
            align-items: center;
            gap: 0.45rem;
            padding: 0.44rem 0.78rem;
            border-radius: 999px;
            font-size: 0.72rem;
            font-weight: 650;
            border: 1px solid var(--line-subtle);
            background: rgba(15, 23, 42, 0.72);
            color: var(--ink-2);
            white-space: nowrap;
        }
        .pill--window {
            color: #bae6fd;
            border-color: rgba(56, 189, 248, 0.3);
            background: rgba(14, 116, 144, 0.16);
        }
        .pill-dot {
            width: 0.46rem;
            height: 0.46rem;
            border-radius: 50%;
            background: currentColor;
            box-shadow: 0 0 10px currentColor;
        }

        .btn {
            display: inline-flex;
            align-items: center;
            gap: 0.45rem;
            min-height: 2.35rem;
            padding: 0.48rem 0.92rem;
            border-radius: var(--radius-md);
            border: 1px solid var(--line-strong);
            background: rgba(17, 24, 39, 0.9);
            color: var(--ink-1);
            font: inherit;
            font-size: 0.76rem;
            font-weight: 650;
            text-decoration: none;
            cursor: pointer;
            transition: border-color 0.16s ease, background 0.16s ease, transform 0.16s ease;
        }
        .btn:hover {
            border-color: rgba(56, 189, 248, 0.55);
            background: rgba(14, 116, 144, 0.2);
            transform: translateY(-1px);
        }
        .btn--primary {
            border-color: rgba(56, 189, 248, 0.45);
            background: linear-gradient(135deg, rgba(14, 165, 233, 0.24), rgba(16, 185, 129, 0.16));
            color: #e0f2fe;
        }
        .btn--warn {
            border-color: rgba(245, 158, 11, 0.42);
            background: rgba(245, 158, 11, 0.12);
            color: #fde68a;
        }

        /* Pipeline Strip */
        .pipeline-strip {
            display: grid;
            grid-template-columns: repeat(5, minmax(0, 1fr));
            gap: 0.65rem;
            margin-bottom: 1.1rem;
        }
        .pipe-card {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 0.6rem;
            padding: 0.72rem 0.9rem;
            border: 1px solid var(--line-subtle);
            border-radius: var(--radius-lg);
            background: rgba(11, 16, 27, 0.88);
            min-width: 0;
        }
        .pipe-card__left { min-width: 0; }
        .pipe-card__label {
            display: block;
            font-size: 0.64rem;
            font-weight: 750;
            letter-spacing: 0.06em;
            text-transform: uppercase;
            color: var(--ink-4);
        }
        .pipe-card__val {
            display: block;
            margin-top: 0.18rem;
            font-size: 0.78rem;
            font-weight: 650;
            color: var(--ink-1);
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }
        .badge {
            display: inline-flex;
            align-items: center;
            gap: 0.3rem;
            padding: 0.22rem 0.52rem;
            border-radius: 999px;
            font-size: 0.6rem;
            font-weight: 800;
            letter-spacing: 0.045em;
            text-transform: uppercase;
            white-space: nowrap;
            border: 1px solid transparent;
        }
        .badge--good, .status-pill--good { color: #34d399; background: var(--emerald-dim); border-color: rgba(16, 185, 129, 0.32); }
        .badge--warn, .status-pill--warn { color: #fbbf24; background: var(--amber-dim); border-color: rgba(245, 158, 11, 0.32); }
        .badge--bad { color: #fb7185; background: var(--rose-dim); border-color: rgba(244, 63, 94, 0.32); }
        .badge--neutral { color: var(--ink-3); background: rgba(148, 163, 184, 0.1); border-color: var(--line-subtle); }
        .status-pill {
            display: inline-flex;
            align-items: center;
            padding: 0.24rem 0.52rem;
            border-radius: 999px;
            font-size: 0.6rem;
            font-weight: 800;
            letter-spacing: 0.045em;
            border: 1px solid var(--line-subtle);
        }

        /* Sticky Module Navigation */
        .module-nav {
            position: sticky;
            top: 0.7rem;
            z-index: 40;
            display: grid;
            grid-template-columns: repeat(6, minmax(0, 1fr));
            gap: 0.35rem;
            padding: 0.38rem;
            margin-bottom: 1.25rem;
            border: 1px solid var(--line-subtle);
            border-radius: var(--radius-lg);
            background: rgba(8, 12, 22, 0.88);
            backdrop-filter: blur(18px);
            box-shadow: 0 14px 40px rgba(0, 0, 0, 0.36);
        }
        .module-tab {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 0.45rem;
            min-height: 2.55rem;
            padding: 0.55rem 0.75rem;
            border: 1px solid transparent;
            border-radius: var(--radius-md);
            background: transparent;
            color: var(--ink-3);
            font: inherit;
            font-size: 0.76rem;
            font-weight: 680;
            cursor: pointer;
            white-space: nowrap;
            transition: background 0.16s ease, color 0.16s ease, border-color 0.16s ease;
        }
        .module-tab:hover { color: var(--ink-1); background: rgba(30, 41, 59, 0.5); }
        .module-tab.is-active {
            color: #f0f9ff;
            background: linear-gradient(135deg, rgba(14, 165, 233, 0.22), rgba(30, 41, 59, 0.86));
            border-color: rgba(56, 189, 248, 0.32);
            box-shadow: 0 6px 18px rgba(0, 0, 0, 0.26);
        }

        [data-dashboard-panel] { display: none !important; }
        [data-dashboard-panel].is-active-panel { display: block !important; }
        #stats-grid.is-active-panel { display: grid !important; }

        /* Surface Cards & Sections */
        .panel {
            border: 1px solid var(--line-subtle);
            border-radius: var(--radius-xl);
            padding: clamp(1.05rem, 2vw, 1.5rem);
            margin-bottom: 1.2rem;
            background: linear-gradient(160deg, rgba(13, 19, 33, 0.94), rgba(8, 12, 22, 0.96));
            box-shadow: var(--shadow-card);
        }
        .panel__head {
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 0.85rem;
            margin-bottom: 1.05rem;
        }
        .panel__title {
            margin: 0;
            font-size: 1.02rem;
            font-weight: 740;
            letter-spacing: -0.02em;
            color: var(--ink-1);
        }
        .panel__desc {
            margin: 0.28rem 0 0;
            font-size: 0.76rem;
            line-height: 1.5;
            color: var(--ink-3);
            max-width: 58rem;
        }

        /* Executive KPI Row */
        .kpi-grid {
            display: grid;
            grid-template-columns: repeat(5, minmax(0, 1fr));
            gap: 0.85rem;
            margin-bottom: 1.2rem;
        }
        .kpi-card {
            position: relative;
            overflow: hidden;
            border: 1px solid var(--line-subtle);
            border-radius: var(--radius-lg);
            padding: 1.05rem 1.1rem;
            background: linear-gradient(155deg, rgba(17, 25, 42, 0.92), rgba(9, 13, 24, 0.96));
            box-shadow: var(--shadow-card);
        }
        .kpi-card::before {
            content: '';
            position: absolute;
            inset: 0 0 auto;
            height: 2px;
            background: linear-gradient(90deg, var(--kpi-accent, var(--cyan)), transparent);
            opacity: 0.85;
        }
        .kpi-card__label {
            font-size: 0.65rem;
            font-weight: 760;
            letter-spacing: 0.06em;
            text-transform: uppercase;
            color: var(--ink-3);
            margin: 0;
        }
        .kpi-card__value {
            margin: 0.42rem 0 0;
            font-size: clamp(1.45rem, 2.2vw, 1.85rem);
            font-weight: 780;
            letter-spacing: -0.03em;
            font-variant-numeric: tabular-nums;
            color: var(--ink-1);
        }
        .kpi-card__sub {
            margin: 0.36rem 0 0;
            font-size: 0.7rem;
            color: var(--ink-4);
        }

        /* Controls Bar */
        .controls-bar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 0.75rem;
            margin-bottom: 1rem;
        }
        .segmented {
            display: inline-flex;
            padding: 0.25rem;
            gap: 0.2rem;
            border: 1px solid var(--line-subtle);
            border-radius: var(--radius-md);
            background: rgba(6, 9, 17, 0.85);
        }
        .seg-btn {
            min-height: 2.1rem;
            padding: 0.35rem 0.78rem;
            border: 0;
            border-radius: 7px;
            background: transparent;
            color: var(--ink-3);
            font: inherit;
            font-size: 0.73rem;
            font-weight: 680;
            cursor: pointer;
            transition: background 0.15s ease, color 0.15s ease;
        }
        .seg-btn:hover { color: var(--ink-1); }
        .seg-btn.is-active {
            color: #f0f9ff;
            background: rgba(56, 189, 248, 0.2);
            box-shadow: inset 0 0 0 1px rgba(56, 189, 248, 0.32);
        }

        select.ctrl-select {
            min-height: 2.35rem;
            padding: 0.4rem 0.75rem;
            border: 1px solid var(--line-strong);
            border-radius: var(--radius-md);
            background: var(--bg-1);
            color: var(--ink-1);
            font: inherit;
            font-size: 0.76rem;
        }
        label.ctrl-label {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            font-size: 0.76rem;
            font-weight: 620;
            color: var(--ink-2);
        }

        /* Chart Container */
        .chart-wrap {
            border: 1px solid var(--line-subtle);
            border-radius: var(--radius-lg);
            padding: 1rem 1.1rem;
            background: rgba(6, 9, 17, 0.62);
            margin-bottom: 1.15rem;
        }
        .chart-legend {
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 0.7rem;
            margin-bottom: 0.75rem;
            font-size: 0.72rem;
            color: var(--ink-3);
        }
        .legend-items { display: flex; gap: 1rem; flex-wrap: wrap; }
        .legend-item { display: inline-flex; align-items: center; gap: 0.4rem; }
        .legend-swatch { width: 0.65rem; height: 0.65rem; border-radius: 3px; }
        .chart-svg { width: 100%; height: 195px; display: block; overflow: visible; }

        /* Tables */
        .table-wrap {
            overflow-x: auto;
            border: 1px solid var(--line-subtle);
            border-radius: var(--radius-lg);
            background: rgba(6, 9, 17, 0.55);
        }
        table {
            width: 100%;
            border-collapse: collapse;
            text-align: left;
        }
        th, td {
            padding: 0.78rem 0.85rem;
            border-bottom: 1px solid rgba(148, 163, 184, 0.1);
            font-size: 0.78rem;
            white-space: nowrap;
        }
        th {
            font-size: 0.64rem;
            font-weight: 760;
            letter-spacing: 0.06em;
            text-transform: uppercase;
            color: var(--ink-4);
            background: rgba(11, 16, 27, 0.92);
        }
        td { color: var(--ink-2); font-variant-numeric: tabular-nums; }
        tbody tr:last-child td { border-bottom: 0; }
        tbody tr:hover { background: rgba(56, 189, 248, 0.05); }
        .td-site { color: var(--ink-1); font-weight: 700; }
        .td-num { text-align: right; }
        .th-num { text-align: right; }

        /* Grids */
        .split-2 {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 1rem;
            margin-top: 1.1rem;
        }
        .cards-3 {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 0.9rem;
        }
        .cards-auto {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(290px, 1fr));
            gap: 0.9rem;
        }

        /* Subcards (compatible with existing JS renderers) */
        .quality-card, .analytics-card, .source-panel, .country-panel, .seo-site {
            border: 1px solid var(--line-subtle);
            border-radius: var(--radius-lg);
            padding: 1rem 1.05rem;
            background: linear-gradient(155deg, rgba(16, 23, 39, 0.88), rgba(8, 12, 22, 0.94));
            min-width: 0;
            transition: border-color 0.16s ease, transform 0.16s ease;
        }
        .quality-card:hover, .analytics-card:hover, .country-panel:hover {
            border-color: rgba(56, 189, 248, 0.34);
            transform: translateY(-2px);
        }
        .quality-card__head, .analytics-card__head, .source-panel__head, .country-panel__head, .seo-site__head {
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            gap: 0.7rem;
            margin-bottom: 0.8rem;
        }
        .quality-card__name, .analytics-card__name, .source-panel__name, .country-panel__name, .seo-site__name {
            color: var(--ink-1);
            font-size: 0.76rem;
            font-weight: 780;
            letter-spacing: 0.06em;
            text-transform: uppercase;
            overflow-wrap: anywhere;
        }
        .source-panel__summary, .country-panel__summary, .seo-site__property {
            color: var(--ink-4);
            font-size: 0.67rem;
            margin-top: 0.2rem;
        }
        .quality-lines { display: grid; gap: 0.45rem; }
        .quality-line {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 0.75rem;
            padding: 0.48rem 0.62rem;
            border-radius: var(--radius-sm);
            background: rgba(6, 9, 17, 0.55);
            border: 1px solid rgba(148, 163, 184, 0.08);
            font-size: 0.71rem;
            color: var(--ink-3);
        }
        .quality-line strong { color: var(--ink-1); font-weight: 700; font-variant-numeric: tabular-nums; text-align: right; }

        .analytics-card__status {
            display: inline-flex;
            align-items: center;
            gap: 0.32rem;
            padding: 0.25rem 0.52rem;
            border-radius: 999px;
            font-size: 0.6rem;
            font-weight: 800;
            white-space: nowrap;
        }
        .analytics-card__status-dot { width: 0.4rem; height: 0.4rem; border-radius: 50%; background: currentColor; }
        .analytics-card__metrics { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.5rem; }
        .analytics-metric {
            padding: 0.58rem 0.68rem;
            border-radius: var(--radius-sm);
            background: rgba(6, 9, 17, 0.58);
            border: 1px solid rgba(148, 163, 184, 0.09);
            min-width: 0;
        }
        .analytics-metric--period { border-color: rgba(56, 189, 248, 0.2); background: rgba(14, 116, 144, 0.08); }
        .analytics-metric__label { display: block; color: var(--ink-4); font-size: 0.6rem; font-weight: 720; text-transform: uppercase; letter-spacing: 0.04em; }
        .analytics-metric--period .analytics-metric__label { color: #7dd3fc; }
        .analytics-metric__value { display: block; margin-top: 0.2rem; color: var(--ink-1); font-size: 0.94rem; font-weight: 750; font-variant-numeric: tabular-nums; }
        .analytics-metric__hint { display: block; margin-top: 0.14rem; color: var(--ink-4); font-size: 0.6rem; }
        .analytics-card__footer { display: flex; justify-content: space-between; gap: 0.5rem; margin-top: 0.78rem; font-size: 0.68rem; color: var(--ink-4); flex-wrap: wrap; }
        .analytics-card__footer a { color: #7dd3fc; text-decoration: none; }
        .analytics-card__footer a:hover { text-decoration: underline; }
        .analytics-card__commit { display: flex; gap: 0.45rem; align-items: baseline; margin-top: 0.45rem; font-size: 0.66rem; color: var(--ink-3); overflow: hidden; }
        .analytics-card__commit a { font-family: ui-monospace, SFMono-Regular, monospace; font-size: 0.64rem; color: #7dd3fc; background: rgba(14, 165, 233, 0.12); padding: 0.12rem 0.36rem; border-radius: 5px; text-decoration: none; flex-shrink: 0; }
        .analytics-card__commit-msg { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
        .analytics-card__check { margin-top: 0.35rem; font-size: 0.62rem; color: var(--ink-4); }

        /* Bars & Lists */
        .bar-row {
            display: grid;
            grid-template-columns: minmax(0, 1.3fr) minmax(3.5rem, 1fr) auto;
            align-items: center;
            gap: 0.65rem;
            padding: 0.48rem 0;
            border-top: 1px solid rgba(148, 163, 184, 0.08);
            font-size: 0.74rem;
        }
        .bar-row:first-child { border-top: 0; }
        .bar-track { height: 0.38rem; border-radius: 999px; background: rgba(30, 41, 59, 0.9); overflow: hidden; }
        .bar-fill { height: 100%; border-radius: inherit; background: linear-gradient(90deg, var(--cyan), var(--emerald)); min-width: 3px; }
        .bar-val { color: var(--ink-1); font-weight: 700; font-variant-numeric: tabular-nums; text-align: right; }
        .bar-sub { color: var(--ink-4); font-size: 0.64rem; margin-left: 0.35rem; }

        .country-row {
            display: grid;
            grid-template-columns: 1.4rem minmax(5.5rem, 1.2fr) minmax(3.5rem, 1fr) auto auto;
            align-items: center;
            gap: 0.5rem;
            margin-top: 0.5rem;
            font-size: 0.7rem;
        }
        .country-row__rank { color: var(--ink-4); font-weight: 760; }
        .country-row__name { color: var(--ink-2); font-weight: 650; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
        .country-row__track { height: 0.36rem; border-radius: 999px; background: rgba(30, 41, 59, 0.9); overflow: hidden; }
        .country-row__bar { height: 100%; min-width: 3px; border-radius: inherit; background: linear-gradient(90deg, var(--cyan), var(--violet)); }
        .country-row__stats { text-align: right; font-variant-numeric: tabular-nums; }
        .country-row__value { display: block; color: var(--ink-1); }
        .country-row__share { display: block; color: var(--ink-4); font-size: 0.6rem; }
        .country-row__traffic { color: var(--ink-4); font-size: 0.62rem; text-align: right; white-space: nowrap; }

        .source-row {
            display: flex;
            justify-content: space-between;
            gap: 0.7rem;
            padding: 0.52rem 0;
            border-top: 1px solid rgba(148, 163, 184, 0.08);
        }
        .source-row__host { color: var(--ink-1); font-size: 0.74rem; font-weight: 650; }
