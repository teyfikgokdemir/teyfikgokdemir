                            <td style="text-align: right;"><a href="https://github.com/teyfikgokdemir/teyfikgokdemir/actions" target="_blank" style="font-size: 0.75rem; background: rgba(15,23,42,0.8); color: #f3f4f6; padding: 0.5rem 1rem; border-radius: 0.5rem; text-decoration: none; border: 1px solid #334155;">Loglar <i class="fa-solid fa-external-link" style="margin-left: 0.25rem;"></i></a></td>
                        </tr>
                        <tr data-site="ctseg">
                            <td style="font-weight: 500;"><i class="fa-solid fa-chart-line" style="color: #fbbf24; margin-right: 0.5rem;"></i> ctseg</td>
                            <td style="color: #cbd5e1;">Deploy, Security</td>
                            <td style="color: #94a3b8; font-size: 0.75rem;">Push &amp; Pazartesi</td>
                            <td><span style="padding: 0.25rem 0.75rem; border-radius: 9999px; background: rgba(52, 211, 153, 0.2); color: #34d399; font-size: 0.75rem; border: 1px solid rgba(52, 211, 153, 0.4);">Snapshot</span></td>
                            <td style="text-align: right;"><a href="https://github.com/teyfikgokdemir/ctseg/actions" target="_blank" style="font-size: 0.75rem; background: rgba(15,23,42,0.8); color: #f3f4f6; padding: 0.5rem 1rem; border-radius: 0.5rem; text-decoration: none; border: 1px solid #334155;">Loglar <i class="fa-solid fa-external-link" style="margin-left: 0.25rem;"></i></a></td>
                        </tr>
                        <tr data-site="mythborn">
                            <td style="font-weight: 500;"><i class="fa-solid fa-gamepad" style="color: #c084fc; margin-right: 0.5rem;"></i> mythborn</td>
                            <td style="color: #cbd5e1;">Deploy, Security, Quality</td>
                            <td style="color: #94a3b8; font-size: 0.75rem;">Push &amp; Çarşamba</td>
                            <td><span style="padding: 0.25rem 0.75rem; border-radius: 9999px; background: rgba(52, 211, 153, 0.2); color: #34d399; font-size: 0.75rem; border: 1px solid rgba(52, 211, 153, 0.4);">Snapshot</span></td>
                            <td style="text-align: right;"><a href="https://github.com/teyfikgokdemir/mythborn/actions" target="_blank" style="font-size: 0.75rem; background: rgba(15,23,42,0.8); color: #f3f4f6; padding: 0.5rem 1rem; border-radius: 0.5rem; text-decoration: none; border: 1px solid #334155;">Loglar <i class="fa-solid fa-external-link" style="margin-left: 0.25rem;"></i></a></td>
                        </tr>
                        <tr data-site="qct-studio">
                            <td style="font-weight: 500;"><i class="fa-solid fa-palette" style="color: #60a5fa; margin-right: 0.5rem;"></i> qct-studio</td>
                            <td style="color: #cbd5e1;">Deploy, Security</td>
                            <td style="color: #94a3b8; font-size: 0.75rem;">Push &amp; Haftalık</td>
                            <td><span style="padding: 0.25rem 0.75rem; border-radius: 9999px; background: rgba(52, 211, 153, 0.2); color: #34d399; font-size: 0.75rem; border: 1px solid rgba(52, 211, 153, 0.4);">Snapshot</span></td>
                            <td style="text-align: right;"><a href="https://github.com/teyfikgokdemir/qct-studio/actions" target="_blank" style="font-size: 0.75rem; background: rgba(15,23,42,0.8); color: #f3f4f6; padding: 0.5rem 1rem; border-radius: 0.5rem; text-decoration: none; border: 1px solid #334155;">Loglar <i class="fa-solid fa-external-link" style="margin-left: 0.25rem;"></i></a></td>
                        </tr>
                        <tr data-site="qct-commerce-tr">
                            <td style="font-weight: 500;"><i class="fa-solid fa-store" style="color: #34d399; margin-right: 0.5rem;"></i> qct-commerce-tr</td>
                            <td style="color: #cbd5e1;">Deploy, Security</td>
                            <td style="color: #94a3b8; font-size: 0.75rem;">Push &amp; Günlük</td>
                            <td><span style="padding: 0.25rem 0.75rem; border-radius: 9999px; background: rgba(52, 211, 153, 0.2); color: #34d399; font-size: 0.75rem; border: 1px solid rgba(52, 211, 153, 0.4);">Snapshot</span></td>
                            <td style="text-align: right;"><a href="https://github.com/teyfikgokdemir/qct-commerce-tr/actions" target="_blank" style="font-size: 0.75rem; background: rgba(15,23,42,0.8); color: #f3f4f6; padding: 0.5rem 1rem; border-radius: 0.5rem; text-decoration: none; border: 1px solid #334155;">Loglar <i class="fa-solid fa-external-link" style="margin-left: 0.25rem;"></i></a></td>
                        </tr>
                        <tr data-site="iran-ahli">
                            <td style="font-weight: 500;"><i class="fa-solid fa-building" style="color: #f87171; margin-right: 0.5rem;"></i> iran-ahli</td>
                            <td style="color: #cbd5e1;">Deploy, Security, Audit</td>
                            <td style="color: #94a3b8; font-size: 0.75rem;">Push &amp; Günlük</td>
                            <td><span style="padding: 0.25rem 0.75rem; border-radius: 9999px; background: rgba(52, 211, 153, 0.2); color: #34d399; font-size: 0.75rem; border: 1px solid rgba(52, 211, 153, 0.4);">Snapshot</span></td>
                            <td style="text-align: right;"><a href="https://github.com/teyfikgokdemir/iran-ahli/actions" target="_blank" style="font-size: 0.75rem; background: rgba(15,23,42,0.8); color: #f3f4f6; padding: 0.5rem 1rem; border-radius: 0.5rem; text-decoration: none; border: 1px solid #334155;">Loglar <i class="fa-solid fa-external-link" style="margin-left: 0.25rem;"></i></a></td>
