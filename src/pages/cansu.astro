---
const title = 'Cansu Operations Center';
const description = 'Kaynak bazlı web operasyon, trafik, SEO ve deployment merkezi';
const canonical = 'https://cansu.teyfikgokdemir.com/';
---
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{title}</title>
    <meta name="description" content={description}>
    <link rel="canonical" href={canonical}>
    <meta name="robots" content="noindex, nofollow">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style is:global>
        :root { color-scheme: dark; }
        body {
            background-color: #030712;
            color: #f3f4f6;
            font-family: system-ui, -apple-system, sans-serif;
            margin: 0;
            padding: 0;
            min-height: 100vh;
            overflow-x: hidden;
        }

        /* Dashboard crystal clear background */
        .dashboard-bg {
            position: fixed;
            inset: 0;
            background: linear-gradient(rgba(3, 7, 18, 0.85), rgba(3, 7, 18, 0.94)),
                        url('/images/cansu/uF2GI.jpg') no-repeat center center/cover;
            z-index: 0;
            pointer-events: none;
        }

        .bg-overlay {
            position: fixed;
            inset: 0;
            background: rgba(3, 7, 18, 0.6);
            z-index: 2;
            pointer-events: none;
        }
        .content-layer { position: relative; z-index: 10; width: 100%; }
        .glass {
            background: rgba(15, 23, 42, 0.92);
            backdrop-filter: blur(20px);
            border: 1px solid rgba(244, 63, 94, 0.4);
            box-shadow: 0 25px 60px rgba(0, 0, 0, 0.9);
        }
        .hidden { display: none !important; }
        .analytics-card { background: linear-gradient(145deg, rgba(15,23,42,.96), rgba(2,6,23,.96)); border: 1px solid rgba(148,163,184,.16); border-radius: 1rem; padding: 1.15rem; box-shadow: 0 12px 28px rgba(0,0,0,.22); transition: transform .2s ease, border-color .2s ease, box-shadow .2s ease; min-width: 0; }
        .analytics-card:hover { transform: translateY(-3px); border-color: rgba(96,165,250,.45); box-shadow: 0 18px 36px rgba(15,23,42,.55); }
        .analytics-card__head { display: flex; justify-content: space-between; align-items: flex-start; gap: .75rem; margin-bottom: 1rem; }
        .analytics-card__name { color: #e2e8f0; font-size: .78rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; overflow-wrap: anywhere; }
        .analytics-card__status { display: inline-flex; align-items: center; gap: .35rem; border-radius: 9999px; padding: .3rem .55rem; font-size: .63rem; font-weight: 800; letter-spacing: .04em; white-space: nowrap; }
        .analytics-card__status-dot { width: .42rem; height: .42rem; border-radius: 50%; background: currentColor; }
        .analytics-card__metrics { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .55rem; }
        .analytics-metric { background: rgba(2,6,23,.58); border: 1px solid rgba(51,65,85,.72); border-radius: .7rem; padding: .65rem .7rem; min-width: 0; }
        .analytics-metric--period { background: linear-gradient(145deg, rgba(14,116,144,.12), rgba(2,6,23,.58)); border-color: rgba(56,189,248,.2); }
        .analytics-metric__label { color: #64748b; font-size: .62rem; font-weight: 700; text-transform: uppercase; letter-spacing: .04em; }
        .analytics-metric--period .analytics-metric__label { color: #7dd3fc; }
        .analytics-metric__value { display: block; color: #f8fafc; font-size: 1rem; font-weight: 750; line-height: 1.25; margin-top: .25rem; overflow-wrap: anywhere; }
        .analytics-card__footer { display: flex; justify-content: space-between; gap: .5rem; color: #64748b; font-size: .66rem; margin-top: .85rem; flex-wrap: wrap; }
        .analytics-card__footer a { color: #93c5fd; text-decoration: none; }
        .analytics-card__footer a:hover { color: #bfdbfe; text-decoration: underline; }
        .analytics-card__commit { color:#94a3b8; font-size:.66rem; margin-top:.5rem; display:flex; gap:.4rem; align-items:baseline; flex-wrap:wrap; overflow:hidden; }
        .analytics-card__commit a { color:#93c5fd; font-size:.62rem; background:rgba(15,23,42,.7); padding:.15rem .35rem; border-radius:.3rem; flex-shrink:0; text-decoration:none; font-family:monospace; }
        .analytics-card__commit a:hover { background:rgba(96,165,250,.2); }
        .analytics-card__commit-msg { overflow:hidden; text-overflow:ellipsis; white-space:nowrap; max-width:18rem; }
        .analytics-card__check { color:#475569; font-size:.6rem; margin-top:.35rem; }
        .country-section { background: radial-gradient(circle at 12% 0%, rgba(56,189,248,.09), transparent 32%), linear-gradient(145deg, rgba(15,23,42,.96), rgba(2,6,23,.98)); border: 1px solid rgba(148,163,184,.2); border-radius: 1.25rem; padding: 1.55rem 1.65rem; box-shadow: 0 24px 70px rgba(0,0,0,.28), inset 0 1px 0 rgba(255,255,255,.04); }
        .country-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 1rem; }
        .country-panel { position: relative; overflow: hidden; background: linear-gradient(160deg, rgba(15,23,42,.86), rgba(2,6,23,.9)); border: 1px solid rgba(100,116,139,.34); border-radius: 1rem; padding: 1.05rem; box-shadow: 0 12px 30px rgba(0,0,0,.2), inset 0 1px 0 rgba(255,255,255,.035); transition: transform .2s ease, border-color .2s ease, box-shadow .2s ease; }
        .country-panel::before { content: ''; position: absolute; inset: 0 0 auto; height: 2px; background: linear-gradient(90deg, #38bdf8, #818cf8, transparent); opacity: .8; }
        .country-panel:hover { transform: translateY(-3px); border-color: rgba(96,165,250,.55); box-shadow: 0 18px 40px rgba(0,0,0,.32), 0 0 0 1px rgba(96,165,250,.08); }
        .country-panel__head { display: flex; align-items: flex-start; justify-content: space-between; gap: .75rem; margin-bottom: .95rem; }
        .country-panel__name { color: #f8fafc; font-size: .78rem; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; }
        .country-panel__summary { color: #64748b; font-size: .64rem; margin-top: .25rem; }
        .country-panel__badge { color: #bae6fd; background: rgba(14,116,144,.18); border: 1px solid rgba(56,189,248,.25); border-radius: 9999px; padding: .27rem .5rem; font-size: .62rem; font-weight: 800; white-space: nowrap; }
        .country-row { display: grid; grid-template-columns: 1.35rem minmax(6.5rem,1.25fr) minmax(3.5rem,1fr) auto; align-items: center; gap: .55rem; margin-top: .62rem; }
        .country-row__rank { color: #64748b; font-size: .62rem; font-weight: 800; text-align: center; }
        .country-row__name { color: #e2e8f0; font-size: .7rem; font-weight: 700; letter-spacing: .05em; }
        .country-row__track { height: .42rem; background: linear-gradient(90deg, rgba(30,41,59,.95), rgba(15,23,42,.8)); border: 1px solid rgba(71,85,105,.35); border-radius: 9999px; overflow: hidden; }
        .country-row__bar { height: 100%; min-width: 3px; background: linear-gradient(90deg, #38bdf8, #818cf8 70%, #c084fc); border-radius: inherit; box-shadow: 0 0 12px rgba(56,189,248,.28); }
        .country-row__stats { min-width: 4.4rem; text-align: right; }
        .country-row__value { display: block; color: #f8fafc; font-size: .7rem; font-variant-numeric: tabular-nums; }
        .country-row__share { display: block; color: #64748b; font-size: .59rem; font-variant-numeric: tabular-nums; margin-top: .12rem; }
        .country-row__traffic { color: #94a3b8; font-size: .6rem; font-variant-numeric: tabular-nums; text-align: right; white-space: nowrap; }
        .country-empty { color: #64748b; font-size: .72rem; padding: .65rem 0 .25rem; }
        .insights-section { background: radial-gradient(circle at 88% 0%, rgba(129,140,248,.1), transparent 34%), linear-gradient(145deg, rgba(15,23,42,.97), rgba(2,6,23,.98)); border: 1px solid rgba(148,163,184,.2); border-radius: 1.25rem; padding: 1.55rem 1.65rem; box-shadow: 0 24px 70px rgba(0,0,0,.28), inset 0 1px 0 rgba(255,255,255,.04); }
        .source-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 1rem; }
        .source-panel { background: linear-gradient(160deg, rgba(15,23,42,.88), rgba(2,6,23,.94)); border: 1px solid rgba(129,140,248,.25); border-radius: 1rem; padding: 1.05rem; }
        .source-panel__head { display:flex; justify-content:space-between; align-items:flex-start; gap:.75rem; margin-bottom:.8rem; }
        .source-panel__name { color:#f8fafc; font-size:.78rem; font-weight:800; letter-spacing:.08em; text-transform:uppercase; }
        .source-panel__summary { color:#64748b; font-size:.64rem; margin-top:.25rem; }
        .source-row { display:grid; grid-template-columns: minmax(0,1fr) auto; gap:.7rem; padding:.65rem 0; border-top:1px solid rgba(51,65,85,.5); }
        .source-row__host { color:#e2e8f0; font-size:.72rem; font-weight:700; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
        .source-row__meta { color:#64748b; font-size:.6rem; margin-top:.18rem; }
        .source-row__value { color:#f8fafc; font-size:.72rem; font-variant-numeric:tabular-nums; text-align:right; }
        .seo-panel { background:linear-gradient(145deg, rgba(14,116,144,.12), rgba(2,6,23,.66)); border:1px solid rgba(56,189,248,.22); border-radius:1rem; padding:1.05rem; }
        .seo-panel__badge { color:#bae6fd; background:rgba(14,116,144,.18); border:1px solid rgba(56,189,248,.25); border-radius:9999px; padding:.27rem .5rem; font-size:.62rem; font-weight:800; white-space:nowrap; }
        .seo-periods { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:.65rem; margin-top:1rem; }
        .seo-period { background:rgba(2,6,23,.58); border:1px solid rgba(51,65,85,.72); border-radius:.7rem; padding:.7rem; }
        .seo-period__label { color:#7dd3fc; font-size:.62rem; font-weight:700; text-transform:uppercase; }
        .seo-period__value { display:block; color:#f8fafc; font-size:.95rem; font-weight:750; margin-top:.25rem; }
        .seo-row-note { display:block; color:#64748b; font-size:.58rem; margin-top:.22rem; }
        .seo-sites-grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(320px,1fr)); gap:1rem; margin-top:1rem; }
        .seo-site { background:linear-gradient(160deg,rgba(15,23,42,.9),rgba(2,6,23,.95)); border:1px solid rgba(129,140,248,.25); border-radius:1rem; padding:1rem; min-width:0; }
        .seo-site__head { display:flex; justify-content:space-between; align-items:flex-start; gap:.65rem; margin-bottom:.8rem; }
        .seo-site__name { color:#f8fafc; font-size:.78rem; font-weight:800; letter-spacing:.08em; text-transform:uppercase; }
        .seo-site__property { color:#64748b; font-size:.6rem; margin-top:.25rem; overflow-wrap:anywhere; }
        .seo-table { width:100%; margin-top:.75rem; border-collapse:collapse; table-layout:fixed; }
        .seo-table th,.seo-table td { padding:.48rem .35rem; border-bottom:1px solid rgba(51,65,85,.5); font-size:.62rem; }
        .seo-table th { color:#64748b; background:transparent; font-size:.58rem; }
        .seo-table td { color:#cbd5e1; }
        .seo-table th:first-child,.seo-table td:first-child { width:50%; text-align:left; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
        .seo-table th:not(:first-child),.seo-table td:not(:first-child) { text-align:right; }
        .seo-connect { display:inline-flex; align-items:center; gap:.4rem; color:#bae6fd; border:1px solid rgba(56,189,248,.3); background:rgba(14,116,144,.18); border-radius:9999px; padding:.45rem .7rem; font-size:.65rem; font-weight:800; text-decoration:none; }
        .seo-connect:hover { background:rgba(14,116,144,.32); }
        table { width: 100%; border-collapse: collapse; }
        th, td { padding: 1.25rem 1.5rem; text-align: left; border-bottom: 1px solid #1e293b; }
        th { font-size: 0.75rem; text-transform: uppercase; color: #94a3b8; background: rgba(2, 6, 23, 0.85); }
        tr:hover { background: rgba(30, 41, 59, 0.6); }

        /* Responsive — tablet */
        @media (max-width: 900px) {
            .country-grid, .source-grid, .seo-sites-grid { grid-template-columns: 1fr; }
        }
        /* Responsive — mobile */
        @media (max-width: 700px) {
            .analytics-card__metrics { grid-template-columns: repeat(2, minmax(0, 1fr)); }
            .analytics-card { padding: .9rem; }
            .country-section, .insights-section { padding: 1rem; }
            #dashboard-content { padding: 1rem 0.75rem !important; }
            #stats-grid { grid-template-columns: repeat(2, 1fr) !important; gap: .75rem !important; }
            #live-summary-grid { grid-template-columns: 1fr !important; }
            .seo-periods { grid-template-columns: 1fr; }
            th, td { padding: .75rem .5rem; }
            .analytics-card__commit-msg { max-width: 10rem; }
            #refresh-data, #header-refresh { padding: .7rem 1.1rem !important; min-height: 44px; }
            .dash-header { flex-direction: column !important; align-items: flex-start !important; }
        }
        /* Responsive — small phone */
        @media (max-width: 480px) {
            #stats-grid { grid-template-columns: 1fr !important; }
            .analytics-card__metrics { grid-template-columns: 1fr; }
            .seo-table th, .seo-table td { padding: .35rem .2rem; font-size: .56rem; }
            .country-row { grid-template-columns: 1.2rem minmax(4rem,1.2fr) minmax(3rem,1fr) auto; gap: .35rem; }
            .country-row__traffic { display: none; }
        }

        .module-nav {
            position: sticky;
            top: .75rem;
            z-index: 30;
            display: grid;
            grid-template-columns: repeat(6, minmax(0,1fr));
            gap: .45rem;
            padding: .45rem;
            margin: 0 0 1.5rem;
            border: 1px solid rgba(71,85,105,.55);
            border-radius: 1rem;
            background: rgba(2,6,23,.88);
            backdrop-filter: blur(18px);
            box-shadow: 0 18px 50px rgba(0,0,0,.28);
        }
        .module-tab {
            border: 0;
            border-radius: .72rem;
            padding: .78rem .7rem;
            background: transparent;
            color: #94a3b8;
            font: inherit;
            font-size: .72rem;
            font-weight: 780;
            letter-spacing: .01em;
            cursor: pointer;
            transition: background .18s ease, color .18s ease, box-shadow .18s ease;
            white-space: nowrap;
        }
        .module-tab:hover { color: #e2e8f0; background: rgba(30,41,59,.65); }
        .module-tab.is-active {
            color: #f8fafc;
            background: linear-gradient(135deg, rgba(14,116,144,.32), rgba(30,41,59,.86));
            box-shadow: inset 0 0 0 1px rgba(56,189,248,.22), 0 8px 22px rgba(2,6,23,.28);
        }
        [data-dashboard-panel] { display: none !important; }
        [data-dashboard-panel].is-active-panel { display: block !important; }
        #stats-grid.is-active-panel { display: grid !important; }
        .ops-section {
            background: radial-gradient(circle at 15% 0%, rgba(56,189,248,.07), transparent 30%), linear-gradient(145deg, rgba(15,23,42,.95), rgba(2,6,23,.97));
            border: 1px solid rgba(148,163,184,.18);
            border-radius: 1.15rem;
            padding: 1.35rem;
            box-shadow: 0 20px 55px rgba(0,0,0,.24), inset 0 1px 0 rgba(255,255,255,.035);
            margin-bottom: 1.5rem;
        }
        .ops-section__head { display:flex; justify-content:space-between; gap:1rem; align-items:flex-start; flex-wrap:wrap; margin-bottom:1rem; }
        .ops-section__title { margin:0; font-size:1.05rem; color:#f8fafc; }
        .ops-section__copy { color:#94a3b8; font-size:.75rem; line-height:1.55; margin:.35rem 0 0; max-width:54rem; }
        .source-chip { display:inline-flex; align-items:center; gap:.35rem; border-radius:999px; padding:.3rem .55rem; font-size:.6rem; font-weight:800; letter-spacing:.035em; border:1px solid rgba(148,163,184,.22); background:rgba(15,23,42,.72); color:#cbd5e1; }
        .quality-grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(300px,1fr)); gap:.8rem; }
        .quality-card { border:1px solid rgba(71,85,105,.55); border-radius:.85rem; padding:.9rem; background:rgba(2,6,23,.56); }
        .quality-card__head { display:flex; justify-content:space-between; gap:.7rem; align-items:flex-start; }
        .quality-card__name { font-size:.72rem; font-weight:800; color:#e2e8f0; text-transform:uppercase; letter-spacing:.055em; }
        .quality-lines { display:grid; gap:.45rem; margin-top:.7rem; }
        .quality-line { display:flex; justify-content:space-between; gap:.8rem; padding-top:.45rem; border-top:1px solid rgba(51,65,85,.48); font-size:.65rem; color:#94a3b8; }
        .quality-line strong { color:#e2e8f0; font-weight:700; text-align:right; }
        .attention-grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(260px,1fr)); gap:.8rem; }
        .attention-card { border:1px solid rgba(71,85,105,.5); border-radius:.9rem; padding:1rem; background:rgba(2,6,23,.55); }
        .attention-card strong { display:block; color:#f8fafc; font-size:.75rem; }
        .attention-card span { display:block; color:#94a3b8; font-size:.67rem; line-height:1.5; margin-top:.35rem; }
        .status-pill { display:inline-flex; align-items:center; border-radius:999px; padding:.25rem .48rem; font-size:.58rem; font-weight:850; letter-spacing:.04em; }
        @media (max-width: 900px) {
            .module-nav { grid-template-columns: repeat(3, minmax(0,1fr)); position:relative; top:auto; }
        }
        @media (max-width: 560px) {
            .module-nav { display:flex; overflow-x:auto; scrollbar-width:none; padding:.4rem; }
            .module-nav::-webkit-scrollbar { display:none; }
            .module-tab { min-width:8.8rem; }
        }

    </style>
</head>
<body>
    <div class="bg-overlay"></div>

    <!-- Dashboard Crystal Clear Background -->
    <div id="dash-bg-element" class="dashboard-bg"></div>

    <!-- Main Dashboard -->
    <div id="dashboard-content" class="content-layer" style="max-width: 80rem; margin: 0 auto; padding: 2rem 1.5rem;">
        <header class="dash-header" style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2.5rem; padding-bottom: 1.5rem; border-bottom: 1px solid rgba(255,255,255,0.15); flex-wrap: wrap; gap: 1rem;">
            <div>
                <h1 style="font-size: 1.875rem; font-weight: 700; display: flex; align-items: center; gap: 0.75rem; margin: 0;">
                    <span style="display: inline-block; width: 3rem; height: 3rem; border-radius: 9999px; overflow: hidden; border: 2px solid #f43f5e; vertical-align: middle; box-shadow: 0 5px 15px rgba(244,63,94,0.4);">
                        <img src="/images/cansu/uF2GI.jpg" alt="Cansu Operations Center" style="width: 100%; height: 100%; object-fit: cover; object-position: 50% 20%;">
                    </span>
                    Cansu Operations Center
                </h1>
                <p style="color: #cbd5e1; font-size: 0.875rem; margin-top: 0.35rem;">6 site · kaynak bazlı operasyon, trafik, SEO ve deployment merkezi</p>
            </div>
            <div style="display: flex; align-items: center; gap: 0.75rem; flex-wrap: wrap;">
                <span id="live-status" style="display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.5rem 1rem; border-radius: 9999px; background: rgba(251, 191, 36, 0.2); color: #fbbf24; font-size: 0.75rem; font-weight: 500; border: 1px solid rgba(251, 191, 36, 0.4);">
                    <span style="width: 0.5rem; height: 0.5rem; border-radius: 9999px; background: currentColor;"></span> Canlı veriler yükleniyor...
                </span>
                <button id="header-refresh" type="button" style="background: rgba(15,23,42,0.8); border: 1px solid #334155; color: #cbd5e1; padding: 0.625rem 1.25rem; border-radius: 0.75rem; font-size: 0.75rem; cursor: pointer;" title="Verileri yenile">
                    <i class="fa-solid fa-arrows-rotate" style="margin-right: 0.35rem;"></i> Yenile
                </button>
            </div>
        </header>

        <nav class="module-nav" aria-label="Cansu modülleri">
            <button class="module-tab is-active" type="button" data-tab="overview">Genel Bakış</button>
            <button class="module-tab" type="button" data-tab="traffic">Trafik &amp; Kaynaklar</button>
            <button class="module-tab" type="button" data-tab="seo">SEO</button>
            <button class="module-tab" type="button" data-tab="health">Sistem Sağlığı</button>
            <button class="module-tab" type="button" data-tab="deployments">Deployments</button>
            <button class="module-tab" type="button" data-tab="data-quality">Veri Kalitesi</button>
        </nav>

        <!-- Real Data Preview -->
        <div id="stats-grid" data-dashboard-panel="overview" class="is-active-panel" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:1rem;margin-bottom:1.35rem;">
            <div class="glass" style="border-radius:1rem;padding:1.35rem;">
                <p style="color:#94a3b8;font-size:.72rem;font-weight:700;text-transform:uppercase;margin:0;">Oturumlar · 24s</p>
                <h3 id="overview-umami-visits-1d" style="font-size:1.95rem;font-weight:750;margin:.45rem 0 0;">—</h3>
                <p style="color:#64748b;font-size:.7rem;margin:.45rem 0 0;">Umami · tarayıcı ölçümü</p>
            </div>
            <div class="glass" style="border-radius:1rem;padding:1.35rem;">
                <p style="color:#94a3b8;font-size:.72rem;font-weight:700;text-transform:uppercase;margin:0;">Ziyaretçiler · 24s</p>
                <h3 id="overview-umami-visitors-1d" style="font-size:1.95rem;font-weight:750;margin:.45rem 0 0;">—</h3>
                <p style="color:#64748b;font-size:.7rem;margin:.45rem 0 0;">Umami · anonim ziyaretçi</p>
            </div>
            <div class="glass" style="border-radius:1rem;padding:1.35rem;">
                <p style="color:#94a3b8;font-size:.72rem;font-weight:700;text-transform:uppercase;margin:0;">Sayfa Görüntüleme · 24s</p>
                <h3 id="overview-umami-pageviews-1d" style="font-size:1.95rem;font-weight:750;margin:.45rem 0 0;">—</h3>
                <p style="color:#64748b;font-size:.7rem;margin:.45rem 0 0;">Umami · gerçek sayfa olayı</p>
            </div>
            <div class="glass" style="border-radius:1rem;padding:1.35rem;">
                <p style="color:#94a3b8;font-size:.72rem;font-weight:700;text-transform:uppercase;margin:0;">Dönüşüm · 30 Gün</p>
                <h3 id="conversion-overview" style="font-size:1.95rem;font-weight:750;margin:.45rem 0 0;">—</h3>
