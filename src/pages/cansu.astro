    <script>
        const liveStatus = document.getElementById('live-status');
        const summaryGrid = document.getElementById('live-summary-grid');
        const countryGrid = document.getElementById('country-grid');
        const sourceGrid = document.getElementById('source-grid');
        const firstPartySourceGrid = document.getElementById('first-party-source-grid');
        const seoContent = document.getElementById('seo-content');
        const refreshButton = document.getElementById('refresh-data');
        const headerRefresh = document.getElementById('header-refresh');
        const attentionGrid = document.getElementById('attention-grid');
        const dataQualityGrid = document.getElementById('data-quality-grid');
        const conversionTypes = document.getElementById('conversion-types');
        const umamiSourceChip = document.getElementById('umami-source-chip');
        const overviewUmamiSourceChip = document.getElementById('overview-umami-source-chip');
        const umamiOverviewGrid = document.getElementById('umami-overview-grid');
        const cloudflareOverviewGrid = document.getElementById('cloudflare-overview-grid');
        const overviewUmamiVisits1d = document.getElementById('overview-umami-visits-1d');
        const overviewUmamiVisitors1d = document.getElementById('overview-umami-visitors-1d');
        const overviewUmamiPageviews1d = document.getElementById('overview-umami-pageviews-1d');
        const umamiSiteGrid = document.getElementById('umami-site-grid');
        const umamiVisits1d = document.getElementById('umami-visits-1d');
        const umamiVisitors1d = document.getElementById('umami-visitors-1d');
        const umamiPageviews1d = document.getElementById('umami-pageviews-1d');
        const umamiVisits30d = document.getElementById('umami-visits-30d');
        const conversionOverview = document.getElementById('conversion-overview');
        const conversionOverviewDetail = document.getElementById('conversion-overview-detail');
        const issueSummary = document.getElementById('ops-issue-summary');
        const conv1d = document.getElementById('conv-1d');
        const conv7d = document.getElementById('conv-7d');
        const conv30d = document.getElementById('conv-30d');

        // Lossless Telemetry Elements
        const losslessHumanTotal = document.getElementById('lossless-human-total');
        const losslessHumanSub = document.getElementById('lossless-human-sub');
        const losslessBotTotal = document.getElementById('lossless-bot-total');
        const losslessBotSub = document.getElementById('lossless-bot-sub');
        const losslessConsentRate = document.getElementById('lossless-consent-rate');
        const losslessConsentSub = document.getElementById('lossless-consent-sub');
        const losslessSyncChip = document.getElementById('lossless-sync-chip');
        const losslessChart = document.getElementById('lossless-chart');
        const losslessSiteRows = document.getElementById('lossless-site-rows');
        const losslessCountries = document.getElementById('lossless-countries');
        const losslessPaths = document.getElementById('lossless-paths');
        const losslessPeriodBtns = Array.from(document.querySelectorAll('[data-lossless-period]'));
        const losslessSiteFilter = document.getElementById('lossless-site-filter');

        // Pipeline Strip Elements
        const setPipe = (prefix, value, badgeText, tone) => {
            const valEl = document.getElementById(`pipe-${prefix}-val`);
            const badgeEl = document.getElementById(`pipe-${prefix}-badge`);
            if (valEl) valEl.textContent = value;
            if (badgeEl) {
                badgeEl.textContent = badgeText;
                badgeEl.className = `badge badge--${tone}`;
            }
        };

        const moduleTabs = Array.from(document.querySelectorAll('[data-tab]'));
        const dashboardPanels = Array.from(document.querySelectorAll('[data-dashboard-panel]'));
        const portfolioSection = document.getElementById('portfolio-section');
        const portfolioSource = document.getElementById('portfolio-source');
        const claritySourcePanel = document.getElementById('clarity-source-panel');

        const formatTime = (value) => value ? new Date(value).toLocaleString('tr-TR', { dateStyle: 'short', timeStyle: 'medium' }) : '—';
        const formatNumber = (value) => typeof value === 'number' && Number.isFinite(value) ? new Intl.NumberFormat('tr-TR').format(value) : '—';
        const formatBytes = (value) => typeof value === 'number' ? `${(value / 1024 / 1024).toFixed(1)} MB` : '—';
        const numericValue = (value) => { const n = Number(value); return Number.isFinite(n) ? n : 0; };
        const escapeHtml = (value) => String(value ?? '').replace(/[&<>"']/g, (c) => ({ '&':'&amp;', '<':'&lt;', '>':'&gt;', '"':'&quot;', "'":'&#039;' }[c]));
        const countryNames = new Intl.DisplayNames(['tr-TR'], { type: 'region' });
        const getCountryName = (value) => {
            const code = String(value || '').trim().toUpperCase();
            if (!code || code === 'XX') return 'Bilinmeyen';
            const map = { US: 'ABD', GB: 'Birleşik Krallık', AE: 'BAE', KR: 'Güney Kore', RU: 'Rusya', CN: 'Çin', TR: 'Türkiye', DE: 'Almanya', NL: 'Hollanda', AZ: 'Azerbaycan' };
            if (map[code]) return map[code];
            try { return countryNames.of(code) || code; } catch { return code; }
        };

        const statusBadge = (label, tone = 'neutral') => `<span class="badge badge--${tone}">${label}</span>`;

        const setLiveState = (text, color = '#34d399') => {
            if (!liveStatus) return;
            liveStatus.style.color = color;
            liveStatus.style.borderColor = `${color}55`;
            liveStatus.style.background = `${color}18`;
            liveStatus.innerHTML = `<span class="pill-dot"></span> ${escapeHtml(text)}`;
        };

        // Tab Navigation (supports both new 6-tab names and legacy hash aliases)
        const tabAliases = { umami: 'services', ga4: 'services', clarity: 'services', deployments: 'health', 'data-quality': 'health' };
        const activateTab = (tab, pushHash = true) => {
            const mapped = tabAliases[tab] || tab;
            const allowed = new Set(['overview', 'services', 'cloudflare', 'seo', 'traffic', 'health']);
            const target = allowed.has(mapped) ? mapped : 'overview';
            moduleTabs.forEach((btn) => btn.classList.toggle('is-active', btn.dataset.tab === target));
            dashboardPanels.forEach((panel) => {
                panel.classList.toggle('is-active-panel', panel.dataset.dashboardPanel === target);
            });
            if (portfolioSection) portfolioSection.hidden = target !== 'services';
            if (claritySourcePanel) claritySourcePanel.hidden = !(target === 'services' && portfolioSource?.value === 'clarity');
            if (['umami', 'ga4', 'clarity'].includes(tab) && portfolioSource && portfolioSource.value !== tab) {
                portfolioSource.value = tab;
                portfolioSource.dispatchEvent(new Event('change'));
            }
            if (pushHash && window.location.hash !== `#${target}`) history.replaceState(null, '', `#${target}`);
        };
        moduleTabs.forEach((btn) => btn.addEventListener('click', () => activateTab(btn.dataset.tab || 'overview')));
        activateTab(window.location.hash.replace('#', '') || 'overview', false);
        window.addEventListener('hashchange', () => activateTab(window.location.hash.replace('#', '') || 'overview', false));

        // 1. LOSSLESS FIRST-PARTY D1 TELEMETRY (THROUGH 2027-01-01)
        let activeLosslessPeriod = '7d';

        const renderLosslessChart = (series) => {
            if (!losslessChart) return;
            if (!series || !series.length) {
                losslessChart.innerHTML = '<div class="country-empty">Seçili dönem için günlük veri henüz yok.</div>';
                return;
            }
            const width = 920;
            const height = 185;
            const padL = 38, padR = 16, padT = 14, padB = 28;
            const plotW = width - padL - padR;
            const plotH = height - padT - padB;
            const maxVal = Math.max(5, ...series.map((d) => Math.max(d.humanViews, d.botViews)));
            const xAt = (i) => series.length === 1 ? padL + plotW / 2 : padL + (i / (series.length - 1)) * plotW;
            const yAt = (v) => padT + plotH - (v / maxVal) * plotH;

            const humanPts = series.map((d, i) => `${xAt(i).toFixed(1)},${yAt(d.humanViews).toFixed(1)}`).join(' ');
            const botPts = series.map((d, i) => `${xAt(i).toFixed(1)},${yAt(d.botViews).toFixed(1)}`).join(' ');
            const areaPath = `M ${xAt(0).toFixed(1)},${(padT + plotH).toFixed(1)} ` +
                series.map((d, i) => `L ${xAt(i).toFixed(1)},${yAt(d.humanViews).toFixed(1)}`).join(' ') +
                ` L ${xAt(series.length - 1).toFixed(1)},${(padT + plotH).toFixed(1)} Z`;

            const gridLines = [0, 0.5, 1].map((ratio) => {
                const y = (padT + plotH * (1 - ratio)).toFixed(1);
                const val = Math.round(maxVal * ratio);
                return `<line x1="${padL}" y1="${y}" x2="${width - padR}" y2="${y}" stroke="rgba(148,163,184,0.12)" stroke-dasharray="3 4"/><text x="${padL - 8}" y="${Number(y) + 3}" text-anchor="end" fill="#64748b" font-size="10">${formatNumber(val)}</text>`;
            }).join('');

            const step = Math.max(1, Math.ceil(series.length / 8));
            const xLabels = series.map((d, i) => (i % step === 0 || i === series.length - 1)
                ? `<text x="${xAt(i).toFixed(1)}" y="${height - 6}" text-anchor="middle" fill="#64748b" font-size="10">${escapeHtml(d.day.slice(5))}</text>`
                : '').join('');

            const dots = series.map((d, i) =>
                `<circle cx="${xAt(i).toFixed(1)}" cy="${yAt(d.humanViews).toFixed(1)}" r="3.4" fill="#38bdf8" stroke="#060911" stroke-width="1.5"><title>${escapeHtml(d.day)} · İnsan: ${formatNumber(d.humanViews)} · Bot: ${formatNumber(d.botViews)} · Kabul: ${formatNumber(d.accept)} · Red: ${formatNumber(d.reject)}</title></circle>`
            ).join('');

            losslessChart.innerHTML = `<svg class="chart-svg" viewBox="0 0 ${width} ${height}" preserveAspectRatio="none" role="img" aria-label="Günlük kayıpsız insan ve bot trafik grafiği">
                <defs>
                    <linearGradient id="humanAreaGrad" x1="0" y1="0" x2="0" y2="1">
                        <stop offset="0%" stop-color="#38bdf8" stop-opacity="0.28"/>
                        <stop offset="100%" stop-color="#38bdf8" stop-opacity="0.01"/>
                    </linearGradient>
                </defs>
                ${gridLines}
                <path d="${areaPath}" fill="url(#humanAreaGrad)"/>
                <polyline fill="none" stroke="#64748b" stroke-width="1.6" stroke-dasharray="4 4" points="${botPts}"/>
                <polyline fill="none" stroke="#38bdf8" stroke-width="2.4" stroke-linejoin="round" stroke-linecap="round" points="${humanPts}"/>
                ${dots}
                ${xLabels}
            </svg>`;
        };

        async function loadLosslessSummary() {
            const site = losslessSiteFilter?.value || '';
            const qs = new URLSearchParams({ version: 'summary', period: activeLosslessPeriod });
            if (site) qs.set('site', site);
            try {
                const res = await fetch(`/api/sources?${qs.toString()}`, { cache: 'no-store' });
                const data = await res.json();
                if (!res.ok || !data.ok) throw new Error(data.error || `HTTP ${res.status}`);

                const t = data.totals || {};
                const c = t.consent || {};
                const totalAll = numericValue(t.totalViews);
                const humanShare = totalAll > 0 ? ((numericValue(t.humanViews) / totalAll) * 100).toFixed(1) : '0.0';

                if (losslessHumanTotal) losslessHumanTotal.textContent = formatNumber(numericValue(t.humanViews));
                if (losslessHumanSub) losslessHumanSub.textContent = `Toplamın %${humanShare}'i · Tüm dönem (→ 2027): ${formatNumber(numericValue(t.allTimeHuman))}`;
                if (losslessBotTotal) losslessBotTotal.textContent = formatNumber(numericValue(t.botViews));
                if (losslessBotSub) losslessBotSub.textContent = `Tüm dönem bot: ${formatNumber(numericValue(t.allTimeBot))}`;

                if (losslessConsentRate) losslessConsentRate.textContent = c.acceptRate !== null && c.acceptRate !== undefined ? `%${c.acceptRate}` : 'Takip aktif';
                if (losslessConsentSub) losslessConsentSub.textContent = `Kabul ${formatNumber(numericValue(c.accept))} · Red ${formatNumber(numericValue(c.reject))} · Kapat/İhmal ${formatNumber(numericValue(c.dismiss) + numericValue(c.ignored))}`;

                if (losslessSyncChip) losslessSyncChip.textContent = `D1 Kayıpsız · saklama ${data.retentionDays}g · hedef ${data.trackingUntil} · ${formatTime(data.generatedAt)}`;
                setPipe('d1', `${formatNumber(numericValue(t.humanViews))} insan · ${formatNumber(numericValue(t.botViews))} bot`, 'KAYIPSIZ', 'good');

                renderLosslessChart(data.dailySeries || []);

                const sortedSites = [...(data.sites || [])].sort((a, b) => numericValue(b.humanViews) - numericValue(a.humanViews));
                if (losslessSiteRows) {
                    losslessSiteRows.innerHTML = sortedSites.map((s) => {
                        const sc = s.consent || {};
                        const dismissTotal = numericValue(sc.dismiss) + numericValue(sc.ignored);
                        const rateCell = sc.acceptRate !== null && sc.acceptRate !== undefined
                            ? `<span class="badge ${sc.acceptRate >= 50 ? 'badge--good' : 'badge--warn'}">%${sc.acceptRate}</span>`
                            : `<span class="badge badge--neutral">—</span>`;
                        return `<tr>
                            <td class="td-site">${escapeHtml(s.name)}</td>
                            <td class="td-num" style="color:#38bdf8;font-weight:750;">${formatNumber(s.humanViews)}</td>
                            <td class="td-num" style="color:#94a3b8;">${formatNumber(s.botViews)}</td>
                            <td class="td-num">${formatNumber(s.totalViews)}</td>
                            <td class="td-num">${formatNumber(s.todayHuman)}</td>
                            <td class="td-num" style="color:#e2e8f0;font-weight:680;">${formatNumber(s.allTimeHuman)}</td>
                            <td class="td-num">${formatNumber(numericValue(sc.banner_shown))}</td>
                            <td class="td-num" style="color:#34d399;">${formatNumber(numericValue(sc.accept))}</td>
                            <td class="td-num" style="color:#fb7185;">${formatNumber(numericValue(sc.reject))}</td>
                            <td class="td-num" style="color:#fbbf24;">${formatNumber(dismissTotal)}</td>
                            <td class="td-num">${rateCell}</td>
                        </tr>`;
                    }).join('');
                }

                // Countries
                const countries = data.topCountries || [];
                if (losslessCountries) {
                    if (!countries.length) {
                        losslessCountries.innerHTML = '<div class="country-empty">Yeni anonim ülke sayacı az önce devreye alındı; ilk ziyaretlerle dolacak.</div>';
                    } else {
                        const maxC = Math.max(1, ...countries.map((x) => x.humanViews + x.botViews));
                        losslessCountries.innerHTML = countries.map((x) => {
                            const pct = Math.max(4, Math.round(((x.humanViews + x.botViews) / maxC) * 100));
                            return `<div class="bar-row"><span>${escapeHtml(getCountryName(x.country))}</span><div class="bar-track"><div class="bar-fill" style="width:${pct}%"></div></div><span class="bar-val">${formatNumber(x.humanViews)}<span class="bar-sub">+${formatNumber(x.botViews)} bot</span></span></div>`;
                        }).join('');
                    }
                }

                // Paths
                const paths = data.topPaths || [];
                if (losslessPaths) {
                    if (!paths.length) {
                        losslessPaths.innerHTML = '<div class="country-empty">Yol verisi henüz yok.</div>';
                    } else {
                        const maxP = Math.max(1, ...paths.map((x) => x.humanViews));
                        losslessPaths.innerHTML = paths.map((x) => {
                            const pct = Math.max(4, Math.round((x.humanViews / maxP) * 100));
                            return `<div class="bar-row"><span style="font-family:ui-monospace,monospace;">${escapeHtml(x.path)}</span><div class="bar-track"><div class="bar-fill" style="width:${pct}%"></div></div><span class="bar-val">${formatNumber(x.humanViews)}<span class="bar-sub">+${formatNumber(x.botViews)} bot</span></span></div>`;
                        }).join('');
                    }
                }
            } catch (err) {
                if (losslessSyncChip) losslessSyncChip.textContent = `D1 hata: ${err?.message || 'erişilemedi'}`;
                setPipe('d1', 'D1 erişim hatası', 'HATA', 'bad');
            }
        }

        losslessPeriodBtns.forEach((btn) => btn.addEventListener('click', () => {
            activeLosslessPeriod = btn.dataset.losslessPeriod || '7d';
            losslessPeriodBtns.forEach((b) => b.classList.toggle('is-active', b === btn));
            loadLosslessSummary();
        }));
        losslessSiteFilter?.addEventListener('change', loadLosslessSummary);

        // 2. CLOUDFLARE OVERVIEW, HEALTH & DEPLOYMENTS
        const sortOverviewSites = (items) => [...(items || [])].sort((a, b) => {
            const aOk = a.health?.ok && a.health?.ssl?.valid !== false;
            const bOk = b.health?.ok && b.health?.ssl?.valid !== false;
            if (aOk !== bOk) return aOk ? -1 : 1;
            return numericValue(b.cloudflare?.last24h?.requests) - numericValue(a.cloudflare?.last24h?.requests);
        });
        const sortSources = (items) => [...(items || [])].sort((a, b) => numericValue(b.visits ?? b.requests) - numericValue(a.visits ?? a.requests));
        const sortCountries = (items) => [...(items || [])].sort((a, b) => numericValue(b.requests) - numericValue(a.requests));
        const signalMeta = (signal) => ({
            high: { label: 'YÜKSEK SİNYAL', color: '#fb7185' },
            medium: { label: 'ORTA SİNYAL', color: '#fbbf24' },
            low: { label: 'DÜŞÜK SİNYAL', color: '#34d399' },
        }[signal?.level] || { label: 'VERİ YOK', color: '#94a3b8' });

        const healthCard = (site) => {
            const h = site.health || {};
            const g = site.github || {};
            const traffic = site.cloudflare?.last24h;
            const productionFailed = g.ok && g.workflow?.production?.conclusion === 'failure';
            const ciFailed = g.ok && g.workflow?.ci?.conclusion === 'failure';
            const prCheckFailed = g.ok && g.workflow?.prCheck?.conclusion === 'failure';
            const healthFailed = !h.ok || h.ssl?.valid === false;
            const status = healthFailed ? 'ERİŞİM SORUNU' : productionFailed ? 'DEPLOY HATASI' : ciFailed ? 'CI HATASI' : prCheckFailed ? 'PR HATASI' : !g.ok ? 'GITHUB YOK' : 'SAĞLIKLI';
            const tone = healthFailed || productionFailed ? '#fb7185' : (ciFailed || prCheckFailed || !g.ok) ? '#fbbf24' : '#34d399';
            const signal = site.cloudflare?.automationSignal;
            const sig = signalMeta(signal);
            const commitHtml = g.latestCommit ? `<div class="analytics-card__commit"><a href="${escapeHtml(g.latestCommit.url)}" target="_blank" rel="noreferrer">${escapeHtml(g.latestCommit.sha)}</a><span class="analytics-card__commit-msg" title="${escapeHtml(g.latestCommit.message)}">${escapeHtml(g.latestCommit.message)}</span></div>` : '';
            return `<article class="analytics-card" style="border-top:2px solid ${tone}">
                <div class="analytics-card__head">
                    <div class="analytics-card__name">${escapeHtml(site.name)}</div>
                    <span class="analytics-card__status" style="color:${tone};background:${tone}1c;border:1px solid ${tone}44"><span class="analytics-card__status-dot"></span>${status}</span>
                </div>
                <div class="analytics-card__metrics">
                    <div class="analytics-metric"><span class="analytics-metric__label">HTTP istek · 24s</span><strong class="analytics-metric__value">${traffic ? formatNumber(traffic.requests) : '—'}</strong></div>
                    <div class="analytics-metric"><span class="analytics-metric__label">CF unique · 24s</span><strong class="analytics-metric__value">${traffic ? formatNumber(traffic.uniqueVisitors) : '—'}</strong></div>
                    <div class="analytics-metric analytics-metric--period"><span class="analytics-metric__label">CF unique · 7g</span><strong class="analytics-metric__value">${traffic ? formatNumber(traffic.uniqueVisitors7d) : '—'}</strong></div>
                    <div class="analytics-metric analytics-metric--period"><span class="analytics-metric__label">CF unique · 30g</span><strong class="analytics-metric__value">${traffic ? formatNumber(traffic.uniqueVisitors30d) : '—'}</strong></div>
                    <div class="analytics-metric"><span class="analytics-metric__label">Yanıt süresi</span><strong class="analytics-metric__value">${typeof h.ms === 'number' ? h.ms + ' ms' : '—'}</strong></div>
                    <div class="analytics-metric"><span class="analytics-metric__label">SSL / TLS</span><strong class="analytics-metric__value" style="color:${h.ssl?.valid ? '#34d399' : '#fb7185'}">${h.ssl?.valid ? 'Geçerli' : 'Sorun'}</strong></div>
                    <div class="analytics-metric"><span class="analytics-metric__label">Veri · 24s</span><strong class="analytics-metric__value">${traffic ? formatBytes(traffic.bytes) : '—'}</strong></div>
                    <div class="analytics-metric"><span class="analytics-metric__label">Bot sinyali</span><strong class="analytics-metric__value" style="color:${sig.color};font-size:.74rem;">${sig.label}</strong></div>
                </div>
                <div class="analytics-card__footer"><span>HTTP ${h.status || '—'} · ${formatTime(h.checkedAt)}</span><a href="${escapeHtml(site.actions)}" target="_blank" rel="noreferrer">Actions ↗</a></div>
                ${commitHtml}
            </article>`;
        };

        const renderAttention = (sites) => {
            const issues = [];
            for (const site of sites || []) {
                if (!site.health?.ok) issues.push({ site: site.name, title: 'Site erişilemiyor', detail: `HTTP ${site.health?.status || 'yanıt yok'}`, tone: 'bad' });
                else if (site.health?.ssl?.valid === false) issues.push({ site: site.name, title: 'SSL/TLS hatası', detail: site.health?.ssl?.error || 'Sertifika doğrulanamadı', tone: 'bad' });
                if (site.github?.ok && site.github?.workflow?.production?.conclusion === 'failure') issues.push({ site: site.name, title: 'Production deploy başarısız', detail: formatTime(site.github?.workflow?.production?.updated_at), tone: 'bad' });
                else if (site.github?.ok && site.github?.workflow?.ci?.conclusion === 'failure') issues.push({ site: site.name, title: 'CI başarısız', detail: formatTime(site.github?.workflow?.ci?.updated_at), tone: 'warn' });
            }
            if (!issues.length) {
                attentionGrid.innerHTML = `<div class="attention-card" style="border-color:rgba(16,185,129,.35)"><strong style="color:#34d399">0 Kritik Sistem Sorunu</strong><span>6 sitenin tamamı HTTP 200, geçerli SSL ve sağlıklı deploy durumunda.</span></div>`;
                return;
            }
            attentionGrid.innerHTML = issues.map((i) => `<div class="attention-card" style="border-color:${i.tone === 'bad' ? 'rgba(244,63,94,.4)' : 'rgba(245,158,11,.4)'}"><strong style="color:${i.tone === 'bad' ? '#fb7185' : '#fbbf24'}">${escapeHtml(i.site)} · ${escapeHtml(i.title)}</strong><span>${escapeHtml(i.detail)}</span></div>`).join('');
        };

        async function loadOverview() {
            setLiveState('Canlı veriler yenileniyor...', '#fbbf24');
            try {
                const res = await fetch('/api/overview', { cache: 'no-store', signal: AbortSignal.timeout(15000) });
                if (!res.ok) throw new Error(`HTTP ${res.status}`);
                const data = await res.json();
                const sites = sortOverviewSites(data.sites || []);
                const cfActive = sites.filter((s) => s.cloudflare?.available).length;
                const totalReqs = sites.reduce((sum, s) => sum + numericValue(s.cloudflare?.last24h?.requests), 0);
                setPipe('cf', `${cfActive}/${sites.length} site · ${formatNumber(totalReqs)} istek/24s`, cfActive === sites.length ? 'CANLI' : 'KISMİ', cfActive === sites.length ? 'good' : 'warn');

                const siteIssues = sites.filter((s) => !s.health?.ok || s.health?.ssl?.valid === false || s.github?.workflow?.production?.conclusion === 'failure').length;
                if (issueSummary) {
                    issueSummary.textContent = siteIssues ? `${siteIssues} Uyarı` : '0 Kritik';
                    issueSummary.style.color = siteIssues ? '#fbbf24' : '#34d399';
                }
                const wfDetail = document.getElementById('workflow-detail');
                if (wfDetail) wfDetail.textContent = siteIssues ? 'HTTP / SSL veya deploy kontrolü gerekli' : `${sites.length}/${sites.length} site online · SSL geçerli`;

                const topCloudflare = [...data.sites].filter((site) => site.cloudflare?.available).sort((a, b) => numericValue(b.cloudflare?.last24h?.requests) - numericValue(a.cloudflare?.last24h?.requests)).slice(0, 3);
                if (cloudflareOverviewGrid) {
                    cloudflareOverviewGrid.innerHTML = topCloudflare.map((site) => `<div class="quality-line"><span>${escapeHtml(site.name)}</span><strong>${formatNumber(numericValue(site.cloudflare?.last24h?.requests))} istek</strong></div>`).join('') || '<div class="country-empty">Cloudflare verisi yok</div>';
                }

                renderAttention(sites);
                if (summaryGrid) summaryGrid.innerHTML = sites.map(healthCard).join('');

                if (dataQualityGrid) {
                    dataQualityGrid.innerHTML = sites.map((s) => `<article class="quality-card">
                        <div class="quality-card__head"><div class="quality-card__name">${escapeHtml(s.name)}</div>${s.health?.ok ? statusBadge('ONLINE', 'good') : statusBadge('OFFLINE', 'bad')}</div>
                        <div class="quality-lines">
                            <div class="quality-line"><span>HTTP / SSL</span><strong>${s.health?.ok ? 'CANLI' : 'HATA'} · ${s.health?.ms ?? '—'} ms</strong></div>
                            <div class="quality-line"><span>Cloudflare GraphQL</span><strong>${s.cloudflare?.available ? 'CANLI' : 'VERİ YOK'}</strong></div>
                            <div class="quality-line"><span>GitHub Actions</span><strong>${s.github?.ok ? 'CANLI' : 'HATA'}</strong></div>
                        </div>
                    </article>`).join('');
                }

                if (sourceGrid) {
                    sourceGrid.innerHTML = sites.map((site) => {
                        const rows = sortSources(site.cloudflare?.sources).slice(0, 8).map((item) => `<div class="source-row"><div><div class="source-row__host">${escapeHtml(item.host)}</div><div class="source-row__meta">${formatNumber(item.requests)} istek · ${formatBytes(item.bytes)}</div></div><strong class="source-row__value">${formatNumber(item.visits)}</strong></div>`).join('');
                        return `<article class="source-panel"><div class="source-panel__head"><div><div class="source-panel__name">${escapeHtml(site.name)}</div><div class="source-panel__summary">Son 24 saat · Cloudflare HTTP kaynakları</div></div><span class="seo-panel__badge">TOP 8</span></div>${rows || '<div class="country-empty">Kaynak verisi yok</div>'}</article>`;
                    }).join('');
                }

                if (countryGrid) {
                    countryGrid.innerHTML = sites.map((site) => {
                        const sorted = sortCountries(site.cloudflare?.countries);
                        const maxReq = Math.max(1, ...sorted.map((x) => numericValue(x.requests)));
                        const totalReq = sorted.reduce((sum, x) => sum + numericValue(x.requests), 0);
                        const rows = sorted.slice(0, 12).map((item, idx) => {
                            const name = getCountryName(item.country);
                            const pct = Math.max(3, Math.round((numericValue(item.requests) / maxReq) * 100));
                            const share = totalReq ? ((numericValue(item.requests) / totalReq) * 100).toFixed(1) : '0.0';
                            return `<div class="country-row"><span class="country-row__rank">${String(idx + 1).padStart(2, '0')}</span><span class="country-row__name" title="${escapeHtml(name)}">${escapeHtml(name)}</span><span class="country-row__track"><span class="country-row__bar" style="width:${pct}%"></span></span><span class="country-row__stats"><strong class="country-row__value">${formatNumber(item.requests)}</strong><span class="country-row__share">%${share}</span></span><span class="country-row__traffic">${formatBytes(item.bytes)}</span></div>`;
                        }).join('');
                        return `<article class="country-panel"><div class="country-panel__head"><div><div class="country-panel__name">${escapeHtml(site.name)}</div><div class="country-panel__summary">${formatNumber(totalReq)} istek · 24s</div></div><span class="country-panel__badge">TOP 12</span></div>${rows || '<div class="country-empty">Ülke verisi yok</div>'}</article>`;
                    }).join('');
                }

                const depBody = document.getElementById('deployments-tbody');
                sites.forEach((site) => {
                    const row = depBody?.querySelector(`tr[data-site="${site.key}"]`);
                    if (!row) return;
                    const h = site.health || {};
                    const g = site.github || {};
                    const ok = h.ok && (!g.latest || g.latest.conclusion === 'success');
                    row.cells[3].innerHTML = `${statusBadge(ok ? 'Sağlıklı' : 'Kontrol Gerekli', ok ? 'good' : 'bad')}<div style="color:#64748b;font-size:.66rem;margin-top:.25rem;">HTTP ${h.status || '—'} · ${h.ms ?? '—'} ms${h.ssl?.valid ? ' · SSL ✓' : ''}</div>`;
                });

                const note = document.getElementById('data-source-note');
                if (note) note.textContent = `${cfActive}/${sites.length} Cloudflare · ${sites.filter((s) => s.github?.ok).length}/${sites.length} GitHub · ${sites.filter((s) => s.health?.ok).length}/${sites.length} HTTP/SSL canlı.`;
                const updated = document.getElementById('last-updated');
                if (updated) updated.textContent = `Son kontrol: ${formatTime(data.generatedAt)}`;
                setLiveState(`Canlı · ${formatTime(data.generatedAt)}`, '#34d399');
            } catch {
                setPipe('cf', 'API erişilemedi', 'HATA', 'bad');
                setLiveState('Bağlantı hatası', '#fb7185');
            }
        }

        // 3. SEO (GOOGLE SEARCH CONSOLE) + GOOGLE PIPELINE BADGE
        const formatPercent = (v) => `${(Number(v || 0) * 100).toFixed(1)}%`;
        const formatPosition = (v) => Number(v || 0) ? Number(v).toFixed(1) : '—';
        const seoTable = (title, rows, type) => {
            const list = [...(rows || [])].sort((a, b) => numericValue(b.clicks) - numericValue(a.clicks)).slice(0, 5);
            const body = list.map((r) => `<tr><td title="${escapeHtml(r.value)}">${escapeHtml(r.value)}</td><td>${formatNumber(r.clicks)}</td><td>${formatNumber(r.impressions)}</td><td>${formatPercent(r.ctr)}</td><td>${formatPosition(r.position)}</td></tr>`).join('');
            return `<div style="margin-top:.85rem;"><div style="color:#7dd3fc;font-size:.62rem;font-weight:780;text-transform:uppercase;letter-spacing:.05em;">${title}</div>${body ? `<table class="seo-table"><thead><tr><th>${type === 'query' ? 'Sorgu' : 'Sayfa'}</th><th>Tık.</th><th>Göst.</th><th>CTR</th><th>Konum</th></tr></thead><tbody>${body}</tbody></table>` : '<div class="country-empty">Veri yok</div>'}</div>`;
        };

        async function loadSeo() {
            const gVal = document.getElementById('pipe-google-val');
            const gAct = document.getElementById('pipe-google-action');
            try {
                const res = await fetch('/api/gsc/seo', { cache: 'no-store', signal: AbortSignal.timeout(15000) });
                const data = await res.json();
                if (!data.connected) {
                    if (gVal) gVal.textContent = 'OAuth token süresi dolmuş';
                    if (gAct) { gAct.textContent = 'BAĞLA ↗'; gAct.className = 'badge badge--warn'; }
                    seoContent.innerHTML = `<div class="attention-card" style="border-color:rgba(245,158,11,.35)"><strong style="color:#fbbf24">Google OAuth bağlantısı yenilenmeli</strong><span>${escapeHtml(data.error || 'Search Console ve GA4 için tek tıkla yeniden yetkilendirme gerekir.')}</span><div style="margin-top:.85rem;display:flex;gap:.6rem;flex-wrap:wrap;"><a class="seo-connect" href="/api/gsc/start?analytics=1"><i class="fa-brands fa-google"></i> GA4 + Search Console'u Yeniden Bağla</a></div></div>`;
                    return;
                }
                if (gVal) gVal.textContent = `${(data.sites || []).filter((s) => s.ok).length}/${(data.sites || []).length} mülk canlı`;
                if (gAct) { gAct.textContent = 'CANLI'; gAct.className = 'badge badge--good'; }
                const cards = (data.sites || []).map((site) => {
                    if (!site.ok) return `<article class="seo-site"><div class="seo-site__head"><div><div class="seo-site__name">${escapeHtml(site.name)}</div><div class="seo-site__property">${escapeHtml(site.property)}</div></div><span class="badge badge--warn">VERİ YOK</span></div><div class="country-empty">${escapeHtml(site.error || 'Veri alınamadı')}</div></article>`;
                    const s7 = site.periods?.sevenDays || {}, s30 = site.periods?.thirtyDays || {};
                    return `<article class="seo-site"><div class="seo-site__head"><div><div class="seo-site__name">${escapeHtml(site.name)}</div><div class="seo-site__property">${escapeHtml(site.property)}</div></div><span class="badge badge--good">CANLI</span></div><div class="seo-periods"><div class="seo-period"><span class="seo-period__label">7 gün · tıklama</span><strong class="seo-period__value">${formatNumber(s7.clicks)}</strong><span class="seo-row-note">${formatNumber(s7.impressions)} göst · ${formatPercent(s7.ctr)}</span></div><div class="seo-period"><span class="seo-period__label">30 gün · tıklama</span><strong class="seo-period__value">${formatNumber(s30.clicks)}</strong><span class="seo-row-note">${formatNumber(s30.impressions)} göst · ${formatPercent(s30.ctr)}</span></div></div><div style="color:#64748b;font-size:.64rem;margin-top:.55rem;">Ort. konum: 7g ${formatPosition(s7.position)} · 30g ${formatPosition(s30.position)}</div>${seoTable('SEO fırsatları · 30g', site.opportunities, 'query')}${seoTable('En iyi sorgular · 30g', site.topQueries, 'query')}${seoTable('En iyi sayfalar · 30g', site.topPages, 'page')}</article>`;
                }).join('');
                seoContent.innerHTML = `<div style="color:#64748b;font-size:.7rem;margin-bottom:.75rem;">Son GSC verisi: ${escapeHtml(data.dataThrough || '—')}</div><div class="seo-sites-grid">${cards}</div>`;
            } catch {
                if (gVal) gVal.textContent = 'Erişim hatası';
                seoContent.innerHTML = '<div class="country-empty">Search Console verisi şu anda alınamadı.</div>';
            }
        }

        // 4. UMAMI
        const UMAMI_CACHE_KEY = 'cansu-umami-last-success-v2';
        function renderUmamiData(data, options = {}) {
            window.cansuUmamiSnapshot = { data, cached: Boolean(options.cached) };
            window.dispatchEvent(new CustomEvent('cansu:umami', { detail: { data, cached: Boolean(options.cached) } }));
            const connected = (data?.sites || []).filter((s) => s.connected);
            const sum = (p, m) => connected.reduce((acc, s) => acc + numericValue(s.periods?.[p]?.[m]), 0);
            if (umamiVisits1d) umamiVisits1d.textContent = formatNumber(sum('oneDay', 'visits'));
            if (umamiVisitors1d) umamiVisitors1d.textContent = formatNumber(sum('oneDay', 'visitors'));
            if (umamiPageviews1d) umamiPageviews1d.textContent = formatNumber(sum('oneDay', 'pageviews'));
            if (umamiVisits30d) umamiVisits30d.textContent = formatNumber(sum('thirtyDays', 'visits'));
            if (overviewUmamiVisits1d) overviewUmamiVisits1d.textContent = formatNumber(sum('oneDay', 'visits'));
            if (overviewUmamiVisitors1d) overviewUmamiVisitors1d.textContent = formatNumber(sum('oneDay', 'visitors'));
            if (overviewUmamiPageviews1d) overviewUmamiPageviews1d.textContent = formatNumber(sum('oneDay', 'pageviews'));

            const label = options.cached ? `Umami · önbellek (${connected.length}/6)` : `Umami · canlı (${connected.length}/6)`;
            if (umamiSourceChip) umamiSourceChip.textContent = label;
            if (overviewUmamiSourceChip) overviewUmamiSourceChip.textContent = label;
            setPipe('umami', `${connected.length}/6 site · ${formatNumber(sum('oneDay', 'visits'))} oturum`, options.cached ? 'ÖNBELLEK' : 'CANLI', options.cached ? 'warn' : 'good');

            if (umamiSiteGrid) {
                umamiSiteGrid.innerHTML = (data?.sites || []).map((s) => {
                    if (!s.connected) return `<article class="quality-card"><div class="quality-card__head"><div class="quality-card__name">${escapeHtml(s.name)}</div>${statusBadge('VERİ YOK', 'warn')}</div><div class="quality-lines"><div class="quality-line"><span>Durum</span><strong>${escapeHtml(s.reason || 'Bağlantı yok')}</strong></div></div></article>`;
                    const d = s.periods?.oneDay || {}, m = s.periods?.thirtyDays || {};
                    return `<article class="quality-card"><div class="quality-card__head"><div class="quality-card__name">${escapeHtml(s.name)}</div>${statusBadge('CANLI', 'good')}</div><div class="quality-lines"><div class="quality-line"><span>Oturum · 24s</span><strong>${formatNumber(d.visits || 0)}</strong></div><div class="quality-line"><span>Ziyaretçi · 24s</span><strong>${formatNumber(d.visitors || 0)}</strong></div><div class="quality-line"><span>Görüntüleme · 24s</span><strong>${formatNumber(d.pageviews || 0)}</strong></div><div class="quality-line"><span>Oturum · 30g</span><strong>${formatNumber(m.visits || 0)}</strong></div></div></article>`;
                }).join('');
            }
        }

        async function loadUmami() {
            let cachedData = null;
            try {
                const raw = localStorage.getItem(UMAMI_CACHE_KEY);
                if (raw) {
                    const parsed = JSON.parse(raw);
                    if (parsed?.data?.ok && parsed?.data?.configured) {
                        cachedData = parsed.data;
                        renderUmamiData(cachedData, { cached: true });
                    }
                }
            } catch {}
            try {
                const res = await fetch('/api/umami', { cache: 'no-store', signal: AbortSignal.timeout(25000) });
                const data = await res.json().catch(() => ({}));
                if (!res.ok || !data.ok) throw new Error(data.error || `HTTP ${res.status}`);
                renderUmamiData(data);
                if (Number(data.connectedCount) > 0) {
                    try { localStorage.setItem(UMAMI_CACHE_KEY, JSON.stringify({ savedAt: Date.now(), data })); } catch {}
                }
            } catch (err) {
                const reason = err?.message || 'Render sunucusu yanıt vermiyor';
                if (!cachedData) {
                    window.dispatchEvent(new CustomEvent('cansu:umami', { detail: { data: { ok: false, reason } } }));
                    setPipe('umami', 'Render zaman aşımı (502)', 'UYKUDA', 'bad');
                    if (umamiSourceChip) umamiSourceChip.textContent = `Umami · erişilemiyor (${reason})`;
                    if (overviewUmamiSourceChip) overviewUmamiSourceChip.textContent = `Umami · erişilemiyor (${reason})`;
                    if (umamiSiteGrid) umamiSiteGrid.innerHTML = `<div class="attention-card" style="border-color:rgba(244,63,94,.35)"><strong style="color:#fb7185">Umami sunucusu (Render) yanıt vermiyor</strong><span>${escapeHtml(reason)} · Kayıpsız 1. parti D1 sayacı etkilenmez ve tüm trafiği kaydetmeye devam eder.</span></div>`;
                }
            }
        }

        // 5. CLARITY PIPE PING (fast single check for top strip)
        async function loadClarityPipe() {
            try {
                const res = await fetch('/api/clarity?numOfDays=1&site=ctseg', { signal: AbortSignal.timeout(12000) });
                const data = await res.json();
                if (res.ok && data.ok) {
                    setPipe('clarity', 'API aktif · 6 proje', 'CANLI', 'good');
                } else {
                    setPipe('clarity', data.reason || 'Kısmi', 'UYARI', 'warn');
                }
            } catch {
                setPipe('clarity', 'Yanıt alınamadı', 'HATA', 'bad');
            }
        }

        // 6. FIRST-PARTY SOURCES & CONVERSIONS
        async function loadFirstPartySources() {
            const sites = [
                ['qct-commerce-tr', 'QCT Commerce'], ['ctseg', 'CTSEG'], ['qct-studio', 'QCT Studio'],
                ['teyfikgokdemir', 'Teyfik Gökdemir'], ['mythborn', 'Mythborn'], ['qctone', 'QCT One'],
            ];
            try {
                const results = await Promise.all(sites.map(async ([key, name]) => {
                    const [v2Res, anonRes] = await Promise.all([
                        fetch('/api/sources?site=' + encodeURIComponent(key) + '&period=today&version=v2', { cache: 'no-store' }),
                        fetch('/api/sources?site=' + encodeURIComponent(key) + '&period=today&version=anonymous', { cache: 'no-store' }),
                    ]);
                    const [data, anonymous] = await Promise.all([v2Res.json(), anonRes.json()]);
                    const total = (data.sources || []).reduce((sum, item) => sum + numericValue(item.views), 0);
                    return { key, name, total, sources: data.sources || [], pageviews: numericValue(anonymous.pageviews), botPageviews: numericValue(anonymous.botPageviews) };
                }));
                if (firstPartySourceGrid) {
                    firstPartySourceGrid.innerHTML = results.map((site) => {
                        const rows = site.sources.slice(0, 6).map((item) => `<div class="source-row"><div><div class="source-row__host">${escapeHtml(item.source || 'Bilinmiyor')}</div><div class="source-row__meta">first-party oturum</div></div><strong class="source-row__value">${formatNumber(numericValue(item.views))}</strong></div>`).join('');
                        return `<article class="source-panel"><div class="source-panel__head"><div><div class="source-panel__name">${escapeHtml(site.name)}</div><div class="source-panel__summary">Bugün · ${formatNumber(site.pageviews)} anonim toplu sayfa görüntüleme · ${formatNumber(site.botPageviews)} bot · ${formatNumber(site.total)} onaylı oturum</div></div><span class="badge badge--good">D1</span></div>${rows || '<div class="country-empty">Bugün onaylı oturum kaynağı yok; anonim sayaç yukarıda kayıtlı.</div>'}</article>`;
                    }).join('');
                }
            } catch {
                if (firstPartySourceGrid) firstPartySourceGrid.innerHTML = '<div class="country-empty">First-party kaynak verisi alınamadı.</div>';
            }
        }

        const conversionLabels = {
            form_submit: 'Form gönderimi', rfq_submit: 'RFQ / teklif', whatsapp_click: 'WhatsApp tıklaması',
            telegram_click: 'Telegram tıklaması', phone_click: 'Telefon tıklaması', email_click: 'E-posta tıklaması',
            purchase: 'Satın alma', lead: 'Nitelikli lead',
        };

        async function loadConversions() {
            try {
                const res = await fetch('/api/conversions', { cache: 'no-store' });
                const data = await res.json();
                if (!res.ok || !data.ok) throw new Error('conversion API failed');
                if (conv1d) conv1d.textContent = formatNumber(numericValue(data.periods?.oneDay?.total));
                if (conv7d) conv7d.textContent = formatNumber(numericValue(data.periods?.sevenDays?.total));
                if (conv30d) conv30d.textContent = formatNumber(numericValue(data.periods?.thirtyDays?.total));
                if (conversionOverview) conversionOverview.textContent = formatNumber(numericValue(data.periods?.thirtyDays?.total));
                const totals = data.periods?.thirtyDays?.byType || {};
                const byType = Object.entries(totals).sort((a, b) => numericValue(b[1]) - numericValue(a[1]));
                if (conversionOverviewDetail) conversionOverviewDetail.textContent = `${formatNumber(numericValue(data.periods?.thirtyDays?.byQuality?.browser))} tarayıcı · ${formatNumber(numericValue(data.periods?.thirtyDays?.byQuality?.server))} sunucu olayı`;
                if (conversionTypes) {
                    conversionTypes.innerHTML = byType.length
                        ? byType.map(([type, count]) => `<div class="attention-card"><strong>${escapeHtml(conversionLabels[type] || type)}</strong><span>${formatNumber(numericValue(count))} olay · son 30 gün</span></div>`).join('')
                        : '<div class="attention-card"><strong>Henüz dönüşüm olayı kaydedilmedi</strong><span>CORS (www. + qctone.com) düzeltildi; onaylı form/CTA olayları burada toplanacak.</span></div>';
                }
            } catch {
                if (conversionOverview) conversionOverview.textContent = '—';
            }
        }

        const refreshAll = () => {
            loadLosslessSummary();
            loadOverview();
            loadSeo();
            loadUmami();
            loadClarityPipe();
            loadFirstPartySources();
            loadConversions();
        };

        refreshAll();
        refreshButton?.addEventListener('click', refreshAll);
        headerRefresh?.addEventListener('click', refreshAll);
        setInterval(refreshAll, 5 * 60 * 1000);
    </script>
</body>
</html>
