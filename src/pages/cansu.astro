    <script>
        const dashboard = document.getElementById('dashboard-content');
        const liveStatus = document.getElementById('live-status');
        const summaryGrid = document.getElementById('live-summary-grid');
        const countryGrid = document.getElementById('country-grid');
        const sourceGrid = document.getElementById('source-grid');
        const seoContent = document.getElementById('seo-content');
        const refreshButton = document.getElementById('refresh-data');
        const headerRefresh = document.getElementById('header-refresh');
        const attentionGrid = document.getElementById('attention-grid');
        const dataQualityGrid = document.getElementById('data-quality-grid');
        const conversionTypes = document.getElementById('conversion-types');
        const umamiSourceChip = document.getElementById('umami-source-chip');
        const overviewUmamiSourceChip = document.getElementById('overview-umami-source-chip');
        const umamiOverviewGrid = document.getElementById('umami-overview-grid');
        const overviewUmamiVisits1d = document.getElementById('overview-umami-visits-1d');
        const overviewUmamiVisitors1d = document.getElementById('overview-umami-visitors-1d');
        const overviewUmamiPageviews1d = document.getElementById('overview-umami-pageviews-1d');
        const umamiSiteGrid = document.getElementById('umami-site-grid');
        const umamiVisits1d = document.getElementById('umami-visits-1d');
        const umamiVisitors1d = document.getElementById('umami-visitors-1d');
        const umamiPageviews1d = document.getElementById('umami-pageviews-1d');
        const umamiVisits30d = document.getElementById('umami-visits-30d');
        const conversionOverview = document.getElementById('conversion-overview');
        const conversionOverviewDetail = document.getElementById('conversion-overview-detail');
        const issueSummary = document.getElementById('ops-issue-summary');
        const conv1d = document.getElementById('conv-1d');
        const conv7d = document.getElementById('conv-7d');
        const conv30d = document.getElementById('conv-30d');
        const moduleTabs = Array.from(document.querySelectorAll('[data-tab]'));
        const dashboardPanels = Array.from(document.querySelectorAll('[data-dashboard-panel]'));
        const formatTime = (value) => value ? new Date(value).toLocaleString('tr-TR', { dateStyle: 'short', timeStyle: 'medium' }) : '—';
        const formatNumber = (value) => typeof value === 'number' ? new Intl.NumberFormat('tr-TR').format(value) : '—';
        const formatBytes = (value) => typeof value === 'number' ? `${(value / 1024 / 1024).toFixed(1)} MB` : '—';
        const numericValue = (value) => {
            const number = Number(value);
            return Number.isFinite(number) ? number : 0;
        };
        const compareText = (left, right) => {
            const a = String(left ?? '').toLocaleLowerCase('tr-TR');
            const b = String(right ?? '').toLocaleLowerCase('tr-TR');
            return a < b ? -1 : a > b ? 1 : 0;
        };
        const sortOverviewSites = (items) => [...(items || [])].sort((a, b) => {
            const aSuspended = a.key === 'iran-ahli';
            const bSuspended = b.key === 'iran-ahli';
            if (aSuspended !== bSuspended) return aSuspended ? 1 : -1;

            const aHealthy = a.health?.ok && a.health?.ssl?.valid !== false;
            const bHealthy = b.health?.ok && b.health?.ssl?.valid !== false;
            if (aHealthy !== bHealthy) return aHealthy ? -1 : 1;

            const aVisits = numericValue(a.cloudflare?.last24h?.uniqueVisitors);
            const bVisits = numericValue(b.cloudflare?.last24h?.uniqueVisitors);
            if (bVisits !== aVisits) return bVisits - aVisits;

            const aReqs = numericValue(a.cloudflare?.last24h?.requests);
            const bReqs = numericValue(b.cloudflare?.last24h?.requests);
            if (bReqs !== aReqs) return bReqs - aReqs;

            const aMs = numericValue(a.health?.ms);
            const bMs = numericValue(b.health?.ms);
            if (aMs && bMs && aMs !== bMs) return aMs - bMs;

            return compareText(a.name, b.name);
        });

        const sortSources = (items) => [...(items || [])].sort((a, b) => {
            const aVisits = numericValue(a.visits ?? a.uniqueVisitors ?? a.requests);
            const bVisits = numericValue(b.visits ?? b.uniqueVisitors ?? b.requests);
            if (bVisits !== aVisits) return bVisits - aVisits;

            const aReqs = numericValue(a.requests);
            const bReqs = numericValue(b.requests);
            if (bReqs !== aReqs) return bReqs - aReqs;

            return compareText(a.host, b.host);
        });

        const sortCountries = (items) => [...(items || [])].sort((a, b) => {
            const aReqs = numericValue(a.requests ?? a.uniqueVisitors ?? a.visits);
            const bReqs = numericValue(b.requests ?? b.uniqueVisitors ?? b.visits);
            if (bReqs !== aReqs) return bReqs - aReqs;

            const aBytes = numericValue(a.bytes);
            const bBytes = numericValue(b.bytes);
            if (bBytes !== aBytes) return bBytes - aBytes;

            return compareText(a.country, b.country);
        });

        const sortSeoRows = (items) => [...(items || [])].sort((a, b) => {
            const aClicks = numericValue(a.clicks);
            const bClicks = numericValue(b.clicks);
            if (bClicks !== aClicks) return bClicks - aClicks;

            const aImp = numericValue(a.impressions);
            const bImp = numericValue(b.impressions);
            if (bImp !== aImp) return bImp - aImp;

            const aCtr = numericValue(a.ctr);
            const bCtr = numericValue(b.ctr);
            if (bCtr !== aCtr) return bCtr - aCtr;

            const aPos = numericValue(a.position) || 999;
            const bPos = numericValue(b.position) || 999;
            if (aPos !== bPos) return aPos - bPos;

            return compareText(a.value, b.value);
        });

        const sortGscSites = (items) => [...(items || [])].sort((a, b) => {
            const aClicks = numericValue(a.periods?.thirtyDays?.clicks ?? a.periods?.sevenDays?.clicks);
            const bClicks = numericValue(b.periods?.thirtyDays?.clicks ?? b.periods?.sevenDays?.clicks);
            if (bClicks !== aClicks) return bClicks - aClicks;

            const aImp = numericValue(a.periods?.thirtyDays?.impressions ?? a.periods?.sevenDays?.impressions);
            const bImp = numericValue(b.periods?.thirtyDays?.impressions ?? b.periods?.sevenDays?.impressions);
            if (bImp !== aImp) return bImp - aImp;

            return compareText(a.key, b.key);
        });

        const signalMeta = (signal) => ({
            high: { label: 'YÜKSEK SİNYAL', color: '#fb7185', bg: 'rgba(251,113,133,.12)' },
            medium: { label: 'ORTA SİNYAL', color: '#fbbf24', bg: 'rgba(251,191,36,.12)' },
            low: { label: 'DÜŞÜK SİNYAL', color: '#34d399', bg: 'rgba(52,211,153,.12)' },
        }[signal?.level] || { label: 'VERİ YOK', color: '#94a3b8', bg: 'rgba(148,163,184,.12)' });
        const countryNames = new Intl.DisplayNames(['tr-TR'], { type: 'region' });
        const getCountryName = (value) => {
            const code = String(value || '').trim().toUpperCase();
            if (!code) return 'Bilinmeyen ülke';
            const shortNames = { US: 'ABD', GB: 'Birleşik Krallık', AE: 'BAE', KR: 'Güney Kore', RU: 'Rusya', CN: 'Çin', TR: 'Türkiye', DE: 'Almanya', NL: 'Hollanda' };
            if (shortNames[code]) return shortNames[code];
            try { return countryNames.of(code) || code; } catch { return code; }
        };
        const escapeHtml = (value) => String(value ?? '').replace(/[&<>"']/g, (char) => ({ '&':'&amp;', '<':'&lt;', '>':'&gt;', '"':'&quot;', "'":'&#039;' }[char]));
        const card = (site) => {
            const h = site.health || {};
            const g = site.github || {};
            const traffic = site.cloudflare?.last24h;
            const productionFailed = g.ok && g.workflow?.production?.conclusion === 'failure';
            const ciFailed = g.ok && g.workflow?.ci?.conclusion === 'failure';
            const prCheckFailed = g.ok && g.workflow?.prCheck?.conclusion === 'failure';
            const githubUnknown = !g.ok;
            const healthFailed = !h.ok || h.ssl?.valid === false;
            const status = healthFailed ? 'ERİŞİM SORUNU'
                : productionFailed ? 'DEPLOY HATASI'
                : ciFailed ? 'CI HATASI'
                : prCheckFailed ? 'PR KONTROL HATASI'
                : githubUnknown ? 'GITHUB BAĞLANTISI YOK'
                : 'SAĞLIKLI';
            const workflowFailed = productionFailed || ciFailed || prCheckFailed;
            const tone = healthFailed || productionFailed ? '#f87171' : (ciFailed || prCheckFailed || githubUnknown) ? '#fbbf24' : '#34d399';
            const statusBg = healthFailed || productionFailed ? 'rgba(248,113,113,.12)' : (ciFailed || prCheckFailed || githubUnknown) ? 'rgba(251,191,36,.12)' : 'rgba(52,211,153,.12)';
            const activeWorkflow = productionFailed ? g.workflow?.production : ciFailed ? g.workflow?.ci : prCheckFailed ? g.workflow?.prCheck : g.workflow?.production || g.workflow?.ci || g.latest;
            const githubStatus = g.errorType === 'authentication' ? 'Bağlantı doğrulanamadı'
                : g.errorType === 'repository' ? 'Repository kullanılamıyor'
                : activeWorkflow?.conclusion || (g.ok ? 'run verisi yok' : 'bağlantı hatası');
            const signal = site.cloudflare?.automationSignal;
            const signalStyle = signalMeta(signal);
            const sslColor = h.ssl?.valid ? '#34d399' : '#f87171';
            const sslText = h.ssl?.valid ? '✓ Geçerli' : (h.ssl?.error || '✗ Sorun');
            const commitHtml = g.latestCommit ? `<div class="analytics-card__commit"><a href="${escapeHtml(g.latestCommit.url)}" target="_blank" rel="noreferrer" title="Commit'i aç">${escapeHtml(g.latestCommit.sha)}</a><span class="analytics-card__commit-msg" title="${escapeHtml(g.latestCommit.message)}">${escapeHtml(g.latestCommit.message)}</span><span style="color:#475569;flex-shrink:0;">${formatTime(g.latestCommit.date)}</span></div>` : '';
            return `<article class="analytics-card" style="border-top:2px solid ${tone}">
                <div class="analytics-card__head">
                    <div class="analytics-card__name"><i class="fa-solid fa-chart-simple" style="color:#93c5fd;margin-right:.45rem"></i>${site.name}</div>
                    <span class="analytics-card__status" style="color:${tone};background:${statusBg};border:1px solid ${tone}55"><span class="analytics-card__status-dot"></span>${status}</span>
                </div>
                <div class="analytics-card__metrics">
                    <div class="analytics-metric"><span class="analytics-metric__label">HTTP istekleri · 24s</span><strong class="analytics-metric__value">${traffic ? formatNumber(traffic.requests) : '—'}</strong></div>
                    <div class="analytics-metric"><span class="analytics-metric__label">Cloudflare unique sinyali · 24s</span><strong class="analytics-metric__value">${traffic ? formatNumber(traffic.uniqueVisitors) : '—'}</strong></div>
                    <div class="analytics-metric analytics-metric--period"><span class="analytics-metric__label">Unique sinyal · 7g</span><strong class="analytics-metric__value">${traffic ? formatNumber(traffic.uniqueVisitors7d) : '—'}</strong></div>
                    <div class="analytics-metric analytics-metric--period"><span class="analytics-metric__label">Unique sinyal · 30g</span><strong class="analytics-metric__value">${traffic ? formatNumber(traffic.uniqueVisitors30d) : '—'}</strong></div>
                    <div class="analytics-metric"><span class="analytics-metric__label">Aktarılan veri · 24s</span><strong class="analytics-metric__value">${traffic ? formatBytes(traffic.bytes) : '—'}</strong></div>
                    <div class="analytics-metric"><span class="analytics-metric__label">Heuristik trafik sinyali</span><strong class="analytics-metric__value" style="color:${signalStyle.color};font-size:.78rem">${signalStyle.label}</strong><span class="analytics-metric__hint">${signal ? `${signal.requestPerVisitor} istek/unique · üst ülke ${signal.topCountryShare}%` : '—'}</span></div>
                    <div class="analytics-metric"><span class="analytics-metric__label">Yanıt süresi</span><strong class="analytics-metric__value">${typeof h.ms === 'number' ? h.ms + ' ms' : '—'}</strong></div>
                    <div class="analytics-metric"><span class="analytics-metric__label">SSL / TLS</span><strong class="analytics-metric__value" style="color:${sslColor}">${sslText}</strong></div>
                </div>
                <div class="analytics-card__footer"><span><i class="fa-solid fa-code-branch" style="margin-right:.3rem"></i>GitHub: ${productionFailed ? 'deploy failure' : ciFailed ? 'CI failure' : prCheckFailed ? 'PR check failure' : githubStatus}</span><a href="${site.actions}" target="_blank" rel="noreferrer">Logları aç <i class="fa-solid fa-arrow-up-right-from-square" style="margin-left:.25rem"></i></a></div>
                ${commitHtml}
                <div class="analytics-card__check">HTTP ${h.status || '—'} · Kontrol: ${formatTime(h.checkedAt)}</div>
            </article>`;
        };
        const formatPercent = (value) => `${(Number(value || 0) * 100).toFixed(1)}%`;
        const formatPosition = (value) => Number(value || 0) ? Number(value).toFixed(1) : '—';
        const seoTable = (title, rows, type) => {
            const orderedRows = sortSeoRows(rows);
            const body = orderedRows.slice(0, 5).map((row) => `<tr><td title="${escapeHtml(row.value)}">${escapeHtml(row.value)}</td><td>${formatNumber(row.clicks)}</td><td>${formatNumber(row.impressions)}</td><td>${formatPercent(row.ctr)}</td><td>${formatPosition(row.position)}</td></tr>`).join('');
            return `<div style="margin-top:1rem;"><div style="color:#7dd3fc;font-size:.65rem;font-weight:800;letter-spacing:.06em;text-transform:uppercase;">${title}</div>${body ? `<table class="seo-table"><thead><tr><th>${type === 'query' ? 'Sorgu' : 'Landing page'}</th><th>Tık.</th><th>Göst.</th><th>CTR</th><th>Ort.</th></tr></thead><tbody>${body}</tbody></table>` : '<div class="country-empty">Bu dönem için veri yok</div>'}</div>`;
        };
        const shortPagePath = (value) => {
            try { return new URL(String(value || '')).pathname; } catch { return String(value || ''); }
        };
        const glassSeoTable = (title, rows, tone = '#7dd3fc') => {
            const body = (rows || []).slice(0, 8).map((row) => `<tr>
                <td title="${escapeHtml(row.query || row.value)}">${escapeHtml(row.query || row.value || '—')}</td>
                <td title="${escapeHtml(row.page || '')}">${escapeHtml(shortPagePath(row.page || '—'))}</td>
                <td>${formatNumber(row.impressions)}</td>
                <td>${formatPercent(row.ctr)}</td>
                <td>${formatPosition(row.position)}</td>
            </tr>`).join('');
            return `<div style="margin-top:1rem;"><div style="color:${tone};font-size:.65rem;font-weight:800;letter-spacing:.06em;text-transform:uppercase;">${title}</div>
                ${body ? `<table class="seo-table"><thead><tr><th>Sorgu</th><th>Landing</th><th>Göst.</th><th>CTR</th><th>Ort.</th></tr></thead><tbody>${body}</tbody></table>` : '<div class="country-empty">Henüz yeterli cam sorgu sinyali yok</div>'}
            </div>`;
        };
        const glassCannibalizationTable = (rows) => {
            const body = (rows || []).slice(0, 8).map((row) => {
                const pages = (row.pages || []).map((page) => shortPagePath(page.page)).join(' · ');
                return `<tr><td title="${escapeHtml(row.query)}">${escapeHtml(row.query)}</td><td title="${escapeHtml(pages)}">${escapeHtml(pages)}</td><td>${formatNumber(row.impressions)}</td><td>${formatPosition(row.position)}</td></tr>`;
            }).join('');
            return `<div style="margin-top:1rem;"><div style="color:#fbbf24;font-size:.65rem;font-weight:800;letter-spacing:.06em;text-transform:uppercase;">Cannibalization sinyali · CTSEG cam</div>
                ${body ? `<table class="seo-table"><thead><tr><th>Sorgu</th><th>Yarışan landing'ler</th><th>Göst.</th><th>Ort.</th></tr></thead><tbody>${body}</tbody></table>` : '<div class="country-empty">Belirgin cannibalization sinyali yok</div>'}
            </div>`;
        };
        const glassSeoBlock = (site) => {
            if (site.key !== 'ctseg' || !site.glassSeo) return '';
            const glass = site.glassSeo;
            return `<div style="margin-top:1.15rem;padding:1rem;border:1px solid rgba(56,189,248,.24);border-radius:.85rem;background:rgba(14,116,144,.07);">
                <div style="display:flex;justify-content:space-between;gap:.75rem;align-items:flex-start;flex-wrap:wrap;">
                    <div><strong style="color:#e0f2fe;font-size:.78rem;">CTSEG Glass · Ranking Signals</strong><div style="color:#64748b;font-size:.61rem;margin-top:.2rem;">Search Console query + landing eşleşmesi · son 30 gün · ${formatNumber(glass.rows)} satır</div></div>
                    <span class="seo-panel__badge">GLASS SEO</span>
                </div>
                ${glassSeoTable('Fırsat sorguları · pozisyon 4–30', glass.opportunities)}
                ${glassSeoTable('Düşük CTR · ilk 10', glass.lowCtr, '#fb7185')}
                ${glassCannibalizationTable(glass.cannibalization)}
            </div>`;
        };
        async function loadSeo() {
            const controller = new AbortController();
            const timer = setTimeout(() => controller.abort(), 15000);
            try {
                const response = await fetch('/api/gsc/seo', { cache: 'no-store', signal: controller.signal });
                clearTimeout(timer);
                const data = await response.json();
                if (!data.connected) {
                    seoContent.innerHTML = `<div class="seo-periods"><div class="seo-period"><span class="seo-period__label">Son 7 gün</span><strong class="seo-period__value">Yetkilendirme bekliyor</strong></div><div class="seo-period"><span class="seo-period__label">Son 30 gün</span><strong class="seo-period__value">Yetkilendirme bekliyor</strong></div></div><div style="margin-top:.85rem;"><a class="seo-connect" href="/api/gsc/start"><i class="fa-brands fa-google"></i> Search Console'u bağla</a></div>`;
                    return;
                }
                const siteCards = sortGscSites(data.sites).map((site) => {
                    if (!site.ok) return `<article class="seo-site"><div class="seo-site__head"><div><div class="seo-site__name">${escapeHtml(site.name)}</div><div class="seo-site__property">${escapeHtml(site.property)}</div></div><span class="seo-panel__badge">VERİ YOK</span></div><div class="country-empty">${escapeHtml(site.error || 'Search Console verisi alınamadı')}</div></article>`;
                    const seven = site.periods?.sevenDays || {};
                    const thirty = site.periods?.thirtyDays || {};
                    return `<article class="seo-site"><div class="seo-site__head"><div><div class="seo-site__name">${escapeHtml(site.name)}</div><div class="seo-site__property">${escapeHtml(site.property)}</div></div><span class="seo-panel__badge">CANLI RAPOR</span></div><div class="seo-periods"><div class="seo-period"><span class="seo-period__label">7 gün · tıklama</span><strong class="seo-period__value">${formatNumber(seven.clicks)}</strong><span class="seo-row-note">${formatNumber(seven.impressions)} gösterim · ${formatPercent(seven.ctr)}</span></div><div class="seo-period"><span class="seo-period__label">30 gün · tıklama</span><strong class="seo-period__value">${formatNumber(thirty.clicks)}</strong><span class="seo-row-note">${formatNumber(thirty.impressions)} gösterim · ${formatPercent(thirty.ctr)}</span></div></div><div style="color:#64748b;font-size:.62rem;margin-top:.65rem;">Ort. konum: 7g ${formatPosition(seven.position)} · 30g ${formatPosition(thirty.position)}</div>${seoTable('SEO fırsatları · 30 gün', site.opportunities, 'query')}${seoTable('En iyi sorgular · 30 gün', site.topQueries, 'query')}${seoTable("En iyi landing page'ler · 30 gün", site.topPages, 'page')}${glassSeoBlock(site)}</article>`;
                }).join('');
                seoContent.innerHTML = `<div style="color:#64748b;font-size:.65rem;margin-top:1rem;">Son Search Console verisi: ${escapeHtml(data.dataThrough || '—')} · Google verileri genellikle birkaç gün gecikmeli gelir.</div><div class="seo-sites-grid">${siteCards}</div>`;
            } catch {
                clearTimeout(timer);
                seoContent.innerHTML = '<div class="country-empty">Search Console verisi şu anda alınamadı.</div>';
            }
        }
        function setLiveState(text, color = '#34d399') {
            liveStatus.style.color = color;
            liveStatus.style.borderColor = color;
            liveStatus.style.background = `${color}22`;
            liveStatus.lastChild.textContent = ` ${text}`;
        }
        const statusBadge = (label, tone = 'neutral') => {
            const palette = {
                good: ['#34d399','rgba(52,211,153,.12)'],
                warn: ['#fbbf24','rgba(251,191,36,.12)'],
                bad: ['#f87171','rgba(248,113,113,.12)'],
                neutral: ['#94a3b8','rgba(148,163,184,.12)'],
            }[tone] || ['#94a3b8','rgba(148,163,184,.12)'];
            return `<span class="status-pill" style="color:${palette[0]};background:${palette[1]};border:1px solid ${palette[0]}44">${label}</span>`;
        };

        const renderAttention = (sites) => {
            const issues = [];
            const githubFailures = (sites || []).filter((site) => !site.github?.ok);
            const sameGithubError = githubFailures.length > 1 && new Set(githubFailures.map((site) => `${site.github?.errorType || ''}:${site.github?.error || ''}`)).size === 1;

            if (sameGithubError) {
                const sample = githubFailures[0]?.github;
                issues.push({
                    site: 'GitHub entegrasyonu',
                    title: `${githubFailures.length} site aynı bağlantı sorunundan etkileniyor`,
                    detail: `${sample?.error || 'Workflow verisi alınamıyor'} · tek entegrasyon sorunu olarak gruplanmıştır`,
                    tone: 'warn',
                });
            }

            for (const site of sites || []) {
                if (!site.health?.ok) issues.push({ site: site.name, title: 'Site erişilemiyor', detail: `HTTP ${site.health?.status || 'yanıt yok'} · ${formatTime(site.health?.checkedAt)}`, tone: 'bad' });
                else if (site.health?.ssl?.valid === false) issues.push({ site: site.name, title: 'SSL/TLS kontrolü başarısız', detail: site.health?.ssl?.error || 'Sertifika doğrulanamadı', tone: 'bad' });

                if (!site.github?.ok && !sameGithubError) issues.push({ site: site.name, title: 'GitHub bağlantısı doğrulanamadı', detail: site.github?.error || 'Workflow durumu bilinmiyor', tone: 'warn' });
                else if (site.github?.ok && site.github?.workflow?.production?.conclusion === 'failure') issues.push({ site: site.name, title: 'Production deploy başarısız', detail: formatTime(site.github?.workflow?.production?.updated_at), tone: 'bad' });
                else if (site.github?.ok && site.github?.workflow?.ci?.conclusion === 'failure') issues.push({ site: site.name, title: 'CI kontrolü başarısız', detail: formatTime(site.github?.workflow?.ci?.updated_at), tone: 'warn' });
                else if (site.github?.ok && site.github?.workflow?.prCheck?.conclusion === 'failure') issues.push({ site: site.name, title: 'PR kontrolü başarısız', detail: formatTime(site.github?.workflow?.prCheck?.updated_at), tone: 'warn' });
            }

            if (!issues.length) {
                attentionGrid.innerHTML = `<div class="attention-card" style="border-color:rgba(52,211,153,.35)"><strong style="color:#34d399">Kritik aksiyon yok</strong><span>HTTP, SSL ve doğrulanabilen GitHub kontrollerinde şu an kritik bir sorun görünmüyor.</span></div>`;
                return;
            }
            attentionGrid.innerHTML = issues.slice(0, 12).map((item) => {
                const border = item.tone === 'bad' ? 'rgba(248,113,113,.32)' : 'rgba(251,191,36,.34)';
                const color = item.tone === 'bad' ? '#f8fafc' : '#fbbf24';
                return `<div class="attention-card" style="border-color:${border}"><strong style="color:${color}">${escapeHtml(item.site)} · ${escapeHtml(item.title)}</strong><span>${escapeHtml(item.detail)}</span></div>`;
            }).join('');
        };

        const renderDataQuality = (sites, generatedAt) => {
            dataQualityGrid.innerHTML = (sites || []).map((site) => {
                const cf = site.cloudflare?.available ? statusBadge('CANLI','good') : statusBadge('VERİ YOK','warn');
                const gh = site.github?.ok ? statusBadge('CANLI','good') : statusBadge('BAĞLANTI HATASI','bad');
                const http = site.health?.ok ? statusBadge('CANLI','good') : statusBadge('HATA','bad');
                return `<article class="quality-card">
                    <div class="quality-card__head"><div class="quality-card__name">${escapeHtml(site.name)}</div>${site.health?.ok ? statusBadge('ONLINE','good') : statusBadge('OFFLINE','bad')}</div>
                    <div class="quality-lines">
                        <div class="quality-line"><span>HTTP / SSL</span><strong>${http} · ${formatTime(site.health?.checkedAt)}</strong></div>
                        <div class="quality-line"><span>Cloudflare GraphQL</span><strong>${cf}</strong></div>
                        <div class="quality-line"><span>GitHub Actions</span><strong>${gh}</strong></div>
                        <div class="quality-line"><span>Panel senkronizasyonu</span><strong>${formatTime(generatedAt)}</strong></div>
                    </div>
                </article>`;
            }).join('');
        };

        const activateTab = (tab, pushHash = true) => {
            const allowed = new Set(['overview','traffic','seo','health','deployments','data-quality']);
            const target = allowed.has(tab) ? tab : 'overview';
            moduleTabs.forEach((button) => button.classList.toggle('is-active', button.dataset.tab === target));
            dashboardPanels.forEach((panel) => panel.classList.toggle('is-active-panel', panel.dataset.dashboardPanel === target));
            if (pushHash && window.location.hash !== `#${target}`) history.replaceState(null, '', `#${target}`);
        };

        moduleTabs.forEach((button) => button.addEventListener('click', () => activateTab(button.dataset.tab || 'overview')));
        activateTab(window.location.hash.replace('#','') || 'overview', false);
        window.addEventListener('hashchange', () => activateTab(window.location.hash.replace('#','') || 'overview', false));

        async function loadOverview() {
            setLiveState('Canlı veriler yükleniyor...', '#fbbf24');
            const controller = new AbortController();
            const timer = setTimeout(() => controller.abort(), 15000);
            try {
                const response = await fetch('/api/overview', { cache: 'no-store', signal: controller.signal });
                clearTimeout(timer);
                if (!response.ok) throw new Error(`HTTP ${response.status}`);
                const data = await response.json();
                const healthy = data.sites.filter((site) => site.health.ok).length;
                const sslValid = data.sites.filter((site) => site.health.ssl?.valid).length;
                const failed = data.sites.reduce((sum, site) => sum + (site.github.failed24h || 0), 0);
                const cfActive = data.sites.filter((site) => site.cloudflare?.available).length;
                const siteIssues = data.sites.filter((site) =>
                    !site.health?.ok ||
                    site.health?.ssl?.valid === false ||
                    site.github?.workflow?.production?.conclusion === 'failure' ||
                    site.github?.workflow?.ci?.conclusion === 'failure' ||
                    site.github?.workflow?.prCheck?.conclusion === 'failure'
                ).length;
                const githubFailures = data.sites.filter((site) => !site.github?.ok);
                const githubIssueCount = githubFailures.length
                    ? (new Set(githubFailures.map((site) => `${site.github?.errorType || ''}:${site.github?.error || ''}`)).size === 1 ? 1 : githubFailures.length)
                    : 0;
                const connectionIssues = siteIssues + githubIssueCount;
                issueSummary.textContent = connectionIssues ? `${connectionIssues} Uyarı` : '0 Kritik';
                issueSummary.style.color = connectionIssues ? '#fbbf24' : '#34d399';
                document.getElementById('workflow-detail').textContent = connectionIssues
                    ? (failed ? `${failed} geçmiş başarısız run · son 24 saat · güncel durum kontrol edilmeli` : 'HTTP · SSL · güncel workflow uyarısı')
                    : (failed ? `Güncel durum sağlıklı · ${failed} eski başarısız run sonradan düzeldi` : 'HTTP · SSL · güncel workflowlar sağlıklı');
                
                const sortedSites = sortOverviewSites(data.sites);
                renderAttention(sortedSites);
                renderDataQuality(sortedSites, data.generatedAt);
                summaryGrid.innerHTML = sortedSites.map((site) => card(site)).join('');
                sourceGrid.innerHTML = sortedSites.map((site) => {
                    const sortedSources = sortSources(site.cloudflare?.sources).slice(0, 8);
                    const sourceRows = sortedSources.map((item) => `<div class="source-row"><div><div class="source-row__host" title="${item.host}">${item.host}</div><div class="source-row__meta">${formatNumber(item.requests)} istek · ${formatBytes(item.bytes)}</div></div><strong class="source-row__value">${formatNumber(item.visits)} görüntüleme</strong></div>`).join('');
                    return `<article class="source-panel"><div class="source-panel__head"><div><div class="source-panel__name">${site.name}</div><div class="source-panel__summary">Son 24 saat · Cloudflare HTTP kaynak sinyalleri</div></div><span class="seo-panel__badge">TOP 12</span></div>${sourceRows || '<div class="country-empty">Kaynak verisi bekleniyor</div>'}</article>`;
                }).join('');
                countryGrid.innerHTML = sortedSites.map((site) => {
                    const sortedCountries = sortCountries(site.cloudflare?.countries);
                    const maxRequests = Math.max(1, ...sortedCountries.map((item) => numericValue(item.requests)));
                    const totalRequests = sortedCountries.reduce((sum, item) => sum + numericValue(item.requests), 0);
                    const rows = sortedCountries.slice(0, 15).map((item, index) => { const countryName = getCountryName(item.country); return `<div class="country-row"><span class="country-row__rank">${String(index + 1).padStart(2, '0')}</span><span class="country-row__name" title="${countryName}">${countryName}</span><span class="country-row__track"><span class="country-row__bar" style="width:${Math.max(3, Math.round((numericValue(item.requests) / maxRequests) * 100))}%"></span></span><span class="country-row__stats"><strong class="country-row__value">${formatNumber(item.requests)}</strong><span class="country-row__share">${Number(item.requestShare || (totalRequests ? (numericValue(item.requests) / totalRequests) * 100 : 0)).toFixed(1)}% pay</span></span><span class="country-row__traffic">${formatBytes(item.bytes)}</span></div>`; }).join('');
                    return `<article class="country-panel"><div class="country-panel__head"><div><div class="country-panel__name">${site.name}</div><div class="country-panel__summary">${formatNumber(totalRequests)} ülke isteği · 24 saat</div></div><span class="country-panel__badge">TOP 15</span></div>${rows || '<div class="country-empty">Cloudflare ülke verisi bekleniyor</div>'}</article>`;
                }).join('');
                const tbody = document.querySelector('tbody');
                sortedSites.forEach((site) => {
                    const row = document.querySelector(`tr[data-site="${site.key}"]`);
                    if (!row) return;
                    if (tbody) tbody.appendChild(row);
                    const statusCell = row.cells[3];
                    const h = site.health;
                    const g = site.github;
                    const ok = h.ok && (!g.latest || g.latest.conclusion === 'success');
                    statusCell.innerHTML = `<span style="padding:.25rem .75rem;border-radius:9999px;background:${ok ? 'rgba(52,211,153,.2)' : 'rgba(248,113,113,.2)'};color:${ok ? '#34d399' : '#f87171'};font-size:.75rem;border:1px solid ${ok ? 'rgba(52,211,153,.4)' : 'rgba(248,113,113,.4)'}">${ok ? 'Sağlıklı' : 'Kontrol gerekli'}</span><div style="color:#94a3b8;font-size:.7rem;margin-top:.35rem">${h.status || '—'} · ${h.ms} ms${h.ssl?.valid ? ' · SSL ✓' : ''}</div>`;
                });
                document.getElementById('data-source-note').textContent = data.source.cloudflareAnalytics ? 'Cloudflare trafik + HTTP sağlık + GitHub Actions; 5 dakikada bir yenilenir.' : 'HTTP sağlık + GitHub Actions; Cloudflare Analytics secret yapılandırılmadı.';
                document.getElementById('last-updated').textContent = `Son güncelleme: ${formatTime(data.generatedAt)}`;
                setLiveState(`Canlı kontrol: ${formatTime(data.generatedAt)}`);
            } catch (error) {
                clearTimeout(timer);
                const isTimeout = error?.name === 'AbortError';
                summaryGrid.innerHTML = `<article class="analytics-card" style="border-top:2px solid #f87171"><div class="analytics-card__name">Veri kaynağı</div><strong class="analytics-card__value" style="display:block;color:#f87171;margin-top:.6rem">${isTimeout ? 'ZAMAN AŞIMI' : 'ERİŞİLEMİYOR'}</strong><div style="color:#94a3b8;font-size:.75rem;margin-top:.4rem">${isTimeout ? 'API 15 saniye içinde yanıt vermedi.' : 'Pages Function henüz yayınlanmamış olabilir.'}</div></article>`;
                countryGrid.innerHTML = '<div class="country-empty">Ülke verisi alınamadı.</div>';
                sourceGrid.innerHTML = '<div class="country-empty">Kaynak verisi alınamadı.</div>';
                setLiveState(isTimeout ? 'Zaman aşımı' : 'Veri alınamadı', '#f87171');
            }
        }
        const conversionLabels = {
            form_submit: 'Form gönderimi',
            rfq_submit: 'RFQ / teklif talebi',
            whatsapp_click: 'WhatsApp tıklaması',
            phone_click: 'Telefon tıklaması',
            email_click: 'E-posta tıklaması',
            purchase: 'Satın alma',
            lead: 'Nitelikli lead',
        };

        const UMAMI_CACHE_KEY = 'cansu-umami-last-success-v2';

        function renderUmamiData(data, options = {}) {
            const cached = Boolean(options.cached);
            if (!data?.configured) {
                const missing = Array.isArray(data?.missing) && data.missing.length ? ` · eksik: ${data.missing.join(', ')}` : '';
                umamiSourceChip.textContent = `Umami · kurulum bekleniyor${missing}`;
                umamiSourceChip.style.color = '#fbbf24';
                overviewUmamiSourceChip.textContent = umamiSourceChip.textContent;
                overviewUmamiSourceChip.style.color = '#fbbf24';
                return false;
            }

            const connected = (data.sites || []).filter((site) => site.connected);
            const sum = (period, metric) => connected.reduce((total, site) => total + Number(site.periods?.[period]?.[metric] || 0), 0);
            const portfolioVisits1d = sum('oneDay','visits');
            const portfolioVisitors1d = sum('oneDay','visitors');
            const portfolioPageviews1d = sum('oneDay','pageviews');

            umamiVisits1d.textContent = formatNumber(portfolioVisits1d);
            umamiVisitors1d.textContent = formatNumber(portfolioVisitors1d);
            umamiPageviews1d.textContent = formatNumber(portfolioPageviews1d);
            umamiVisits30d.textContent = formatNumber(sum('thirtyDays','visits'));
            overviewUmamiVisits1d.textContent = formatNumber(portfolioVisits1d);
            overviewUmamiVisitors1d.textContent = formatNumber(portfolioVisitors1d);
            overviewUmamiPageviews1d.textContent = formatNumber(portfolioPageviews1d);

            const allConnected = connected.length === (data.sites?.length || 6);
            const suffix = cached ? ' · son başarılı veri' : '';
            umamiSourceChip.textContent = `Umami · ${connected.length}/${data.sites?.length || 6} bağlı${suffix}`;
            umamiSourceChip.style.color = cached ? '#7dd3fc' : (allConnected ? '#34d399' : '#fbbf24');
            overviewUmamiSourceChip.textContent = umamiSourceChip.textContent;
            overviewUmamiSourceChip.style.color = umamiSourceChip.style.color;

            const sortedUmamiSites = [...(data.sites || [])].sort((a,b) => Number(b.periods?.oneDay?.visits || 0) - Number(a.periods?.oneDay?.visits || 0));
            umamiOverviewGrid.innerHTML = sortedUmamiSites.map((site) => {
                if (!site.connected) {
                    return `<article class="quality-card"><div class="quality-card__head"><div class="quality-card__name">${escapeHtml(site.name)}</div>${statusBadge('VERİ YOK','warn')}</div><div class="quality-lines"><div class="quality-line"><span>Umami</span><strong>${escapeHtml(site.reason || 'bağlantı bekleniyor')}</strong></div></div></article>`;
                }
                const day = site.periods?.oneDay || {};
                const week = site.periods?.sevenDays || {};
                return `<article class="quality-card">
                    <div class="quality-card__head"><div class="quality-card__name">${escapeHtml(site.name)}</div>${statusBadge(cached ? 'ÖNBELLEK' : 'CANLI',cached ? 'warn' : 'good')}</div>
                    <div class="quality-lines">
                        <div class="quality-line"><span>Oturum · 24s</span><strong>${formatNumber(day.visits || 0)}</strong></div>
                        <div class="quality-line"><span>Ziyaretçi · 24s</span><strong>${formatNumber(day.visitors || 0)}</strong></div>
                        <div class="quality-line"><span>Görüntüleme · 24s</span><strong>${formatNumber(day.pageviews || 0)}</strong></div>
                        <div class="quality-line"><span>Oturum · 7g</span><strong>${formatNumber(week.visits || 0)}</strong></div>
                    </div>
                </article>`;
            }).join('');

            umamiSiteGrid.innerHTML = sortedUmamiSites.map((site) => {
                if (!site.connected) {
                    return `<article class="quality-card"><div class="quality-card__head"><div class="quality-card__name">${escapeHtml(site.name)}</div>${statusBadge('VERİ YOK','warn')}</div><div class="quality-lines"><div class="quality-line"><span>Umami</span><strong>${escapeHtml(site.reason || 'website kaydı bekleniyor')}</strong></div></div></article>`;
                }
                const day = site.periods?.oneDay || {};
                const month = site.periods?.thirtyDays || {};
                return `<article class="quality-card">
                    <div class="quality-card__head"><div class="quality-card__name">${escapeHtml(site.name)}</div>${statusBadge(cached ? 'ÖNBELLEK' : 'CANLI',cached ? 'warn' : 'good')}</div>
                    <div class="quality-lines">
                        <div class="quality-line"><span>Oturumlar · 24s</span><strong>${formatNumber(day.visits || 0)}</strong></div>
                        <div class="quality-line"><span>Ziyaretçiler · 24s</span><strong>${formatNumber(day.visitors || 0)}</strong></div>
                        <div class="quality-line"><span>Sayfa Görüntüleme · 24s</span><strong>${formatNumber(day.pageviews || 0)}</strong></div>
                        <div class="quality-line"><span>Oturumlar · 30g</span><strong>${formatNumber(month.visits || 0)}</strong></div>
                    </div>
                </article>`;
            }).join('');
            return true;
        }

        async function loadUmami() {
            let cachedData = null;
            try {
                const cachedRaw = localStorage.getItem(UMAMI_CACHE_KEY);
                if (cachedRaw) {
                    const parsed = JSON.parse(cachedRaw);
                    if (parsed?.data?.ok && parsed?.data?.configured) {
                        cachedData = parsed.data;
                        renderUmamiData(cachedData, { cached: true });
                    }
                }
            } catch {}

            if (cachedData) {
                umamiSourceChip.textContent = umamiSourceChip.textContent.replace('son başarılı veri','yenileniyor');
                overviewUmamiSourceChip.textContent = umamiSourceChip.textContent;
            } else {
                umamiSourceChip.textContent = 'Umami · canlı veri yükleniyor';
                umamiSourceChip.style.color = '#fbbf24';
                overviewUmamiSourceChip.textContent = 'Umami · canlı veri yükleniyor';
                overviewUmamiSourceChip.style.color = '#fbbf24';
            }

            const controller = new AbortController();
            const timer = setTimeout(() => controller.abort(), 8000);
            try {
                const response = await fetch('https://cansu.teyfikgokdemir.com/api/umami', {
                    cache: 'no-store',
                    signal: controller.signal,
                });
                clearTimeout(timer);
                const data = await response.json();
                if (!response.ok || !data.ok) throw new Error(data.error || 'Umami API failed');

                if (!data.configured) {
                    renderUmamiData(data);
                    if (!cachedData) {
                        umamiVisits1d.textContent = '—';
                        umamiVisitors1d.textContent = '—';
                        umamiPageviews1d.textContent = '—';
                        umamiVisits30d.textContent = '—';
                        overviewUmamiVisits1d.textContent = '—';
                        overviewUmamiVisitors1d.textContent = '—';
                        overviewUmamiPageviews1d.textContent = '—';
                    }
                    return;
                }

                renderUmamiData(data);
                try {
                    localStorage.setItem(UMAMI_CACHE_KEY, JSON.stringify({ savedAt: Date.now(), data }));
                } catch {}
            } catch (error) {
                clearTimeout(timer);
                if (cachedData) {
                    const timedOut = error?.name === 'AbortError';
                    umamiSourceChip.textContent = timedOut ? 'Umami · son veri · canlı yanıt gecikti' : 'Umami · son veri · canlı yenileme başarısız';
                    umamiSourceChip.style.color = '#fbbf24';
                    overviewUmamiSourceChip.textContent = umamiSourceChip.textContent;
                    overviewUmamiSourceChip.style.color = '#fbbf24';
                    return;
                }

                const timedOut = error?.name === 'AbortError';
                umamiSourceChip.textContent = timedOut ? 'Umami · yanıt gecikiyor' : 'Umami · bağlantı hatası';
                umamiSourceChip.style.color = '#f87171';
                overviewUmamiSourceChip.textContent = umamiSourceChip.textContent;
                overviewUmamiSourceChip.style.color = '#f87171';
                overviewUmamiVisits1d.textContent = '—';
                overviewUmamiVisitors1d.textContent = '—';
                overviewUmamiPageviews1d.textContent = '—';
                umamiOverviewGrid.innerHTML = `<div class="attention-card" style="border-color:rgba(248,113,113,.3)"><strong style="color:#f87171">${timedOut ? 'Umami yanıtı gecikiyor' : 'Umami verisi alınamadı'}</strong><span>${timedOut ? 'Son başarılı veri henüz bu cihazda yok. Bir sonraki başarılı yüklemeden sonra panel anında açılacak.' : 'Canlı API geçici olarak kullanılamıyor.'}</span></div>`;
                umamiSiteGrid.innerHTML = umamiOverviewGrid.innerHTML;
            }
        }

        async function loadConversions() {
            try {
                const response = await fetch('/api/conversions', { cache: 'no-store' });
                const data = await response.json();
                if (!response.ok || !data.ok) throw new Error(data.error || 'conversion API failed');
                conv1d.textContent = formatNumber(data.periods?.oneDay?.total || 0);
                conv7d.textContent = formatNumber(data.periods?.sevenDays?.total || 0);
                conv30d.textContent = formatNumber(data.periods?.thirtyDays?.total || 0);
                conversionOverview.textContent = formatNumber(data.periods?.thirtyDays?.total || 0);
                const verified = Number(data.periods?.thirtyDays?.byQuality?.server || 0);
                const browser = Number(data.periods?.thirtyDays?.byQuality?.browser || 0);
                conversionOverviewDetail.textContent = verified ? `${formatNumber(verified)} doğrulanmış · ${formatNumber(browser)} tarayıcı olayı` : `${formatNumber(browser)} tarayıcı olayı · server event bekleniyor`;
                const byType = Object.entries(data.periods?.thirtyDays?.byType || {}).sort((a,b) => Number(b[1]) - Number(a[1]));
                conversionTypes.innerHTML = byType.length
                    ? byType.map(([type,count]) => `<div class="attention-card"><strong>${escapeHtml(conversionLabels[type] || type)}</strong><span>${formatNumber(Number(count))} · son 30 gün</span></div>`).join('')
                    : '<div class="attention-card"><strong>Henüz dönüşüm olayı yok</strong><span>Form, RFQ ve CTA event entegrasyonları bağlandıkça burada görünecek.</span></div>';
            } catch {
                conv1d.textContent = '—';
                conv7d.textContent = '—';
                conv30d.textContent = '—';
                conversionOverview.textContent = '—';
                conversionOverviewDetail.textContent = 'Dönüşüm kaynağı henüz hazır değil';
                conversionTypes.innerHTML = '<div class="attention-card" style="border-color:rgba(251,191,36,.3)"><strong style="color:#fbbf24">Dönüşüm kaynağı hazır değil</strong><span>D1 migration veya event entegrasyonu henüz tamamlanmamış olabilir.</span></div>';
            }
        }

        function refreshAll() { loadOverview(); loadSeo(); loadUmami(); loadConversions(); }
        refreshButton.addEventListener('click', refreshAll);
        headerRefresh.addEventListener('click', refreshAll);
        loadOverview();
        loadSeo();
        loadUmami();
        loadConversions();
        setInterval(refreshAll, 5 * 60 * 1000);
    </script>
</body>
</html>
