---
const title = 'Teyfik Gökdemir | Otonom Büyüme & DevOps Paneli';
const description = 'Gizli Yönetici Paneli';
const canonical = 'https://teyfikgokdemir.com/cansu/';
---
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{title}</title>
    <meta name="description" content={description}>
    <link rel="canonical" href={canonical}>
    <meta name="robots" content="noindex, nofollow">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        :root {
            color-scheme: dark;
        }
        body {
            background-color: #030712;
            color: #f3f4f6;
            font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
            margin: 0;
            padding: 0;
            min-height: 100vh;
        }
        .glass {
            background: rgba(15, 23, 42, 0.75);
            backdrop-filter: blur(16px);
            border: 1px solid rgba(56, 189, 248, 0.15);
        }
        .hidden { display: none !important; }
        .flex { display: flex; }
        .grid { display: grid; }
        .items-center { align-items: center; }
        .justify-between { justify-content: space-between; }
        .justify-center { justify-content: center; }
        .gap-4 { gap: 1rem; }
        .gap-3 { gap: 0.75.rem; }
        .p-8 { padding: 2rem; }
        .p-5 { padding: 1.25rem; }
        .px-6 { padding-left: 1.5rem; padding-right: 1.5rem; }
        .py-4 { padding-top: 1rem; padding-bottom: 1rem; }
        .mb-8 { margin-bottom: 2rem; }
        .w-full { width: 100%; }
        .max-w-md { max-width: 28rem; }
        .max-w-7xl { max-width: 80rem; margin: 0 auto; }
        .rounded-2xl { border-radius: 1rem; }
        .rounded-xl { border-radius: 0.75rem; }
        .text-center { text-align: center; }
        .text-right { text-align: right; }
        .font-bold { font-weight: 700; }
        .text-2xl { font-size: 1.5rem; line-height: 2rem; }
        .text-xl { font-size: 1.25rem; line-height: 1.75rem; }
        .text-sm { font-size: 0.875rem; line-height: 1.25rem; }
        .text-xs { font-size: 0.75rem; line-height: 1rem; }
        .text-cyan-400 { color: #38bdf8; }
        .text-slate-400 { color: #94a3b8; }
        .text-emerald-400 { color: #34d399; }
        .bg-slate-900 { background-color: #0f172a; }
        .border-slate-800 { border-color: #1e293b; }
        input {
            background-color: #020617;
            border: 1px solid #1e293b;
            color: #f3f4f6;
            padding: 0.875rem 1rem;
            border-radius: 0.75rem;
            width: 100%;
            box-sizing: border-box;
            outline: none;
            transition: border-color 0.2s;
        }
        input:focus { border-color: #38bdf8; }
        button.btn-primary {
            background: linear-gradient(135deg, #38bdf8 0%, #0284c7 100%);
            color: #020617;
            font-weight: 600;
            padding: 0.875rem;
            border-radius: 0.75rem;
            border: none;
            width: 100%;
            cursor: pointer;
            box-shadow: 0 10px 25px -5px rgba(56, 189, 248, 0.3);
            transition: opacity 0.2s;
        }
        button.btn-primary:hover { opacity: 0.9; }
        table { width: 100%; border-collapse: collapse; }
        th, td { padding: 1rem 1.5rem; text-align: left; border-bottom: 1px solid #1e293b; }
        th { font-size: 0.75rem; text-transform: uppercase; color: #94a3b8; background: rgba(2, 6, 23, 0.6); }
        tr:hover { background: rgba(30, 41, 59, 0.3); }
    </style>
</head>
<body>
    <!-- Auth Guard Modal -->
    <div id="auth-modal" style="position: fixed; inset: 0; background: rgba(2, 6, 23, 0.95); z-index: 50; display: flex; align-items: center; justify-content: center; padding: 1rem;">
        <div class="glass rounded-2xl p-8 max-w-md w-full shadow-2xl">
            <div class="text-center" style="margin-bottom: 1.5rem;">
                <div style="display: inline-flex; align-items: center; justify-content: center; width: 4rem; height: 4rem; border-radius: 9999px; background: rgba(56, 189, 248, 0.1); color: #38bdf8; margin-bottom: 1rem; font-size: 1.5rem;">
                    <i class="fa-solid fa-heart"></i>
                </div>
                <h2 class="text-xl font-bold">Cansu & Teyfik Özel Paneli</h2>
                <p class="text-sm text-slate-400" style="margin-top: 0.25rem;">Lütfen erişim şifrenizi girin.</p>
            </div>
            <form onsubmit="handleAuth(event)" style="display: flex; flex-direction: column; gap: 1rem;">
                <div>
                    <input type="password" id="admin-pass" placeholder="Özel Şifre (cansu2026)" required>
                </div>
                <button type="submit" class="btn-primary">
                    Sisteme Giriş Yap
                </button>
            </form>
            <p id="auth-error" style="color: #f87171; font-size: 0.75rem; text-align: center; margin-top: 0.75rem; display: none;">Geçersiz şifre! Tekrar deneyin.</p>
        </div>
    </div>

    <!-- Main Dashboard -->
    <div id="dashboard-content" class="hidden max-w-7xl" style="padding: 2rem 1rem;">
        <header style="display: flex; flex-direction: column; md-flex-row; justify-content: space-items; align-items: flex-start; margin-bottom: 2rem; padding-bottom: 1.5rem; border-bottom: 1px solid #1e293b; gap: 1rem;">
            <div>
                <h1 class="text-2xl font-bold flex items-center" style="gap: 0.75rem;">
                    <i class="fa-solid fa-server text-cyan-400"></i> Cansu & Teyfik - Otonom Büyüme Paneli
                </h1>
                <p class="text-sm text-slate-400" style="margin-top: 0.25rem;">Cloudflare & GitHub Actions Otomasyon Sağlık ve İzleme Merkezi</p>
            </div>
            <div style="display: flex; align-items: center; gap: 0.75rem;">
                <span style="display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.375rem 0.875rem; border-radius: 9999px; background: rgba(52, 211, 153, 0.1); color: #34d399; font-size: 0.75rem; font-weight: 500; border: 1px solid rgba(52, 211, 153, 0.2);">
                    <span style="width: 0.5rem; height: 0.5rem; border-radius: 9999px; background: #34d399;"></span> Sistem Aktif (0 Hata)
                </span>
                <button onclick="lockDashboard()" style="background: #0f172a; border: 1px solid #1e293b; color: #cbd5e1; padding: 0.5rem 1rem; border-radius: 0.75rem; font-size: 0.75rem; cursor: pointer;">
                    <i class="fa-solid fa-lock" style="margin-right: 0.35rem;"></i> Kilitle
                </button>
            </div>
        </header>

        <!-- Stats Grid -->
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1rem; margin-bottom: 2rem;">
            <div class="glass rounded-2xl p-5">
                <p class="text-slate-400 text-xs font-medium" style="text-transform: uppercase;">Toplam Repolar</p>
                <h3 class="text-2xl font-bold" style="margin-top: 0.5rem;">6 Varlık</h3>
                <p class="text-emerald-400 text-xs" style="margin-top: 0.5rem;">%100 Senkronize</p>
            </div>
            <div class="glass rounded-2xl p-5">
                <p class="text-slate-400 text-xs font-medium" style="text-transform: uppercase;">Aktif Workflow</p>
                <h3 class="text-2xl font-bold" style="margin-top: 0.5rem;">24+ Otomasyon</h3>
                <p class="text-slate-400 text-xs" style="margin-top: 0.5rem;">CI/CD, SEO, Security</p>
            </div>
            <div class="glass rounded-2xl p-5">
                <p class="text-slate-400 text-xs font-medium" style="text-transform: uppercase;">Büyüme Motorları</p>
                <h3 class="text-2xl font-bold" style="margin-top: 0.5rem;">3 Bot</h3>
                <p class="text-cyan-400 text-xs" style="margin-top: 0.5rem;">Lead Bot, Devlog, AI Content</p>
            </div>
            <div class="glass rounded-2xl p-5">
                <p class="text-slate-400 text-xs font-medium" style="text-transform: uppercase;">Güvenlik Zırhı</p>
                <h3 class="text-2xl font-bold" style="margin-top: 0.5rem;">Aktif</h3>
                <p class="text-emerald-400 text-xs" style="margin-top: 0.5rem;">WAF, Origin Pulls, Dependabot</p>
            </div>
        </div>

        <!-- Repositories Table -->
        <div class="glass rounded-2xl overflow-hidden" style="margin-bottom: 2rem;">
            <div style="padding: 1.25rem 1.5rem; border-bottom: 1px solid #1e293b; display: flex; justify-content: space-between; align-items: center;">
                <h3 style="font-weight: 700; font-size: 1.125rem; margin: 0;">Proje Otomasyon Durumları</h3>
                <span class="text-xs text-slate-400">Canlı GitHub Actions Entegrasyonu</span>
            </div>
            <div style="overflow-x: auto;">
                <table>
                    <thead>
                        <tr>
                            <th>Proje / Varlık</th>
                            <th>Ana Otomasyonlar</th>
                            <th>Çalışma Sıklığı</th>
                            <th>Durum</th>
                            <th class="text-right">Aksiyon</th>
                        </tr>
                    </thead>
                    <tbody style="font-size: 0.875rem;">
                        <tr>
                            <td style="font-weight: 500;"><i class="fa-solid fa-globe text-cyan-400" style="margin-right: 0.5rem;"></i> teyfikgokdemir</td>
                            <td style="color: #cbd5e1;">Deploy, Security, Maintenance, SEO Ping, AI Content</td>
                            <td class="text-slate-400 text-xs">Push & Günlük</td>
                            <td><span style="padding: 0.25rem 0.625rem; border-radius: 9999px; background: rgba(52, 211, 153, 0.1); color: #34d399; font-size: 0.75rem; border: 1px solid rgba(52, 211, 153, 0.2);">Çalışıyor</span></td>
                            <td class="text-right"><a href="https://github.com/teyfikgokdemir/teyfikgokdemir/actions" target="_blank" style="font-size: 0.75rem; background: #1e293b; color: #f3f4f6; padding: 0.375rem 0.75rem; border-radius: 0.5rem; text-decoration: none;">Loglar <i class="fa-solid fa-external-link" style="margin-left: 0.25rem;"></i></a></td>
                        </tr>
                        <tr>
                            <td style="font-weight: 500;"><i class="fa-solid fa-chart-line text-cyan-400" style="margin-right: 0.5rem;"></i> ctseg</td>
                            <td style="color: #cbd5e1;">Deploy, Security, B2B Lead Scraper Bot</td>
                            <td class="text-slate-400 text-xs">Push & Pazartesi</td>
                            <td><span style="padding: 0.25rem 0.625rem; border-radius: 9999px; background: rgba(52, 211, 153, 0.1); color: #34d399; font-size: 0.75rem; border: 1px solid rgba(52, 211, 153, 0.2);">Çalışıyor</span></td>
                            <td class="text-right"><a href="https://github.com/teyfikgokdemir/ctseg/actions" target="_blank" style="font-size: 0.75rem; background: #1e293b; color: #f3f4f6; padding: 0.375rem 0.75rem; border-radius: 0.5rem; text-decoration: none;">Loglar <i class="fa-solid fa-external-link" style="margin-left: 0.25rem;"></i></a></td>
                        </tr>
                        <tr>
                            <td style="font-weight: 500;"><i class="fa-solid fa-gamepad text-cyan-400" style="margin-right: 0.5rem;"></i> mythborn</td>
                            <td style="color: #cbd5e1;">Deploy, Security, Community & Devlog Sync</td>
                            <td class="text-slate-400 text-xs">Push & Çarşamba</td>
                            <td><span style="padding: 0.25rem 0.625rem; border-radius: 9999px; background: rgba(52, 211, 153, 0.1); color: #34d399; font-size: 0.75rem; border: 1px solid rgba(52, 211, 153, 0.2);">Çalışıyor</span></td>
                            <td class="text-right"><a href="https://github.com/teyfikgokdemir/mythborn/actions" target="_blank" style="font-size: 0.75rem; background: #1e293b; color: #f3f4f6; padding: 0.375rem 0.75rem; border-radius: 0.5rem; text-decoration: none;">Loglar <i class="fa-solid fa-external-link" style="margin-left: 0.25rem;"></i></a></td>
                        </tr>
                        <tr>
                            <td style="font-weight: 500;"><i class="fa-solid fa-palette text-cyan-400" style="margin-right: 0.5rem;"></i> qct-studio</td>
                            <td style="color: #cbd5e1;">Deploy, Security, Link Checker, SEO Ping</td>
                            <td class="text-slate-400 text-xs">Push & Haftalık</td>
                            <td><span style="padding: 0.25rem 0.625rem; border-radius: 9999px; background: rgba(52, 211, 153, 0.1); color: #34d399; font-size: 0.75rem; border: 1px solid rgba(52, 211, 153, 0.2);">Çalışıyor</span></td>
                            <td class="text-right"><a href="https://github.com/teyfikgokdemir/qct-studio/actions" target="_blank" style="font-size: 0.75rem; background: #1e293b; color: #f3f4f6; padding: 0.375rem 0.75rem; border-radius: 0.5rem; text-decoration: none;">Loglar <i class="fa-solid fa-external-link" style="margin-left: 0.25rem;"></i></a></td>
                        </tr>
                        <tr>
                            <td style="font-weight: 500;"><i class="fa-solid fa-store text-cyan-400" style="margin-right: 0.5rem;"></i> qct-commerce-tr</td>
                            <td style="color: #cbd5e1;">Deploy, Security, Maintenance</td>
                            <td class="text-slate-400 text-xs">Push & Günlük</td>
                            <td><span style="padding: 0.25rem 0.625rem; border-radius: 9999px; background: rgba(52, 211, 153, 0.1); color: #34d399; font-size: 0.75rem; border: 1px solid rgba(52, 211, 153, 0.2);">Çalışıyor</span></td>
                            <td class="text-right"><a href="https://github.com/teyfikgokdemir/qct-commerce-tr/actions" target="_blank" style="font-size: 0.75rem; background: #1e293b; color: #f3f4f6; padding: 0.375rem 0.75rem; border-radius: 0.5rem; text-decoration: none;">Loglar <i class="fa-solid fa-external-link" style="margin-left: 0.25rem;"></i></a></td>
                        </tr>
                        <tr>
                            <td style="font-weight: 500;"><i class="fa-solid fa-building text-cyan-400" style="margin-right: 0.5rem;"></i> iran-ahli</td>
                            <td style="color: #cbd5e1;">Deploy, Security, Audit</td>
                            <td class="text-slate-400 text-xs">Push & Günlük</td>
                            <td><span style="padding: 0.25rem 0.625rem; border-radius: 9999px; background: rgba(52, 211, 153, 0.1); color: #34d399; font-size: 0.75rem; border: 1px solid rgba(52, 211, 153, 0.2);">Çalışıyor</span></td>
                            <td class="text-right"><a href="https://github.com/teyfikgokdemir/iran-ahli/actions" target="_blank" style="font-size: 0.75rem; background: #1e293b; color: #f3f4f6; padding: 0.375rem 0.75rem; border-radius: 0.5rem; text-decoration: none;">Loglar <i class="fa-solid fa-external-link" style="margin-left: 0.25rem;"></i></a></td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <script>
        function handleAuth(event) {
            event.preventDefault();
            const pass = document.getElementById('admin-pass').value;
            if (pass === 'cansu2026') {
                document.getElementById('auth-modal').style.display = 'none';
                document.getElementById('dashboard-content').classList.remove('hidden');
                localStorage.setItem('admin_auth', 'true');
            } else {
                const err = document.getElementById('auth-error');
                err.style.display = 'block';
            }
        }

        function lockDashboard() {
            localStorage.removeItem('admin_auth');
            location.reload();
        }

        window.onload = function() {
            if (localStorage.getItem('admin_auth') === 'true') {
                document.getElementById('auth-modal').style.display = 'none';
                document.getElementById('dashboard-content').classList.remove('hidden');
            }
        }
    </script>
</body>
</html>
