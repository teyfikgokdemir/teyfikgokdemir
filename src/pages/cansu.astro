                </table>
            </div>
        </div>
    </div>

    <script>
        const dashboard = document.getElementById('dashboard-content');
        const liveStatus = document.getElementById('live-status');
        const summaryGrid = document.getElementById('live-summary-grid');
        const countryGrid = document.getElementById('country-grid');
        const sourceGrid = document.getElementById('source-grid');
        const seoContent = document.getElementById('seo-content');
        const refreshButton = document.getElementById('refresh-data');
        const headerRefresh = document.getElementById('header-refresh');
        const formatTime = (value) => value ? new Date(value).toLocaleString('tr-TR', { dateStyle: 'short', timeStyle: 'medium' }) : '—';
        const formatNumber = (value) => typeof value === 'number' ? new Intl.NumberFormat('tr-TR').format(value) : '—';
        const formatBytes = (value) => typeof value === 'number' ? `${(value / 1024 / 1024).toFixed(1)} MB` : '—';
        const numericValue = (value) => {
            const number = Number(value);
            return Number.isFinite(number) ? number : 0;
        };
        const compareText = (left, right) => {
            const a = String(left ?? '').toLocaleLowerCase('tr-TR');
            const b = String(right ?? '').toLocaleLowerCase('tr-TR');
            return a < b ? -1 : a > b ? 1 : 0;
        };
        const sortOverviewSites = (items) => [...(items || [])].sort((a, b) => {
            const aSuspended = a.key === 'iran-ahli';
            const bSuspended = b.key === 'iran-ahli';
            if (aSuspended !== bSuspended) return aSuspended ? 1 : -1;

            const aHealthy = a.health?.ok && a.health?.ssl?.valid !== false;
            const bHealthy = b.health?.ok && b.health?.ssl?.valid !== false;
            if (aHealthy !== bHealthy) return aHealthy ? -1 : 1;

            const aVisits = numericValue(a.cloudflare?.last24h?.uniqueVisitors);
            const bVisits = numericValue(b.cloudflare?.last24h?.uniqueVisitors);
            if (bVisits !== aVisits) return bVisits - aVisits;

            const aReqs = numericValue(a.cloudflare?.last24h?.requests);
            const bReqs = numericValue(b.cloudflare?.last24h?.requests);
            if (bReqs !== aReqs) return bReqs - aReqs;

            const aMs = numericValue(a.health?.ms);
            const bMs = numericValue(b.health?.ms);
            if (aMs && bMs && aMs !== bMs) return aMs - bMs;

            return compareText(a.name, b.name);
        });

        const sortSources = (items) => [...(items || [])].sort((a, b) => {
            const aVisits = numericValue(a.visits ?? a.uniqueVisitors ?? a.requests);
            const bVisits = numericValue(b.visits ?? b.uniqueVisitors ?? b.requests);
            if (bVisits !== aVisits) return bVisits - aVisits;

            const aReqs = numericValue(a.requests);
            const bReqs = numericValue(b.requests);
            if (bReqs !== aReqs) return bReqs - aReqs;

            return compareText(a.host, b.host);
        });

        const sortCountries = (items) => [...(items || [])].sort((a, b) => {
            const aReqs = numericValue(a.requests ?? a.uniqueVisitors ?? a.visits);
            const bReqs = numericValue(b.requests ?? b.uniqueVisitors ?? b.visits);
            if (bReqs !== aReqs) return bReqs - aReqs;

            const aBytes = numericValue(a.bytes);
            const bBytes = numericValue(b.bytes);
            if (bBytes !== aBytes) return bBytes - aBytes;

            return compareText(a.country, b.country);
        });

        const sortSeoRows = (items) => [...(items || [])].sort((a, b) => {
            const aClicks = numericValue(a.clicks);
            const bClicks = numericValue(b.clicks);
            if (bClicks !== aClicks) return bClicks - aClicks;

            const aImp = numericValue(a.impressions);
            const bImp = numericValue(b.impressions);
            if (bImp !== aImp) return bImp - aImp;

            const aCtr = numericValue(a.ctr);
            const bCtr = numericValue(b.ctr);
            if (bCtr !== aCtr) return bCtr - aCtr;

            const aPos = numericValue(a.position) || 999;
            const bPos = numericValue(b.position) || 999;
            if (aPos !== bPos) return aPos - bPos;

            return compareText(a.value, b.value);
        });

        const sortGscSites = (items) => [...(items || [])].sort((a, b) => {
            const aClicks = numericValue(a.periods?.thirtyDays?.clicks ?? a.periods?.sevenDays?.clicks);
            const bClicks = numericValue(b.periods?.thirtyDays?.clicks ?? b.periods?.sevenDays?.clicks);
            if (bClicks !== aClicks) return bClicks - aClicks;

            const aImp = numericValue(a.periods?.thirtyDays?.impressions ?? a.periods?.sevenDays?.impressions);
            const bImp = numericValue(b.periods?.thirtyDays?.impressions ?? b.periods?.sevenDays?.impressions);
            if (bImp !== aImp) return bImp - aImp;

            return compareText(a.key, b.key);
        });

        const signalMeta = (signal) => ({
            high: { label: 'YÜKSEK SİNYAL', color: '#fb7185', bg: 'rgba(251,113,133,.12)' },
            medium: { label: 'ORTA SİNYAL', color: '#fbbf24', bg: 'rgba(251,191,36,.12)' },
            low: { label: 'DÜŞÜK SİNYAL', color: '#34d399', bg: 'rgba(52,211,153,.12)' },
        }[signal?.level] || { label: 'VERİ YOK', color: '#94a3b8', bg: 'rgba(148,163,184,.12)' });
        const countryNames = new Intl.DisplayNames(['tr-TR'], { type: 'region' });
        const getCountryName = (value) => {
            const code = String(value || '').trim().toUpperCase();
            if (!code) return 'Bilinmeyen ülke';
            const shortNames = { US: 'ABD', GB: 'Birleşik Krallık', AE: 'BAE', KR: 'Güney Kore', RU: 'Rusya', CN: 'Çin', TR: 'Türkiye', DE: 'Almanya', NL: 'Hollanda' };
            if (shortNames[code]) return shortNames[code];
            try { return countryNames.of(code) || code; } catch { return code; }
        };
        const escapeHtml = (value) => String(value ?? '').replace(/[&<>"']/g, (char) => ({ '&':'&amp;', '<':'&lt;', '>':'&gt;', '"':'&quot;', "'":'&#039;' }[char]));
        const card = (site) => {
            const h = site.health;
            const g = site.github;
            const traffic = site.cloudflare?.last24h;
            const healthy = h.ok && h.ssl?.valid !== false && (!g.latest || g.latest.conclusion === 'success');
            const tone = healthy ? '#34d399' : '#f87171';
            const status = healthy ? 'SAĞLIKLI' : 'KONTROL GEREKLİ';
            const statusBg = healthy ? 'rgba(52,211,153,.12)' : 'rgba(248,113,113,.12)';
            const githubStatus = g.errorType === 'authentication' ? 'GitHub bağlantısı doğrulanamadı' : g.errorType === 'repository' ? 'Repository kullanılamıyor' : g.latest?.conclusion || (g.ok ? 'veri yok' : 'erişilemiyor');
            const signal = site.cloudflare?.automationSignal;
            const signalStyle = signalMeta(signal);
            const sslColor = h.ssl?.valid ? '#34d399' : '#f87171';
            const sslText = h.ssl?.valid ? '✓ Geçerli' : (h.ssl?.error || '✗ Sorun');
            const commitHtml = g.latestCommit ? `<div class="analytics-card__commit"><a href="${escapeHtml(g.latestCommit.url)}" target="_blank" rel="noreferrer" title="Commit'i aç">${escapeHtml(g.latestCommit.sha)}</a><span class="analytics-card__commit-msg" title="${escapeHtml(g.latestCommit.message)}">${escapeHtml(g.latestCommit.message)}</span><span style="color:#475569;flex-shrink:0;">${formatTime(g.latestCommit.date)}</span></div>` : '';
            return `<article class="analytics-card" style="border-top:2px solid ${tone}">
                <div class="analytics-card__head">
                    <div class="analytics-card__name"><i class="fa-solid fa-chart-simple" style="color:#93c5fd;margin-right:.45rem"></i>${site.name}</div>
                    <span class="analytics-card__status" style="color:${tone};background:${statusBg};border:1px solid ${tone}55"><span class="analytics-card__status-dot"></span>${status}</span>
                </div>
                <div class="analytics-card__metrics">
                    <div class="analytics-metric"><span class="analytics-metric__label">Toplam HTTP istekleri / 24s</span><strong class="analytics-metric__value">${traffic ? formatNumber(traffic.requests) : '—'}</strong></div>
                    <div class="analytics-metric"><span class="analytics-metric__label">Tahmini ziyaret / oturum · 24s</span><strong class="analytics-metric__value">${traffic ? formatNumber(traffic.uniqueVisitors) : '—'}</strong></div>
                    <div class="analytics-metric analytics-metric--period"><span class="analytics-metric__label">Tahmini ziyaret / oturum · 7g</span><strong class="analytics-metric__value">${traffic ? formatNumber(traffic.uniqueVisitors7d) : '—'}</strong></div>
                    <div class="analytics-metric analytics-metric--period"><span class="analytics-metric__label">Tahmini ziyaret / oturum · 30g</span><strong class="analytics-metric__value">${traffic ? formatNumber(traffic.uniqueVisitors30d) : '—'}</strong></div>
                    <div class="analytics-metric"><span class="analytics-metric__label">Trafik / 24s</span><strong class="analytics-metric__value">${traffic ? formatBytes(traffic.bytes) : '—'}</strong></div>
                    <div class="analytics-metric"><span class="analytics-metric__label">Otomatik trafik sinyali</span><strong class="analytics-metric__value" style="color:${signalStyle.color};font-size:.78rem">${signalStyle.label}</strong><span class="analytics-metric__hint">${signal ? `${signal.requestPerVisitor} istek/ziyaret · üst ülke ${signal.topCountryShare}%` : '—'}</span></div>
                    <div class="analytics-metric"><span class="analytics-metric__label">Yanıt süresi</span><strong class="analytics-metric__value">${h.ms} ms</strong></div>
                    <div class="analytics-metric"><span class="analytics-metric__label">SSL / TLS</span><strong class="analytics-metric__value" style="color:${sslColor}">${sslText}</strong></div>
                </div>
                <div class="analytics-card__footer"><span><i class="fa-solid fa-code-branch" style="margin-right:.3rem"></i>GitHub: ${githubStatus}</span><a href="${site.actions}" target="_blank" rel="noreferrer">Logları aç <i class="fa-solid fa-arrow-up-right-from-square" style="margin-left:.25rem"></i></a></div>
                ${commitHtml}
                <div class="analytics-card__check">HTTP ${h.status || '—'} · Son kontrol: ${formatTime(h.checkedAt)}</div>
            </article>`;
        };
        const formatPercent = (value) => `${(Number(value || 0) * 100).toFixed(1)}%`;
        const formatPosition = (value) => Number(value || 0) ? Number(value).toFixed(1) : '—';
        const seoTable = (title, rows, type) => {
            const orderedRows = sortSeoRows(rows);
            const body = orderedRows.slice(0, 5).map((row) => `<tr><td title="${escapeHtml(row.value)}">${escapeHtml(row.value)}</td><td>${formatNumber(row.clicks)}</td><td>${formatNumber(row.impressions)}</td><td>${formatPercent(row.ctr)}</td><td>${formatPosition(row.position)}</td></tr>`).join('');
            return `<div style="margin-top:1rem;"><div style="color:#7dd3fc;font-size:.65rem;font-weight:800;letter-spacing:.06em;text-transform:uppercase;">${title}</div>${body ? `<table class="seo-table"><thead><tr><th>${type === 'query' ? 'Sorgu' : 'Landing page'}</th><th>Tık.</th><th>Göst.</th><th>CTR</th><th>Ort.</th></tr></thead><tbody>${body}</tbody></table>` : '<div class="country-empty">Bu dönem için veri yok</div>'}</div>`;
        };
        async function loadSeo() {
            const controller = new AbortController();
            const timer = setTimeout(() => controller.abort(), 15000);
            try {
                const response = await fetch('/api/gsc/seo', { cache: 'no-store', signal: controller.signal });
                clearTimeout(timer);
                const data = await response.json();
                if (!data.connected) {
                    seoContent.innerHTML = `<div class="seo-periods"><div class="seo-period"><span class="seo-period__label">Son 7 gün</span><strong class="seo-period__value">Yetkilendirme bekliyor</strong></div><div class="seo-period"><span class="seo-period__label">Son 30 gün</span><strong class="seo-period__value">Yetkilendirme bekliyor</strong></div></div><div style="margin-top:.85rem;"><a class="seo-connect" href="/api/gsc/start"><i class="fa-brands fa-google"></i> Search Console'u bağla</a></div>`;
                    return;
                }
                const siteCards = sortGscSites(data.sites).map((site) => {
                    if (!site.ok) return `<article class="seo-site"><div class="seo-site__head"><div><div class="seo-site__name">${escapeHtml(site.name)}</div><div class="seo-site__property">${escapeHtml(site.property)}</div></div><span class="seo-panel__badge">VERİ YOK</span></div><div class="country-empty">${escapeHtml(site.error || 'Search Console verisi alınamadı')}</div></article>`;
                    const seven = site.periods?.sevenDays || {};
                    const thirty = site.periods?.thirtyDays || {};
                    return `<article class="seo-site"><div class="seo-site__head"><div><div class="seo-site__name">${escapeHtml(site.name)}</div><div class="seo-site__property">${escapeHtml(site.property)}</div></div><span class="seo-panel__badge">CANLI RAPOR</span></div><div class="seo-periods"><div class="seo-period"><span class="seo-period__label">7 gün · tıklama</span><strong class="seo-period__value">${formatNumber(seven.clicks)}</strong><span class="seo-row-note">${formatNumber(seven.impressions)} gösterim · ${formatPercent(seven.ctr)}</span></div><div class="seo-period"><span class="seo-period__label">30 gün · tıklama</span><strong class="seo-period__value">${formatNumber(thirty.clicks)}</strong><span class="seo-row-note">${formatNumber(thirty.impressions)} gösterim · ${formatPercent(thirty.ctr)}</span></div></div><div style="color:#64748b;font-size:.62rem;margin-top:.65rem;">Ort. konum: 7g ${formatPosition(seven.position)} · 30g ${formatPosition(thirty.position)}</div>${seoTable('En iyi sorgular · 30 gün', site.topQueries, 'query')}${seoTable("En iyi landing page'ler · 30 gün", site.topPages, 'page')}</article>`;
                }).join('');
                seoContent.innerHTML = `<div style="color:#64748b;font-size:.65rem;margin-top:1rem;">Son Search Console verisi: ${escapeHtml(data.dataThrough || '—')} · Google verileri genellikle birkaç gün gecikmeli gelir.</div><div class="seo-sites-grid">${siteCards}</div>`;
            } catch {
                clearTimeout(timer);
                seoContent.innerHTML = '<div class="country-empty">Search Console verisi şu anda alınamadı.</div>';
            }
        }
        function setLiveState(text, color = '#34d399') {
            liveStatus.style.color = color;
            liveStatus.style.borderColor = color;
            liveStatus.style.background = `${color}22`;
            liveStatus.lastChild.textContent = ` ${text}`;
        }
        async function loadOverview() {
            setLiveState('Canlı veriler yükleniyor...', '#fbbf24');
            const controller = new AbortController();
            const timer = setTimeout(() => controller.abort(), 15000);
            try {
                const response = await fetch('/api/overview', { cache: 'no-store', signal: controller.signal });
                clearTimeout(timer);
                if (!response.ok) throw new Error(`HTTP ${response.status}`);
                const data = await response.json();
                const healthy = data.sites.filter((site) => site.health.ok).length;
                const sslValid = data.sites.filter((site) => site.health.ssl?.valid).length;
                const failed = data.sites.reduce((sum, site) => sum + (site.github.failed24h || 0), 0);
                const cfActive = data.sites.filter((site) => site.cloudflare?.available).length;
                document.getElementById('health-summary').textContent = `${healthy}/${data.sites.length} site erişilebilir · ${sslValid} SSL geçerli`;
                document.getElementById('workflow-summary').textContent = `${data.sites.length} repo izleniyor`;
                document.getElementById('workflow-detail').textContent = failed ? `${failed} başarısız run (24 saat)` : 'Son 24 saatte failure yok';
                document.getElementById('bot-summary-title').textContent = `${cfActive} Aktif Motor`;
                document.getElementById('bot-summary-detail').textContent = `Resmi Bot API'si Enterprise gerektirir; kartlarda otonom sinyal izleniyor.`;
                
                const sortedSites = sortOverviewSites(data.sites);
                summaryGrid.innerHTML = sortedSites.map((site) => card(site)).join('');
                sourceGrid.innerHTML = sortedSites.map((site) => {
                    const sortedSources = sortSources(site.cloudflare?.sources).slice(0, 8);
                    const sourceRows = sortedSources.map((item) => `<div class="source-row"><div><div class="source-row__host" title="${item.host}">${item.host}</div><div class="source-row__meta">${formatNumber(item.requests)} istek · ${formatBytes(item.bytes)}</div></div><strong class="source-row__value">${formatNumber(item.visits)} visit</strong></div>`).join('');
                    return `<article class="source-panel"><div class="source-panel__head"><div><div class="source-panel__name">${site.name}</div><div class="source-panel__summary">Son 24 saat · referrer kaynakları</div></div><span class="seo-panel__badge">TOP 12</span></div>${sourceRows || '<div class="country-empty">Kaynak verisi bekleniyor</div>'}</article>`;
                }).join('');
                countryGrid.innerHTML = sortedSites.map((site) => {
                    const sortedCountries = sortCountries(site.cloudflare?.countries);
                    const maxRequests = Math.max(1, ...sortedCountries.map((item) => numericValue(item.requests)));
                    const totalRequests = sortedCountries.reduce((sum, item) => sum + numericValue(item.requests), 0);
                    const rows = sortedCountries.slice(0, 15).map((item, index) => { const countryName = getCountryName(item.country); return `<div class="country-row"><span class="country-row__rank">${String(index + 1).padStart(2, '0')}</span><span class="country-row__name" title="${countryName}">${countryName}</span><span class="country-row__track"><span class="country-row__bar" style="width:${Math.max(3, Math.round((numericValue(item.requests) / maxRequests) * 100))}%"></span></span><span class="country-row__stats"><strong class="country-row__value">${formatNumber(item.requests)}</strong><span class="country-row__share">${Number(item.requestShare || (totalRequests ? (numericValue(item.requests) / totalRequests) * 100 : 0)).toFixed(1)}% pay</span></span><span class="country-row__traffic">${formatBytes(item.bytes)}</span></div>`; }).join('');
                    return `<article class="country-panel"><div class="country-panel__head"><div><div class="country-panel__name">${site.name}</div><div class="country-panel__summary">${formatNumber(totalRequests)} ülke isteği · 24 saat</div></div><span class="country-panel__badge">TOP 15</span></div>${rows || '<div class="country-empty">Cloudflare ülke verisi bekleniyor</div>'}</article>`;
                }).join('');
                const tbody = document.querySelector('tbody');
                sortedSites.forEach((site) => {
                    const row = document.querySelector(`tr[data-site="${site.key}"]`);
                    if (!row) return;
                    if (tbody) tbody.appendChild(row);
                    const statusCell = row.cells[3];
                    const h = site.health;
                    const g = site.github;
                    const ok = h.ok && (!g.latest || g.latest.conclusion === 'success');
                    statusCell.innerHTML = `<span style="padding:.25rem .75rem;border-radius:9999px;background:${ok ? 'rgba(52,211,153,.2)' : 'rgba(248,113,113,.2)'};color:${ok ? '#34d399' : '#f87171'};font-size:.75rem;border:1px solid ${ok ? 'rgba(52,211,153,.4)' : 'rgba(248,113,113,.4)'}">${ok ? 'Sağlıklı' : 'Kontrol gerekli'}</span><div style="color:#94a3b8;font-size:.7rem;margin-top:.35rem">${h.status || '—'} · ${h.ms} ms${h.ssl?.valid ? ' · SSL ✓' : ''}</div>`;
                });
                document.getElementById('data-source-note').textContent = data.source.cloudflareAnalytics ? 'Cloudflare trafik + HTTP sağlık + GitHub Actions; 5 dakikada bir yenilenir.' : 'HTTP sağlık + GitHub Actions; Cloudflare Analytics secret yapılandırılmadı.';
                document.getElementById('last-updated').textContent = `Son güncelleme: ${formatTime(data.generatedAt)}`;
                setLiveState(`Canlı kontrol: ${formatTime(data.generatedAt)}`);
            } catch (error) {
                clearTimeout(timer);
                const isTimeout = error?.name === 'AbortError';
                summaryGrid.innerHTML = `<article class="analytics-card" style="border-top:2px solid #f87171"><div class="analytics-card__name">Veri kaynağı</div><strong class="analytics-card__value" style="display:block;color:#f87171;margin-top:.6rem">${isTimeout ? 'ZAMAN AŞIMI' : 'ERİŞİLEMİYOR'}</strong><div style="color:#94a3b8;font-size:.75rem;margin-top:.4rem">${isTimeout ? 'API 15 saniye içinde yanıt vermedi.' : 'Pages Function henüz yayınlanmamış olabilir.'}</div></article>`;
                countryGrid.innerHTML = '<div class="country-empty">Ülke verisi alınamadı.</div>';
                sourceGrid.innerHTML = '<div class="country-empty">Kaynak verisi alınamadı.</div>';
                setLiveState(isTimeout ? 'Zaman aşımı' : 'Veri alınamadı', '#f87171');
            }
        }
        function refreshAll() { loadOverview(); loadSeo(); }
        refreshButton.addEventListener('click', refreshAll);
        headerRefresh.addEventListener('click', refreshAll);
        loadOverview();
        loadSeo();
        setInterval(refreshAll, 5 * 60 * 1000);
    </script>
</body>
</html>
