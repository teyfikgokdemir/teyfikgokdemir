---
const title = 'Teyfik Gökdemir | Cansu & Teyfik Özel Paneli';
const description = 'Gizli Yönetici Paneli';
const canonical = 'https://teyfikgokdemir.com/cansu/';
---
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{title}</title>
    <meta name="description" content={description}>
    <link rel="canonical" href={canonical}>
    <meta name="robots" content="noindex, nofollow">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style is:global>
        :root { color-scheme: dark; }
        body {
            background-color: #030712;
            color: #f3f4f6;
            font-family: system-ui, -apple-system, sans-serif;
            margin: 0;
            padding: 0;
            min-height: 100vh;
            overflow-x: hidden;
        }

        /* Master Grid Wrapper for Desktop */
        .page-wrapper {
            display: grid;
            grid-template-columns: 280px 1fr 280px;
            align-items: center;
            justify-content: center;
            min-height: 100vh;
            max-width: 1500px;
            margin: 0 auto;
            padding: 2rem;
            gap: 2rem;
            position: relative;
            z-index: 10;
        }

        .gallery-side {
            display: flex;
            flex-direction: column;
            gap: 1.5rem;
            align-items: center;
            justify-content: center;
        }

        /* Mobile specific gallery (hidden on desktop) */
        .mobile-gallery {
            display: none;
        }

        .polaroid {
            background: #ffffff;
            padding: 8px 8px 22px 8px;
            box-shadow: 0 15px 30px rgba(0,0,0,0.6);
            border-radius: 6px;
            width: 220px;
            transform: rotate(var(--rot, 0deg));
            transition: transform 0.3s ease, box-shadow 0.3s ease;
            border: 1px solid rgba(255,255,255,0.3);
        }
        .polaroid:hover {
            transform: scale(1.04) rotate(0deg) !important;
            z-index: 30;
            box-shadow: 0 25px 50px rgba(244,63,94,0.4);
        }
        .polaroid img {
            width: 100%;
            height: 180px;
            object-fit: cover;
            display: block;
            border-radius: 3px;
        }

        /* Precise Face Focus */
        .img-wedding { object-position: 50% 15% !important; }
        .img-sunset { object-position: 50% 25% !important; }
        .img-zarafet { object-position: 50% 15% !important; }
        .img-nikah { object-position: 50% 20% !important; }
        .img-kahve { object-position: 50% 30% !important; }
        .img-huzur { object-position: 50% 30% !important; }

        .polaroid .caption {
            color: #111827;
            font-size: 11px;
            font-weight: 700;
            text-align: center;
            margin-top: 8px;
            font-family: monospace;
        }

        /* Center Login Card */
        .login-card {
            background: rgba(15, 23, 42, 0.95);
            backdrop-filter: blur(20px);
            border: 1px solid rgba(244, 63, 94, 0.4);
            box-shadow: 0 25px 60px rgba(0, 0, 0, 0.9);
            border-radius: 1.5rem;
            padding: 2.5rem;
            width: 100%;
            max-width: 420px;
            margin: 0 auto;
            z-index: 20;
        }

        /* Dashboard crystal clear background */
        .dashboard-bg {
            position: fixed;
            inset: 0;
            background: linear-gradient(rgba(3, 7, 18, 0.85), rgba(3, 7, 18, 0.94)),
                        url('/images/cansu/uF2GI.jpg') no-repeat center center/cover;
            z-index: 0;
            pointer-events: none;
        }

        .bg-overlay {
            position: fixed;
            inset: 0;
            background: rgba(3, 7, 18, 0.6);
            z-index: 2;
            pointer-events: none;
        }
        .content-layer { position: relative; z-index: 10; width: 100%; }
        .glass {
            background: rgba(15, 23, 42, 0.92);
            backdrop-filter: blur(20px);
            border: 1px solid rgba(244, 63, 94, 0.4);
            box-shadow: 0 25px 60px rgba(0, 0, 0, 0.9);
        }
        .hidden { display: none !important; }
        .analytics-card { background: linear-gradient(145deg, rgba(15,23,42,.96), rgba(2,6,23,.96)); border: 1px solid rgba(148,163,184,.16); border-radius: 1rem; padding: 1.15rem; box-shadow: 0 12px 28px rgba(0,0,0,.22); transition: transform .2s ease, border-color .2s ease, box-shadow .2s ease; min-width: 0; }
        .analytics-card:hover { transform: translateY(-3px); border-color: rgba(96,165,250,.45); box-shadow: 0 18px 36px rgba(15,23,42,.55); }
        .analytics-card__head { display: flex; justify-content: space-between; align-items: flex-start; gap: .75rem; margin-bottom: 1rem; }
        .analytics-card__name { color: #e2e8f0; font-size: .78rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; overflow-wrap: anywhere; }
        .analytics-card__status { display: inline-flex; align-items: center; gap: .35rem; border-radius: 9999px; padding: .3rem .55rem; font-size: .63rem; font-weight: 800; letter-spacing: .04em; white-space: nowrap; }
        .analytics-card__status-dot { width: .42rem; height: .42rem; border-radius: 50%; background: currentColor; }
        .analytics-card__metrics { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .55rem; }
        .analytics-metric { background: rgba(2,6,23,.58); border: 1px solid rgba(51,65,85,.72); border-radius: .7rem; padding: .65rem .7rem; min-width: 0; }
        .analytics-metric--period { background: linear-gradient(145deg, rgba(14,116,144,.12), rgba(2,6,23,.58)); border-color: rgba(56,189,248,.2); }
        .analytics-metric__label { color: #64748b; font-size: .62rem; font-weight: 700; text-transform: uppercase; letter-spacing: .04em; }
        .analytics-metric--period .analytics-metric__label { color: #7dd3fc; }
        .analytics-metric__value { display: block; color: #f8fafc; font-size: 1rem; font-weight: 750; line-height: 1.25; margin-top: .25rem; overflow-wrap: anywhere; }
        .analytics-card__footer { display: flex; justify-content: space-between; gap: .5rem; color: #64748b; font-size: .66rem; margin-top: .85rem; }
        .analytics-card__footer a { color: #93c5fd; text-decoration: none; }
        .analytics-card__footer a:hover { color: #bfdbfe; text-decoration: underline; }
        .country-section { background: radial-gradient(circle at 12% 0%, rgba(56,189,248,.09), transparent 32%), linear-gradient(145deg, rgba(15,23,42,.96), rgba(2,6,23,.98)); border: 1px solid rgba(148,163,184,.2); border-radius: 1.25rem; padding: 1.55rem 1.65rem; box-shadow: 0 24px 70px rgba(0,0,0,.28), inset 0 1px 0 rgba(255,255,255,.04); }
        .country-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 1rem; }
        .country-panel { position: relative; overflow: hidden; background: linear-gradient(160deg, rgba(15,23,42,.86), rgba(2,6,23,.9)); border: 1px solid rgba(100,116,139,.34); border-radius: 1rem; padding: 1.05rem; box-shadow: 0 12px 30px rgba(0,0,0,.2), inset 0 1px 0 rgba(255,255,255,.035); transition: transform .2s ease, border-color .2s ease, box-shadow .2s ease; }
        .country-panel::before { content: ''; position: absolute; inset: 0 0 auto; height: 2px; background: linear-gradient(90deg, #38bdf8, #818cf8, transparent); opacity: .8; }
        .country-panel:hover { transform: translateY(-3px); border-color: rgba(96,165,250,.55); box-shadow: 0 18px 40px rgba(0,0,0,.32), 0 0 0 1px rgba(96,165,250,.08); }
        .country-panel__head { display: flex; align-items: flex-start; justify-content: space-between; gap: .75rem; margin-bottom: .95rem; }
        .country-panel__name { color: #f8fafc; font-size: .78rem; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; }
        .country-panel__summary { color: #64748b; font-size: .64rem; margin-top: .25rem; }
        .country-panel__badge { color: #bae6fd; background: rgba(14,116,144,.18); border: 1px solid rgba(56,189,248,.25); border-radius: 9999px; padding: .27rem .5rem; font-size: .62rem; font-weight: 800; white-space: nowrap; }
        .country-row { display: grid; grid-template-columns: 1.35rem minmax(6.5rem,1.25fr) minmax(3.5rem,1fr) auto; align-items: center; gap: .55rem; margin-top: .62rem; }
        .country-row__rank { color: #64748b; font-size: .62rem; font-weight: 800; text-align: center; }
        .country-row__name { color: #e2e8f0; font-size: .7rem; font-weight: 700; letter-spacing: .05em; }
        .country-row__track { height: .42rem; background: linear-gradient(90deg, rgba(30,41,59,.95), rgba(15,23,42,.8)); border: 1px solid rgba(71,85,105,.35); border-radius: 9999px; overflow: hidden; }
        .country-row__bar { height: 100%; min-width: 3px; background: linear-gradient(90deg, #38bdf8, #818cf8 70%, #c084fc); border-radius: inherit; box-shadow: 0 0 12px rgba(56,189,248,.28); }
        .country-row__stats { min-width: 4.4rem; text-align: right; }
        .country-row__value { display: block; color: #f8fafc; font-size: .7rem; font-variant-numeric: tabular-nums; }
        .country-row__share { display: block; color: #64748b; font-size: .59rem; font-variant-numeric: tabular-nums; margin-top: .12rem; }
        .country-row__traffic { color: #94a3b8; font-size: .6rem; font-variant-numeric: tabular-nums; text-align: right; white-space: nowrap; }
        .country-empty { color: #64748b; font-size: .72rem; padding: .65rem 0 .25rem; }
        @media (max-width: 700px) { .analytics-card__metrics { grid-template-columns: repeat(2, minmax(0, 1fr)); } .analytics-card { padding: .9rem; } .country-section { padding: 1rem; } }
        input {
            background-color: #020617;
            border: 1px solid #1e293b;
            color: #f3f4f6;
            padding: 1rem 1.25rem;
            border-radius: 0.75rem;
            width: 100%;
            box-sizing: border-box;
            outline: none;
            font-size: 1rem;
        }
        input:focus { border-color: #f43f5e; box-shadow: 0 0 15px rgba(244, 63, 94, 0.4); }
        button.btn-primary {
            background: linear-gradient(135deg, #f43f5e 0%, #be123c 100%);
            color: #ffffff;
            font-weight: 600;
            padding: 1rem;
            border-radius: 0.75rem;
            border: none;
            width: 100%;
            cursor: pointer;
            box-shadow: 0 10px 25px -5px rgba(244, 63, 94, 0.4);
            font-size: 1rem;
        }
        button.btn-primary:hover { opacity: 0.95; }
        table { width: 100%; border-collapse: collapse; }
        th, td { padding: 1.25rem 1.5rem; text-align: left; border-bottom: 1px solid #1e293b; }
        th { font-size: 0.75rem; text-transform: uppercase; color: #94a3b8; background: rgba(2, 6, 23, 0.85); }
        tr:hover { background: rgba(30, 41, 59, 0.6); }

        /* Mobile Optimization: Exactly 2 photos (top and bottom of login card) */
        @media (max-width: 1100px) {
            .page-wrapper {
                grid-template-columns: 1fr;
                padding: 1rem;
                min-height: 100vh;
                display: flex;
                flex-direction: column;
                justify-content: center;
                gap: 1.5rem;
            }
            .gallery-side {
                display: none;
            }
            .mobile-gallery {
                display: flex;
                flex-direction: column;
                align-items: center;
                gap: 1.25rem;
                width: 100%;
            }
            .mobile-gallery .polaroid {
                width: 180px;
                transform: rotate(0deg) !important;
            }
            .mobile-gallery .polaroid img {
                height: 140px;
            }
            .login-card {
                max-width: 100%;
                padding: 1.75rem;
            }
        }
    </style>
</head>
<body>
    <div class="bg-overlay"></div>

    <!-- Auth Guard Modal -->
    <div id="auth-modal" class="content-layer hidden">
        <div class="page-wrapper">
            <!-- Mobile Top Photo -->
            <div class="mobile-gallery">
                <div class="polaroid" style="--rot: -2deg;"><img src="/images/cansu/wedding_entrance.webp" alt="Wedding" class="img-wedding"><div class="caption">En Mutlu Anımız ❤️</div></div>
            </div>

            <!-- Left Gallery Column (Desktop) -->
            <div class="gallery-side">
                <div class="polaroid" style="--rot: -4deg;"><img src="/images/cansu/wedding_entrance.webp" alt="Wedding" class="img-wedding"><div class="caption">En Mutlu Anımız ❤️</div></div>
                <div class="polaroid" style="--rot: 3deg;"><img src="/images/cansu/couple_reels_new_1.webp" alt="Coffee" class="img-kahve"><div class="caption">Kahve Keyfi ☕</div></div>
                <div class="polaroid" style="--rot: -3deg;"><img src="/images/cansu/lifestyle_vacation_4.webp" alt="Reading" class="img-huzur"><div class="caption">Huzur 📖</div></div>
            </div>

            <!-- Center Login Card -->
            <div class="login-card">
                <div style="text-align: center; margin-bottom: 2rem;">
                    <div style="display: inline-flex; align-items: center; justify-content: center; width: 5.5rem; height: 5.5rem; border-radius: 9999px; background: rgba(244, 63, 94, 0.2); color: #f43f5e; margin-bottom: 1.25rem; border: 2px solid #f43f5e; overflow: hidden; box-shadow: 0 10px 25px rgba(244,63,94,0.3);">
                        <img src="/images/cansu/uF2GI.jpg" alt="Cansu" style="width: 100%; height: 100%; object-fit: cover; object-position: 50% 20%;">
                    </div>
                    <h2 style="font-size: 1.5rem; font-weight: 700; margin: 0; color: #fb7185;">Cansu & Teyfik Özel Paneli</h2>
                    <p style="color: #cbd5e1; font-size: 0.875rem; margin-top: 0.5rem;">Özel panel doğrudan görüntülenir.</p>
                </div>
                <form id="login-form" style="display: flex; flex-direction: column; gap: 1.25rem;">
                    <div>
                        <input type="password" id="admin-pass" placeholder="Özel Şifre" required>
                    </div>
                    <button type="submit" class="btn-primary">
                        Sisteme Giriş Yap
                    </button>
                </form>
                <p id="auth-error" style="color: #f87171; font-size: 0.8rem; text-align: center; margin-top: 1rem; display: none;">Geçersiz şifre! Tekrar deneyin.</p>
            </div>

            <!-- Right Gallery Column (Desktop) -->
            <div class="gallery-side">
                <div class="polaroid" style="--rot: 4deg;"><img src="/images/cansu/wedding_concept_1.webp" alt="Sunset" class="img-sunset"><div class="caption">Gün Batımı 🌅</div></div>
                <div class="polaroid" style="--rot: -2deg;"><img src="/images/cansu/business_luxury_8.webp" alt="Style" class="img-zarafet"><div class="caption">Zarafet ✨</div></div>
                <div class="polaroid" style="--rot: 3deg;"><img src="/images/cansu/wedding_reels.webp" alt="Ceremony" class="img-nikah"><div class="caption">Nikah 💍</div></div>
            </div>

            <!-- Mobile Bottom Photo -->
            <div class="mobile-gallery">
                <div class="polaroid" style="--rot: 2deg;"><img src="/images/cansu/wedding_concept_1.webp" alt="Sunset" class="img-sunset"><div class="caption">Gün Batımı 🌅</div></div>
            </div>
        </div>
    </div>

    <!-- Dashboard Crystal Clear Background (Hidden initially) -->
    <div id="dash-bg-element" class="dashboard-bg hidden"></div>

    <!-- Main Dashboard -->
    <div id="dashboard-content" class="content-layer hidden" style="max-width: 80rem; margin: 0 auto; padding: 2rem 1.5rem;">
        <header style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2.5rem; padding-bottom: 1.5rem; border-bottom: 1px solid rgba(255,255,255,0.15); flex-wrap: wrap; gap: 1rem;">
            <div>
                <h1 style="font-size: 1.875rem; font-weight: 700; display: flex; align-items: center; gap: 0.75rem; margin: 0;">
                    <span style="display: inline-block; width: 3rem; height: 3rem; border-radius: 9999px; overflow: hidden; border: 2px solid #f43f5e; vertical-align: middle; box-shadow: 0 5px 15px rgba(244,63,94,0.4);">
                        <img src="/images/cansu/uF2GI.jpg" alt="Cansu" style="width: 100%; height: 100%; object-fit: cover; object-position: 50% 20%;">
                    </span>
                    Cansu & Teyfik - Otonom Büyüme Paneli
                </h1>
                <p style="color: #cbd5e1; font-size: 0.875rem; margin-top: 0.35rem;">Cloudflare & GitHub Actions Otomasyon Sağlık ve İzleme Merkezi</p>
            </div>
            <div style="display: flex; align-items: center; gap: 1rem;">
                <span id="live-status" style="display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.5rem 1rem; border-radius: 9999px; background: rgba(251, 191, 36, 0.2); color: #fbbf24; font-size: 0.75rem; font-weight: 500; border: 1px solid rgba(251, 191, 36, 0.4);">
                    <span style="width: 0.5rem; height: 0.5rem; border-radius: 9999px; background: currentColor;"></span> Canlı veriler yükleniyor...
                </span>
                <button onclick="lockDashboard()" style="background: rgba(15,23,42,0.8); border: 1px solid #334155; color: #cbd5e1; padding: 0.625rem 1.25rem; border-radius: 0.75rem; font-size: 0.75rem; cursor: pointer;">
                    <i class="fa-solid fa-lock" style="margin-right: 0.35rem;"></i> Kilitle
                </button>
            </div>
        </header>

        <!-- Stats Grid -->
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 1.25rem; margin-bottom: 2.5rem;">
            <div class="glass" style="border-radius: 1rem; padding: 1.5rem;">
                <p style="color: #94a3b8; font-size: 0.75rem; font-weight: 600; text-transform: uppercase; margin: 0;">Toplam Repolar</p>
                <h3 id="site-count" style="font-size: 1.875rem; font-weight: 700; margin: 0.5rem 0 0 0;">6 Site</h3>
                <p id="health-summary" style="color: #94a3b8; font-size: 0.75rem; margin: 0.5rem 0 0 0;">Canlı sağlık kontrolü bekleniyor</p>
            </div>
            <div class="glass" style="border-radius: 1rem; padding: 1.5rem;">
                <p style="color: #94a3b8; font-size: 0.75rem; font-weight: 600; text-transform: uppercase; margin: 0;">Aktif Workflow</p>
                <h3 id="workflow-summary" style="font-size: 1.875rem; font-weight: 700; margin: 0.5rem 0 0 0;">GitHub Actions</h3>
                <p id="workflow-detail" style="color: #94a3b8; font-size: 0.75rem; margin: 0.5rem 0 0 0;">Durum sorgulanıyor</p>
            </div>
            <div class="glass" style="border-radius: 1rem; padding: 1.5rem;">
                <p style="color: #94a3b8; font-size: 0.75rem; font-weight: 600; text-transform: uppercase; margin: 0;">Büyüme Motorları</p>
                <h3 style="font-size: 1.875rem; font-weight: 700; margin: 0.5rem 0 0 0;">0 Bot</h3>
                <p style="color: #94a3b8; font-size: 0.75rem; margin: 0.5rem 0 0 0;">Simülasyon botları kaldırıldı</p>
            </div>
            <div class="glass" style="border-radius: 1rem; padding: 1.5rem;">
                <p style="color: #94a3b8; font-size: 0.75rem; font-weight: 600; text-transform: uppercase; margin: 0;">Güvenlik Zırhı</p>
                <h3 style="font-size: 1.875rem; font-weight: 700; margin: 0.5rem 0 0 0;">Aktif</h3>
                <p style="color: #94a3b8; font-size: 0.75rem; margin: 0.5rem 0 0 0;">Cloudflare Analytics dashboard</p>
            </div>
        </div>

        <!-- Live Data Summary -->
        <section class="glass" style="border-radius: 1rem; padding: 1.5rem 2rem; margin-bottom: 2.5rem;">
            <div style="display:flex; justify-content:space-between; align-items:center; gap:1rem; flex-wrap:wrap; margin-bottom:1rem;">
                <div>
                    <h2 style="font-size:1.15rem; margin:0;">Canlı Site Sağlığı ve GitHub Durumu</h2>
                    <p id="data-source-note" style="color:#94a3b8; font-size:0.78rem; margin:0.4rem 0 0;">HTTP ve GitHub durumu sayfa açıldığında güncellenir; otomatik yenileme 5 dakikada bir.</p>
                </div>
                <button id="refresh-data" type="button" style="background:#1e293b; border:1px solid #475569; color:#e2e8f0; padding:0.55rem 0.9rem; border-radius:0.6rem; cursor:pointer;">Yenile</button>
            </div>
            <div id="live-summary-grid" style="display:grid; grid-template-columns:repeat(auto-fit,minmax(270px,1fr)); gap:1rem;"></div>
        </section>

        <section class="country-section" style="margin-bottom:2.5rem;">
            <div style="display:flex; justify-content:space-between; align-items:flex-start; gap:1rem; flex-wrap:wrap; margin-bottom:1rem;">
                <div>
                    <h2 style="font-size:1.15rem; margin:0;">Ülkelere Göre Trafik</h2>
                    <p style="color:#94a3b8; font-size:.78rem; margin:.4rem 0 0;">Son 24 saatteki Cloudflare istek ve trafik dağılımı. Ziyaretçi trendleri üst site kartlarında gösterilir.</p>
                </div>
                <div style="display:flex; gap:.75rem; align-items:center; flex-wrap:wrap; color:#64748b; font-size:.7rem;"><span>İlk 15 ülke · request payı</span><span style="color:#475569;">Bar uzunluğu: en yüksek ülkeye göre istek yoğunluğu</span></div>
            </div>
            <div id="country-grid" class="country-grid"></div>
        </section>

        <!-- Repositories Table -->
        <div class="glass" style="border-radius: 1rem; overflow: hidden; margin-bottom: 3rem;">
            <div style="padding: 1.5rem 2rem; border-bottom: 1px solid rgba(255,255,255,0.1); display: flex; justify-content: space-between; align-items: center;">
                <h3 style="font-weight: 700; font-size: 1.25rem; margin: 0;">Proje Otomasyon Durumları</h3>
                <span id="last-updated" style="color: #94a3b8; font-size: 0.75rem;">GitHub Actions ve HTTP kontrolleri</span>
            </div>
            <div style="overflow-x: auto;">
                <table>
                    <thead>
                        <tr>
                            <th>Proje / Varlık</th>
                            <th>Ana Otomasyonlar</th>
                            <th>Çalışma Sıklığı</th>
                            <th>Durum</th>
                            <th style="text-align: right;">Aksiyon</th>
                        </tr>
                    </thead>
                    <tbody style="font-size: 0.875rem;">
                        <tr data-site="teyfikgokdemir">
                            <td style="font-weight: 500;"><i class="fa-solid fa-globe" style="color: #38bdf8; margin-right: 0.5rem;"></i> teyfikgokdemir</td>
                            <td style="color: #cbd5e1;">Deploy, Security</td>
                            <td style="color: #94a3b8; font-size: 0.75rem;">Push & Günlük</td>
                            <td><span style="padding: 0.25rem 0.75rem; border-radius: 9999px; background: rgba(52, 211, 153, 0.2); color: #34d399; font-size: 0.75rem; border: 1px solid rgba(52, 211, 153, 0.4);">Snapshot</span></td>
