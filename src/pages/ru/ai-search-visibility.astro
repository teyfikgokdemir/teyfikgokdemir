---
import ContentPage from '../../components/ContentPage.astro';
import { site } from '../../data/site';

const title = 'Видимость в AI поиске: SEO, GEO, AEO и AIO | Тейфик Гёкдемир';
const description = 'Практическая система, помогающая бизнесу быть найденным, понятным и правильно представленным в поисковых и AI-системах.';
const pathname = '/ru/ai-search-visibility/';
const canonical = site.origin + pathname;

const faq = [
  {
    question: 'Что такое видимость в AI поиске?',
    answer: 'Это способность компании или бренда быть правильно найденными, понятыми и цитируемыми поисковыми системами, диалоговыми интерфейсами и платформами ИИ.',
  },
  {
    question: 'GEO — это то же самое, что и SEO?',
    answer: 'Нет. SEO ориентировано на классические поисковые выдачи, в то время как GEO улучшает понятность и структурированность данных для генеративных нейросетей.',
  },
  {
    question: 'Гарантирует ли файл llms.txt цитирование в AI?',
    answer: 'Нет. Файл llms.txt дает дополнительный контекст, но не гарантирует индексацию или обязательное цитирование.',
  },
];

const alternates = {
  en: site.origin + '/ai-search-visibility/',
  tr: site.origin + '/yapay-zeka-arama-gorunurlugu/',
  ru: site.origin + '/ru/ai-search-visibility/',
  sq: site.origin + '/sq/dukshmeria-ne-kerkimin-ai/',
  mk: site.origin + '/mk/vidlivost-vo-ai-prebaruvanje/',
  sr: site.origin + '/sr/vidljivost-u-ai-pretrazi/',
  fa: site.origin + '/fa/مشاهده-پذیری-در-جستجوی-هوش-مصنوعی/',
  zh: site.origin + '/zh/ai-search-visibility/',
  vi: site.origin + '/vi/ai-search-visibility/',
  'x-default': site.origin + '/ai-search-visibility/',
};

const pageSchema = {
  '@type': ['WebPage', 'FAQPage'],
  '@id': canonical + '#webpage',
  url: canonical,
  name: title,
  description,
  inLanguage: 'ru',
  isPartOf: { '@id': site.origin + '/#website' },
  mainEntity: faq.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: item.answer },
  })),
};
---

<ContentPage
  locale="ru"
  title={title}
  description={description}
  eyebrow="Видимость в AI поиске"
  heading="Сделайте ваш бизнес видимым и понятным для алгоритмов ИИ"
  lead="Оптимизация для генеративных моделей (GEO), диалоговых систем (AEO) и классических поисковиков (SEO) в единой коммерческой стратегии."
  pathname={pathname}
  alternates={alternates}
  faq={faq}
  pageSchema={pageSchema}
>
  <div class="answer-block">
    <p><strong>Видимость в AI-поиске</strong> — это не один файл и не отдельный технический трюк. Это система, в которой техническая доступность, ясное описание компании, полезный контент и проверяемые доказательства помогают поисковым и AI-системам корректно находить и понимать бизнес.</p>
  </div>

  <h2>Что входит в систему?</h2>
  <div class="content-grid">
    <article class="content-card"><h3>Техническая доступность</h3><p>Canonical URL, правила сканирования, sitemap, hreflang, производительность и структурированные данные.</p></article>
    <article class="content-card"><h3>Ясность сущности и бренда</h3><p>Последовательное описание компании, экспертизы, проектов, профилей и связей между брендами.</p></article>
    <article class="content-card"><h3>Контент, отвечающий на вопросы</h3><p>Прямые ответы, понятные определения, полезные FAQ и логичная информационная архитектура.</p></article>
    <article class="content-card"><h3>Доказательства и источники</h3><p>Подтверждение заявлений реальными проектами, результатами, публичными профилями и надежными внешними источниками.</p></article>
  </div>

  <h2>SEO, GEO, AEO и AIO работают вместе</h2>
  <p><strong>SEO</strong> создает основу для классического поиска. <strong>GEO</strong> улучшает понятность и цитируемость информации в генеративных системах. <strong>AEO</strong> структурирует контент вокруг прямых ответов. <strong>AIO</strong> объединяет сайт, данные о сущностях и контент в единую систему AI-видимости.</p>

  <h2>Как строится работа</h2>
  <ol>
    <li><strong>Аудит обнаружения:</strong> проверяются сканирование, canonical, индексация, языковая архитектура и технические конфликты.</li>
    <li><strong>Описание сущности:</strong> фиксируется, кто вы, чем занимаетесь, где работаете и как связаны ваши бренды.</li>
    <li><strong>Коммерческие вопросы:</strong> определяются запросы, которые задают потенциальные клиенты и исследовательские системы.</li>
    <li><strong>Источник знаний:</strong> создаются глубокие и сфокусированные страницы с проверяемыми фактами.</li>
    <li><strong>Структурированные данные:</strong> размечается только то, что действительно видно и подтверждается на странице.</li>
    <li><strong>Сеть доказательств:</strong> экспертиза связывается с проектами, результатами, профилями и внешними упоминаниями.</li>
    <li><strong>Измерение:</strong> отслеживаются показы, брендовые запросы, переходы и наблюдаемые цитирования.</li>
  </ol>

  <h2>Чего эта работа не гарантирует?</h2>
  <p>Нельзя гарантировать, что ChatGPT, Google, Perplexity, Claude или любая другая система процитирует конкретную страницу. Цель — убрать технические барьеры, повысить ясность и создать более надежные источники.</p>

  <h2>Часто задаваемые вопросы</h2>
  <div class="faq-list">{faq.map((item) => (<details><summary>{item.question}</summary><p>{item.answer}</p></details>))}</div>
</ContentPage>
