---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PersonalHomePage from '../../components/PersonalHomePage.astro';
import { content } from '../../i18n/content';
import type { Locale } from '../../i18n/locales';
const locale = 'ru' as Locale;
const copy = content[locale] || content.en;
const title = 'Teyfik Gökdemir | Технологии, цифровая коммерция и глобальные операции';
const description = 'Персональный центр Teyfik Gökdemir: технологии, e-commerce, системы роста, цифровые активы и международные торговые операции.';
---
<BaseLayout locale={locale} copy={copy} title={title} description={description}>
  <PersonalHomePage locale={locale} />
</BaseLayout>
