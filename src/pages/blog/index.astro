---
import ContentPage from '../../components/ContentPage.astro';
import { site } from '../../data/site';

const title = 'Insights on Digital Commerce, SEO and AI Systems | Teyfik Gökdemir';
const description = 'Practical articles on digital commerce, SEO, GEO, AEO, AI-assisted operations and commercial systems.';
const pathname = '/blog/';
const canonical = site.origin + pathname;

const pageSchema = {
  '@type': 'CollectionPage',
  '@id': canonical + '#webpage',
  url: canonical,
  name: title,
  description,
  inLanguage: 'en',
  isPartOf: { '@id': site.origin + '/#website' },
};

const alternates = {
  en: canonical,
  tr: site.origin + '/tr/blog/',
  'x-default': canonical,
};
---
<ContentPage
  locale="en"
  title={title}
  description={description}
  pathname={pathname}
  alternates={alternates}
  pageSchema={pageSchema}
  eyebrow="Insights"
  heading="Practical thinking for connected commercial systems."
  lead="Long-form guides connecting digital commerce, search visibility, operations and AI-assisted execution."
>
  <article class="content-card">
    <p class="section-label">Search visibility</p>
    <h2><a href="/blog/seo-vs-geo-vs-aeo-vs-aio/">SEO vs GEO vs AEO vs AIO: What each discipline actually does</a></h2>
    <p>A practical framework for understanding where traditional search optimisation ends, where AI visibility begins and how the disciplines should work together.</p>
    <p><a href="/blog/seo-vs-geo-vs-aeo-vs-aio/">Read the guide →</a></p>
  </article>

  <section class="content-cta">
    <h2>Need a structured visibility system?</h2>
    <p>Review the <a href="/ai-search-visibility/">AI Search Visibility service page</a> or contact <a href={`mailto:${site.email}`}>{site.email}</a>.</p>
  </section>
</ContentPage>