---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PersonalHomePage from '../../components/PersonalHomePage.astro';
import PersonalHomePolish from '../../components/PersonalHomePolish.astro';
import Footer from '../../components/Footer.astro';
import { content } from '../../i18n/content';
import type { Locale } from '../../i18n/locales';
const locale = 'sq' as Locale;
const copy = content[locale] || content.en;
const title = 'Teyfik Gökdemir | Teknologji, tregti digjitale dhe operacione globale';
const description = 'Qendra personale e Teyfik Gökdemir për teknologji, e-commerce, sisteme rritjeje, asete digjitale dhe operacione tregtare ndërkombëtare.';
---
<BaseLayout locale={locale} copy={copy} title={title} description={description}>
  <PersonalHomePage locale={locale} />
  <PersonalHomePolish />
  <Footer copy={copy} locale={locale} />
</BaseLayout>
