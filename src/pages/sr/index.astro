---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PersonalHomePage from '../../components/PersonalHomePage.astro';
import PersonalHomePolish from '../../components/PersonalHomePolish.astro';
import { content } from '../../i18n/content';
import type { Locale } from '../../i18n/locales';
const locale = 'sr' as Locale;
const copy = content[locale] || content.en;
const title = 'Teyfik Gökdemir | Tehnologija, digitalna trgovina i globalne operacije';
const description = 'Lični centar Teyfik Gökdemir za tehnologiju, e-trgovinu, sisteme rasta, digitalnu imovinu i međunarodne komercijalne operacije.';
---
<BaseLayout locale={locale} copy={copy} title={title} description={description}>
  <PersonalHomePage locale={locale} />
  <PersonalHomePolish />
</BaseLayout>
