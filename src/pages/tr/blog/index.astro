---
import ContentPage from '../../../components/ContentPage.astro';
import { site } from '../../../data/site';

const title = 'Dijital Ticaret, SEO ve Yapay Zekâ Sistemleri | Teyfik Gökdemir';
const description = 'Dijital ticaret, SEO, GEO, AEO, yapay zekâ destekli operasyon ve ticari sistemler hakkında uygulamaya dönük içerikler.';
const pathname = '/tr/blog/';
const canonical = site.origin + pathname;

const pageSchema = {
  '@type': 'CollectionPage',
  '@id': canonical + '#webpage',
  url: canonical,
  name: title,
  description,
  inLanguage: 'tr',
  isPartOf: { '@id': site.origin + '/#website' },
};

const alternates = {
  en: site.origin + '/blog/',
  tr: site.origin + '/tr/blog/',
  sq: site.origin + '/sq/blog/',
  mk: site.origin + '/mk/blog/',
  sr: site.origin + '/sr/blog/',
  'x-default': site.origin + '/blog/',
};
---
<ContentPage
  locale="tr"
  title={title}
  description={description}
  pathname={pathname}
  alternates={alternates}
  pageSchema={pageSchema}
  eyebrow="İçgörüler"
  heading="Bağlantılı ticari sistemler için uygulamaya dönük içerikler."
  lead="Dijital ticaret, arama görünürlüğü, operasyon ve yapay zekâ destekli iş süreçlerini bir araya getiren kapsamlı rehberler."
>
  <article class="content-card">
    <p class="section-label">Arama görünürlüğü</p>
    <h2><a href="/tr/blog/seo-geo-aeo-aio-farklari/">SEO, GEO, AEO ve AIO arasındaki farklar</a></h2>
    <p>Klasik arama optimizasyonunun nerede bittiğini, yapay zekâ görünürlüğünün nerede başladığını ve bu disiplinlerin nasıl birlikte çalışması gerektiğini açıklayan uygulamalı rehber.</p>
    <p><a href="/tr/blog/seo-geo-aeo-aio-farklari/">Rehberi oku →</a></p>
  </article>

  <section class="content-cta">
    <h2>Görünürlük sisteminizi yapılandırmak mı istiyorsunuz?</h2>
    <p><a href="/tr/yapay-zeka-arama-gorunurlugu/">Yapay Zekâ Arama Görünürlüğü sayfasını</a> inceleyebilir veya <a href={`mailto:${site.email}`}>{site.email}</a> adresinden iletişime geçebilirsiniz.</p>
  </section>
</ContentPage>