---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PersonalHomePage from '../../components/PersonalHomePage.astro';
import { content } from '../../i18n/content';
const locale = 'fa';
const copy = content.fa;
const title = 'Teyfik Gökdemir | فناوری، تجارت دیجیتال و عملیات جهانی';
const description = 'مرکز شخصی Teyfik Gökdemir برای فناوری، تجارت الکترونیک، سیستم‌های رشد، دارایی‌های دیجیتال و عملیات تجارت بین‌المللی.';
---
<BaseLayout locale={locale} copy={copy} title={title} description={description}>
  <PersonalHomePage locale={locale} />
</BaseLayout>
