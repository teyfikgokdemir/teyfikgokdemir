    { '@type': 'WebSite', '@id': 'https://teyfikgokdemir.com/#website', name: 'Teyfik Gökdemir', url: 'https://teyfikgokdemir.com/', author: { '@id': 'https://teyfikgokdemir.com/#person' } },
    { '@type': 'WebPage', '@id': 'https://teyfikgokdemir.com/fa/#webpage', url: 'https://teyfikgokdemir.com/fa/', name: 'تیفیک گوکدمیر | بنیان‌گذار CTSEG، تجارت بین‌المللی و تأمین راهبردی', description: 'هویت حرفه‌ای بنیان‌گذار CTSEG و رویکرد او به تجارت بین‌المللی و تأمین راهبردی.', inLanguage: 'fa', isPartOf: { '@id': 'https://teyfikgokdemir.com/#website' }, about: { '@id': 'https://teyfikgokdemir.com/#person' } },
