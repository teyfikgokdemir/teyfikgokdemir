---
const email = 'info@teyfikgokdemir.com';
const ventures = [
  { name: 'QCT Commerce', region: 'ترکیه', href: 'https://qctcommerce.com', text: 'توسعه ساختارهای تجارت دیجیتال، فروش مستقیم و سیستم‌های مقیاس‌پذیر برای تولیدکنندگان، عمده‌فروشان و کسب‌وکارها.' },
  { name: 'QCT Studio', region: 'بالکان', href: 'https://qctstudio.com', text: 'راهکارهای چندزبانه وب، تجارت الکترونیک، دیده‌شدن در جست‌وجو و اتوماسیون برای کسب‌وکارهای منطقه بالکان.' },
  { name: 'Mythborn', region: 'بین‌المللی', href: 'https://mythborn.co', text: 'یک برند و اکوسیستم محصول و تجارت بین‌المللی که در حال توسعه است.' },
];
const expertise = [
  { title: 'تجارت بین‌المللی', items: ['فرصت‌های واردات و صادرات', 'تطبیق محصول و بازار', 'هماهنگی تولیدکننده و خریدار', 'تهیه پیشنهاد تجاری', 'توسعه همکاری‌های فرامرزی'] },
  { title: 'تأمین و عملیات', items: ['شناسایی تولیدکننده و تأمین‌کننده', 'بررسی قیمت و ظرفیت', 'مشخصات فنی محصول', 'هماهنگی مدارک و کیفیت', 'برنامه‌ریزی حمل‌ونقل و زنجیره تأمین'] },
  { title: 'تجارت دیجیتال و رشد', items: ['تجارت دیجیتال B2B', 'استراتژی تجارت الکترونیک', 'کانال‌های فروش مستقیم', 'عملیات بازارگاه‌ها', 'دیده‌شدن و رشد دیجیتال'] },
  { title: 'هوش مصنوعی و سیستم‌ها', items: ['پژوهش تأمین‌کنندگان', 'هوشمندی فروش', 'تحلیل فرصت و شرکت', 'اتوماسیون فرایندها', 'استانداردسازی عملیات'] },
];
---
<!doctype html>
<html lang="fa" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>تیفیک گوکدمیر | تجارت بین‌المللی، تأمین و توسعه کسب‌وکار</title>
  <meta name="description" content="تیفیک گوکدمیر در زمینه تجارت بین‌المللی، تأمین راهبردی، توسعه کسب‌وکار، تجارت دیجیتال و سیستم‌های عملیاتی فعالیت می‌کند." />
  <meta name="robots" content="index,follow" />
  <link rel="canonical" href="https://teyfikgokdemir.com/fa/" />
  <link rel="alternate" hreflang="fa" href="https://teyfikgokdemir.com/fa/" />
  <link rel="alternate" hreflang="tr" href="https://teyfikgokdemir.com/tr/" />
  <link rel="alternate" hreflang="en" href="https://teyfikgokdemir.com/" />
  <link rel="alternate" hreflang="x-default" href="https://teyfikgokdemir.com/" />
  <link rel="icon" href="/favicon-32x32.png?v=7" type="image/png" sizes="32x32" />
</head>
<body>
  <header>
    <a class="brand" href="/fa/"><img src="/images/teyfik-gokdemir-tg-logo-transparent.png?v=7" alt="" /><strong>Teyfik Gökdemir</strong></a>
    <nav aria-label="ناوبری اصلی">
      <a href="#focus">حوزه‌های فعالیت</a><a href="#ventures">کسب‌وکارها</a><a href="#contact">تماس</a>
    </nav>
    <div class="langs"><a href="/tr/">TR</a><a href="/">EN</a><a class="active" href="/fa/" aria-current="page">FA</a></div>
  </header>
  <main>
    <section class="hero shell">
      <div>
        <p class="label">مستقر در ترکیه · تجارت فرامرزی · بازارهای بین‌المللی</p>
        <h1>تجارت بین‌المللی، تأمین و توسعه کسب‌وکار را به سیستم‌های اجرایی تبدیل می‌کنم.</h1>
        <p class="lead">تولیدکننده، محصول، بازار و عملیات را به یکدیگر متصل می‌کنم و فرایند تجاری را از تأمین و لجستیک تا کانال فروش و زیرساخت دیجیتال، به‌صورت یکپارچه طراحی می‌کنم.</p>
        <div class="actions"><a class="primary" href="#focus">مشاهده حوزه‌های فعالیت</a><a href="#contact">تماس مستقیم</a></div>
        <p class="summary">تیفیک گوکدمیر، کارآفرین مستقر در ترکیه است که در حوزه تجارت بین‌المللی، تأمین راهبردی، توسعه کسب‌وکار، تجارت دیجیتال و سیستم‌های عملیاتی فعالیت می‌کند.</p>
      </div>
      <img class="portrait" src="/images/teyfik-gokdemir.webp" alt="پرتره تیفیک گوکدمیر" />
    </section>

    <section class="section" id="focus"><div class="shell"><p class="label">رویکرد تجاری</p><h2>یافتن فرصت فقط آغاز کار است؛ آن را به یک ساختار تجاری قابل اجرا تبدیل می‌کنم.</h2><p class="lead">پژوهش تأمین‌کننده، بررسی محصول و قیمت، هماهنگی خریدار و فروشنده، آمادگی صادرات، لجستیک، کانال‌های فروش و زیرساخت دیجیتال به‌عنوان یک سیستم واحد مدیریت می‌شوند.</p><div class="grid">{expertise.map(group => <article><h3>{group.title}</h3><ul>{group.items.map(item => <li>{item}</li>)}</ul></article>)}</div></div></section>

    <section class="section" id="ventures"><div class="shell"><p class="label">کسب‌وکارها و سیستم‌ها</p><h2>فعالیت‌های مرتبط برای بازارهای مختلف.</h2><div class="ventures">{ventures.map(v => <a href={v.href} target="_blank" rel="noopener noreferrer"><span>{v.region}</span><h3>{v.name}</h3><p>{v.text}</p><b>↗</b></a>)}</div></div></section>

    <section class="section"><div class="shell split"><div><p class="label">نگاه فرامرزی</p><h2>ایجاد ارتباطات تجاری میان ترکیه، ایران، بالکان و بازارهای منطقه.</h2><p class="lead">توان تولید و تأمین ترکیه را با تقاضای منطقه‌ای پیوند می‌دهم و فرصت‌های محصول و همکاری در بازارهای پیرامونی را به ترکیه متصل می‌کنم. هر فرصت با توجه به محصول، طرف‌های معامله، الزامات قانونی، پرداخت و لجستیک بررسی می‌شود.</p></div><div class="note"><h3>زمینه‌های همکاری</h3><p>خرید و فروش بین‌المللی، یافتن تولیدکننده یا تأمین‌کننده، توسعه بازار، همکاری تجاری و ایجاد ساختارهای فروش دیجیتال.</p></div></div></section>

    <section class="section" id="contact"><div class="shell contact"><p class="label">برای همکاری تجاری</p><h2>بیایید یک محصول، بازار یا فرصت تأمین را بررسی کنیم.</h2><p class="lead">برای فرصت‌های واردات و صادرات، تأمین کالا، توسعه بازار یا همکاری تجاری می‌توانید مستقیماً تماس بگیرید.</p><a class="primary" href={`mailto:${email}`}>{email}</a></div></section>
  </main>
  <footer><span>© 2026 Teyfik Gökdemir</span><div><a href="/privacy-policy/">حریم خصوصی</a><a href="/terms/">شرایط استفاده</a></div></footer>
</body>
</html>
<style>
:root{color-scheme:dark;--bg:#09111d;--deep:#070d16;--panel:#101c2b;--text:#f4f1e9;--muted:#aab7c9;--accent:#f2aa8f;--line:#26374d;--max:1180px}*{box-sizing:border-box}html{scroll-behavior:smooth;background:var(--bg)}body{margin:0;background:radial-gradient(circle at 20% 4%,rgba(35,67,103,.34),transparent 30rem),linear-gradient(180deg,var(--bg),var(--deep) 58%,var(--bg));color:var(--text);font-family:Tahoma,"Segoe UI",Arial,sans-serif;line-height:1.8}a{color:inherit;text-decoration:none}.shell{width:min(var(--max),calc(100% - 3rem));margin-inline:auto}header{position:sticky;top:0;z-index:10;min-height:76px;display:flex;align-items:center;gap:1.25rem;padding:.7rem max(1.25rem,calc((100vw - var(--max))/2));border-bottom:1px solid var(--line);background:rgba(9,17,29,.92);backdrop-filter:blur(18px)}.brand{margin-left:auto;display:flex;align-items:center;gap:.7rem;direction:ltr}.brand img{width:54px;height:54px;object-fit:contain}.brand strong{font:700 .95rem/1.2 Arial,sans-serif;letter-spacing:.1em;text-transform:uppercase}nav{display:flex;gap:1.2rem}nav a,.langs a{min-height:42px;display:inline-flex;align-items:center;color:var(--muted);font-size:.88rem}.langs{display:flex;border:1px solid var(--line);border-radius:999px;padding:.15rem;direction:ltr}.langs a{justify-content:center;min-width:40px;border-radius:50%;font:800 .72rem Arial}.langs .active{background:var(--text);color:var(--bg)}.hero{min-height:calc(100svh - 76px);display:grid;grid-template-columns:1.15fr .85fr;align-items:center;gap:clamp(2rem,5vw,5rem);padding-block:4rem}.portrait{width:100%;max-height:720px;object-fit:cover;border:1px solid var(--line);border-radius:24px}.label{margin:0 0 1rem;color:var(--accent);font-size:.78rem;font-weight:800;letter-spacing:.04em}h1,h2,h3{margin-top:0;text-wrap:balance}h1{font-size:clamp(2.7rem,6vw,5.8rem);line-height:1.08;letter-spacing:-.035em;margin-bottom:1.5rem}h2{font-size:clamp(2.1rem,4.5vw,4.5rem);line-height:1.15;letter-spacing:-.025em;margin-bottom:1.25rem}.lead{max-width:800px;color:var(--muted);font-size:clamp(1rem,1.5vw,1.22rem)}.summary{max-width:760px;color:var(--muted);font-size:.9rem}.actions{display:flex;flex-wrap:wrap;gap:.8rem;margin:2rem 0}.actions a,.primary{min-height:48px;display:inline-flex;align-items:center;padding:.75rem 1.15rem;border:1px solid var(--line);border-radius:999px}.primary{background:var(--text);color:var(--bg);font-weight:800}.section{padding:clamp(4rem,7vw,7rem) 0;border-top:1px solid var(--line)}.grid{display:grid;grid-template-columns:repeat(4,1fr);gap:1rem;margin-top:2.5rem}.grid article,.note{padding:1.5rem;border:1px solid var(--line);border-radius:20px;background:var(--panel)}h3{font-size:1.25rem}ul{margin:0;padding-right:1.2rem;color:var(--muted)}.ventures{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem;margin-top:2.5rem}.ventures a{position:relative;min-height:270px;padding:1.6rem;border:1px solid var(--line);border-radius:20px;background:var(--panel)}.ventures span{color:var(--accent);font-size:.78rem}.ventures p{color:var(--muted)}.ventures b{position:absolute;left:1.5rem;bottom:1.2rem}.split{display:grid;grid-template-columns:1.35fr .65fr;gap:2rem;align-items:start}.contact{text-align:center}.contact .lead{margin-inline:auto;margin-bottom:2rem}footer{display:flex;justify-content:space-between;gap:1rem;padding:2rem max(1.5rem,calc((100vw - var(--max))/2));border-top:1px solid var(--line);color:var(--muted)}footer div{display:flex;gap:1rem}@media(max-width:900px){header nav{display:none}.hero,.split{grid-template-columns:1fr}.portrait{max-height:560px}.grid{grid-template-columns:repeat(2,1fr)}.ventures{grid-template-columns:1fr}}@media(max-width:560px){.shell{width:min(100% - 2rem,var(--max))}.brand strong{display:none}.grid{grid-template-columns:1fr}h1{font-size:2.45rem}footer{flex-direction:column}.langs a{min-width:36px}}
</style>