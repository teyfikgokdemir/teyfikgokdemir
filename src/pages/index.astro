---
import BaseLayout from '../layouts/BaseLayout.astro';
import FounderPage from '../components/FounderPage.astro';
import { content } from '../i18n/content';

const locale = 'tr';
const copy = content.tr;
const title = 'Teyfik Gökdemir | Uluslararası Ticaret, Stratejik Tedarik ve CTSEG';
const description = 'CTSEG kurucusu Teyfik Gökdemir; stratejik tedarik, tedarikçi doğrulama ve uluslararası ticari operasyonlar için kanıta dayalı sistemler kurar.';
---
<BaseLayout locale={locale} copy={copy} title={title} description={description} pathname="/">
  <FounderPage locale={locale} />
</BaseLayout>
