---
import BaseLayout from '../layouts/BaseLayout.astro';
import PersonalHomePage from '../components/PersonalHomePage.astro';
import PersonalHomePolish from '../components/PersonalHomePolish.astro';
import { content } from '../i18n/content';

const locale = 'tr';
const copy = content.tr;
const title = 'Teyfik Gökdemir | Teknoloji, Dijital Ticaret ve Küresel Operasyonlar';
const description = 'Teyfik Gökdemir’in teknoloji, e-ticaret, büyüme sistemleri ve uluslararası ticaret alanındaki şirket, ürün ve operasyonlarını bir araya getiren kişisel merkezi.';
---
<BaseLayout locale={locale} copy={copy} title={title} description={description} pathname="/">
  <PersonalHomePage locale={locale} />
  <PersonalHomePolish />
</BaseLayout>
