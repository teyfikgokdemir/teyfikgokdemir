---
import BaseLayout from '../layouts/BaseLayout.astro';
import FounderPage from '../components/FounderPage.astro';
import { content } from '../i18n/content';
import { faqSchema } from '../data/homeFaq';

const locale = 'tr';
const copy = content.tr;
const title = 'Teyfik Gökdemir | Uluslararası Ticaret, Stratejik Tedarik ve CTSEG';
const description = 'Teyfik Gökdemir’in kurucu ve uzmanlık hub’ı. Uluslararası ticaret, stratejik tedarik, RFQ ve ticari operasyonlar CTSEG üzerinden yürütülür.';
const pageSchema = faqSchema(locale);
---
<BaseLayout locale={locale} copy={copy} title={title} description={description} pathname="/" pageSchema={pageSchema}>
  <FounderPage locale={locale} />
</BaseLayout>
