---
import BaseLayout from '../layouts/BaseLayout.astro';
import FounderPage from '../components/FounderPage.astro';
import { content } from '../i18n/content';

const locale = 'tr';
const copy = content.tr;
const title = 'Teyfik Gökdemir — Uluslararası Ticaret ve Stratejik Tedarik';
const description = 'Uluslararası ticaret, stratejik tedarik, iş geliştirme ve AI destekli ticari operasyonlar için uçtan uca sistemler.';
---
<BaseLayout locale={locale} copy={copy} title={title} description={description}>
  <FounderPage locale={locale} />
</BaseLayout>
