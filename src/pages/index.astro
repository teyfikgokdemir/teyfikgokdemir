---
import BaseLayout from '../layouts/BaseLayout.astro';
import PersonalHomePage from '../components/PersonalHomePage.astro';
import PersonalHomePolish from '../components/PersonalHomePolish.astro';
import Footer from '../components/Footer.astro';
import { content } from '../i18n/content';

const locale = 'tr';
const copy = content.tr;
const title = 'Teyfik Gökdemir | Teknoloji, Dijital Ticaret ve Küresel Operasyonlar';
const description = 'Teyfik Gökdemir’in teknoloji, e-ticaret, büyüme sistemleri ve uluslararası ticaret alanındaki şirket, ürün ve operasyonlarını bir araya getiren kişisel merkezi.';
---
<BaseLayout locale={locale} copy={copy} title={title} description={description} pathname="/">
  <PersonalHomePage locale={locale} />
  <PersonalHomePolish />
  <Footer copy={copy} locale={locale} />
  <style is:global>
    .personal-home .hero-media,
    .personal-home .portrait-shell {
      background: transparent !important;
      border: 0 !important;
      outline: 0 !important;
      box-shadow: none !important;
      filter: none !important;
    }

    .personal-home .hero-media::before,
    .personal-home .hero-media::after,
    .personal-home .portrait-shell::before,
    .personal-home .portrait-shell::after {
      content: none !important;
      display: none !important;
      background: none !important;
      border: 0 !important;
      box-shadow: none !important;
    }

    .personal-home .portrait-shell img {
      box-shadow: none !important;
      filter: none !important;
    }
  </style>
</BaseLayout>
