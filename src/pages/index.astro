<style>
:root{--bg:#0b1019;--panel:#121a27;--text:#f4f1e9;--muted:#aab2c0;--accent:#df624f;--line:#273144}*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:radial-gradient(circle at 80% 10%,#19263b 0,transparent 32%),var(--bg);color:var(--text);font-family:Inter,ui-sans-serif,system-ui,-apple-system,Segoe UI,sans-serif}a{color:inherit;text-decoration:none}header{height:74px;display:flex;align-items:center;justify-content:space-between;padding:0 5vw;border-bottom:1px solid var(--line);position:sticky;top:0;background:rgba(11,16,25,.86);backdrop-filter:blur(18px);z-index:10}.brand{font-size:13px;letter-spacing:.12em;font-weight:800;display:flex;align-items:center;gap:12px}.brand span{display:grid;place-items:center;width:36px;height:36px;border:1px solid var(--accent);color:var(--accent);border-radius:50%}nav{display:flex;gap:28px;font-size:14px;color:var(--muted)}nav a:hover{color:var(--text)}select{background:var(--panel);color:var(--text);border:1px solid var(--line);padding:9px 12px;border-radius:8px}.shell{width:min(1180px,90vw);margin:auto}.hero{min-height:calc(100vh - 74px);display:grid;grid-template-columns:1.15fr .85fr;align-items:center;gap:8vw;padding:80px 0}.eyebrow{color:var(--accent);font-size:12px;font-weight:800;letter-spacing:.18em;text-transform:uppercase}.hero h1{font-size:clamp(48px,6.7vw,96px);line-height:.94;letter-spacing:-.065em;margin:20px 0 30px}.hero h1 span,.hero h1 strong{display:block}.hero h1 strong{color:var(--accent);font-weight:700}.lead{font-size:clamp(18px,2vw,25px);line-height:1.5;color:#d5d9e0;max-width:760px}.actions{display:flex;gap:12px;flex-wrap:wrap;margin-top:34px}.btn{border:1px solid var(--line);padding:14px 20px;border-radius:999px;font-weight:700}.primary{background:var(--accent);border-color:var(--accent);color:white}.meta{margin-top:36px;color:var(--muted);font-size:13px}.portrait-wrap{position:relative;min-height:570px;display:flex;align-items:flex-end;justify-content:center}.portrait-glow{position:absolute;inset:12% 2% 0;background:linear-gradient(145deg,#263753,#101722);border-radius:240px 240px 28px 28px;border:1px solid #30405a}.portrait-wrap img{position:relative;width:min(100%,420px);max-height:560px;object-fit:cover;object-position:top;border-radius:220px 220px 24px 24px;filter:saturate(.8) contrast(1.05)}.portrait-card{position:absolute;left:-18px;bottom:55px;background:rgba(18,26,39,.93);border:1px solid var(--line);padding:18px 20px;width:230px;border-radius:14px;box-shadow:0 20px 50px #0008}.portrait-card small{display:block;color:var(--accent);letter-spacing:.15em;margin-bottom:8px}.section{padding:120px 0;border-top:1px solid var(--line)}.grid2{display:grid;grid-template-columns:1fr 1fr;gap:9vw}.section h2,.contact h2{font-size:clamp(38px,5vw,68px);line-height:1.04;letter-spacing:-.045em;margin:16px 0}.copy{font-size:20px;line-height:1.7;color:#c9ced7}.cards{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin-top:50px}.cards article,.ventures a{background:linear-gradient(145deg,#151f2e,#0f1621);border:1px solid var(--line);border-radius:18px;padding:28px;transition:.25s}.cards article:hover,.ventures a:hover{transform:translateY(-5px);border-color:#46556f}.cards span,.ventures small{color:var(--accent);font-size:12px;letter-spacing:.15em}.cards h3,.ventures h3{font-size:23px;margin:30px 0 12px}.cards p,.ventures p{color:var(--muted);line-height:1.6}.ventures{display:grid;grid-template-columns:1fr 1fr;gap:18px;margin-top:44px}.ventures a{min-height:300px;display:flex;flex-direction:column}.ventures h3{font-size:38px}.ventures b{margin-top:auto}.contact{padding:130px 5vw;margin-top:30px;background:linear-gradient(120deg,#131d2c,#0d131d);border-top:1px solid var(--line);text-align:center}.contact p{max-width:720px;margin:20px auto;color:var(--muted);font-size:19px}.contact .actions{justify-content:center}footer{display:flex;justify-content:space-between;padding:28px 5vw;color:var(--muted);font-size:13px;border-top:1px solid var(--line)}@