---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FounderPage from '../../components/FounderPage.astro';
import { content } from '../../i18n/content';

const locale = 'en';
const copy = content.en;
const title = 'Teyfik Gökdemir — Digital Commerce & Growth Operator';
const description = 'Building digital commerce, growth, operations and AI-assisted business systems across Türkiye, the Balkans and international markets.';
---
<BaseLayout locale={locale} copy={copy} title={title} description={description} pathname="/en/">
  <FounderPage locale={locale} />
</BaseLayout>
