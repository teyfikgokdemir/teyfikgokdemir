import Header from './Header.astro';
import FloatingActions from './FloatingActions.astro';
import type { Locale } from '../i18n/locales';
import { content } from '../i18n/content';
import { site } from '../data/site';
import {
  posts,
  blogPath,
  postPath,
  legacySeoArticle,
  postSupportsLocale,
  localizedPostValue,
  localeMeta,
  type BlogLocale,
} from '../data/blog';

interface Props { locale: Locale | 'fa'; }
const { locale } = Astro.props;
const copy = content[locale as Locale] ?? content.en;
const blogLoc = (locale in localeMeta ? locale : 'en') as BlogLocale;
const blogMeta = localeMeta[blogLoc];
const blogIndexUrl = blogPath(blogLoc);
const legacyArticle = legacySeoArticle[blogLoc];

const featuredArticles = [
  ...(legacyArticle
    ? [{
        href: legacyArticle.path,
        title: legacyArticle.title,
        description: legacyArticle.description,
        tag: 'SEO · GEO · AEO · AIO',
      }]
    : []),
  ...posts
    .filter((item) => postSupportsLocale(item, blogLoc))
    .slice(0, 3)
    .map((item) => ({
      href: postPath(blogLoc, item.slug, item),
      title: localizedPostValue(item.title, blogLoc) ?? '',
      description: localizedPostValue(item.description, blogLoc) ?? '',
      tag: blogMeta.blog,
    })),
].slice(0, 4);

type IntentItem = { label: string; title: string; text: string; action: string; href: string };
type CoreProof = { roleLabel: string; outputLabel: string; studioRole: string; studioOut: string; commerceRole: string; commerceOut: string; ctsegRole: string; ctsegOut: string };
