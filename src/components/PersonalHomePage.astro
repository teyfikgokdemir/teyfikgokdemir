const ui = t[locale] ?? t.en;
const marqueeItems: Record<string, string[]> = {
  tr: ['TEKNOLOJİ & DİJİTAL ÜRÜNLER', 'E-TİCARET & BÜYÜME', 'KÜRESEL TİCARET & STRATEJİK TEDARİK', 'YAPAY ZEKA & OTOMASYON', 'BÜYÜME İSTİHBARATI'],
  en: ['TECHNOLOGY & DIGITAL PRODUCTS', 'E-COMMERCE & GROWTH', 'GLOBAL TRADE & STRATEGIC SOURCING', 'AI & AUTOMATION', 'GROWTH INTELLIGENCE'],
  ru: ['ТЕХНОЛОГИИ И ЦИФРОВЫЕ ПРОДУКТЫ', 'E-COMMERCE И РОСТ', 'МЕЖДУНАРОДНАЯ ТОРГОВЛЯ И СТРАТЕГИЧЕСКИЙ СОРСИНГ', 'ИИ И АВТОМАТИЗАЦИЯ', 'АНАЛИТИКА РОСТА'],
  mk: ['ТЕХНОЛОГИЈА И ДИГИТАЛНИ ПРОИЗВОДИ', 'Е-ТРГОВИЈА И РАСТ', 'ГЛОБАЛНА ТРГОВИЈА И СТРАТЕШКО СНАБДУВАЊЕ', 'ВЕШТАЧКА ИНТЕЛИГЕНЦИЈА И АВТОМАТИЗАЦИЈА', 'АНАЛИТИКА НА РАСТ'],
  sr: ['TEHNOLOGIJA I DIGITALNI PROIZVODI', 'E-TRGOVINA I RAST', 'GLOBALNA TRGOVINA I STRATEŠKI SOURCING', 'AI I AUTOMATIZACIJA', 'ANALITIKA RASTA'],
  sq: ['TEKNOLOGJI DHE PRODUKTE DIGJITALE', 'E-COMMERCE DHE RRITJE', 'TREGTI GLOBALE DHE SOURCING STRATEGJIK', 'AI DHE AUTOMATIZIM', 'ANALITIKË RRITJEJE'],
  fa: ['فناوری و محصولات دیجیتال', 'تجارت الکترونیک و رشد', 'تجارت جهانی و تأمین راهبردی', 'هوش مصنوعی و اتوماسیون', 'هوشمندی رشد'],
  zh: ['技术与数字产品', '电商与增长', '全球贸易与战略采购', '人工智能与自动化', '增长洞察'],
  vi: ['CÔNG NGHỆ & SẢN PHẨM SỐ', 'THƯƠNG MẠI ĐIỆN TỬ & TĂNG TRƯỞNG', 'THƯƠNG MẠI TOÀN CẦU & SOURCING CHIẾN LƯỢC', 'AI & TỰ ĐỘNG HÓA', 'PHÂN TÍCH TĂNG TRƯỞNG'],
};
const activeMarquee = marqueeItems[locale] ?? marqueeItems.en;
const homePath = locale === 'tr' ? '/' : `/${locale}/`;
const emailHref = `mailto:${site.email}`;
const whatsappHref = `https://wa.me/${site.whatsapp}?text=${encodeURIComponent(ui.form.introLine)}`;

const core = [
  {
    name: 'QCT Studio',
    domain: 'qctstudio.com',
    tag: 'Technology & Digital Products',
    desc: ui.studioDesc,
    url: site.links.qctStudio,
    role: ui.proof.studioRole,
    output: ui.proof.studioOut,
  },
  {
    name: 'QCT Commerce',
    domain: 'qctcommerce.com',
    tag: 'E-Commerce & Growth',
    desc: ui.commerceDesc,
    url: site.links.qctCommerce,
    role: ui.proof.commerceRole,
    output: ui.proof.commerceOut,
  },
  {
    name: 'CTSEG',
    domain: 'ctseg.com.tr',
    tag: 'Global Trade & Strategic Sourcing',
    desc: ui.ctsegDesc,
    url: site.links.ctseg,
    role: ui.proof.ctsegRole,
    output: ui.proof.ctsegOut,
  },
];

const intentCards: IntentItem[] = [
  { ...ui.intents[0], href: site.links.qctStudio },
  { ...ui.intents[1], href: site.links.qctCommerce },
  { ...ui.intents[2], href: site.links.ctseg },
  { ...ui.intents[3], href: whatsappHref },
];
---
<Header locale={locale} copy={copy} homePath={homePath} />
<main id="main-content" class={`personal-home locale-${locale}`}>
  <!-- STAGE 1: MIDNIGHT SAPPHIRE HERO -->
  <div class="midnight-stage">
    <div class="stage-container">
      <div class="dossier-bar" aria-label="Operating coordinates">
        <span class="dossier-bar__coord">{ui.dossierLocation}</span>
        <span class="dossier-bar__scope">{ui.dossierScope}</span>
      </div>

      <section class="hero" id="top">
        <div class="hero-copy">
          <div class="hero-status-pill">
            <span class="status-dot" aria-hidden="true"></span>
            <span class="status-label">{ui.eyebrow}</span>
          </div>
          <h1 class="hero-title">{ui.title}</h1>
          <p class="lead">{ui.lead}</p>
          <div class="actions">
            <a class="button primary hero-btn-primary" href="#ventures">
              <span>{ui.primary}</span>
              <svg aria-hidden="true" viewBox="0 0 16 16" width="14" height="14"><path d="M3 8h10M9 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </a>
            <a class="button ghost hero-btn-ghost" href={whatsappHref} target="_blank" rel="noopener noreferrer">
              <span>{ui.secondary}</span>
            </a>
          </div>
          <div class="signal-row" aria-label="Focus areas">
            <a href="https://qctstudio.com" target="_blank" rel="noopener noreferrer">QCT Studio</a>
            <a href="https://qctcommerce.com" target="_blank" rel="noopener noreferrer">QCT Commerce</a>
            <a href="https://ctseg.com.tr" target="_blank" rel="noopener noreferrer">CTSEG</a>
            <a href="https://growth.teyfikgokdemir.com" target="_blank" rel="noopener noreferrer">Growth OS</a>
            <a href="https://mythborn.co" target="_blank" rel="noopener noreferrer">Mythborn</a>
          </div>
        </div>
        <div class="hero-media">
          <div class="portrait-shell">
            <div class="portrait-frame">
              <img
                src={site.images.hero.path}
                srcset={site.images.hero.srcset}
                sizes="(max-width:900px) 84vw, 440px"
                width={site.images.hero.width}
                height={site.images.hero.height}
                alt="Teyfik Gökdemir"
                loading="eager"
                fetchpriority="high"
              />
            </div>
            <div class="portrait-badge">
              <span class="badge-role">FOUNDER / OPERATOR</span>
              <span class="badge-base">IST · BLK · GLOBAL</span>
            </div>
          </div>
        </div>
      </section>
    </div>
  </div>

  <!-- STAGE 2: WARM ALABASTER GALLERY (INTENT ROUTING & CORE COMPANIES) -->
  <div class="alabaster-stage">
    <div class="stage-container">
      <section class="section intent-routing" aria-labelledby="intent-routing-title">
        <div class="section-ledger-head">
          <div>
            <p class="eyebrow">{ui.intentEyebrow}</p>
            <h2 id="intent-routing-title">{ui.intentTitle}</h2>
          </div>
          <p class="section-lead-note">{ui.intentLead}</p>
        </div>
        <div class="intent-grid">
          {intentCards.map((item) => (
            <a class="intent-card" href={item.href} target="_blank" rel="noopener noreferrer">
              <div class="intent-card-copy">
                <span class="card-tag">{item.label}</span>
                <h3>{item.title}</h3>
                <p>{item.text}</p>
              </div>
              <span class="card-link">{item.action}<span aria-hidden="true"> ↗</span></span>
            </a>
          ))}
        </div>
      </section>

      <section class="section" id="ventures">
        <div class="section-ledger-head">
          <div>
            <p class="eyebrow">{ui.coreLabel}</p>
            <h2>{ui.coreTitle}</h2>
          </div>
          <p class="section-lead-note">{ui.coreLead}</p>
        </div>
        <div class="grid core-grid">
          {core.map((item) => (
            <a class="card core-card" href={item.url} target="_blank" rel="noopener noreferrer" data-venture-link="true">
              <div>
                <div class="card-top-meta">
                  <span class="card-tag">{item.tag}</span>
                  <span class="card-domain">{item.domain}</span>
                </div>
                <h3>{item.name}</h3>
                <p>{item.desc}</p>
                <dl class="project-proof">
                  <div>
                    <dt>{ui.proof.roleLabel}</dt>
                    <dd>{item.role}</dd>
                  </div>
                  <div>
                    <dt>{ui.proof.outputLabel}</dt>
                    <dd>{item.output}</dd>
                  </div>
                </dl>
              </div>
              <span class="card-link">{ui.view} <span aria-hidden="true">↗</span></span>
            </a>
          ))}
        </div>
      </section>
    </div>
  </div>

  <!-- STAGE 3: OXFORD SAPPHIRE VAULT (OWNED DIGITAL ASSETS, MARQUEE & COLLABORATION) -->
  <div class="sapphire-vault-stage">
    <div class="stage-container">
      <section class="section split-section" id="expertise">
        <div class="section-ledger-head">
          <div>
            <p class="eyebrow">{ui.ownedLabel}</p>
            <h2>{ui.ownedTitle}</h2>
          </div>
          <p class="section-lead-note">{ui.ownedLead}</p>
        </div>
        <div class="asset-stack">
          <a class="asset-card" href="https://growth.teyfikgokdemir.com" target="_blank" rel="noopener noreferrer">
            <div>
              <div class="card-top-meta">
                <span class="card-tag">{ui.privateLabel}</span>
                <span class="card-domain">growth.teyfikgokdemir.com</span>
              </div>
              <h3>Growth OS</h3>
              <p>{ui.growthDesc}</p>
              <p class="asset-spec">{ui.growthSpec}</p>
            </div>
            <span>growth.teyfikgokdemir.com ↗</span>
          </a>
          <a class="asset-card" href={site.links.mythborn} target="_blank" rel="noopener noreferrer">
            <div>
              <div class="card-top-meta">
                <span class="card-tag">{ui.mediaLabel}</span>
                <span class="card-domain">mythborn.co</span>
              </div>
              <h3>Mythborn</h3>
              <p>{ui.mythDesc}</p>
              <p class="asset-spec">{ui.mythSpec}</p>
            </div>
            <span>mythborn.co ↗</span>
          </a>
        </div>
      </section>
    </div>

    <div class="gap-marquee" aria-label="Core operating themes">
      <div class="gap-marquee-track">
        <div class="gap-marquee-group">
          {activeMarquee.map((item) => <><span>{item}</span><i>•</i></>)}
        </div>
        <div class="gap-marquee-group" aria-hidden="true">
          {activeMarquee.map((item) => <><span>{item}</span><i>•</i></>)}
        </div>
      </div>
    </div>

    <div class="stage-container">
      <section class="section collaboration">
        <p class="eyebrow">{ui.collabLabel}</p>
        <div class="collab-card">
          <div>
            <span class="card-tag">{ui.collaborationLabel}</span>
            <h2>Olivon</h2>
            <p>{ui.olivonDesc}</p>
          </div>
          <a class="button ghost" href="https://olivon.com.tr" target="_blank" rel="noopener noreferrer">olivon.com.tr ↗</a>
        </div>
      </section>
    </div>
  </div>

  <!-- STAGE 4: WARM ALABASTER EDITORIAL (OPERATING MODEL, FIELD NOTES & ABOUT) -->
  <div class="alabaster-stage">
    <div class="stage-container">
      <section class="section method" id="journey">
        <div class="section-ledger-head">
          <div>
            <p class="eyebrow">{ui.methodLabel}</p>
            <h2>{ui.methodTitle}</h2>
          </div>
          <p class="section-lead-note">{ui.methodLead}</p>
        </div>
        <ol class="method-grid">
          {ui.steps.map((step, index) => (
            <li>
              <strong>{step}</strong>
              <p class="method-step-note">{ui.stepNotes[index]}</p>
            </li>
          ))}
        </ol>
      </section>

      <section class="section insights-section" id="insights">
        <div class="section-ledger-head">
          <div>
            <p class="eyebrow">{ui.insightsLabel}</p>
            <h2>{ui.insightsTitle}</h2>
          </div>
          <div class="insights-head-aside">
            <p class="section-lead-note">{ui.insightsLead}</p>
            <a class="insights-all-link" href={blogIndexUrl}>{ui.insightsAll} <span aria-hidden="true">→</span></a>
          </div>
        </div>
        <div class="insights-ledger">
          {featuredArticles.map((article) => (
            <a class="insight-row" href={article.href}>
              <div class="insight-row__main">
                <span class="insight-row__tag">{article.tag}</span>
                <h3>{article.title}</h3>
                <p>{article.description}</p>
              </div>
              <span class="insight-row__cta">{blogMeta.read} <span aria-hidden="true">→</span></span>
            </a>
          ))}
        </div>
      </section>

      <section class="section about" id="about">
        <div class="about-copy">
          <p class="eyebrow">{ui.aboutLabel}</p>
          <h2>{ui.aboutTitle}</h2>
          <p>{ui.aboutBody}</p>
          <p class="about-thesis">{ui.aboutNote}</p>
        </div>
        <div class="about-portrait-frame">
          <img
            src={site.images.profile.path}
            srcset={site.images.profile.srcset}
            sizes="(max-width:900px) 88vw, 420px"
            width={site.images.profile.width}
            height={site.images.profile.height}
            alt="Teyfik Gökdemir"
            loading="lazy"
          />
        </div>
      </section>
    </div>
  </div>

  <!-- STAGE 5: MIDNIGHT SAPPHIRE FOUNDER DESK (CONTACT) -->
  <div class="midnight-stage contact-stage">
    <div class="stage-container">
      <section class="section contact" id="contact">
        <div class="contact-ledger">
          <div class="contact-intro">
            <p class="eyebrow">{ui.contactLabel}</p>
            <h2>{ui.contactTitle}</h2>
            <p>{ui.contactBody}</p>
            <div class="contact-primary-actions">
              <a class="button primary" href={whatsappHref} target="_blank" rel="noopener noreferrer">{locale === 'tr' ? 'WhatsApp’tan yaz' : 'WhatsApp'}</a>
              <a class="button ghost" href={emailHref}>{site.email}</a>
            </div>
            <div class="contact-links">
              <a href={site.links.qctStudio} target="_blank" rel="noopener noreferrer">QCT Studio</a>
              <a href={site.links.qctCommerce} target="_blank" rel="noopener noreferrer">QCT Commerce</a>
              <a href={site.links.ctseg} target="_blank" rel="noopener noreferrer">CTSEG</a>
            </div>
          </div>

          <form class="contact-form" data-contact-form data-intro-line={ui.form.introLine}>
            <label>
              <span>{ui.form.topicLabel}</span>
              <select name="topic" required>
                <option value="">{ui.form.selectPlaceholder}</option>
                {ui.form.topics.map((topicOption) => <option>{topicOption}</option>)}
              </select>
            </label>
            <label>
              <span>{ui.form.companyLabel}</span>
              <input name="company" autocomplete="organization" placeholder={ui.form.companyPlaceholder} />
            </label>
            <label class="contact-form-wide">
              <span>{ui.form.messageLabel}</span>
              <textarea name="message" rows="4" required placeholder={ui.form.messagePlaceholder}></textarea>
            </label>
            <button class="button primary contact-form-wide" type="submit">{ui.form.submit}</button>
          </form>
        </div>
      </section>
    </div>
  </div>
</main>
<FloatingActions locale={locale} />

<script is:inline define:vars={{ whatsappNumber: site.whatsapp }}>
  document.querySelectorAll('[data-contact-form]').forEach((form) => {
    form.addEventListener('submit', (event) => {
      event.preventDefault();
      if (!(form instanceof HTMLFormElement)) return;
      const data = new FormData(form);
      const topic = String(data.get('topic') || '').trim();
      const company = String(data.get('company') || '').trim();
      const message = String(data.get('message') || '').trim();
      if (!topic || !message) return;
      const intro = form.getAttribute('data-intro-line') || 'Hello Teyfik, I am contacting you via teyfikgokdemir.com.';
      const lines = [intro, '', 'Topic: ' + topic];
      if (company) lines.push('Company: ' + company);
      lines.push('Message: ' + message);
      window.open('https://wa.me/' + whatsappNumber + '?text=' + encodeURIComponent(lines.join('\n')), '_blank', 'noopener,noreferrer');
    });
  });
</script>

