const strings = copy[locale];
const campaign = 'trade_checklist';
const tracked = (url: string, content: string) => {
  const target = new URL(url);
  target.searchParams.set('utm_source', 'instagram');
  target.searchParams.set('utm_medium', 'post');
  target.searchParams.set('utm_campaign', campaign);
  target.searchParams.set('utm_content', content);
  return target.toString();
};
const ctsegBase = locale === 'tr' ? 'https://ctseg.com.tr/tr/iletisim/' : locale === 'fa' ? 'https://ctseg.com.tr/fa/tamin-beynolmelali-iran/' : 'https://ctseg.com.tr/en/';
const ctsegUrl = tracked(ctsegBase, 'second_post_ctseg');
const instagramUrl = `https://www.instagram.com/teyfikgokdemir/?utm_source=website&utm_medium=referral&utm_campaign=instagram_growth&utm_content=trade_checklist`;
const whatsappUrl = `https://wa.me/${site.whatsapp}?text=${encodeURIComponent(strings.whatsappText)}`;
const pageSchema = {
  '@type': 'HowTo',
  '@id': siteUrl(locale) + '#howto',
  name: strings.title,
  description: strings.description,
  url: siteUrl(locale),
  inLanguage: locale,
  isPartOf: { '@id': site.origin + '/#website' },
  author: { '@id': site.origin + '/#person' },
  step: strings.checks.map(([name, text], index) => ({ '@type': 'HowToStep', position: index + 1, name, text })),
};
---

<ContentPage locale={locale} title={strings.title} description={strings.description} pathname={pathnameFor(locale)} alternates={alternates} pageSchema={pageSchema} eyebrow={strings.eyebrow} heading={strings.heading} lead={strings.lead}>
  <div class="trade-checklist" dir={locale === 'fa' ? 'rtl' : 'ltr'}>
    <section class="answer-block trade-checklist__opening">
      <p><strong>{strings.opening[0]}</strong></p>
      <p>{strings.opening[1]}</p>
    </section>
    <section aria-labelledby="trade-checklist-title">
      <div class="section-heading">
        <p class="section-label">{strings.sectionLabel}</p>
        <h2 id="trade-checklist-title">{strings.sectionTitle}</h2>
        <p>{strings.sectionLead}</p>
      </div>
      <div class="trade-checklist-grid">
        {strings.checks.map(([title, text, signal], index) => (
          <article class="trade-check-card">
            <span class="trade-check-card__number">{String(index + 1).padStart(2, '0')}</span>
            <h3>{title}</h3>
            <p>{text}</p>
            <span class="trade-check-card__signal">{signal}</span>
          </article>
        ))}
      </div>
    </section>
    <section class="trade-checklist__decision" aria-labelledby="trade-decision-title">
      <p class="section-label">{strings.decisionLabel}</p>
      <h2 id="trade-decision-title">{strings.decisionTitle}</h2>
      <p>{strings.decisionText}</p>
      <div class="trade-checklist__actions">
        <a class="button button--primary" href={ctsegUrl} data-trade-route="ctseg">{strings.ctseg}</a>
        <a class="button button--secondary" href={whatsappUrl} data-trade-route="whatsapp">{strings.whatsapp}</a>
      </div>
    </section>
    <section class="trade-checklist__return" aria-labelledby="trade-return-title">
      <p class="section-label">{strings.returnLabel}</p>
      <h2 id="trade-return-title">{strings.returnTitle}</h2>
      <p>{strings.returnText}</p>
      <a class="text-link" href={instagramUrl} data-trade-route="instagram_profile">{strings.instagram}</a>
    </section>
  </div>
</ContentPage>

<script is:inline>
  document.querySelectorAll('[data-trade-route]').forEach((link) => {
    link.addEventListener('click', () => {
      const destination = link.getAttribute('data-trade-route') || 'unknown';
      if (typeof window.gtag === 'function') window.gtag('event', 'instagram_trade_checklist_click', { destination, source: 'instagram', medium: 'post', campaign: 'trade_checklist', content: 'second_post' });
    });
  });
</script>

<style>
  .trade-checklist { display: grid; gap: 4rem; }
  .trade-checklist__opening { display: grid; gap: 1rem; }
  .trade-checklist__opening p { margin: 0; }
  .trade-checklist-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; }
  .trade-check-card { display: grid; gap: .85rem; min-height: 260px; padding: 1.5rem; border: 1px solid var(--border); border-radius: 1rem; background: var(--surface); }
  .trade-check-card:nth-child(2) { background: #e1e6df; }
  .trade-check-card:nth-child(3) { background: #e8dfd2; }
  .trade-check-card:nth-child(4) { background: #eadbd4; }
  .trade-check-card:nth-child(5) { background: #dddbe5; }
  .trade-check-card__number { color: var(--accent); font-size: .78rem; font-weight: 850; letter-spacing: .14em; }
  .trade-check-card h3 { margin: 0; font-size: clamp(1.45rem, 2.5vw, 2rem); }
  .trade-check-card p { margin: 0; color: var(--text-muted); line-height: 1.75; }
  .trade-check-card__signal { align-self: end; color: var(--accent); font-size: .82rem; font-weight: 800; }
  .trade-checklist__decision { padding: clamp(2rem, 5vw, 3.5rem); border-radius: 1rem; background: var(--surface-dark); color: #f3eee6; }
  .trade-checklist__decision h2, .trade-checklist__return h2 { margin-top: 0; }
  .trade-checklist__decision h2 { color: #f3eee6; }
  .trade-checklist__decision p:not(.section-label) { max-width: 760px; color: #d2c8bc; line-height: 1.8; }
  .trade-checklist__decision .section-label { color: var(--accent-coral); }
  .trade-checklist__actions { display: flex; flex-wrap: wrap; gap: .8rem; margin-top: 1.5rem; }
  .button { display: inline-flex; align-items: center; justify-content: center; min-height: 48px; padding: .85rem 1.2rem; border-radius: 999px; font-weight: 850; text-decoration: none !important; }
  .button--primary { background: var(--accent-coral); color: #211c18 !important; }
  .button--secondary { border: 1px solid #d2c8bc; color: #f3eee6 !important; }
  .trade-checklist__return { padding-top: 1rem; border-top: 1px solid var(--border); }
  .trade-checklist__return p:not(.section-label) { max-width: 720px; color: var(--text-muted); line-height: 1.8; }
  .text-link { color: var(--accent); font-weight: 850; text-decoration: underline; text-underline-offset: .2em; }
  [dir="rtl"] .trade-checklist-card, [dir="rtl"] .trade-checklist__decision, [dir="rtl"] .trade-checklist__return { text-align: right; }
  @media (max-width: 680px) { .trade-checklist-grid { grid-template-columns: 1fr; } .trade-check-card { min-height: 0; } .trade-checklist__actions { display: grid; } .button { width: 100%; } }
</style>
