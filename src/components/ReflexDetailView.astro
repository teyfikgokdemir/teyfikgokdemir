const detailText = detailTextMap[lang] || detailTextMap.tr;

const translateQty = (val: string) => {
  if (!val) return val;
  if (lang === 'en') return val.replace(/Adet/g, 'Pcs').replace(/Kutu/g, 'Boxes').replace(/Koli/g, 'Cartons');
  if (lang === 'mk') return val.replace(/Adet/g, 'парчиња').replace(/Kutu/g, 'кутии').replace(/Koli/g, 'коли');
  if (lang === 'sr') return val.replace(/Adet/g, 'komada').replace(/Kutu/g, 'kutija').replace(/Koli/g, 'kartona');
  if (lang === 'sq') return val.replace(/Adet/g, 'copë').replace(/Kutu/g, 'kuti').replace(/Koli/g, 'kartona');
  if (lang === 'fa') return val.replace(/Adet/g, 'عدد').replace(/Kutu/g, 'جعبه').replace(/Koli/g, 'کارتن');
  if (lang === 'zh') return val.replace(/Adet/g, '只').replace(/Kutu/g, '盒').replace(/Koli/g, '箱');
  if (lang === 'vi') return val.replace(/Adet/g, 'chiếc').replace(/Kutu/g, 'hộp').replace(/Koli/g, 'thùng');
  return val;
};

const v0 = product.variants[0];
const rawBoxQty = v0?.boxQuantity || '100 Adet';
const rawCartonQty = v0?.cartonQuantity || '20 Kutu';
const rawPalletQty = v0?.palletQuantity || '70 Koli';
const boxDim = v0?.boxDimensions || '200 x 120 x 28.5 mm';

const boxQty = translateQty(rawBoxQty);
const cartonQty = translateQty(rawCartonQty);
const palletQty = translateQty(rawPalletQty);

const primaryApp = i18n.applications?.[0] || detailText.endustriyelKullanim;
const relatedProducts = reflexProducts.filter(p => p.slug !== product.slug).slice(0, 3);
---

<div class="reflex-detail">
  <div class="shell">
    <!-- BREADCRUMB -->
    <nav class="reflex-breadcrumb" aria-label="Breadcrumb">
      <a href={locale === 'tr' ? '/' : `/${locale}/`}>{detailText.homeBreadcrumb}</a>
      <span class="bc-sep">›</span>
      <a href={locale === 'tr' ? '/reflex/' : `/${locale}/reflex/`}>Reflex</a>
      <span class="bc-sep">›</span>
      <span class="bc-current">{i18n.name}</span>
    </nav>

    <!-- MAIN EDITORIAL OVERVIEW LAYOUT -->
    <div class="detail-main-grid">
      <!-- LEFT COLUMN -->
      <div class="detail-left-col">
        <h1 class="detail-editorial-title">{detailText.overviewTitle}</h1>
        <p class="detail-editorial-desc">{i18n.description}</p>

        <h2 class="detail-section-subtitle">{detailText.featuresTitle}</h2>
        <ul class="editorial-features-list">
          {i18n.features.map(f => (
            <li>
              <span class="feature-badge" aria-hidden="true">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
              </span>
              <span class="feature-text">{f}</span>
            </li>
          ))}
        </ul>
      </div>

      <!-- RIGHT COLUMN -->
      <div class="detail-right-col">
        <div class="black-pills-row">
          <span class="black-pill">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M3 21h18"></path>
              <path d="M5 21V7l8-4v18"></path>
              <path d="M19 21V11l-6-3"></path>
            </svg>
            <span>{primaryApp}</span>
          </span>
          <span class="black-pill">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
            </svg>
            <span>{detailText.genelPaket}: {cartonQty}</span>
          </span>
        </div>

        <div class="editorial-image-card">
          <img
            src={product.images.main}
            alt={`${i18n.name} - ${i18n.materialName}`}
            width="600"
            height="450"
            decoding="async"
          />
        </div>
      </div>
    </div>

    <!-- 4-COLUMN LOGISTICS SUMMARY BAR -->
    <div class="logistics-bar-card">
      <div class="logistics-col">
        <div class="logistics-icon">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#D45D35" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
          </svg>
        </div>
        <div class="logistics-info">
          <span class="logistics-label">{detailText.kutuIci}</span>
          <strong class="logistics-val">{boxQty}</strong>
        </div>
      </div>

      <div class="logistics-col">
        <div class="logistics-icon">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#D45D35" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M16.5 9.4 7.55 4.24"></path>
            <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
            <polyline points="3.29 7 12 12 20.71 7"></polyline>
            <line x1="12" y1="22" x2="12" y2="12"></line>
          </svg>
        </div>
        <div class="logistics-info">
          <span class="logistics-label">{detailText.koliIci}</span>
          <strong class="logistics-val">{cartonQty}</strong>
        </div>
      </div>

      <div class="logistics-col">
        <div class="logistics-icon">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#D45D35" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M2 20h20"></path>
            <path d="M5 20v-4h14v4"></path>
            <path d="M7 16V4h10v12"></path>
          </svg>
        </div>
        <div class="logistics-info">
          <span class="logistics-label">{detailText.paletIci}</span>
          <strong class="logistics-val">{palletQty}</strong>
        </div>
      </div>

      <div class="logistics-col">
        <div class="logistics-icon">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#D45D35" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
            <line x1="3" y1="9" x2="21" y2="9"></line>
            <line x1="9" y1="21" x2="9" y2="9"></line>
          </svg>
        </div>
        <div class="logistics-info">
          <span class="logistics-label">{detailText.kutuOlcusu}</span>
          <strong class="logistics-val">{boxDim}</strong>
        </div>
      </div>
    </div>

    <!-- SPECIFICATIONS TABLE -->
    <div id="packaging-specs">
      <ReflexSpecTable product={product} locale={locale} />
    </div>

    <!-- GALLERY -->
    {product.images.gallery.length > 0 && (
      <div class="detail-gallery-section">
        <h2>{detailText.galleryTitle}</h2>
        <div class="gallery-grid">
          {product.images.gallery.map((img, idx) => (
            <div class="gallery-item">
              <img src={img} alt={`${i18n.name} Görsel ${idx + 1}`} width="400" height="300" loading="lazy" />
            </div>
          ))}
        </div>
      </div>
    )}

    <!-- FAQ SECTION -->
    {i18n.faq && i18n.faq.length > 0 && (
      <div class="detail-faq-section" id="faq">
        <h2>{detailText.faqTitle}</h2>
        <div class="faq-accordion">
          {i18n.faq.map((item, idx) => (
            <details class="faq-item" open={idx === 0}>
              <summary class="faq-question">
                <span>{item.question}</span>
                <span class="faq-icon" aria-hidden="true">+</span>
              </summary>
              <div class="faq-answer">
                <p>{item.answer}</p>
              </div>
            </details>
          ))}
        </div>
      </div>
    )}

    <!-- RELATED PRODUCTS -->
    <div class="related-section">
      <h2>{detailText.relatedTitle}</h2>
      <div class="reflex-grid">
        {relatedProducts.map(p => (
          <ReflexProductCard product={p} locale={locale} />
        ))}
      </div>
    </div>

    <!-- QUOTE SECTION -->
    <div id="quote" class="quote-card">
      <div class="quote-card__content">
        <h2>{detailText.quoteTitle}</h2>
        <p>{detailText.quoteDesc}</p>
      </div>
      <div class="quote-card__action">
        <a href={`mailto:info@teyfikgokdemir.com?subject=Reflex%20${encodeURIComponent(i18n.name)}%20Quotation`} class="button primary quote-btn">
          {detailText.quoteBtn}
        </a>
      </div>
    </div>
  </div>
</div>

<style>
  .reflex-detail {
    padding-block: 2rem 5rem;
    background-color: #F6F3EC;
    color: #1A1815;
    min-height: 100vh;
  }
  .reflex-breadcrumb {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.92rem;
    margin-bottom: 2.2rem;
    color: #59534B;
    flex-wrap: wrap;
  }
  .reflex-breadcrumb a {
    color: #59534B;
    text-decoration: none;
    font-weight: 500;
    transition: color 0.2s ease;
  }
  .reflex-breadcrumb a:hover {
    color: #D45D35;
  }
  .bc-sep {
    color: #A39B8E;
  }
  .bc-current {
    color: #D45D35;
    font-weight: 700;
  }

  .detail-main-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    gap: clamp(2rem, 4vw, 4rem);
    align-items: flex-start;
    margin-bottom: 2.5rem;
  }

  .detail-editorial-title {
    font-family: Georgia, Cambria, 'Times New Roman', serif;
    font-size: clamp(2.2rem, 4vw, 3.2rem);
    line-height: 1.15;
    font-weight: 700;
    margin: 0 0 1.25rem;
    color: #1A1815;
  }
  .detail-editorial-desc {
    font-size: 1.05rem;
    line-height: 1.7;
    color: #2E2A25;
    margin-bottom: 2rem;
  }

  .detail-section-subtitle {
    font-family: Georgia, Cambria, 'Times New Roman', serif;
    font-size: 1.5rem;
    font-weight: 700;
    margin: 0 0 1.25rem;
    color: #1A1815;
  }

  .editorial-features-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
  }
  .editorial-features-list li {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding-block: 0.9rem;
    border-bottom: 1px solid #E6E1D7;
    font-size: 0.98rem;
    font-weight: 600;
    color: #1A1815;
  }
  .feature-badge {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: #D45D35;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .feature-text {
    line-height: 1.4;
  }

  .black-pills-row {
    display: flex;
    justify-content: flex-end;
    gap: 0.65rem;
    margin-bottom: 1rem;
    flex-wrap: wrap;
  }
  .black-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.45rem 1rem;
    border-radius: 999px;
    background: #1A1815;
    color: #FFFFFF;
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.01em;
  }

  .editorial-image-card {
    background: #FFFFFF;
    border: 1px solid #E6E1D7;
    border-radius: 20px;
    padding: 1.5rem;
    box-shadow: 0 10px 30px rgba(26, 24, 21, 0.05);
    overflow: hidden;
    display: flex;
