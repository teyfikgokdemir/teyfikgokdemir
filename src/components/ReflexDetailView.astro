---
import type { ReflexProduct } from '../data/reflexProducts';
import { reflexProducts } from '../data/reflexProducts';
import ReflexSpecTable from './ReflexSpecTable.astro';
import ReflexProductCard from './ReflexProductCard.astro';
import type { Locale } from '../i18n/locales';

interface Props {
  product: ReflexProduct;
  locale: Locale | 'fa';
}

const { product, locale } = Astro.props;
const lang = (locale === 'fa' ? 'tr' : locale) as 'tr' | 'en' | 'mk' | 'sr' | 'sq';
const i18n = product.i18n[lang] || product.i18n.tr;

const detailText = {
  tr: {
    backToCatalog: '← Tüm Reflex Ürün Portföyüne Dön',
    overviewTitle: 'Ürün Hakkında Genel Bakış',
    featuresTitle: 'Temel Özellikler & Avantajlar',
    applicationsTitle: 'Kullanım & Uygulama Alanları',
    galleryTitle: 'Ürün Görsel Galerisi',
    relatedTitle: 'Diğer Reflex Ürün Aileleri',
    quoteTitle: 'Bu Ürün İçin Teklif Alın',
    quoteDesc: 'Koli, palet ve konteyner bazlı toptan alım talepleriniz için teknik detayları ve fiyatlandırmayı hemen öğrenin.',
    quoteBtn: 'Fiyat & Tedarik Talebi Gönder',
    faqTitle: 'Sıkça Sorulan Sorular (SSS)',
  },
  en: {
    backToCatalog: '← Back to Reflex Product Portfolio',
    overviewTitle: 'Product Overview',
    featuresTitle: 'Key Features & Benefits',
    applicationsTitle: 'Target Applications & Sectors',
    galleryTitle: 'Product Image Gallery',
    relatedTitle: 'Related Reflex Product Families',
    quoteTitle: 'Request a Quote for This Product',
    quoteDesc: 'Contact us for bulk purchasing by box, carton, pallet, or container loading, including private label availability.',
    quoteBtn: 'Request B2B Quote',
    faqTitle: 'Frequently Asked Questions (FAQ)',
  },
  mk: {
    backToCatalog: '← Назад до Сите Reflex Производи',
    overviewTitle: 'Општ Преглед на Производот',
    featuresTitle: 'Клучни Карактеристики и Придобивки',
    applicationsTitle: 'Сектори и Примена',
    galleryTitle: 'Галерија Слики',
    relatedTitle: 'Други Reflex Производи',
    quoteTitle: 'Побарај Понуда за Овој Производ',
    quoteDesc: 'Контактирајте нѐ за големопродажба на ниво на кутии, палети или контејнери.',
    quoteBtn: 'Побарај Понуда',
    faqTitle: 'Често Поставувани Прашања (ЧПП)',
  },
  sr: {
    backToCatalog: '← Nazad na Reflex Portfolijo',
    overviewTitle: 'Pregled Proizvoda',
    featuresTitle: 'Glavne Prednosti i Osobine',
    applicationsTitle: 'Sektori i Oblasti Primene',
    galleryTitle: 'Galerija Fotografija',
    relatedTitle: 'Ostali Reflex Proizvodi',
    quoteTitle: 'Zatražite Ponudu za Ovaj Proizvod',
    quoteDesc: 'Kontaktirajte nas za veleprodajne cene po kutijama, kartonima i paletnim isporukama.',
    quoteBtn: 'Zatraži Ponudu',
    faqTitle: 'Često Postavljana Pitanja (FAQ)',
  },
  sq: {
    backToCatalog: '← Kthehu te Portofoli Reflex',
    overviewTitle: 'Përmbledhje e Produktit',
    featuresTitle: 'Veçoritë Kryesore dhe Avantazhet',
    applicationsTitle: 'Fushat e Përdorimit dhe Sektorët',
    galleryTitle: 'Galeria e Fotove të Produktit',
    relatedTitle: 'Familjet e Tjera të Reflex',
    quoteTitle: 'Kërkoni Ofertë për Këtë Produkt',
    quoteDesc: 'Na kontaktoni për blerje me shumicë në kuti, kartona ose paleta sipas nevojave tuaja.',
    quoteBtn: 'Kërko Ofertë',
    faqTitle: 'Pyetjet më të Shpeshta (FAQ)',
  }
}[lang] || detailText.tr;
if (locale === 'fa') {
  detailText.faqTitle = 'پرسش‌های متداول (SSS)';
}

const relatedProducts = reflexProducts.filter(p => p.slug !== product.slug).slice(0, 3);
---

<div class="reflex-detail">
  <div class="shell">
    <div class="reflex-detail__top-nav">
      <a href={`/${locale}/reflex/`} class="reflex-back-link">
        {locale === 'fa' ? '→ بازگشت به سبد محصولات رفلکس' : detailText.backToCatalog}
      </a>
    </div>

    <!-- HERO HEADER -->
    <div class="detail-hero">
      <div class="detail-hero__gallery">
        <div class="main-image-wrap">
          <img
            src={product.images.main}
            alt={`${i18n.name} - ${i18n.materialName}`}
            width="600"
            height="420"
            decoding="async"
          />
        </div>
      </div>

      <div class="detail-hero__info">
        <span class="detail-badge">{i18n.materialName}</span>
        <h1 class="detail-title">{i18n.name}</h1>
        <p class="detail-tagline">{i18n.tagline}</p>

        <div class="quick-highlights">
          <div class="qh-item">
            <span class="qh-label">Pudra:</span>
            <span class="qh-val">{product.powderStatus}</span>
          </div>
          <div class="qh-item">
            <span class="qh-label">Lateks:</span>
            <span class="qh-val">{product.latexStatus}</span>
          </div>
          <div class="qh-item">
            <span class="qh-label">Silikon:</span>
            <span class="qh-val">{product.siliconeStatus}</span>
          </div>
          <div class="qh-item">
            <span class="qh-label">Gıda Uyumu:</span>
            <span class="qh-val">{product.foodContact ? 'Uygun' : 'Uygun Değil'}</span>
          </div>
        </div>

        <div class="detail-hero__ctas">
          <a href="#quote" class="button primary">{detailText.quoteBtn}</a>
          {product.images.packaging && (
            <a href="#packaging-specs" class="button">Lojistik Detayları</a>
          )}
        </div>
      </div>
    </div>

    <!-- OVERVIEW & FEATURES -->
    <div class="section-content">
      <div class="detail-grid">
        <div class="detail-col">
          <h2>{detailText.overviewTitle}</h2>
          <p class="overview-desc">{i18n.description}</p>

          <h3>{detailText.featuresTitle}</h3>
          <ul class="features-list">
            {i18n.features.map(f => (
              <li>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--accent-coral)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
                <span>{f}</span>
              </li>
            ))}
          </ul>
        </div>

        <div class="detail-col">
          <h3>{detailText.applicationsTitle}</h3>
          <div class="apps-pills">
            {i18n.applications.map(app => (
              <span class="app-pill">{app}</span>
            ))}
          </div>

          {product.images.packaging && (
            <div class="packaging-box-img">
              <img src={product.images.packaging} alt={`${i18n.name} Ambalaj Kutusu`} width="400" height="280" loading="lazy" />
            </div>
          )}
        </div>
      </div>
    </div>

    <!-- SPECIFICATIONS TABLE -->
    <div id="packaging-specs">
      <ReflexSpecTable product={product} locale={locale} />
    </div>

    <!-- GALLERY -->
    {product.images.gallery.length > 0 && (
      <div class="detail-gallery-section">
        <h2>{detailText.galleryTitle}</h2>
        <div class="gallery-grid">
          {product.images.gallery.map((img, idx) => (
            <div class="gallery-item">
              <img src={img} alt={`${i18n.name} Görsel ${idx + 1}`} width="400" height="300" loading="lazy" />
            </div>
          ))}
        </div>
      </div>
    )}

    <!-- FAQ SECTION -->
    {i18n.faq && i18n.faq.length > 0 && (
      <div class="detail-faq-section" id="faq">
        <h2>{detailText.faqTitle}</h2>
        <div class="faq-accordion">
          {i18n.faq.map((item, idx) => (
            <details class="faq-item" open={idx === 0}>
              <summary class="faq-question">
                <span>{item.question}</span>
                <span class="faq-icon" aria-hidden="true">+</span>
              </summary>
              <div class="faq-answer">
                <p>{item.answer}</p>
              </div>
            </details>
          ))}
        </div>
      </div>
    )}

    <!-- RELATED PRODUCTS -->
    <div class="related-section">
      <h2>{detailText.relatedTitle}</h2>
      <div class="reflex-grid">
        {relatedProducts.map(p => (
          <ReflexProductCard product={p} locale={locale} />
        ))}
      </div>
    </div>

    <!-- QUOTE SECTION -->
    <div id="quote" class="quote-card">
      <div class="quote-card__content">
        <h2>{detailText.quoteTitle}</h2>
        <p>{detailText.quoteDesc}</p>
      </div>
      <div class="quote-card__action">
        <a href={`mailto:info@teyfikgokdemir.com?subject=Reflex%20${encodeURIComponent(i18n.name)}%20Quotation`} class="button primary">
          {detailText.quoteBtn}
        </a>
      </div>
    </div>
  </div>
</div>

<style>
  .reflex-detail {
    padding-block: 2.5rem 5rem;
    color: #f3eee6;
  }
  .reflex-detail__top-nav {
    margin-bottom: 2rem;
  }
  .reflex-back-link {
    color: var(--accent-coral);
    font-weight: 700;
    font-size: 0.92rem;
    transition: opacity 0.2s ease;
  }
  .reflex-back-link:hover {
    opacity: 0.8;
  }

  .detail-hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
    gap: clamp(2rem, 4vw, 4rem);
    align-items: center;
    padding: 2.5rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface-dark);
    margin-bottom: 3rem;
  }
  .main-image-wrap {
    overflow: hidden;
    border-radius: 16px;
    background: #181411;
    border: 1px solid rgba(255, 255, 255, 0.08);
  }
  .main-image-wrap img {
    width: 100%;
    height: auto;
    object-fit: cover;
  }

  .detail-badge {
    display: inline-block;
    padding: 0.35rem 0.8rem;
    margin-bottom: 1rem;
    border-radius: 999px;
    background: rgba(226, 118, 98, 0.12);
    border: 1px solid rgba(242, 170, 143, 0.3);
    color: var(--accent-coral);
    font-size: 0.78rem;
    font-weight: 800;
    text-transform: uppercase;
  }
  .detail-title {
    font-size: clamp(2.2rem, 4vw, 3.4rem);
    line-height: 1.1;
    margin: 0 0 0.8rem;
    color: #ffffff;
  }
  .detail-tagline {
    font-size: 1.15rem;
    color: #c9bfb2;
    margin: 0 0 1.75rem;
    line-height: 1.55;
  }

  .quick-highlights {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.6rem 1rem;
    padding: 1rem 1.2rem;
    margin-bottom: 1.75rem;
    border-radius: 14px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.06);
    font-size: 0.88rem;
  }
  .qh-item {
    display: flex;
    gap: 0.4rem;
  }
  .qh-label {
    color: #a99d8f;
  }
  .qh-val {
    color: #ffffff;
    font-weight: 700;
  }

  .detail-hero__ctas {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .detail-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 3rem;
    margin-block: 3rem;
  }
  .detail-col h2,
  .detail-col h3 {
    color: #ffffff;
    margin-top: 0;
  }
  .overview-desc {
    font-size: 1.05rem;
    line-height: 1.7;
    color: #c9bfb2;
    margin-bottom: 2rem;
  }

  .features-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }
  .features-list li {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    font-size: 0.98rem;
    color: #f3eee6;
  }

  .apps-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-bottom: 2rem;
  }
  .app-pill {
    padding: 0.5rem 1rem;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: var(--surface-dark);
    font-size: 0.88rem;
    font-weight: 700;
  }

  .packaging-box-img {
    border-radius: 16px;
    overflow: hidden;
    border: 1px solid var(--line);
    background: #181411;
  }
  .packaging-box-img img {
    width: 100%;
    height: auto;
    object-fit: cover;
  }

  .detail-gallery-section,
  .related-section {
    margin-block: 4rem;
  }
  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 1.25rem;
    margin-top: 1.5rem;
  }
  .gallery-item {
    border-radius: 14px;
    overflow: hidden;
    border: 1px solid var(--line);
    background: #181411;
  }
  .gallery-item img {
    width: 100%;
    height: 220px;
    object-fit: cover;
  }

  .reflex-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 1.5rem;
    margin-top: 1.5rem;
  }

  .quote-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    padding: clamp(2rem, 4vw, 3.5rem);
    border: 1px solid var(--accent);
    border-radius: var(--radius);
    background: radial-gradient(circle at 100% 0%, rgba(226, 118, 98, 0.2), transparent 20rem), var(--surface-dark);
    color: #ffffff;
    flex-wrap: wrap;
    margin-top: 4rem;
  }
  .quote-card__content h2 {
    font-size: clamp(1.8rem, 3vw, 2.5rem);
    margin: 0 0 0.75rem;
  }
  .quote-card__content p {
    margin: 0;
    max-width: 600px;
    color: #c9bfb2;
    line-height: 1.6;
  }

  .detail-faq-section {
    margin-block: 4rem;
  }
  .detail-faq-section h2 {
    font-size: 1.8rem;
    margin-bottom: 1.5rem;
    color: #ffffff;
  }
  .faq-accordion {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }
  .faq-item {
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--surface-dark);
    overflow: hidden;
    transition: border-color 0.2s ease;
  }
  .faq-item[open] {
    border-color: rgba(226, 118, 98, 0.4);
  }
  .faq-question {
    padding: 1.1rem 1.4rem;
    font-weight: 700;
    font-size: 1.02rem;
    color: #f3eee6;
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    align-items: center;
    list-style: none;
    user-select: none;
  }
  .faq-question::-webkit-details-marker {
    display: none;
  }
  .faq-icon {
    font-size: 1.2rem;
    color: var(--accent-coral);
    transition: transform 0.2s ease;
    flex-shrink: 0;
    margin-inline-start: 0.75rem;
  }
  .faq-item[open] .faq-icon {
    transform: rotate(45deg);
  }
  .faq-answer {
    padding: 0 1.4rem 1.25rem;
    color: #c9bfb2;
    font-size: 0.95rem;
    line-height: 1.6;
  }
  .faq-answer p {
    margin: 0;
  }

  @media (max-width: 768px) {
    .detail-hero {
      grid-template-columns: 1fr;
    }
  }
</style>
