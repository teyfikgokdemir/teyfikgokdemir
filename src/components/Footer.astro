---
import type { SiteContent } from '../i18n/content';
import { site } from '../data/site';

interface Props {
  copy: SiteContent;
}

const { copy } = Astro.props;

const socialLinks = [
  ['LinkedIn', site.links.linkedin],
  ['Instagram', site.links.instagram],
  ['GitHub', site.links.github],
] as const;

const ventureLinks = [
  ['QCT Studio', site.links.qctStudio],
  ['QCT Commerce', site.links.qctCommerce],
  ['Mythborn', site.links.mythborn],
] as const;

const whatsappUrl =
  `https://wa.me/${site.whatsapp}?text=` +
  encodeURIComponent(
    'Hello Teyfik, I am contacting you through teyfikgokdemir.com.'
  );
---
<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-intro">
      <a class="footer-brand" href="#top">Teyfik Gökdemir</a>
      <p class="footer-position">
        Digital commerce, AI operations and growth systems.
      </p>
      <p class="footer-rights">{copy.footer.rights}</p>
    </div>

    <div class="footer-links">
      <div class="footer-link-group">
        <span class="footer-label">Connect</span>
        <nav aria-label="Social links">
          {socialLinks.map(([label, href]) => (
            <a
              href={href}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={label + ', ' + copy.a11y.external}
            >
              {label}<span aria-hidden="true">↗</span>
            </a>
          ))}
        </nav>
      </div>

      <div class="footer-link-group">
        <span class="footer-label">Ventures</span>
        <nav aria-label="Venture links">
          {ventureLinks.map(([label, href]) => (
            <a
              href={href}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={label + ', ' + copy.a11y.external}
            >
              {label}<span aria-hidden="true">↗</span>
            </a>
          ))}
        </nav>
      </div>

      <div class="footer-link-group footer-contact">
        <span class="footer-label">Contact</span>
        <nav aria-label="Contact links">
          <a href={'mailto:' + site.email}>{site.email}</a>
          <a href={'mailto:' + site.directEmail}>{site.directEmail}</a>
          <a
            href={whatsappUrl}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={'WhatsApp, ' + copy.a11y.external}
          >
            WhatsApp<span aria-hidden="true">↗</span>
          </a>
        </nav>
      </div>
    </div>
  </div>
</footer>