---
import type { SiteContent } from '../i18n/content';
import type { Locale } from '../i18n/locales';
import { site } from '../data/site';
import SitewidePalette from './SitewidePalette.astro';

interface Props { copy: SiteContent; locale?: Locale | 'fa'; }
const { copy, locale = 'en' } = Astro.props;
const text = ({
  tr:{ position:'Teknoloji, dijital ticaret ve küresel operasyonlar arasında çalışan sistemler kuruyorum.', connect:'Bağlantılar', ecosystem:'Ekosistem', contact:'İletişim', blog:'Blog' },
  en:{ position:'Building working systems across technology, digital commerce and global operations.', connect:'Connect', ecosystem:'Ecosystem', contact:'Contact', blog:'Blog' },
  ru:{ position:'Создаю работающие системы на стыке технологий, цифровой коммерции и глобальных операций.', connect:'Связи', ecosystem:'Экосистема', contact:'Контакты', blog:'Блог' },
  mk:{ position:'Градам функционални системи меѓу технологија, дигитална трговија и глобални операции.', connect:'Поврзување', ecosystem:'Екосистем', contact:'Контакт', blog:'Блог' },
  sr:{ position:'Gradim funkcionalne sisteme između tehnologije, digitalne trgovine i globalnih operacija.', connect:'Povezivanje', ecosystem:'Ekosistem', contact:'Kontakt', blog:'Blog' },
  sq:{ position:'Ndërtoj sisteme funksionale mes teknologjisë, tregtisë digjitale dhe operacioneve globale.', connect:'Lidhje', ecosystem:'Ekosistemi', contact:'Kontakt', blog:'Blog' },
  fa:{ position:'در تقاطع فناوری، تجارت دیجیتال و عملیات جهانی، سیستم‌های اجرایی می‌سازم.', connect:'ارتباطات', ecosystem:'اکوسیستم', contact:'تماس', blog:'وبلاگ' },
  zh:{ position:'在技术、数字商业与全球运营之间构建可执行、可衡量的系统。', connect:'连接', ecosystem:'业务生态', contact:'联系', blog:'博客' },
  vi:{ position:'Xây dựng các hệ thống vận hành giữa công nghệ, thương mại số và hoạt động toàn cầu.', connect:'Kết nối', ecosystem:'Hệ sinh thái', contact:'Liên hệ', blog:'Blog' },
}[locale] ?? { position:'Building working systems across technology, digital commerce and global operations.', connect:'Connect', ecosystem:'Ecosystem', contact:'Contact', blog:'Blog' });
const ctseg = locale === 'tr' ? 'https://ctseg.com.tr/' : locale === 'fa' ? 'https://ctseg.com.tr/fa/' : locale === 'zh' ? 'https://ctseg.com.tr/zh/' : locale === 'vi' ? 'https://ctseg.com.tr/vi/' : 'https://ctseg.com.tr/en/';
const legal = ({
  tr:{privacy:'Gizlilik Politikası',cookies:'Çerez Politikası',terms:'Kullanım Koşulları',kvkk:'KVKK Aydınlatma Metni',rights:'© 2026 Teyfik Gökdemir. Tüm hakları saklıdır.'},
  en:{privacy:'Privacy Policy',cookies:'Cookie Policy',terms:'Terms of Use',rights:'© 2026 Teyfik Gökdemir. All rights reserved.'},
  ru:{privacy:'Политика конфиденциальности',cookies:'Политика cookie',terms:'Условия использования',rights:'© 2026 Teyfik Gökdemir. Все права защищены.'},
  fa:{privacy:'سیاست حفظ حریم خصوصی',cookies:'سیاست کوکی',terms:'شرایط استفاده',rights:'© 2026 Teyfik Gökdemir. تمامی حقوق محفوظ است.'},
  mk:{privacy:'Политика за приватност',cookies:'Политика за колачиња',terms:'Услови за користење',rights:'© 2026 Teyfik Gökdemir. Сите права се задржани.'},
  sr:{privacy:'Politika privatnosti',cookies:'Politika kolačića',terms:'Uslovi korišćenja',rights:'© 2026 Teyfik Gökdemir. Sva prava zadržana.'},
  sq:{privacy:'Politika e Privatësisë',cookies:'Politika e Cookies',terms:'Kushtet e Përdorimit',rights:'© 2026 Teyfik Gökdemir. Të gjitha të drejtat e rezervuara.'},
  zh:{privacy:'隐私政策',cookies:'Cookie 政策',terms:'使用条款',rights:'© 2026 Teyfik Gökdemir. 保留所有权利。'},
  vi:{privacy:'Chính sách bảo mật',cookies:'Chính sách Cookie',terms:'Điều khoản sử dụng',rights:'© 2026 Teyfik Gökdemir. Bảo lưu mọi quyền.'}
}[locale] ?? {privacy:'Privacy Policy',cookies:'Cookie Policy',terms:'Terms of Use',rights:'© 2026 Teyfik Gökdemir. All rights reserved.'});
const legalPrivacy = locale === 'tr' ? '/privacy-policy/' : `/${locale}/privacy-policy/`;
const legalTerms = locale === 'tr' ? '/terms/' : `/${locale}/terms/`;
const legalCookie = legalPrivacy;
const blogUrl = locale === 'tr' ? '/blog/' : `/${locale}/blog/`;
const social = [['LinkedIn',site.links.linkedin],['Instagram',site.links.instagram],['GitHub',site.links.github]] as const;
const ecosystem = [
  ['QCT Studio',site.links.qctStudio],['QCT Commerce',site.links.qctCommerce],['CTSEG',ctseg],['Growth OS','https://growth.teyfikgokdemir.com'],['Mythborn',site.links.mythborn],['Olivon','https://olivon.com.tr']
] as const;
---
<SitewidePalette />
<footer class="tg-footer">
  <div class="footer-grid">
    <div class="footer-intro">
      <a href="#top" class="footer-brand" aria-label="Teyfik Gökdemir">
        <picture><source srcset="/brand/teyfik-gokdemir-signature.webp" type="image/webp"/><img src="/brand/teyfik-gokdemir-signature.png" width="380" height="102" alt="Teyfik Gökdemir" loading="lazy" decoding="async"/></picture>
      </a>
      <p>{text.position}</p>
      <a class="footer-cta" href={`https://wa.me/${site.whatsapp}`} target="_blank" rel="noopener noreferrer"><span>{text.contact}</span><svg aria-hidden="true" viewBox="0 0 16 16" width="14" height="14"><path d="M3 8h10M9 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
    </div>
    <div class="footer-group">
      <span class="footer-label">{text.connect}</span>
      <nav aria-label={text.connect}><a href={blogUrl}><span>{text.blog}</span><span aria-hidden="true"></span></a>{social.map(([name,href]) => <a href={href} target="_blank" rel="noopener noreferrer"><span>{name}</span><span aria-hidden="true"></span></a>)}</nav>
    </div>
    <div class="footer-group footer-group--ecosystem">
      <span class="footer-label">{text.ecosystem}</span>
      <nav aria-label={text.ecosystem}>{ecosystem.map(([name,href]) => <a href={href} target="_blank" rel="noopener noreferrer"><span>{name}</span><span aria-hidden="true"></span></a>)}</nav>
    </div>
    <div class="footer-group footer-group--contact">
      <span class="footer-label">{text.contact}</span>
      <nav aria-label={text.contact}>
        <a href={`mailto:${site.email}`}>{site.email}</a>
        <a href={`mailto:${site.directEmail}`}>{site.directEmail}</a>
        <a href={`https://wa.me/${site.whatsapp}`} target="_blank" rel="noopener noreferrer"><span>WhatsApp</span><span aria-hidden="true"></span></a>
      </nav>
    </div>
  </div>
  <div class="footer-bottom">
    <span class="footer-rights">{legal.rights}</span>
    <nav class="footer-legal" aria-label="Legal">
      <a href={legalPrivacy}>{legal.privacy}</a>
      <a href={legalCookie}>{legal.cookies}</a>
      <a href={legalTerms}>{legal.terms}</a>
      {locale === 'tr' && <a href="/kvkk/">{legal.kvkk}</a>}
    </nav>
  </div>
</footer>
<style>
.tg-footer{position:relative;border-top:1px solid rgba(212,175,106,.22);background:radial-gradient(70% 120% at 0% 0%,rgba(30,62,122,.28) 0%,rgba(6,11,22,0) 60%),#060b16;color:#f4f1ea;padding:clamp(56px,6vw,88px) 0 28px}
.tg-footer::before{content:"";position:absolute;inset:0 0 auto 0;height:1px;background:linear-gradient(90deg,transparent,rgba(212,175,106,.7),transparent);opacity:.55}
.footer-grid,.footer-bottom{max-width:1360px;margin-inline:auto;padding-inline:clamp(18px,3.2vw,44px)}
.footer-grid{display:grid;grid-template-columns:minmax(260px,1.3fr) minmax(140px,.6fr) minmax(240px,1.1fr) minmax(200px,.9fr);gap:clamp(28px,4vw,64px);align-items:start}
.footer-brand{display:block;width:min(300px,100%)}
.footer-brand picture,.footer-brand img{display:block;width:100%;height:auto}
.footer-intro p{max-width:38ch;margin:20px 0 0;color:#9fb0cb;line-height:1.7;font-size:.96rem;text-wrap:pretty}
.footer-cta{display:inline-flex;align-items:center;gap:10px;margin-top:26px;padding:12px 20px;border-radius:999px;background:linear-gradient(135deg,#e6ca92 0%,#c79f56 100%);color:#060c18!important;font-weight:700;font-size:.86rem;letter-spacing:.02em;text-decoration:none;transition:transform .2s ease,box-shadow .2s ease}
.footer-cta:hover{transform:translateY(-2px);box-shadow:0 12px 28px rgba(212,175,106,.28)}
.footer-cta svg{transition:transform .2s ease}.footer-cta:hover svg{transform:translateX(3px)}
.footer-label{display:block;color:#d4af6a;font-size:.68rem;letter-spacing:.16em;text-transform:uppercase;margin:0 0 20px;font-weight:700}
.footer-group nav{display:flex;flex-direction:column;align-items:flex-start;gap:6px}
.footer-group a{position:relative;display:inline-flex;align-items:center;gap:9px;padding:5px 0;color:#d2dced;text-decoration:none;font-size:.92rem;line-height:1.4;overflow-wrap:anywhere;transition:color .18s ease,transform .18s ease}
.footer-group a:hover{color:#e6ca92;transform:translateX(3px)}
.footer-group a span:last-child:empty{display:none}
.footer-group--ecosystem nav{display:grid;grid-template-columns:1fr 1fr;gap:6px 24px}
.footer-bottom{display:flex;align-items:center;justify-content:space-between;gap:16px 32px;flex-wrap:wrap;margin-top:clamp(40px,5vw,64px);padding-block:22px 0;padding-inline-end:max(clamp(18px,3.2vw,44px),84px);position:relative;color:#8fa0bc;font-size:.78rem}
.footer-bottom::before{content:"";position:absolute;top:0;inset-inline:clamp(18px,3.2vw,44px);height:1px;background:#17274a}
.footer-rights{flex:0 1 auto}
.footer-legal{display:flex;align-items:center;flex-wrap:wrap;gap:8px 22px}
.footer-legal a{color:#b5c3db;text-decoration:none;transition:color .18s ease}
.footer-legal a:hover{color:#e6ca92}
@media(max-width:1024px){.footer-grid{grid-template-columns:1fr 1fr;gap:40px 32px}.footer-intro{grid-column:1/-1}.footer-intro p{max-width:56ch}.footer-group--ecosystem{grid-column:1/-1}.footer-group--ecosystem nav{grid-template-columns:repeat(3,minmax(0,1fr))}.footer-group--contact{grid-column:auto}}
@media(max-width:680px){.tg-footer{padding-top:48px}.footer-grid{grid-template-columns:1fr 1fr;gap:34px 20px}.footer-group--ecosystem nav{grid-template-columns:1fr 1fr}.footer-group--contact{grid-column:1/-1}.footer-brand{width:240px}.footer-cta{width:100%;justify-content:center}.footer-bottom{flex-direction:column;align-items:flex-start;gap:12px;padding-inline-end:clamp(18px,3.2vw,44px);padding-bottom:88px}.footer-legal{gap:8px 18px}}
@media(max-width:380px){.footer-grid{grid-template-columns:1fr}.footer-group--ecosystem nav{grid-template-columns:1fr 1fr}}
@media(prefers-reduced-motion:reduce){.footer-group a,.footer-cta,.footer-cta svg{transition:none}.footer-group a:hover,.footer-cta:hover{transform:none}}
</style>