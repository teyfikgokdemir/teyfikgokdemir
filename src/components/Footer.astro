---
import type { SiteContent } from '../i18n/content';
import { site } from '../data/site';

interface Props {
  copy: SiteContent;
}

const { copy } = Astro.props;

const socialLinks = [
  ['LinkedIn', site.links.linkedin],
  ['Instagram', site.links.instagram],
  ['GitHub', site.links.github],
] as const;

const ventureLinks = [
  ['QCT Studio', site.links.qctStudio],
  ['QCT Commerce', site.links.qctCommerce],
  ['Mythborn', site.links.mythborn],
] as const;

const whatsappUrl =
  `https://wa.me/${site.whatsapp}?text=` +
  encodeURIComponent(
    'Hello Teyfik, I am contacting you through teyfikgokdemir.com.'
  );
---
<footer class="site-footer premium-footer">
  <div class="premium-footer__inner">
    <div class="premium-footer__intro">
      <a
        class="footer-brand"
        href="#top"
        aria-label="Teyfik Gökdemir"
      >
        <img
          class="footer-brand__logo"
          src="/images/teyfik-gokdemir-monogram.svg"
          width="64"
          height="64"
          alt=""
          aria-hidden="true"
          loading="lazy"
          decoding="async"
        />

        <span>Teyfik Gökdemir</span>
      </a>

      <p class="premium-footer__position">
        Digital commerce, AI operations and growth systems.
      </p>

      <span
        class="footer-ladybug"
        aria-hidden="true"
        title="Uğur böceğim"
      >
        <svg
          viewBox="0 0 48 48"
          width="28"
          height="28"
          focusable="false"
        >
          <path
            class="footer-ladybug__antenna"
            d="M18 13c-3-4-6-5-9-4M30 13c3-4 6-5 9-4"
          />
          <circle
            class="footer-ladybug__head"
            cx="24"
            cy="15"
            r="7"
          />
          <path
            class="footer-ladybug__wing"
            d="M24 19C15 13 7 20 8 31c1 9 8 12 16 8V19Z"
          />
          <path
            class="footer-ladybug__wing"
            d="M24 19c9-6 17 1 16 12-1 9-8 12-16 8V19Z"
          />
          <path
            class="footer-ladybug__divider"
            d="M24 19v20"
          />
          <circle class="footer-ladybug__spot" cx="16" cy="25" r="2.2" />
          <circle class="footer-ladybug__spot" cx="16" cy="33" r="2.2" />
          <circle class="footer-ladybug__spot" cx="32" cy="25" r="2.2" />
          <circle class="footer-ladybug__spot" cx="32" cy="33" r="2.2" />
        </svg>
      </span>
    </div>

    <div class="premium-footer__groups">
      <div class="premium-footer__group">
        <span class="premium-footer__label">Connect</span>

        <nav aria-label="Social links">
          {socialLinks.map(([label, href]) => (
            <a
              href={href}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={label + ', ' + copy.a11y.external}
            >
              <span>{label}</span>
              <span aria-hidden="true">↗</span>
            </a>
          ))}
        </nav>
      </div>

      <div class="premium-footer__group">
        <span class="premium-footer__label">Ventures</span>

        <nav aria-label="Venture links">
          {ventureLinks.map(([label, href]) => (
            <a
              href={href}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={label + ', ' + copy.a11y.external}
            >
              <span>{label}</span>
              <span aria-hidden="true">↗</span>
            </a>
          ))}
        </nav>
      </div>

      <div class="premium-footer__group premium-footer__group--contact">
        <span class="premium-footer__label">Contact</span>

        <nav aria-label="Contact links">
          <a href={'mailto:' + site.email}>
            <span>{site.email}</span>
          </a>

          <a href={'mailto:' + site.directEmail}>
            <span>{site.directEmail}</span>
          </a>

          <a
            href={whatsappUrl}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={'WhatsApp, ' + copy.a11y.external}
          >
            <span>WhatsApp</span>
            <span aria-hidden="true">↗</span>
          </a>
        </nav>
      </div>
    </div>
  </div>

  <div class="premium-footer__bottom">
    <p class="premium-footer__rights">{copy.footer.rights}</p>
  </div>
</footer>

<style>
  .premium-footer {
    display: block;
    width: 100%;
    overflow: hidden;
    background:
      radial-gradient(
        circle at 18% 12%,
        rgba(18, 52, 83, 0.18),
        transparent 38%
      ),
      #06111f;
  }

  .premium-footer__inner {
    width: min(1460px, calc(100% - 80px));
    margin-inline: auto;
    display: grid;
    grid-template-columns:
      minmax(360px, 1.15fr)
      minmax(680px, 2fr);
    gap: clamp(72px, 8vw, 150px);
    align-items: start;
  }

  .premium-footer__intro {
    min-width: 0;
  }

  .footer-brand {
    display: inline-flex;
    align-items: center;
    gap: 28px;
    color: inherit;
    text-decoration: none;
    white-space: nowrap;
  }

  .footer-brand__logo {
    display: block;
    width: 92px;
    height: 92px;
    flex: 0 0 92px;
    object-fit: contain;
  }

  .footer-brand span {
    font-size: clamp(1.65rem, 2.2vw, 2.35rem);
    font-weight: 500;
    letter-spacing: -0.025em;
  }

  .premium-footer__position {
    width: auto;
    max-width: 410px;
    margin: 26px 0 0;
    font-size: clamp(1rem, 1.25vw, 1.18rem);
    line-height: 1.65;
    white-space: normal;
  }

  .premium-footer__groups {
    display: grid;
    grid-template-columns:
      minmax(150px, 0.8fr)
      minmax(190px, 1fr)
      minmax(310px, 1.55fr);
    gap: clamp(42px, 5vw, 90px);
    min-width: 0;
  }

  .premium-footer__group {
    display: flex;
    min-width: 0;
    flex-direction: column;
    align-items: flex-start;
    text-align: left;
  }

  .premium-footer__label {
    margin-bottom: 24px;
    color: #dfad5c;
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .premium-footer__group nav {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 22px;
  }

  .premium-footer__group nav a {
    display: inline-flex;
    width: auto;
    max-width: 100%;
    align-items: center;
    justify-content: flex-start;
    gap: 12px;
    color: inherit;
    text-align: left;
    text-decoration: none;
    white-space: nowrap;
    overflow-wrap: normal;
    word-break: normal;
    transition:
      color 180ms ease,
      transform 180ms ease;
  }

  .premium-footer__group nav a:hover {
    color: #e4b35f;
    transform: translateX(3px);
  }

  .premium-footer__group nav a span:last-child {
    color: #dfad5c;
  }

  .premium-footer__group--contact nav a {
    font-size: clamp(0.92rem, 1vw, 1.03rem);
  }

  .footer-ladybug {
    display: inline-flex;
    width: 42px;
    height: 42px;
    margin-top: 20px;
    align-items: center;
    justify-content: center;
    opacity: 0.9;
    transform: rotate(-8deg);
    transition:
      opacity 180ms ease,
      transform 180ms ease;
  }

  .footer-ladybug svg {
    display: block;
    overflow: visible;
  }

  .footer-ladybug__antenna {
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    opacity: 0.78;
  }

  .footer-ladybug__head,
  .footer-ladybug__spot {
    fill: currentColor;
  }

  .footer-ladybug__wing {
    fill: #d65243;
    stroke: currentColor;
    stroke-width: 1.6;
  }

  .footer-ladybug__divider {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.7;
    stroke-linecap: round;
  }

  .premium-footer__intro:hover .footer-ladybug {
    opacity: 1;
    transform: rotate(0deg) translateY(-2px);
  }

  .premium-footer__bottom {
    display: block;
    width: min(1460px, calc(100% - 80px));
    max-width: none;
    margin: 64px auto 0;
    padding: 32px 0 8px;
    border-top: 1px solid rgba(255, 255, 255, 0.11);
    text-align: center;
  }

  .premium-footer__bottom .premium-footer__rights {
    display: block;
    width: 100%;
    max-width: none;
    margin: 0;
    text-align: center;
    white-space: nowrap;
  }

  @media (max-width: 1180px) {
    .premium-footer__inner {
      grid-template-columns: 1fr;
      gap: 58px;
    }

    .premium-footer__groups {
      grid-template-columns:
        minmax(150px, 0.8fr)
        minmax(180px, 0.95fr)
        minmax(290px, 1.4fr);
    }
  }

  @media (max-width: 760px) {
    .premium-footer__inner,
    .premium-footer__bottom {
      width: min(100% - 40px, 1460px);
    }

    .footer-brand {
      gap: 18px;
    }

    .footer-brand__logo {
      width: 68px;
      height: 68px;
      flex-basis: 68px;
    }

    .premium-footer__groups {
      grid-template-columns: 1fr;
      gap: 38px;
    }

    .premium-footer__group,
    .premium-footer__group nav {
      align-items: flex-start;
      text-align: left;
    }

    .premium-footer__group nav a {
      white-space: normal;
      overflow-wrap: anywhere;
    }

    .premium-footer__bottom .premium-footer__rights {
      white-space: normal;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .premium-footer__group nav a,
    .footer-ladybug {
      transition: none;
    }

    .premium-footer__group nav a:hover {
      transform: none;
    }

    .premium-footer__intro:hover .footer-ladybug {
      transform: rotate(-8deg);
    }
  }
</style>