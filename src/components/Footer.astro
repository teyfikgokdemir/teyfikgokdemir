---
import type { SiteContent } from '../i18n/content';
import { site } from '../data/site';

interface Props {
  copy: SiteContent;
}

const { copy } = Astro.props;

const links = [
  ['LinkedIn', site.links.linkedin],
  ['Instagram', site.links.instagram],
  ['GitHub', site.links.github],
  ['QCT Studio', site.links.qctStudio],
  ['QCT Commerce', site.links.qctCommerce],
  ['Mythborn', site.links.mythborn],
] as const;

const whatsappUrl =
  `https://wa.me/${site.whatsapp}?text=` +
  encodeURIComponent(
    'Hello Teyfik, I am contacting you through teyfikgokdemir.com.'
  );
---
<footer class="site-footer">
  <div>
    <a class="footer-brand" href="#top">Teyfik Gökdemir</a>
    <p>{copy.footer.rights}</p>
  </div>

  <nav aria-label={copy.footer.links}>
    {links.map(([label, href]) => (
      <a
        href={href}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={label + ', ' + copy.a11y.external}
      >
        {label}<span aria-hidden="true">↗</span>
      </a>
    ))}

    <a
      href={whatsappUrl}
      target="_blank"
      rel="noopener noreferrer"
      aria-label={'WhatsApp, ' + copy.a11y.external}
    >
      WhatsApp<span aria-hidden="true">↗</span>
    </a>

    <a href={'mailto:' + site.email}>{site.email}</a>
    <a href={'mailto:' + site.directEmail}>{site.directEmail}</a>
  </nav>
</footer>