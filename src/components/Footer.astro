---
import type { SiteContent } from '../i18n/content';
import type { Locale } from '../i18n/locales';
import { site } from '../data/site';

interface Props {
  copy: SiteContent;
  locale: Locale;
}

const { copy, locale } = Astro.props;

const footerText = {
  tr: { connect: 'Bağlantılar', ventures: 'Yapılar', contact: 'İletişim', position: 'CTSEG kurucusu · Uluslararası ticaret ve stratejik tedarik sistemleri.' },
  en: { connect: 'Connect', ventures: 'Organizations', contact: 'Contact', position: 'Founder of CTSEG · International trade and strategic sourcing systems.' },
  mk: { connect: 'Поврзување', ventures: 'Организации', contact: 'Контакт', position: 'Основач на CTSEG · Меѓународна трговија и стратешко снабдување.' },
  sr: { connect: 'Povezivanje', ventures: 'Organizacije', contact: 'Kontakt', position: 'Osnivač CTSEG-a · Međunarodna trgovina i strateška nabavka.' },
  sq: { connect: 'Lidhje', ventures: 'Organizata', contact: 'Kontakt', position: 'Themelues i CTSEG · Tregti ndërkombëtare dhe furnizim strategjik.' },
  fa: { connect: 'ارتباطات', ventures: 'سازمان‌ها', contact: 'تماس', position: 'بنیان‌گذار CTSEG · تجارت بین‌المللی و تأمین راهبردی.' },
} as const;

const footer = footerText[locale] ?? footerText.en;

const socialLinks = [
  ['LinkedIn', site.links.linkedin],
  ['Instagram', site.links.instagram],
  ['GitHub', site.links.github],
] as const;

const ctsegUrl = locale === 'tr'
  ? 'https://ctseg.com.tr/'
  : locale === 'fa'
    ? 'https://ctseg.com.tr/fa/tamin-beynolmelali-iran/'
    : 'https://ctseg.com.tr/en/';

const ventureLinks = [
  ['CTSEG', ctsegUrl],
  ['QCT Studio', site.links.qctStudio],
  ['QCT Commerce', site.links.qctCommerce],
  ['Mythborn', site.links.mythborn],
] as const;

const whatsappUrl =
  `https://wa.me/${site.whatsapp}?text=` +
  encodeURIComponent(
    'Hello Teyfik, I am contacting you through teyfikgokdemir.com.'
  );
---
<footer class="site-footer premium-footer">
  <div class="premium-footer__inner">
    <div class="premium-footer__intro">
      <a
        class="footer-brand"
        href="#top"
        aria-label="Teyfik Gökdemir"
      >
        <img
          class="footer-brand__logo"
          src="/images/teyfik-gokdemir-tg-logo-transparent.png?v=7"
          width="64"
          height="64"
          alt=""
          aria-hidden="true"
          loading="lazy"
          decoding="async"
        />

        <span>Teyfik Gökdemir</span>
      </a>

      <p class="premium-footer__position">
        {footer.position}
      </p>

      <span
        class="footer-ladybug"
        aria-hidden="true"
        title="Uğur böceğim"
      >
        <svg
          viewBox="0 0 48 48"
          width="28"
          height="28"
          focusable="false"
        >
          <path
            class="footer-ladybug__antenna"
            d="M18 13c-3-4-6-5-9-4M30 13c3-4 6-5 9-4"
          />
          <circle
            class="footer-ladybug__head"
            cx="24"
            cy="15"
            r="7"
          />
          <path
            class="footer-ladybug__wing"
            d="M24 19C15 13 7 20 8 31c1 9 8 12 16 8V19Z"
          />
          <path
            class="footer-ladybug__wing"
            d="M24 19c9-6 17 1 16 12-1 9-8 12-16 8V19Z"
          />
          <path
            class="footer-ladybug__divider"
            d="M24 19v20"
          />
          <circle class="footer-ladybug__spot" cx="16" cy="25" r="2.2" />
          <circle class="footer-ladybug__spot" cx="16" cy="33" r="2.2" />
          <circle class="footer-ladybug__spot" cx="32" cy="25" r="2.2" />
          <circle class="footer-ladybug__spot" cx="32" cy="33" r="2.2" />
        </svg>
      </span>
    </div>

    <div class="premium-footer__groups">
      <div class="premium-footer__group">
        <span class="premium-footer__label">{footer.connect}</span>

        <nav aria-label="Social links">
          {socialLinks.map(([label, href]) => (
            <a
              href={href}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={label + ', ' + copy.a11y.external}
            >
              <span>{label}</span>
              <span aria-hidden="true">↗</span>
            </a>
          ))}
        </nav>
      </div>

      <div class="premium-footer__group">
        <span class="premium-footer__label">{footer.ventures}</span>

        <nav aria-label="Venture links">
          {ventureLinks.map(([label, href]) => (
            <a
              href={href}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={label + ', ' + copy.a11y.external}
            >
              <span>{label}</span>
              <span aria-hidden="true">↗</span>
            </a>
          ))}
        </nav>
      </div>

      <div class="premium-footer__group premium-footer__group--contact">
        <span class="premium-footer__label">{footer.contact}</span>

        <nav aria-label="Contact links">
          <a href={'mailto:' + site.email}>
            <span>{site.email}</span>
          </a>

          <a href={'mailto:' + site.directEmail}>
            <span>{site.directEmail}</span>
          </a>

          <a
            href={whatsappUrl}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={'WhatsApp, ' + copy.a11y.external}
          >
            <span>WhatsApp</span>
            <span aria-hidden="true">↗</span>
          </a>
        </nav>
      </div>
    </div>
  </div>

  <div class="premium-footer__bottom">
    <p class="premium-footer__rights">{copy.footer.rights}</p>
  </div>
</footer>

<style>
  .premium-footer {
    display: block;
    width: 100%;
    overflow: hidden;
    padding: 86px 0 54px;
    --text: #f3eee6;
    --muted: #c9bfb2;
    color: var(--text);
    background: var(--surface-dark);
  }

  .premium-footer__inner {
    width: min(1440px, calc(100% - 96px));
    margin-inline: auto;
    display: grid;
    grid-template-columns:
      minmax(390px, 1.2fr)
      minmax(0, 2fr);
    gap: clamp(80px, 8vw, 150px);
    align-items: start;
  }

  .premium-footer__intro {
    min-width: 0;
  }

  .footer-brand {
    display: inline-flex;
    align-items: center;
    gap: 34px;
    color: inherit;
    text-decoration: none;
    white-space: nowrap;
  }

  .footer-brand__logo {
    display: block;
    width: 112px;
    height: 112px;
    flex: 0 0 112px;
    object-fit: contain;
  }

  .footer-brand span {
    font-size: clamp(2rem, 2.35vw, 2.6rem);
    font-weight: 500;
    letter-spacing: -0.035em;
  }

  .premium-footer__position {
    width: auto;
    max-width: 410px;
    margin: 28px 0 0;
    font-size: clamp(1rem, 1.25vw, 1.18rem);
    line-height: 1.68;
    white-space: normal;
  }

  .premium-footer__groups {
    display: grid;
    grid-template-columns:
      minmax(120px, 0.8fr)
      minmax(150px, 1fr)
      minmax(250px, 1.55fr);
    gap: clamp(28px, 3.5vw, 56px);
    min-width: 0;
  }

  .premium-footer__group {
    display: flex;
    min-width: 0;
    flex-direction: column;
    align-items: flex-start;
    text-align: left;
  }

  .premium-footer__label {
    margin-bottom: 28px;
    color: #d78263;
    font-size: 0.84rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .premium-footer__group nav {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 25px;
  }

  .premium-footer__group nav a {
    display: inline-flex;
    width: auto;
    max-width: 100%;
    align-items: center;
    justify-content: flex-start;
    gap: 12px;
    color: inherit;
    text-align: left;
    text-decoration: none;
    white-space: nowrap;
    overflow-wrap: normal;
    word-break: normal;
    transition:
      color 180ms ease;
  }

  .premium-footer__group nav a:hover {
    color: #f3eee6;
  }

  .premium-footer__group nav a span:last-child {
    color: #d78263;
  }

  .premium-footer__group--contact nav a {
    font-size: clamp(0.92rem, 1vw, 1.04rem);
  }

  .footer-ladybug {
    display: inline-flex;
    width: 43px;
    height: 43px;
    margin-top: 19px;
    align-items: center;
    justify-content: center;
    opacity: 0.92;
    transform: rotate(-8deg);
    transition:
      opacity 180ms ease,
      transform 180ms ease;
  }

  .footer-ladybug svg {
    display: block;
    overflow: visible;
  }

  .footer-ladybug__antenna {
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
  }

  .footer-ladybug__head,
  .footer-ladybug__spot {
    fill: currentColor;
  }

  .footer-ladybug__wing {
    fill: #d65243;
    stroke: currentColor;
    stroke-width: 1.6;
  }

  .footer-ladybug__divider {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.7;
    stroke-linecap: round;
  }

  .premium-footer__intro:hover .footer-ladybug {
    opacity: 1;
    transform: rotate(0deg) translateY(-2px);
  }

  .premium-footer__bottom {
    display: block;
    width: min(1440px, calc(100% - 96px));
    margin: 72px auto 0;
    padding-top: 34px;
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    text-align: center;
  }

  .premium-footer__bottom .premium-footer__rights {
    display: block;
    width: 100%;
    max-width: none;
    margin: 0;
    text-align: center;
    white-space: nowrap;
  }

  @media (max-width: 1180px) {
    .premium-footer__inner {
      grid-template-columns: 1fr;
      gap: 62px;
    }

    .premium-footer__groups {
      grid-template-columns:
        minmax(150px, 0.8fr)
        minmax(190px, 1fr)
        minmax(310px, 1.45fr);
    }
  }

  @media (max-width: 760px) {
    .premium-footer {
      padding: 64px 0 40px;
    }

    .premium-footer__inner,
    .premium-footer__bottom {
      width: min(100% - 40px, 1440px);
    }

    .footer-brand {
      gap: 20px;
    }

    .footer-brand__logo {
      width: 76px;
      height: 76px;
      flex-basis: 76px;
    }

    .footer-brand span {
      font-size: 1.7rem;
    }

    .premium-footer__groups {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    .premium-footer__group,
    .premium-footer__group nav {
      align-items: flex-start;
      text-align: left;
    }

    .premium-footer__group nav a {
      white-space: normal;
      overflow-wrap: anywhere;
    }

    .premium-footer__bottom {
      margin-top: 54px;
    }

    .premium-footer__bottom .premium-footer__rights {
      white-space: normal;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .premium-footer__group nav a,
    .footer-ladybug {
      transition: none;
    }

    .premium-footer__group nav a:hover {
      transform: none;
    }

    .premium-footer__intro:hover .footer-ladybug {
      transform: rotate(-8deg);
    }
  }
</style>
