---
import type { SiteContent } from '../i18n/content';
import type { Locale } from '../i18n/locales';
import { site } from '../data/site';
import SitewidePalette from './SitewidePalette.astro';

interface Props { copy: SiteContent; locale?: Locale | 'fa'; }
const { copy, locale = 'en' } = Astro.props;
const text = ({
  tr:{ position:'Teknoloji, dijital ticaret ve küresel operasyonlar arasında çalışan sistemler kuruyorum.', connect:'Bağlantılar', ecosystem:'Ekosistem', contact:'İletişim' },
  en:{ position:'Building working systems across technology, digital commerce and global operations.', connect:'Connect', ecosystem:'Ecosystem', contact:'Contact' },
  ru:{ position:'Создаю работающие системы на стыке технологий, цифровой коммерции и глобальных операций.', connect:'Связи', ecosystem:'Экосистема', contact:'Контакты' },
  mk:{ position:'Градам функционални системи меѓу технологија, дигитална трговија и глобални операции.', connect:'Поврзување', ecosystem:'Екосистем', contact:'Контакт' },
  sr:{ position:'Gradim funkcionalne sisteme između tehnologije, digitalne trgovine i globalnih operacija.', connect:'Povezivanje', ecosystem:'Ekosistem', contact:'Kontakt' },
  sq:{ position:'Ndërtoj sisteme funksionale mes teknologjisë, tregtisë digjitale dhe operacioneve globale.', connect:'Lidhje', ecosystem:'Ekosistemi', contact:'Kontakt' },
  fa:{ position:'در تقاطع فناوری، تجارت دیجیتال و عملیات جهانی، سیستم‌های اجرایی می‌سازم.', connect:'ارتباطات', ecosystem:'اکوسیستم', contact:'تماس' },
  zh:{ position:'在技术、数字商业与全球运营之间构建可执行、可衡量的系统。', connect:'连接', ecosystem:'业务生态', contact:'联系' },
  vi:{ position:'Xây dựng các hệ thống vận hành giữa công nghệ, thương mại số và hoạt động toàn cầu.', connect:'Kết nối', ecosystem:'Hệ sinh thái', contact:'Liên hệ' },
}[locale] ?? { position:'Building working systems across technology, digital commerce and global operations.', connect:'Connect', ecosystem:'Ecosystem', contact:'Contact' });
const ctseg = locale === 'tr' ? 'https://ctseg.com.tr/' : locale === 'fa' ? 'https://ctseg.com.tr/fa/' : locale === 'zh' ? 'https://ctseg.com.tr/zh/' : locale === 'vi' ? 'https://ctseg.com.tr/vi/' : 'https://ctseg.com.tr/en/';
const legal = ({
  tr:{privacy:'Gizlilik Politikası',cookies:'Çerez Politikası',terms:'Kullanım Koşulları',kvkk:'KVKK Aydınlatma Metni',rights:'© 2026 Teyfik Gökdemir. Tüm hakları saklıdır.'},
  en:{privacy:'Privacy Policy',cookies:'Cookie Policy',terms:'Terms of Use',rights:'© 2026 Teyfik Gökdemir. All rights reserved.'},
  ru:{privacy:'Политика конфиденциальности',cookies:'Политика cookie',terms:'Условия использования',rights:'© 2026 Teyfik Gökdemir. Все права защищены.'},
  fa:{privacy:'سیاست حفظ حریم خصوصی',cookies:'سیاست کوکی',terms:'شرایط استفاده',rights:'© 2026 Teyfik Gökdemir. تمامی حقوق محفوظ است.'},
  mk:{privacy:'Политика за приватност',cookies:'Политика за колачиња',terms:'Услови за користење',rights:'© 2026 Teyfik Gökdemir. Сите права се задржани.'},
  sr:{privacy:'Politika privatnosti',cookies:'Politika kolačića',terms:'Uslovi korišćenja',rights:'© 2026 Teyfik Gökdemir. Sva prava zadržana.'},
  sq:{privacy:'Politika e Privatësisë',cookies:'Politika e Cookies',terms:'Kushtet e Përdorimit',rights:'© 2026 Teyfik Gökdemir. Të gjitha të drejtat e rezervuara.'},
  zh:{privacy:'隐私政策',cookies:'Cookie 政策',terms:'使用条款',rights:'© 2026 Teyfik Gökdemir. 保留所有权利。'},
  vi:{privacy:'Chính sách bảo mật',cookies:'Chính sách Cookie',terms:'Điều khoản sử dụng',rights:'© 2026 Teyfik Gökdemir. Bảo lưu mọi quyền.'}
}[locale] ?? {privacy:'Privacy Policy',cookies:'Cookie Policy',terms:'Terms of Use',rights:'© 2026 Teyfik Gökdemir. All rights reserved.'});
const legalPrivacy = locale === 'tr' ? '/privacy-policy/' : `/${locale}/privacy-policy/`;
const legalTerms = locale === 'tr' ? '/terms/' : `/${locale}/terms/`;
const legalCookie = legalPrivacy;
const social = [['LinkedIn',site.links.linkedin],['Instagram',site.links.instagram],['GitHub',site.links.github]] as const;
const ecosystem = [
  ['QCT Studio',site.links.qctStudio],['QCT Commerce',site.links.qctCommerce],['CTSEG',ctseg],['Growth OS','https://growth.teyfikgokdemir.com'],['Mythborn',site.links.mythborn],['Olivon','https://olivon.com.tr']
] as const;
---
<SitewidePalette />
<footer class="tg-footer">
  <div class="footer-grid">
    <div class="footer-intro">
      <a href="#top" class="footer-brand" aria-label="Teyfik Gökdemir">
        <picture><source srcset="/brand/teyfik-gokdemir-signature.webp" type="image/webp"/><img src="/brand/teyfik-gokdemir-signature.png" width="380" height="102" alt="Teyfik Gökdemir" loading="lazy" decoding="async"/></picture>
      </a>
      <p>{text.position}</p>
    </div>
    <div class="footer-group">
      <span class="footer-label">{text.connect}</span>
      <nav aria-label={text.connect}>{social.map(([name,href]) => <a href={href} target="_blank" rel="noopener noreferrer"><span>{name}</span><span aria-hidden="true"></span></a>)}</nav>
    </div>
    <div class="footer-group footer-group--ecosystem">
      <span class="footer-label">{text.ecosystem}</span>
      <nav aria-label={text.ecosystem}>{ecosystem.map(([name,href]) => <a href={href} target="_blank" rel="noopener noreferrer"><span>{name}</span><span aria-hidden="true"></span></a>)}</nav>
    </div>
    <div class="footer-group footer-group--contact">
      <span class="footer-label">{text.contact}</span>
      <nav aria-label={text.contact}>
        <a href={`mailto:${site.email}`}>{site.email}</a>
        <a href={`mailto:${site.directEmail}`}>{site.directEmail}</a>
        <a href={`https://wa.me/${site.whatsapp}`} target="_blank" rel="noopener noreferrer"><span>WhatsApp</span><span aria-hidden="true"></span></a>
      </nav>
    </div>
  </div>
  <div class="footer-bottom">
    <span class="footer-rights">{legal.rights}</span>
    <nav class="footer-legal" aria-label="Legal">
      <a href={legalPrivacy}>{legal.privacy}</a>
      <a href={legalCookie}>{legal.cookies}</a>
      <a href={legalTerms}>{legal.terms}</a>
      {locale === 'tr' && <a href="/kvkk/">{legal.kvkk}</a>}
    </nav>
  </div>
</footer>
<style>
.tg-footer{border-top:1px solid #332a22;background:#0b0b0a;color:#f7efe5;padding:72px 0 34px}.footer-grid,.footer-bottom{width:min(1440px,calc(100% - 72px));margin-inline:auto}.footer-grid{display:grid;grid-template-columns:minmax(300px,1.25fr) .65fr 1fr 1.15fr;gap:clamp(32px,5vw,72px);align-items:start}.footer-brand{display:block;width:min(320px,100%)}.footer-brand picture,.footer-brand img{display:block;width:100%;height:auto}.footer-intro p{max-width:420px;margin:22px 0 0;color:#b7aa9b;line-height:1.7;font-size:.98rem}.footer-label{display:block;color:#d8893a;font-size:.68rem;letter-spacing:.14em;text-transform:uppercase;margin-bottom:22px}.footer-group nav{display:flex;flex-direction:column;align-items:flex-start;gap:15px}.footer-group a{display:inline-flex;align-items:center;gap:9px;color:#d8d2c8;text-decoration:none;font-size:.9rem;line-height:1.4}.footer-group a:hover{color:#e9b66e}.footer-group a span:last-child{color:#d8893a}.footer-bottom{display:flex;align-items:center;justify-content:space-between;gap:32px;margin-top:56px;padding-top:22px;padding-right:110px;border-top:1px solid #332a22;color:#b7aa9b;font-size:.78rem}.footer-rights{flex:0 0 auto;white-space:nowrap}.footer-legal{display:flex;align-items:center;justify-content:flex-end;flex-wrap:wrap;gap:24px}.footer-legal a{color:#d8d2c8;text-decoration:none}.footer-legal a:hover{color:#e9b66e}.footer-group--ecosystem nav{display:grid;grid-template-columns:1fr 1fr;gap:15px 22px}@media(max-width:980px){.footer-grid{grid-template-columns:1.2fr 1fr 1fr}.footer-intro{grid-column:1/-1}.footer-group--ecosystem nav{grid-template-columns:1fr}}@media(max-width:680px){.tg-footer{padding-top:54px}.footer-grid,.footer-bottom{width:calc(100% - 36px)}.footer-grid{grid-template-columns:1fr 1fr;gap:38px 24px}.footer-intro{grid-column:1/-1}.footer-group--contact{grid-column:1/-1}.footer-bottom{flex-direction:column;align-items:flex-start;margin-top:44px;gap:14px;padding-right:0;padding-bottom:88px}.footer-rights{white-space:normal}.footer-legal{justify-content:flex-start;gap:12px 18px}.footer-group a{font-size:.84rem}.footer-brand{width:260px}}
</style>
