---
import BaseLayout from '../layouts/BaseLayout.astro'; import Header from './Header.astro'; import Footer from './Footer.astro'; import FloatingActions from './FloatingActions.astro'; import { content } from '../i18n/content'; import { glassKnowledgePages } from '../data/glass-knowledge';
const {locale='tr'}=Astro.props as {locale?:'tr'|'en'}; const tr=locale==='tr'; const copy=content[locale];
const path=tr?'/blog/turkiyeden-cam-tedariki/':'/en/blog/glass-sourcing-from-turkiye/'; const canonical='https://teyfikgokdemir.com'+path;
const title=tr?'Türkiye’den Cam Tedariği: B2B Satın Alma Rehberi | Teyfik Gökdemir':'Glass Sourcing from Türkiye: B2B Procurement Guide | Teyfik Gökdemir';
const description=tr?'Float, lamine, Low-E ve proje camlarında Türkiye’den B2B tedarik için teknik şartname, RFQ, paketleme, lojistik ve teklif süreci rehberi.':'A B2B guide to sourcing float, laminated, Low-E and project glass from Türkiye: specifications, RFQs, packing, logistics and commercial terms.';
const alt={tr:'https://teyfikgokdemir.com/blog/turkiyeden-cam-tedariki/',en:'https://teyfikgokdemir.com/en/blog/glass-sourcing-from-turkiye/',fa:'https://teyfikgokdemir.com/fa/blog/glass-guide/',ru:'https://teyfikgokdemir.com/ru/blog/glass-guide/',mk:'https://teyfikgokdemir.com/mk/blog/glass-guide/',sr:'https://teyfikgokdemir.com/sr/blog/glass-guide/',sq:'https://teyfikgokdemir.com/sq/blog/glass-guide/',zh:'https://teyfikgokdemir.com/zh/blog/glass-guide/',vi:'https://teyfikgokdemir.com/vi/blog/glass-guide/','x-default':'https://teyfikgokdemir.com/en/blog/glass-sourcing-from-turkiye/'};
const sections=tr?[
['Cam alımında ürün adından önce spesifikasyon gelir','“Float cam” tek başına yeterli bir RFQ değildir. Kalınlık, levha ebadı, renk/şeffaflık, kaplama, lamine yapı, işleme gereksinimi, tolerans ve kullanım alanı teklifin doğruluğunu doğrudan etkiler.'],
['RFQ hangi bilgileri içermeli?','Ürün tipi, kalınlık, ebat, aylık veya proje miktarı, paketleme beklentisi, teslim noktası ve Incoterm açık yazılmalıdır. Teknik çizim veya proje şartnamesi varsa RFQ’ya eklenmelidir.'],
['Konteyner ve lojistik neden ayrı hesaplanmalı?','Cam ağır ve kırılabilir bir üründür. Levha ölçüsü, kasa/palet yapısı, konteyner ağırlık sınırı, elleçleme ve kırılma riski ticari maliyeti değiştirir. Bu nedenle yalnız fabrika çıkış fiyatıyla karşılaştırma yapmak yanıltıcı olabilir.'],
['Türkiye’den cam tedariğinde doğru ticari akış','Önce teknik ihtiyaç normalize edilir, ardından uygun üretim/tedarik kanalı belirlenir. Teklifler aynı teslim şekli ve aynı teknik kapsam üzerinden karşılaştırılır; sonrasında dokümantasyon, yükleme ve teslim planı oluşturulur.'],
['Ticari teklif aşaması','Aktif bir float, lamine, Low-E, solar control, ayna veya proje camı talebi için CTSEG’in <a href="https://ctseg.com.tr/glass/" rel="noopener">cam tedariki ve RFQ merkezi</a> üzerinden teknik talep doğrudan iletilebilir.']
]:[
['Specification comes before the product label','“Float glass” alone is not a complete RFQ. Thickness, sheet dimensions, tint, coating, laminate build-up, processing requirements, tolerances and end use materially affect quotation accuracy.'],
['What should a glass RFQ include?','State the glass type, thickness, dimensions, project or recurring quantity, packing expectations, destination and Incoterm. Attach drawings or project specifications where available.'],
['Why container planning needs separate attention','Glass is heavy and fragile. Sheet size, crate configuration, container weight limits, handling and breakage risk affect landed cost, so EXW price alone is rarely a sufficient comparison.'],
['A practical sourcing flow from Türkiye','Normalize the technical requirement first, then identify the appropriate production and supply route. Compare quotations on the same specification and delivery basis before planning documentation, loading and delivery.'],
['Commercial quotation','For active float, laminated, Low-E, solar-control, mirror or project-glass requirements, use CTSEG’s <a href="https://ctseg.com.tr/en/glass/" rel="noopener">glass sourcing and RFQ hub</a> to submit the technical requirement.']
];
const schema=[{'@type':'BlogPosting','@id':canonical+'#article',headline:title,description,inLanguage:locale,mainEntityOfPage:canonical,author:{'@type':'Person',name:'Teyfik Gökdemir',url:'https://teyfikgokdemir.com/'}},{'@type':'BreadcrumbList',itemListElement:[{'@type':'ListItem',position:1,name:tr?'Ana Sayfa':'Home',item:tr?'https://teyfikgokdemir.com/':'https://teyfikgokdemir.com/en/'},{'@type':'ListItem',position:2,name:tr?'Blog':'Blog',item:tr?'https://teyfikgokdemir.com/blog/':'https://teyfikgokdemir.com/en/blog/'},{'@type':'ListItem',position:3,name:title,item:canonical}]}];
---
<BaseLayout locale={locale} copy={copy} title={title} description={description} pathname={path} alternates={alt} ogType="article" pageSchema={schema}>
<Header locale={locale} copy={copy} homePath={tr?'/':'/en/'} languageUrls={alt}/>
<main class="guide"><article class="shell"><p class="label">{tr?'CAM SEKTÖRÜ · ULUSLARARASI TİCARET':'GLASS INDUSTRY · INTERNATIONAL TRADE'}</p><h1>{tr?'Türkiye’den cam tedariği: teknik gereksinimden teslimata.':'Glass sourcing from Türkiye: from specification to delivery.'}</h1><p class="lead">{description}</p><div class="body">{sections.map(([h,p])=><section><h2>{h}</h2><p set:html={p}/></section>)}</div><nav class="related"><h2>{tr?'Cam satın alma rehberleri':'Glass procurement guides'}</h2>{glassKnowledgePages.map((page)=><a href={tr?('/blog/cam-rehberi/'+page.slug+'/'):('/en/blog/glass-guide/'+page.slug+'/')}><strong>{page[locale].title}</strong><span>↗</span></a>)}</nav></article></main>
<Footer copy={copy} locale={locale}/><FloatingActions locale={locale}/></BaseLayout>
<style>
.guide{background:var(--scene-paper);min-height:70vh;padding:clamp(4rem,8vw,7rem) 0}.shell{width:min(1040px,calc(100% - 3rem));margin:auto}.label{text-align:center;color:var(--accent);font-size:.78rem;font-weight:800;letter-spacing:.09em}.shell>h1{max-width:1000px;margin:.7rem auto 1.2rem;text-align:center;font-size:clamp(2.6rem,5.8vw,5.5rem);line-height:var(--leading-display);letter-spacing:var(--tracking-display);text-wrap:balance}.lead{max-width:780px;margin:0 auto clamp(3rem,6vw,5rem);text-align:center;color:var(--text-muted);font-size:clamp(1.05rem,1.6vw,1.25rem);line-height:1.7}.body{max-width:800px;margin:auto}.body section{padding:2rem 0;border-top:1px solid var(--border)}.body h2{margin:0 0 1rem;font-size:clamp(1.65rem,3vw,2.5rem);line-height:1.15}.body p{margin:0;color:var(--text-muted);font-size:1.05rem;line-height:1.8}.body :global(a){color:var(--accent);font-weight:800;text-decoration:underline;text-underline-offset:4px}.related{max-width:800px;margin:3rem auto 0}.related h2{font-size:1.4rem}.related a{display:flex;justify-content:space-between;gap:1rem;padding:1rem 0;border-top:1px solid var(--border);color:inherit;text-decoration:none}.related a:last-child{border-bottom:1px solid var(--border)}@media(max-width:640px){.shell{width:min(100% - 2rem,1040px)}.shell>h1{font-size:clamp(2.15rem,10vw,3.1rem)}}
</style>