---
import type { Locale } from '../i18n/locales';
import { site } from '../data/site';

type SupportedLocale = Locale | 'fa';

interface Props {
  locale: SupportedLocale;
}

const { locale } = Astro.props;

const messages: Record<SupportedLocale, string> = {
  en: 'Hello Teyfik, I am contacting you through your website.',
  tr: 'Merhaba Teyfik Bey, web siteniz üzerinden iletişime geçiyorum.',
  sq: 'Përshëndetje Teyfik, po ju kontaktoj përmes faqes suaj.',
  mk: 'Здраво Тејфик, ве контактирам преку вашата веб-страница.',
  sr: 'Zdravo Teyfik, kontaktiram vas putem vašeg sajta.',
  fa: 'سلام آقای تیفیک، از طریق وب‌سایت شما تماس می‌گیرم.',
};

const labels: Record<SupportedLocale, { whatsapp: string; top: string }> = {
  en: { whatsapp: 'Contact Teyfik on WhatsApp', top: 'Back to top' },
  tr: { whatsapp: 'WhatsApp üzerinden iletişime geç', top: 'Sayfa başına dön' },
  sq: { whatsapp: 'Kontaktoni në WhatsApp', top: 'Kthehu në krye' },
  mk: { whatsapp: 'Контактирајте преку WhatsApp', top: 'Назад на врвот' },
  sr: { whatsapp: 'Kontakt putem WhatsApp-a', top: 'Nazad na vrh' },
  fa: { whatsapp: 'تماس با تیفیک در واتس‌اپ', top: 'بازگشت به بالای صفحه' },
};

const whatsappUrl =
  `https://wa.me/${site.whatsapp}?text=${encodeURIComponent(messages[locale])}`;
---
<div class="floating-actions safe-floating-actions" aria-label="Quick actions">
  <button
    class="floating-action back-to-top"
    type="button"
    aria-label={labels[locale].top}
    title={labels[locale].top}
  >
    <svg
      class="back-to-top__icon"
      viewBox="0 0 20 20"
      width="18"
      height="18"
      aria-hidden="true"
      focusable="false"
    >
      <path
        d="M4.5 12.5 10 7l5.5 5.5"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
    </svg>
  </button>

  <a
    class="floating-action whatsapp-action"
    href={whatsappUrl}
    target="_blank"
    rel="noopener noreferrer"
    aria-label={labels[locale].whatsapp}
    title={labels[locale].whatsapp}
  >
    <svg
      viewBox="0 0 32 32"
      width="23"
      height="23"
      aria-hidden="true"
      focusable="false"
    >
      <path
        fill="currentColor"
        d="M16.03 3.2A12.63 12.63 0 0 0 5.1 22.15L3.2 28.8l6.84-1.8a12.65 12.65 0 1 0 5.99-23.8Zm0 22.96a10.25 10.25 0 0 1-5.22-1.43l-.37-.22-4.06 1.07 1.09-3.96-.24-.4a10.28 10.28 0 1 1 8.8 4.94Zm5.64-7.68c-.31-.16-1.84-.91-2.13-1.01-.28-.1-.49-.16-.69.16-.21.31-.8 1.01-.98 1.22-.18.21-.36.23-.67.08-.31-.16-1.31-.48-2.49-1.54-.92-.82-1.54-1.83-1.72-2.14-.18-.31-.02-.48.14-.63.14-.14.31-.36.47-.54.16-.18.21-.31.31-.52.1-.21.05-.39-.03-.54-.08-.16-.69-1.67-.95-2.29-.25-.6-.51-.52-.69-.53h-.59c-.21 0-.54.08-.82.39-.28.31-1.08 1.06-1.08 2.58s1.11 2.99 1.26 3.2c.16.21 2.18 3.33 5.28 4.67.74.32 1.31.51 1.76.65.74.24 1.42.2 1.95.12.6-.09 1.84-.75 2.1-1.48.26-.73.26-1.36.18-1.49-.08-.13-.28-.21-.59-.36Z"
      />
    </svg>
  </a>
</div>

<style>
  .floating-actions {
    position: fixed;
    z-index: 45;
    inset-inline-end: max(
      clamp(1rem, 2.5vw, 2rem),
      env(safe-area-inset-right),
      env(safe-area-inset-left)
    );
    bottom: max(clamp(1rem, 2.5vw, 2rem), env(safe-area-inset-bottom));
    display: grid;
    gap: .45rem;
    opacity: 1;
    transition: opacity .2s ease;
  }

  .floating-action {
    box-sizing: border-box;
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    padding: 0;
    border: 1px solid rgba(242, 170, 143, .42);
    border-radius: 50%;
    background: rgba(33, 28, 24, .95);
    color: var(--text, #f3eee6);
    box-shadow: 0 6px 16px rgba(0, 0, 0, .16);
    font: inherit;
    line-height: 1;
    text-decoration: none;
    appearance: none;
    cursor: pointer;
    transition:
      transform .2s ease,
      border-color .2s ease,
      background-color .2s ease,
      opacity .2s ease;
  }

  .floating-action:hover {
    transform: translateY(-2px);
    border-color: var(--accent-soft, #d78263);
    background: var(--panel-soft, #302a25);
  }

  .floating-action:focus-visible {
    outline: 3px solid var(--focus, #bd5e3c);
    outline-offset: 3px;
  }

  .whatsapp-action {
    border-color: #25d366;
    background: #25d366;
    color: #fff;
    font-size: .7rem;
    font-weight: 900;
    letter-spacing: .08em;
  }

  .whatsapp-action:hover {
    border-color: #20bd5a;
    background: #20bd5a;
  }

  .whatsapp-action svg {
    display: block;
  }

  .back-to-top {
    color: #f3eee6;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translateY(8px);
  }

  .back-to-top__icon {
    display: block;
    width: 18px;
    height: 18px;
    color: inherit;
  }

  .back-to-top:hover,
  .back-to-top:focus-visible {
    color: #fff;
  }

  .back-to-top.is-visible {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateY(0);
  }

  .safe-floating-actions.is-scrolling {
    opacity: .28;
  }

  .safe-floating-actions:hover,
  .safe-floating-actions:focus-within {
    opacity: 1;
  }

  @media (max-width: 640px) {
    .floating-actions {
      inset-inline-end: max(
        .9rem,
        env(safe-area-inset-right),
        env(safe-area-inset-left)
      );
      bottom: max(.9rem, env(safe-area-inset-bottom));
    }

    .floating-action {
      width: 40px;
      height: 40px;
    }

    .back-to-top__icon {
      width: 16px;
      height: 16px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .floating-actions,
    .floating-action {
      transition: none;
    }

    .floating-action:hover,
    .back-to-top,
    .back-to-top.is-visible {
      transform: none;
    }
  }
</style>

<script is:inline>
  const floatingActions = document.querySelector('.safe-floating-actions');
  const backToTop = document.querySelector('.back-to-top');

  if (backToTop) {
    const updateVisibility = () => {
      backToTop.classList.toggle('is-visible', window.scrollY > 600);
    };

    updateVisibility();

    window.addEventListener('scroll', updateVisibility, {
      passive: true,
    });

    backToTop.addEventListener('click', () => {
      const reducedMotion = window.matchMedia(
        '(prefers-reduced-motion: reduce)'
      ).matches;

      window.scrollTo({
        top: 0,
        behavior: reducedMotion ? 'auto' : 'smooth',
      });
    });
  }

  if (floatingActions) {
    let scrollTimer;

    window.addEventListener(
      'scroll',
      () => {
        floatingActions.classList.add('is-scrolling');

        window.clearTimeout(scrollTimer);

        scrollTimer = window.setTimeout(() => {
          floatingActions.classList.remove('is-scrolling');
        }, 240);
      },
      { passive: true }
    );
  }
</script>
