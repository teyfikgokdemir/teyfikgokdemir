---
import type { Locale } from '../i18n/locales';
import { site } from '../data/site';

type SupportedLocale = Locale | 'fa' | 'zh';

interface Props {
  locale: SupportedLocale;
}

const { locale } = Astro.props;

const messages: Record<SupportedLocale, string> = {
  ru: 'Здравствуйте Тейфик, пишу вам с вашего сайта.',
  en: 'Hello Teyfik, I am contacting you through your website.',
  tr: 'Merhaba Teyfik Bey, web siteniz üzerinden iletişime geçiyorum.',
  sq: 'Përshëndetje Teyfik, po ju kontaktoj përmes faqes suaj.',
  mk: 'Здраво Тејфик, ве контактирам преку вашата веб-страница.',
  sr: 'Zdravo Teyfik, kontaktiram vas putem vašeg sajta.',
  fa: 'سلام آقای تیفیک، از طریق وب‌سایت شما تماس می‌گیرم.',
  zh: '您好 Teyfik，我通过您的个人网站与您联系。',
};

const labels: Record<SupportedLocale, { whatsapp: string; top: string }> = {
  ru: { whatsapp: 'Связаться с Тейфиком в WhatsApp', top: 'Наверх' },
  en: { whatsapp: 'Contact Teyfik on WhatsApp', top: 'Back to top' },
  tr: { whatsapp: 'WhatsApp üzerinden iletişime geç', top: 'Sayfa başına dön' },
  sq: { whatsapp: 'Kontaktoni në WhatsApp', top: 'Kthehu në krye' },
  mk: { whatsapp: 'Контактирајте преку WhatsApp', top: 'Назад на врвот' },
  sr: { whatsapp: 'Kontakt putem WhatsApp-a', top: 'Nazad na vrh' },
  fa: { whatsapp: 'تماس با تیفیک در واتس‌اپ', top: 'بازگشت به بالای صفحه' },
  zh: { whatsapp: '通过 WhatsApp 联系 Teyfik', top: '返回顶部' },
};

const whatsappUrl =
  `https://wa.me/${site.whatsapp}?text=${encodeURIComponent(messages[locale])}`;
---
<div class="floating-actions safe-floating-actions" data-locale={locale} aria-label="Quick actions">
  <button
    class="floating-action back-to-top"
    type="button"
    aria-label={labels[locale].top}
    title={labels[locale].top}
  >
    <svg
      class="back-to-top__icon"
      viewBox="0 0 20 20"
      width="18"
      height="18"
      aria-hidden="true"
      focusable="false"
    >
      <path
        d="M4.5 12.5 10 7l5.5 5.5"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
    </svg>
  </button>

  <a
    class="floating-action whatsapp-action"
    href={whatsappUrl}
    target="_blank"
    rel="noopener noreferrer"
    aria-label={labels[locale].whatsapp}
    title={labels[locale].whatsapp}
  >
    <svg
      viewBox="0 0 32 32"
      width="24"
      height="24"
      aria-hidden="true"
      focusable="false"
    >
      <path
        fill="#ffffff"
        d="M16 2a13.8 13.8 0 0 0-11.8 21.1L2.3 30l7.1-1.9A13.8 13.8 0 1 0 16 2zm8.1 19.6c-.3.9-1.8 1.7-2.5 1.8-.7.1-1.6.3-5.2-1.2-4.3-1.8-7.1-6.1-7.3-6.4-.2-.3-1.6-2.2-1.6-4.2s1-3 1.4-3.4c.4-.4.8-.5 1.1-.5h.8c.3 0 .6 0 .8.6.3.8 1 2.5 1.1 2.7.1.2.1.4 0 .6-.1.2-.2.4-.4.6-.2.2-.4.4-.2.8.5.9 1.4 2.1 2.6 3.1 1.5 1.4 2.8 1.8 3.2 2 .4.2.6.2.8-.1.2-.3 1-1.1 1.3-1.5.3-.4.6-.3 1-.2s2.4 1.1 2.8 1.3c.4.2.7.3.8.5.1.4-.2 1.8-.5 2.7z"
      />
    </svg>
  </a>
</div>

<style>
  .floating-actions {
    position: fixed;
    z-index: 45;
    inset-inline-end: max(
      clamp(1rem, 2.5vw, 2rem),
      env(safe-area-inset-right),
      env(safe-area-inset-left)
    );
    bottom: max(clamp(1rem, 2.5vw, 2rem), env(safe-area-inset-bottom));
    display: grid;
    gap: .45rem;
    opacity: 1;
    transition: opacity .2s ease;
  }

  .floating-action {
    box-sizing: border-box;
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    padding: 0;
    border: 1px solid rgba(242, 170, 143, .42);
    border-radius: 50%;
    background: rgba(33, 28, 24, .95);
    color: var(--text, #f3eee6);
    box-shadow: 0 6px 16px rgba(0, 0, 0, .16);
    font: inherit;
    line-height: 1;
    text-decoration: none;
    appearance: none;
    cursor: pointer;
    transition:
      transform .2s ease,
      border-color .2s ease,
      background-color .2s ease,
      opacity .2s ease;
  }

  .floating-action:hover {
    transform: translateY(-2px);
    border-color: var(--accent-soft, #d78263);
    background: var(--panel-soft, #302a25);
  }

  .floating-action:focus-visible {
    outline: 3px solid var(--focus, #bd5e3c);
    outline-offset: 3px;
  }

  .whatsapp-action {
    border-color: #25d366;
    background: #25d366;
    color: #fff;
    font-size: .7rem;
    font-weight: 900;
    letter-spacing: .08em;
  }

  .whatsapp-action:hover {
    border-color: #20bd5a;
    background: #20bd5a;
  }

  .whatsapp-action svg {
    display: block;
  }

  .back-to-top {
    color: #f3eee6;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translateY(8px);
  }

  .back-to-top__icon {
    display: block;
    width: 18px;
    height: 18px;
    color: inherit;
  }

  .back-to-top:hover,
  .back-to-top:focus-visible {
    color: #fff;
  }

  .back-to-top.is-visible {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateY(0);
  }

  .safe-floating-actions.is-scrolling {
    opacity: .28;
  }

  .safe-floating-actions:hover,
  .safe-floating-actions:focus-within {
    opacity: 1;
  }

  .safe-floating-actions.is-obscured {
    opacity: 0;
    pointer-events: none;
  }

  @media (max-width: 640px) {
    .floating-actions {
      inset-inline-end: max(
        .9rem,
        env(safe-area-inset-right),
        env(safe-area-inset-left)
      );
      bottom: max(.9rem, env(safe-area-inset-bottom));
    }

    .floating-action {
      width: 40px;
      height: 40px;
    }

    .back-to-top__icon {
      width: 16px;
      height: 16px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .floating-actions,
    .floating-action {
      transition: none;
    }

    .floating-action:hover,
    .back-to-top,
    .back-to-top.is-visible {
      transform: none;
    }
  }
</style>

<script is:inline>
  const floatingActions = document.querySelector('.safe-floating-actions');
  const backToTop = document.querySelector('.back-to-top');

  if (backToTop) {
    const updateVisibility = () => {
      backToTop.classList.toggle('is-visible', window.scrollY > 600);
    };

    updateVisibility();

    window.addEventListener('scroll', updateVisibility, {
      passive: true,
    });

    backToTop.addEventListener('click', () => {
      const reducedMotion = window.matchMedia(
        '(prefers-reduced-motion: reduce)'
      ).matches;

      window.scrollTo({
        top: 0,
        behavior: reducedMotion ? 'auto' : 'smooth',
      });
    });
  }

  if (floatingActions) {
    let scrollTimer;

    const updateFaMobileCollision = () => {
      if (
        floatingActions.dataset.locale !== 'fa' ||
        !window.matchMedia('(max-width: 640px)').matches
      ) {
        floatingActions.classList.remove('is-obscured');
        return;
      }

      const floatingBox = floatingActions.getBoundingClientRect();
      const protectedElements = document.querySelectorAll(
        'h1, h2, .actions a, .sector-link, .fa-producer-strategy__actions a'
      );
      const overlaps = [...protectedElements].some((element) => {
        const box = element.getBoundingClientRect();
        const visible = box.bottom > 0 && box.top < window.innerHeight;
        return visible &&
          floatingBox.left < box.right && floatingBox.right > box.left &&
          floatingBox.top < box.bottom && floatingBox.bottom > box.top;
      });

      floatingActions.classList.toggle('is-obscured', overlaps);
    };

    updateFaMobileCollision();
    window.addEventListener('resize', updateFaMobileCollision, { passive: true });

    window.addEventListener(
      'scroll',
      () => {
        floatingActions.classList.add('is-scrolling');
        window.requestAnimationFrame(updateFaMobileCollision);

        window.clearTimeout(scrollTimer);

        scrollTimer = window.setTimeout(() => {
          floatingActions.classList.remove('is-scrolling');
          updateFaMobileCollision();
        }, 240);
      },
      { passive: true }
    );
  }
</script>
