---
import type { Locale } from '../i18n/locales';

interface Props {
  locale: Locale | 'fa';
}

const { locale } = Astro.props;

const messages = {
  tr: {
    title: 'Çerez tercihleri',
    text: 'Zorunlu çerezler sitenin çalışması için kullanılır. Analitik ve performans ölçümü yalnızca onay verdiğinizde etkinleştirilir.',
    privacy: 'Gizlilik Politikası',
    reject: 'Reddet',
    accept: 'Onayla',
  },
  ru: {
    title: 'Файлы cookie',
    text: 'Обязательные cookie используются для работы сайта. Аналитика и измерение производительности включаются только после вашего согласия.',
    privacy: 'Политика конфиденциальности',
    reject: 'Отклонить',
    accept: 'Принять',
  },
  en: {
    title: 'Cookie preferences',
    text: 'Essential cookies keep the site working. Analytics and performance measurement are enabled only after you give consent.',
    privacy: 'Privacy Policy',
    reject: 'Reject',
    accept: 'Accept',
  },
  mk: {
    title: 'Поставки за колачиња',
    text: 'Неопходните колачиња овозможуваат работа на страницата. Аналитиката и мерењето на перформансите се активираат само по ваша согласност.',
    privacy: 'Политика за приватност',
    reject: 'Одбиј',
    accept: 'Прифати',
  },
  sr: {
    title: 'Podešavanja kolačića',
    text: 'Neophodni kolačići omogućavaju rad sajta. Analitika i merenje performansi aktiviraju se samo nakon vaše saglasnosti.',
    privacy: 'Politika privatnosti',
    reject: 'Odbij',
    accept: 'Prihvati',
  },
  sq: {
    title: 'Preferencat e cookies',
    text: 'Cookies thelbësore mundësojnë funksionimin e faqes. Analitika dhe matja e performancës aktivizohen vetëm pasi të jepni pëlqimin.',
    privacy: 'Politika e Privatësisë',
    reject: 'Refuzo',
    accept: 'Prano',
  },
  fa: {
    title: 'تنظیمات کوکی',
    text: 'کوکی‌های ضروری برای عملکرد سایت استفاده می‌شوند. تحلیل و اندازه‌گیری عملکرد فقط پس از رضایت شما فعال می‌شود.',
    privacy: 'سیاست حفظ حریم خصوصی',
    reject: 'رد',
    accept: 'پذیرش',
  },
  zh: {
    title: 'Cookie 偏好设置',
    text: '必要 Cookie 用于保障网站基本功能运行。分析和性能测量仅在您明确同意后启用。',
    privacy: '隐私政策',
    reject: '拒绝',
    accept: '同意',
  },
  vi: {
    title: 'Tùy chọn Cookie',
    text: 'Cookie thiết yếu giúp website vận hành. Phân tích và đo lường hiệu suất chỉ được bật sau khi bạn đồng ý.',
    privacy: 'Chính sách bảo mật',
    reject: 'Từ chối',
    accept: 'Chấp nhận',
  },
} as const;

const copy = (messages[locale] || messages.en) ?? messages.en;
const privacyHref = locale === 'tr' ? '/privacy-policy/' : `/${locale}/privacy-policy/`;
---

<aside class="cookie-banner" data-cookie-banner hidden aria-labelledby="cookie-title" aria-live="polite">
  <div class="cookie-copy">
    <strong id="cookie-title">{copy.title}</strong>
    <p>{copy.text} <a href={privacyHref}>{copy.privacy}</a></p>
  </div>
  <div class="cookie-actions">
    <button type="button" class="cookie-button secondary" data-cookie-reject>{copy.reject}</button>
    <button type="button" class="cookie-button primary" data-cookie-accept>{copy.accept}</button>
  </div>
</aside>

<script is:inline>
  (() => {
    const key = 'tg-cookie-consent';
    const measurementId = 'G-52GXBGWHFJ';
    const ANALYTICS_TEST_MODE = true;
    const banner = document.querySelector('[data-cookie-banner]');
    if (!(banner instanceof HTMLElement)) return;

    let analyticsLoaded = false;
    let sourceBeaconLoaded = false;
    window['ga-disable-' + measurementId] = !ANALYTICS_TEST_MODE;
    window.dataLayer = window.dataLayer || [];
    window.gtag = window.gtag || function () { window.dataLayer.push(arguments); };
    window.gtag('consent', 'default', {
      analytics_storage: ANALYTICS_TEST_MODE ? 'granted' : 'denied',
      ad_storage: 'denied',
      ad_user_data: 'denied',
      ad_personalization: 'denied',
    });

    const loadAnalytics = () => {
      if (analyticsLoaded) return;
      analyticsLoaded = true;
      window['ga-disable-' + measurementId] = false;
      window.gtag('consent', 'update', { analytics_storage: 'granted' });
      window.gtag('js', new Date());
      window.gtag('config', measurementId, {
        anonymize_ip: true,
        allow_google_signals: false,
        allow_ad_personalization_signals: false,
      });

      const script = document.createElement('script');
      script.async = true;
      script.src = `https://www.googletagmanager.com/gtag/js?id=${measurementId}`;
      document.head.appendChild(script);
    };

    const loadSourceBeacon = () => {
      if (sourceBeaconLoaded || document.querySelector('script[data-tg-source-beacon]')) return;
      sourceBeaconLoaded = true;
      const script = document.createElement('script');
      script.src = '/cansu-source-beacon.js';
      script.defer = true;
      script.dataset.site = 'teyfikgokdemir';
      script.dataset.tgSourceBeacon = 'true';
      document.body.appendChild(script);
    };

    const clearAnalyticsCookies = () => {
      document.cookie.split(';').map((item) => item.trim().split('=')[0]).filter((name) => name === '_ga' || name.startsWith('_ga_')).forEach((name) => {
        document.cookie = `${name}=; Path=/; Max-Age=0; SameSite=Lax; Secure`;
        document.cookie = `${name}=; Domain=.teyfikgokdemir.com; Path=/; Max-Age=0; SameSite=Lax; Secure`;
      });
    };

    const track = (name, params = {}) => {
      if (!analyticsLoaded || typeof window.gtag !== 'function') return;
      window.gtag('event', name, params);
    };

    if (ANALYTICS_TEST_MODE) { loadAnalytics(); loadSourceBeacon(); }
    const stored = localStorage.getItem(key);
    if (stored === 'accepted') {
      loadAnalytics();
      loadSourceBeacon();
      banner.hidden = true;
    } else if (stored === 'rejected') {
      if (!ANALYTICS_TEST_MODE) {
        window['ga-disable-' + measurementId] = true;
        window.gtag('consent', 'update', { analytics_storage: 'denied' });
        clearAnalyticsCookies();
      }
      banner.hidden = true;
    } else {
      banner.hidden = false;
    }

    banner.querySelector('[data-cookie-accept]')?.addEventListener('click', () => {
      localStorage.setItem(key, 'accepted');
      loadAnalytics();
      loadSourceBeacon();
      track('analytics_preference', { preference: 'accepted' });
      banner.hidden = true;
    });

    banner.querySelector('[data-cookie-reject]')?.addEventListener('click', () => {
      localStorage.setItem(key, 'rejected');
      window['ga-disable-' + measurementId] = true;
      window.gtag('consent', 'update', { analytics_storage: 'denied' });
      clearAnalyticsCookies();
      banner.hidden = true;
    });

    document.addEventListener('click', (event) => {
      const target = event.target instanceof Element ? event.target.closest('a') : null;
      if (!(target instanceof HTMLAnchorElement)) return;
      const href = target.href;
      const label = target.textContent?.trim().slice(0, 120) || '';
      if (href.startsWith('mailto:')) {
        track('mailto_click', { link_url: href, link_text: label });
        return;
      }
      try {
        const url = new URL(href, location.href);
        if (url.hostname === 'wa.me') {
          track('whatsapp_click', { link_url: href, link_text: label });
        } else if (target.dataset.ventureLink === 'true') {
          track('venture_click', { link_url: href, link_domain: url.hostname, link_text: label });
          track('outbound_click', { link_url: href, link_domain: url.hostname, link_text: label });
        } else if (url.origin !== location.origin) {
          track('outbound_click', { link_url: href, link_domain: url.hostname, link_text: label });
        }
      } catch {}
    });
  })();
</script>

<style>
  .cookie-banner {
    --text: #f3eee6;
    --muted: #c9bfb2;
    --accent-soft: #d78263;
    position: fixed;
    z-index: 120;
    right: 0;
    bottom: 0;
    left: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    width: 100%;
    margin: 0;
    padding: .48rem clamp(1rem, 3vw, 2rem);
    border: 0;
    border-top: 1px solid #51483f;
    border-radius: 0;
    background: rgba(22, 18, 15, .98);
    box-shadow: 0 -10px 30px rgba(0, 0, 0, .28);
    backdrop-filter: blur(14px);
  }
  .cookie-banner[hidden] { display: none; }
  .cookie-copy {
    min-width: 0;
    max-width: none;
    display: flex;
    align-items: baseline;
    gap: .85rem;
    white-space: nowrap;
  }
  .cookie-copy strong { flex: 0 0 auto; display: inline; margin: 0; color: #fffaf3; font-size: .76rem; }
  .cookie-copy p { min-width: 0; margin: 0; color: var(--muted); font-size: .75rem; line-height: 1.25; overflow: hidden; text-overflow: ellipsis; }
  .cookie-copy a { color: var(--accent-soft); text-decoration: underline; text-underline-offset: 3px; }
  .cookie-actions { display: flex; flex: 0 0 auto; gap: .5rem; }
  .cookie-button {
    min-height: 32px;
    padding: .38rem .78rem;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    color: var(--text);
    background: transparent;
    cursor: pointer;
    font-size: .82rem;
    font-weight: 800;
  }
  .cookie-button.primary {
    border-color: #763821;
    background: #763821;
    color: #fffaf3;
  }
  .cookie-button:focus-visible {
    outline: 3px solid #ffffff;
    outline-offset: 3px;
  }
  .cookie-button:hover { border-color: var(--accent-soft); }
  @media (max-width: 720px) {
    .cookie-banner {
      align-items: stretch;
      flex-direction: column;
      gap: .55rem;
      padding: .58rem .7rem;
    }
    .cookie-copy {
      display: block;
      white-space: normal;
    }
    .cookie-copy strong { display: block; margin-bottom: .18rem; font-size: .86rem; }
    .cookie-copy p { overflow: visible; text-overflow: clip; font-size: .76rem; line-height: 1.35; }
    .cookie-actions { width: 100%; gap: .45rem; }
    .cookie-button { flex: 1; min-height: 34px; padding: .42rem .65rem; font-size: .8rem; }
  }
</style>
