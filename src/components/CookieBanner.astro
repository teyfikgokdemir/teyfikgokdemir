---
import type { Locale } from '../i18n/locales';

interface Props {
  locale: Locale | 'fa';
}

const { locale } = Astro.props;

const messages = {
  tr: {
    title: 'Çerez tercihleri',
    text: 'Zorunlu çerezler sitenin çalışması için kullanılır. Analitik çerezler yalnızca onay verirseniz etkinleştirilir.',
    privacy: 'Gizlilik Politikası',
    reject: 'Reddet',
    accept: 'Onayla',
  },
  ru: {
    title: 'Файлы cookie',
    text: 'Обязательные cookie используются для работы сайта. Аналитические cookie включаются только с вашего согласия.',
    privacy: 'Политика конфиденциальности',
    reject: 'Отклонить',
    accept: 'Принять',
  },
  en: {
    title: 'Cookie preferences',
    text: 'Essential cookies keep the site working. Analytics cookies are enabled only after you give consent.',
    privacy: 'Privacy Policy',
    reject: 'Reject',
    accept: 'Accept',
  },
  mk: {
    title: 'Поставки за колачиња',
    text: 'Неопходните колачиња овозможуваат работа на страницата. Аналитичките колачиња се активираат само со ваша согласност.',
    privacy: 'Политика за приватност',
    reject: 'Одбиј',
    accept: 'Прифати',
  },
  sr: {
    title: 'Podešavanja kolačića',
    text: 'Neophodni kolačići omogućavaju rad sajta. Analitički kolačići se aktiviraju samo uz vašu saglasnost.',
    privacy: 'Politika privatnosti',
    reject: 'Odbij',
    accept: 'Prihvati',
  },
  sq: {
    title: 'Preferencat e cookies',
    text: 'Cookies thelbësore mundësojnë funksionimin e faqes. Cookies analitike aktivizohen vetëm pasi të jepni pëlqimin.',
    privacy: 'Politika e Privatësisë',
    reject: 'Refuzo',
    accept: 'Prano',
  },
  fa: {
    title: 'تنظیمات کوکی',
    text: 'کوکی‌های ضروری برای کارکرد سایت استفاده می‌شوند. کوکی‌های تحلیلی فقط پس از رضایت شما فعال می‌شوند.',
    privacy: 'سیاست حفظ حریم خصوصی',
    reject: 'رد',
    accept: 'پذیرش',
  },
  zh: {
    title: 'Cookie 偏好设置',
    text: '必要 Cookie 用于保障网站基本功能运行。分析类 Cookie 仅在您明确同意后启用。',
    privacy: '隐私政策',
    reject: '拒绝',
    accept: '同意',
  },
  vi: {
    title: 'Tùy chọn Cookie',
    text: 'Cookie thiết yếu giúp website vận hành chuẩn xác. Cookie phân tích chỉ được kích hoạt khi bạn đồng ý.',
    privacy: 'Chính sách bảo mật',
    reject: 'Từ chối',
    accept: 'Chấp nhận',
  },
} as const;

const copy = (messages[locale] || messages.en) ?? messages.en;
---

<aside class="cookie-banner" data-cookie-banner hidden aria-labelledby="cookie-title" aria-live="polite">
  <div class="cookie-copy">
    <strong id="cookie-title">{copy.title}</strong>
    <p>{copy.text} <a href="/privacy-policy/">{copy.privacy}</a></p>
  </div>
  <div class="cookie-actions">
    <button type="button" class="cookie-button secondary" data-cookie-reject>{copy.reject}</button>
    <button type="button" class="cookie-button primary" data-cookie-accept>{copy.accept}</button>
  </div>
</aside>

<script is:inline>
  (() => {
    const key = 'tg-cookie-consent';
    const measurementId = 'G-52GXBGWHFJ';
    const banner = document.querySelector('[data-cookie-banner]');
    if (!(banner instanceof HTMLElement)) return;

    let analyticsLoaded = false;

    const denyAnalytics = () => {
      window['ga-disable-' + measurementId] = true;
      if (typeof window.gtag === 'function') {
        window.gtag('consent', 'update', {
          analytics_storage: 'denied',
          ad_storage: 'denied',
          ad_user_data: 'denied',
          ad_personalization: 'denied'
        });
      }
    };

    const loadAnalytics = () => {
      if (analyticsLoaded) return;
      analyticsLoaded = true;
      window['ga-disable-' + measurementId] = false;
      window.dataLayer = window.dataLayer || [];
      window.gtag = window.gtag || function () { window.dataLayer.push(arguments); };
      window.gtag('consent', 'default', {
        analytics_storage: 'granted',
        ad_storage: 'denied',
        ad_user_data: 'denied',
        ad_personalization: 'denied'
      });
      window.gtag('js', new Date());
      window.gtag('config', measurementId, { anonymize_ip: true });

      const script = document.createElement('script');
      script.async = true;
      script.src = `https://www.googletagmanager.com/gtag/js?id=${measurementId}`;
      document.head.appendChild(script);
    };

    const stored = localStorage.getItem(key);
    if (stored === 'accepted') {
      loadAnalytics();
      return;
    }
    if (stored === 'rejected') {
      denyAnalytics();
      return;
    }

    denyAnalytics();
    banner.hidden = false;

    banner.querySelector('[data-cookie-accept]')?.addEventListener('click', () => {
      localStorage.setItem(key, 'accepted');
      loadAnalytics();
      banner.hidden = true;
    });

    banner.querySelector('[data-cookie-reject]')?.addEventListener('click', () => {
      localStorage.setItem(key, 'rejected');
      denyAnalytics();
      banner.hidden = true;
    });
  })();
</script>

<style>
  .cookie-banner {
    --text: #f3eee6;
    --muted: #c9bfb2;
    --accent-soft: #d78263;
    position: fixed;
    z-index: 120;
    right: 1rem;
    bottom: 1rem;
    left: 1rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
    width: min(920px, calc(100% - 2rem));
    margin-inline: auto;
    padding: 1.1rem;
    border: 1px solid #6a5e53;
    border-radius: 18px;
    background: rgba(33, 28, 24, .98);
    box-shadow: 0 24px 70px rgba(0, 0, 0, .38);
    backdrop-filter: blur(18px);
  }
  .cookie-banner[hidden] { display: none; }
  .cookie-copy { max-width: 650px; }
  .cookie-copy strong { display: block; margin-bottom: .35rem; color: #fffaf3; font-size: 1rem; }
  .cookie-copy p { margin: 0; color: var(--muted); font-size: .92rem; line-height: 1.55; }
  .cookie-copy a { color: var(--accent-soft); text-decoration: underline; text-underline-offset: 3px; }
  .cookie-actions { display: flex; flex: 0 0 auto; gap: .65rem; }
  .cookie-button {
    min-height: 44px;
    padding: .68rem 1rem;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    color: var(--text);
    background: transparent;
    cursor: pointer;
    font-weight: 800;
  }
  .cookie-button.primary {
    border-color: var(--accent);
    background: var(--accent);
    color: #fff;
  }
  .cookie-button:focus-visible {
    outline: 3px solid #ffffff;
    outline-offset: 3px;
  }
  .cookie-button:hover { border-color: var(--accent-soft); }
  @media (max-width: 720px) {
    .cookie-banner { align-items: stretch; flex-direction: column; }
    .cookie-actions { width: 100%; }
    .cookie-button { flex: 1; }
  }
</style>
