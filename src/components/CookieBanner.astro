---
import type { Locale } from '../i18n/locales';

interface Props {
  locale: Locale | 'fa';
}

const { locale } = Astro.props;

const messages = {
  tr: {
    title: 'Çerez tercihleri',
    text: 'Zorunlu çerezler sitenin çalışması için kullanılır. İsteğe bağlı trafik ve performans analitiği yalnızca onay vermeniz halinde etkinleşir.',
    privacy: 'Gizlilik Politikası',
    reject: 'Reddet',
    accept: 'Onayla',
  },
  ru: {
    title: 'Файлы cookie',
    text: 'Обязательные cookie используются для работы сайта. Необязательная аналитика трафика и производительности включается только после вашего согласия.',
    privacy: 'Политика конфиденциальности',
    reject: 'Отклонить',
    accept: 'Принять',
  },
  en: {
    title: 'Cookie preferences',
    text: 'Essential cookies keep the site working. Optional traffic and performance analytics are enabled only after you give consent.',
    privacy: 'Privacy Policy',
    reject: 'Reject',
    accept: 'Accept',
  },
  mk: {
    title: 'Поставки за колачиња',
    text: 'Неопходните колачиња овозможуваат работа на страницата. Опционалната аналитика за сообраќај и перформанси се активира само со ваша согласност.',
    privacy: 'Политика за приватност',
    reject: 'Одбиј',
    accept: 'Прифати',
  },
  sr: {
    title: 'Podešavanja kolačića',
    text: 'Neophodni kolačići omogućavaju rad sajta. Opciona analitika saobraćaja i performansi aktivira se samo uz vašu saglasnost.',
    privacy: 'Politika privatnosti',
    reject: 'Odbij',
    accept: 'Prihvati',
  },
  sq: {
    title: 'Preferencat e cookies',
    text: 'Cookies thelbësore mundësojnë funksionimin e faqes. Analitika opsionale e trafikut dhe performancës aktivizohet vetëm pasi të jepni pëlqimin.',
    privacy: 'Politika e Privatësisë',
    reject: 'Refuzo',
    accept: 'Prano',
  },
  fa: {
    title: 'تنظیمات کوکی',
    text: 'کوکی‌های ضروری برای عملکرد سایت استفاده می‌شوند. تحلیل اختیاری ترافیک و عملکرد فقط پس از تأیید شما فعال می‌شود.',
    privacy: 'سیاست حفظ حریم خصوصی',
    reject: 'رد',
    accept: 'پذیرش',
  },
  zh: {
    title: 'Cookie 偏好设置',
    text: '必要 Cookie 用于保障网站基本功能运行。可选的流量与性能分析仅在您明确同意后启用。',
    privacy: '隐私政策',
    reject: '拒绝',
    accept: '同意',
  },
  vi: {
    title: 'Tùy chọn Cookie',
    text: 'Cookie thiết yếu giúp website vận hành chuẩn xác. Phân tích lưu lượng và hiệu suất tùy chọn chỉ được bật sau khi bạn đồng ý.',
    privacy: 'Chính sách bảo mật',
    reject: 'Từ chối',
    accept: 'Chấp nhận',
  },
} as const;

const copy = (messages[locale] || messages.en) ?? messages.en;
---

<aside class="cookie-banner" data-cookie-banner hidden aria-labelledby="cookie-title" aria-live="polite">
  <div class="cookie-copy">
    <strong id="cookie-title">{copy.title}</strong>
    <p>{copy.text} <a href="/privacy-policy/">{copy.privacy}</a></p>
  </div>
  <div class="cookie-actions">
    <button type="button" class="cookie-button secondary" data-cookie-reject>{copy.reject}</button>
    <button type="button" class="cookie-button primary" data-cookie-accept>{copy.accept}</button>
  </div>
</aside>

<script is:inline>
  (() => {
    const key = 'tg-cookie-consent';
    const measurementId = 'G-52GXBGWHFJ';
    const banner = document.querySelector('[data-cookie-banner]');
    if (!(banner instanceof HTMLElement)) return;

    let analyticsLoaded = false;
    let sourceBeaconLoaded = false;
    window['ga-disable-' + measurementId] = true;
    window.dataLayer = window.dataLayer || [];
    window.gtag = window.gtag || function () { window.dataLayer.push(arguments); };
    window.gtag('consent', 'default', {
      analytics_storage: 'denied',
      ad_storage: 'denied',
      ad_user_data: 'denied',
      ad_personalization: 'denied',
    });

    const loadAnalytics = () => {
      if (analyticsLoaded) return;
      analyticsLoaded = true;
      window['ga-disable-' + measurementId] = false;
      window.gtag('consent', 'update', { analytics_storage: 'granted' });
      window.gtag('js', new Date());
      window.gtag('config', measurementId, {
        anonymize_ip: true,
        allow_google_signals: false,
        allow_ad_personalization_signals: false,
      });

      const script = document.createElement('script');
      script.async = true;
      script.src = `https://www.googletagmanager.com/gtag/js?id=${measurementId}`;
      document.head.appendChild(script);
    };

    const loadSourceBeacon = () => {
      if (sourceBeaconLoaded || document.querySelector('script[data-tg-source-beacon]')) return;
      sourceBeaconLoaded = true;
      const script = document.createElement('script');
      script.src = '/cansu-source-beacon.js';
      script.defer = true;
      script.dataset.site = 'teyfikgokdemir';
      script.dataset.tgSourceBeacon = 'true';
      document.body.appendChild(script);
    };

    const clearAnalyticsCookies = () => {
      document.cookie.split(';').map((item) => item.trim().split('=')[0]).filter((name) => name === '_ga' || name.startsWith('_ga_')).forEach((name) => {
        document.cookie = `${name}=; Path=/; Max-Age=0; SameSite=Lax; Secure`;
        document.cookie = `${name}=; Domain=.teyfikgokdemir.com; Path=/; Max-Age=0; SameSite=Lax; Secure`;
      });
    };

    const track = (name, params = {}) => {
      if (!analyticsLoaded || typeof window.gtag !== 'function') return;
      window.gtag('event', name, params);
    };

    const stored = localStorage.getItem(key);
    if (stored === 'accepted') {
      banner.hidden = true;
      loadAnalytics();
      loadSourceBeacon();
    } else if (stored === 'rejected') {
      banner.hidden = true;
      window['ga-disable-' + measurementId] = true;
      window.gtag('consent', 'update', { analytics_storage: 'denied' });
      clearAnalyticsCookies();
    } else {
      banner.hidden = false;
    }

    banner.querySelector('[data-cookie-accept]')?.addEventListener('click', () => {
      localStorage.setItem(key, 'accepted');
      loadAnalytics();
      loadSourceBeacon();
      track('analytics_preference', { preference: 'accepted' });
      banner.hidden = true;
    });

    banner.querySelector('[data-cookie-reject]')?.addEventListener('click', () => {
      localStorage.setItem(key, 'rejected');
      window['ga-disable-' + measurementId] = true;
      window.gtag('consent', 'update', { analytics_storage: 'denied' });
      clearAnalyticsCookies();
      banner.hidden = true;
    });

    document.addEventListener('click', (event) => {
      const target = event.target instanceof Element ? event.target.closest('a') : null;
      if (!(target instanceof HTMLAnchorElement)) return;
      const href = target.href;
      const label = target.textContent?.trim().slice(0, 120) || '';
      if (href.startsWith('mailto:')) {
        track('contact_click', { contact_method: 'email', link_url: href, link_text: label });
        return;
      }
      try {
        const url = new URL(href, location.href);
        if (url.hostname === 'wa.me') {
          track('contact_click', { contact_method: 'whatsapp', link_url: href, link_text: label });
        } else if (url.origin !== location.origin) {
          track('outbound_click', { link_url: href, link_domain: url.hostname, link_text: label });
        }
      } catch {}
    });
  })();
</script>

<style>
  .cookie-banner {
    --text: #f3eee6;
    --muted: #c9bfb2;
    --accent-soft: #d78263;
    position: fixed;
    z-index: 120;
    right: 1rem;
    bottom: 1rem;
    left: 1rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
    width: min(920px, calc(100% - 2rem));
    margin-inline: auto;
    padding: 1.1rem;
    border: 1px solid #6a5e53;
    border-radius: 18px;
    background: rgba(33, 28, 24, .98);
    box-shadow: 0 24px 70px rgba(0, 0, 0, .38);
    backdrop-filter: blur(18px);
  }
  .cookie-banner[hidden] { display: none; }
  .cookie-copy { max-width: 650px; }
  .cookie-copy strong { display: block; margin-bottom: .35rem; color: #fffaf3; font-size: 1rem; }
  .cookie-copy p { margin: 0; color: var(--muted); font-size: .92rem; line-height: 1.55; }
  .cookie-copy a { color: var(--accent-soft); text-decoration: underline; text-underline-offset: 3px; }
  .cookie-actions { display: flex; flex: 0 0 auto; gap: .65rem; }
  .cookie-button {
    min-height: 44px;
    padding: .68rem 1rem;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    color: var(--text);
    background: transparent;
    cursor: pointer;
    font-weight: 800;
  }
  .cookie-button.primary {
    border-color: #763821;
    background: #763821;
    color: #fffaf3;
  }
  .cookie-button:focus-visible {
    outline: 3px solid #ffffff;
    outline-offset: 3px;
  }
  .cookie-button:hover { border-color: var(--accent-soft); }
  @media (max-width: 720px) {
    .cookie-banner {
      right: .75rem;
      bottom: .75rem;
      left: .75rem;
      width: calc(100% - 1.5rem);
      align-items: stretch;
      flex-direction: column;
      gap: .75rem;
      padding: .85rem;
      border-radius: 15px;
    }
    .cookie-copy strong { margin-bottom: .2rem; font-size: .92rem; }
    .cookie-copy p { font-size: .78rem; line-height: 1.4; }
    .cookie-actions { width: 100%; gap: .5rem; }
    .cookie-button { flex: 1; min-height: 40px; padding: .55rem .75rem; font-size: .82rem; }
  }
</style>
