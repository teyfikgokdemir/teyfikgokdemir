---
import ContentPage from './ContentPage.astro';
import { site } from '../data/site';
import type { Locale } from '../i18n/locales';

interface Props { locale: Locale; }
const { locale } = Astro.props;
const locales: Locale[] = ['tr', 'en', 'ru', 'fa', 'mk', 'sr', 'sq', 'zh'];
const pathnameFor = (item: Locale) => item === 'tr' ? '/instagram/tedarikci-dogrulama/' : `/${item}/instagram/tedarikci-dogrulama/`;
const siteUrl = (item: Locale) => site.origin + pathnameFor(item);
const alternates = Object.fromEntries([...locales.map((item) => [item, siteUrl(item)]), ['x-default', siteUrl('en')]]);

const copy = {
  tr: {
    title: 'Tedarikçi Doğrulama: 5 Risk Sinyali | Teyfik Gökdemir', description: 'Tedarikçi doğrulamada araştırmayı derinleştirmeyi gerektiren beş risk sinyali: şirket bilgileri, teklif, belgeler, kapasite ve ödeme baskısı.', eyebrow: 'Instagram’dan gelenler için · Tedarikçi doğrulama', heading: 'Bir tedarikçiyi doğrularken gördüğüm 5 risk sinyali.', lead: 'Aşağıdaki başlıklar kesin suçlama değildir. Her biri, karar vermeden önce araştırmayı derinleştirmek ve daha fazla kanıt istemek için bir uyarı sinyalidir.', opening: ['Bir tedarikçinin güvenilirliğini yalnızca web sitesine veya fiyat teklifine bakarak anlayamazsın. Karşı tarafı, ürünü, kaliteyi, kapasiteyi, belgeleri, ticari şartları ve teslim modelini aynı çerçevede değerlendirmek gerekir.', 'Bu sayfa, Instagram’daki üçüncü paylaşımın devamıdır. Tek bir sinyal tek başına kesin hüküm oluşturmaz; ancak eksik kanıtları tamamlamadan ilerlememek için yeterli olabilir.'], sectionLabel: 'ARAŞTIRMA SİNYALLERİ', sectionTitle: 'Beş kırmızı bayrak, beş doğrulama sorusu.', sectionLead: 'Her başlıkta amacın karşı tarafı etiketlemek değil, ticari kararın dayandığı kanıtları güçlendirmek olmalı.', decisionLabel: 'KARAR STANDARDI', decisionTitle: 'Ödeme veya siparişten önce kanıtı tamamla.', decisionText: 'Eksik bilgi varsa önce dur, sonra bilgiyi bağımsız kaynaklarla karşılaştır. Ürün, karşı taraf, belge, fiyat ve teslim modelini aynı dosyada topla.', ctseg: 'CTSEG’e ticari talep gönder ↗', whatsapp: 'Kısa bir mesaj yaz', relatedLabel: 'SERİYİ TAKİP ET', relatedTitle: 'Ticari fırsat kontrol listesine dön.', relatedText: 'Bir fırsatı değerlendirmeden önce ürün, pazar, tedarikçi, ticari şartlar ve sonraki adım için hazırlanan beş soruluk kontrol listesini de inceleyebilirsin.', related: 'Ticari fırsat kontrol listesi ↗', instagram: '@teyfikgokdemir Instagram profiline dön ↗', whatsappText: 'Merhaba Teyfik, Instagram’daki tedarikçi doğrulama içeriğinden ulaşıyorum. Konuşmak istediğim konu: ', signals: [['Şirket bilgileri doğrulanamıyor', 'Adres, şirket kaydı, üretim tesisi, yetkili kişi veya iletişim kanalları birbirini doğrulamıyorsa araştırmayı derinleştir.', 'Kimliği ve üretim gerçekliğini kontrol et.'], ['Teklif gerçek dışı derecede iyi görünüyor', 'Piyasanın çok altında fiyat, belirsiz ürün standardı veya açıklanmayan teslim koşulları birlikte görülüyorsa yalnızca fiyata odaklanma.', 'Toplam ticari çerçeveyi karşılaştır.'], ['Belgeler veya numuneler doğrulanamıyor', 'Sertifika, analiz, menşe, ürün spesifikasyonu veya numune bilgisi kaynağına kadar izlenemiyorsa teklif tamamlanmış sayılmaz.', 'Belgenin varlığını değil, doğrulanabilirliğini kontrol et.'], ['Kapasite ve teslim modeli belirsiz', 'Üretim kapasitesi, stok, minimum sipariş miktarı, üretim süresi, sevkiyat noktası ve teslim şekli net değilse fiyatın uygulanabilirliğini ölçemezsin.', 'Teklifin arkasındaki operasyonu sor.'], ['Doğrulama tamamlanmadan baskı kuruluyor', 'Acele ödeme, belirsiz banka hesabı, sürekli değişen ticari şartlar veya temel sorulara kaçamak cevaplar daha dikkatli ilerleme sinyalidir.', 'Baskı arttıkça doğrulama standardını düşürme.']],
  },
  en: {
    title: 'Supplier Verification: 5 Risk Signals | Teyfik Gökdemir', description: 'Five supplier-verification risk signals covering company identity, offer quality, documents, capacity and payment pressure.', eyebrow: 'For visitors from Instagram · Supplier verification', heading: 'Five risk signals I look for when verifying a supplier.', lead: 'These are not accusations. Each one is a signal to deepen the research and request stronger evidence before making a decision.', opening: ['You cannot assess a supplier only by looking at a website or a price offer. Counterparty, product, quality, capacity, documents, terms and delivery model need to be assessed together.', 'This page continues the third Instagram post. One signal is not a conclusion, but it can be enough reason to complete missing evidence before moving forward.'], sectionLabel: 'RESEARCH SIGNALS', sectionTitle: 'Five red flags, five verification questions.', sectionLead: 'The goal is not to label a counterparty. The goal is to strengthen the evidence behind a commercial decision.', decisionLabel: 'DECISION STANDARD', decisionTitle: 'Complete the evidence before payment or order.', decisionText: 'If information is missing, pause and compare it with independent sources. Put the product, counterparty, documents, price and delivery model in one file.', ctseg: 'Send a trade request to CTSEG ↗', whatsapp: 'Write a short message', relatedLabel: 'FOLLOW THE SERIES', relatedTitle: 'Return to the trade opportunity checklist.', relatedText: 'Review the five questions covering product, market, supplier, commercial terms and next step before evaluating an opportunity.', related: 'Trade opportunity checklist ↗', instagram: 'Return to @teyfikgokdemir on Instagram ↗', whatsappText: 'Hello Teyfik, I am reaching you from the Instagram supplier verification post. I would like to discuss: ', signals: [['Company information cannot be verified', 'If address, registration, production facility, authorised person or contact channels do not confirm each other, deepen the research.', 'Check identity and production reality.'], ['The offer looks too good to be true', 'A price far below the market, unclear product standard or unexplained delivery terms should not be judged on price alone.', 'Compare the total commercial frame.'], ['Documents or samples cannot be traced', 'If certificates, analysis, origin, specifications or sample information cannot be traced to a source, the offer is not complete.', 'Check verifiability, not just document presence.'], ['Capacity and delivery model are unclear', 'If capacity, stock, MOQ, production time, shipping point and delivery terms are unclear, the price cannot be assessed.', 'Ask about the operation behind the offer.'], ['Pressure appears before verification is complete', 'Urgent payment, an unclear bank account, changing terms or evasive answers are signals to move more carefully.', 'Do not lower your verification standard under pressure.']],
  },
  ru: {
    title: 'Проверка поставщика в Турции: 5 сигналов риска | Teyfik Gökdemir', description: 'Пять сигналов риска для компаний, которые ищут поставщика в Турции и хотят проверить контрагента до оплаты.', eyebrow: 'Для посетителей из Instagram · Проверка поставщика', heading: 'Ищете поставщика в Турции? Проверьте эти 5 сигналов до оплаты.', lead: 'Это не обвинения. Это признаки, при которых стоит запросить дополнительные доказательства и не снижать стандарт проверки ради скорости.', opening: ['Сайт и низкая цена не доказывают надёжность поставщика. Если вы закупаете в Турции, нужно вместе проверить контрагента, продукт, документы, мощность, условия и доставку.', 'Эта страница продолжает третью публикацию в Instagram. Один сигнал не является выводом, но он показывает, где нужно закрыть доказательства до платежа или заказа.'], sectionLabel: 'СИГНАЛЫ ДЛЯ ПРОВЕРКИ', sectionTitle: 'Пять красных флагов перед первым платежом.', sectionLead: 'Цель — не обвинить компанию, а быстро увидеть, какие данные нужны для проверяемого запроса к турецкому поставщику.', decisionLabel: 'КОММЕРЧЕСКИЙ СТАНДАРТ', decisionTitle: 'Нужен проверенный поставщик, а не только низкая цена.', decisionText: 'Соберите в одном файле информацию о компании, продукте, документах, цене и доставке. Если ключевой пункт нельзя подтвердить, сначала остановите платёж и запросите проверку.', ctseg: 'Отправить запрос в CTSEG ↗', whatsapp: 'Написать короткое сообщение', relatedLabel: 'СЛЕДУЮЩИЙ ШАГ', relatedTitle: 'Подготовьте торговый запрос.', relatedText: 'Вернитесь к пяти вопросам о продукте, рынке, поставщике, условиях и следующем действии. Это поможет превратить интерес в понятный запрос для CTSEG.', related: 'Открыть торговый чек-лист ↗', instagram: 'Вернуться в Instagram @teyfikgokdemir ↗', whatsappText: 'Здравствуйте, Тейфик. Я ищу проверенного поставщика в Турции и пришёл из Instagram. Хотел бы обсудить: ', signals: [['Данные компании нельзя подтвердить', 'Адрес, регистрация, завод, контактное лицо и каналы связи не подтверждают друг друга.', 'Проверьте компанию и производственную реальность.'], ['Предложение выглядит слишком выгодным', 'Цена сильно ниже рынка, неясный стандарт товара или скрытые условия доставки требуют более глубокой проверки.', 'Сравните всю коммерческую структуру.'], ['Документы или образцы нельзя отследить', 'Сертификаты, анализы, происхождение, спецификации и образцы должны быть связаны с проверяемым источником.', 'Проверяйте источник, а не только файл.'], ['Мощность и доставка не определены', 'Запас, MOQ, срок производства, точка отгрузки и условия доставки должны быть понятны до заказа.', 'Спросите об операции за предложением.'], ['Вас торопят до завершения проверки', 'Срочная оплата, непонятный банковский счёт, меняющиеся условия или уклончивые ответы требуют осторожности.', 'Скорость не должна снижать стандарт проверки.']],
  },
  fa: {
    title: 'اعتبارسنجی تأمین‌کننده در ترکیه: ۵ نشانه ریسک | Teyfik Gökdemir', description: 'پنج نشانه ریسک برای شرکت‌هایی که به دنبال تأمین‌کننده در ترکیه هستند و می‌خواهند پیش از پرداخت، طرف تجاری را بررسی کنند.', eyebrow: 'برای بازدیدکنندگان اینستاگرام · اعتبارسنجی تأمین‌کننده', heading: 'به دنبال تأمین‌کننده در ترکیه هستید؟ پیش از پرداخت این ۵ نشانه را بررسی کنید.', lead: 'این موارد اتهام نیستند؛ نشانه‌هایی هستند که می‌گویند باید مدارک بیشتری بخواهید و برای سرعت، استاندارد اعتبارسنجی را پایین نیاورید.', opening: ['وب‌سایت و قیمت پایین، به‌تنهایی قابل اتکا بودن تأمین‌کننده را ثابت نمی‌کنند. اگر از ترکیه خرید می‌کنید، طرف تجاری، محصول، اسناد، ظرفیت، شرایط و تحویل را هم‌زمان بررسی کنید.', 'این صفحه ادامه سومین محتوای اینستاگرام است. یک نشانه به‌تنهایی نتیجه قطعی نیست؛ اما نشان می‌دهد پیش از پرداخت یا سفارش کدام مدارک باید تکمیل شود.'], sectionLabel: 'نشانه‌های اعتبارسنجی', sectionTitle: 'پنج نشانه ریسک پیش از اولین پرداخت.', sectionLead: 'هدف، متهم کردن شرکت نیست؛ هدف این است که سریع ببینید برای یک درخواست قابل بررسی از تأمین‌کننده ترکیه چه اطلاعاتی لازم است.', decisionLabel: 'استاندارد تجاری', decisionTitle: 'به تأمین‌کننده قابل بررسی نیاز دارید، نه فقط قیمت پایین.', decisionText: 'اطلاعات شرکت، محصول، اسناد، قیمت و تحویل را در یک پرونده جمع کنید. اگر یک بخش کلیدی قابل تأیید نیست، ابتدا پرداخت را متوقف و اعتبارسنجی را تکمیل کنید.', ctseg: 'ارسال درخواست به CTSEG ↗', whatsapp: 'ارسال پیام کوتاه', relatedLabel: 'گام بعدی', relatedTitle: 'درخواست تجاری خود را آماده کنید.', relatedText: 'به پنج سؤال درباره محصول، بازار، تأمین‌کننده، شرایط و گام بعدی برگردید. این کار کمک می‌کند علاقه اولیه را به یک درخواست روشن برای CTSEG تبدیل کنید.', related: 'باز کردن چک‌لیست فرصت تجاری ↗', instagram: 'بازگشت به اینستاگرام @teyfikgokdemir ↗', whatsappText: 'سلام تیفیک، به دنبال تأمین‌کننده قابل بررسی در ترکیه هستم و از اینستاگرام با شما آشنا شدم. موضوعی که می‌خواهم بررسی کنم: ', signals: [['اطلاعات شرکت قابل تأیید نیست', 'آدرس، ثبت شرکت، کارخانه، فرد مسئول و کانال‌های ارتباطی باید یکدیگر را تأیید کنند.', 'هویت شرکت و واقعیت تولید را بررسی کنید.'], ['پیشنهاد بیش از حد خوب به نظر می‌رسد', 'قیمت بسیار پایین، استاندارد نامشخص یا شرایط تحویل پنهان، بررسی عمیق‌تری لازم دارد.', 'کل ساختار تجاری را مقایسه کنید.'], ['اسناد یا نمونه قابل ردیابی نیست', 'گواهی، آنالیز، مبدأ، مشخصات و نمونه باید به یک منبع قابل بررسی متصل باشند.', 'منبع سند را بررسی کنید، نه فقط وجود فایل را.'], ['ظرفیت و مدل تحویل مشخص نیست', 'موجودی، MOQ، زمان تولید، محل ارسال و شرایط تحویل باید پیش از سفارش روشن باشد.', 'عملیات پشت پیشنهاد را بپرسید.'], ['پیش از پایان اعتبارسنجی تحت فشار هستید', 'پرداخت فوری، حساب بانکی نامشخص، تغییر شرایط یا پاسخ‌های مبهم نیازمند احتیاط بیشتر است.', 'فشار نباید استاندارد اعتبارسنجی را پایین بیاورد.']],
  },
  mk: {
    title: 'Проверка на добавувач: 5 сигнали на ризик | Teyfik Gökdemir', description: 'Пет сигнали на ризик при проверка на компанија, понуда, документи, капацитет и плаќање.', eyebrow: 'За посетители од Instagram · Проверка на добавувач', heading: 'Проверувате добавувач? Овие 5 сигнали бараат дополнителна проверка.', lead: 'Ова не се обвинувања. Ова се сигнали дека треба да побарате повеќе докази пред одлуката.', opening: ['Веб-страница и ниска цена не се доволни за проценка на добавувач. Проверете ги партнерот, производот, документите, капацитетот, условите и испораката заедно.', 'Оваа страница е продолжение на третата Instagram објава. Еден сигнал не е заклучок, но покажува каде недостасуваат докази.'], sectionLabel: 'СИГНАЛИ ЗА ПРОВЕРКА', sectionTitle: 'Пет ризични сигнали пред плаќање.', sectionLead: 'Целта е да ја зајакнете комерцијалната одлука со проверливи информации.', decisionLabel: 'КОМЕРЦИЈАЛЕН СТАНДАРД', decisionTitle: 'Завршете ја проверката пред нарачката.', decisionText: 'Соберете ги податоците за компанијата, производот, документите, цената и испораката во една целина. Не продолжувајте со непроверени точки.', ctseg: 'Испратете барање до CTSEG ↗', whatsapp: 'Напишете кратка порака', relatedLabel: 'СЛЕДЕН ЧЕКОР', relatedTitle: 'Вратете се на трговската контролна листа.', relatedText: 'Проверете ги петте прашања за производот, пазарот, добавувачот, условите и следниот чекор.', related: 'Отворете ја контролната листа ↗', instagram: 'Назад на Instagram @teyfikgokdemir ↗', whatsappText: 'Здраво Тефик, доаѓам од Instagram содржината за проверка на добавувач. Би сакал да разговарам за: ', signals: [['Податоците за компанијата не се потврдливи', 'Адресата, регистрацијата, фабриката и контактот мора да се согласуваат.', 'Проверете го идентитетот и производството.'], ['Понудата е премногу добра', 'Невообичаено ниска цена или нејасни услови бараат дополнителна проверка.', 'Споредете ја целата комерцијална рамка.'], ['Документите или примероците не се следливи', 'Сертификатите, анализите и примероците мора да имаат проверлив извор.', 'Проверете го изворот.'], ['Капацитетот и испораката се нејасни', 'Залиха, MOQ, рок на производство и услови за испорака мора да се јасни.', 'Прашајте за операцијата зад понудата.'], ['Постои притисок пред проверката', 'Итно плаќање, променливи услови или избегнувачки одговори бараат внимателност.', 'Не го намалувајте стандардот под притисок.']],
  },
  sr: {
    title: 'Provera dobavljača: 5 signala rizika | Teyfik Gökdemir', description: 'Pet signala rizika pri proveri kompanije, ponude, dokumenata, kapaciteta i plaćanja.', eyebrow: 'Za posetioce sa Instagrama · Provera dobavljača', heading: 'Proveravate dobavljača? Ovih 5 signala traži dodatnu proveru.', lead: 'Ovo nisu optužbe. Ovo su signali da treba tražiti više dokaza pre odluke.', opening: ['Veb-sajt i niska cena nisu dovoljni za procenu dobavljača. Proverite partnera, proizvod, dokumenta, kapacitet, uslove i isporuku zajedno.', 'Ova stranica je nastavak treće Instagram objave. Jedan signal nije zaključak, ali pokazuje gde nedostaju dokazi.'], sectionLabel: 'SIGNALI ZA PROVERU', sectionTitle: 'Pet signala rizika pre plaćanja.', sectionLead: 'Cilj je da komercijalnu odluku zasnujete na proverljivim informacijama.', decisionLabel: 'KOMERCIJALNI STANDARD', decisionTitle: 'Završite proveru pre porudžbine.', decisionText: 'Sakupite podatke o kompaniji, proizvodu, dokumentima, ceni i isporuci na jedno mesto. Ne nastavljajte sa neproverenim tačkama.', ctseg: 'Pošaljite zahtev CTSEG-u ↗', whatsapp: 'Napišite kratku poruku', relatedLabel: 'SLEDEĆI KORAK', relatedTitle: 'Vratite se na trgovinsku kontrolnu listu.', relatedText: 'Proverite pet pitanja o proizvodu, tržištu, dobavljaču, uslovima i sledećem koraku.', related: 'Otvorite kontrolnu listu ↗', instagram: 'Nazad na Instagram @teyfikgokdemir ↗', whatsappText: 'Zdravo Teyfik, dolazim sa Instagram sadržaja o proveri dobavljača. Želeo bih da razgovaram o: ', signals: [['Podaci o kompaniji nisu proverljivi', 'Adresa, registracija, fabrika i kontakt osoba moraju se međusobno potvrđivati.', 'Proverite identitet i proizvodnju.'], ['Ponuda je previše dobra', 'Neobično niska cena ili nejasni uslovi zahtevaju dodatnu proveru.', 'Uporedite ceo komercijalni okvir.'], ['Dokumenti ili uzorci nisu sledljivi', 'Sertifikati, analize i uzorci moraju imati proverljiv izvor.', 'Proverite izvor.'], ['Kapacitet i isporuka nisu jasni', 'Zalihe, MOQ, rok proizvodnje i uslovi isporuke moraju biti jasni.', 'Pitajte o operaciji iza ponude.'], ['Postoji pritisak pre provere', 'Hitno plaćanje, promenljivi uslovi ili izbegavajući odgovori zahtevaju oprez.', 'Ne snižavajte standard pod pritiskom.']],
