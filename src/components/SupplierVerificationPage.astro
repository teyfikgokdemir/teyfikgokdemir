const strings = copy[locale];
const campaign = 'supplier_verification';
const tracked = (url: string, content: string) => { const target = new URL(url); target.searchParams.set('utm_source', 'instagram'); target.searchParams.set('utm_medium', 'post'); target.searchParams.set('utm_campaign', campaign); target.searchParams.set('utm_content', content); return target.toString(); };
const ctsegBase = locale === 'tr' ? 'https://ctseg.com.tr/tr/iletisim/' : locale === 'fa' ? 'https://ctseg.com.tr/fa/tamin-beynolmelali-iran/' : 'https://ctseg.com.tr/en/';
const ctsegUrl = tracked(ctsegBase, 'third_post_ctseg');
const tradeUrl = tracked(`${site.origin}${locale === 'tr' ? '/instagram/tedarik/' : `/${locale}/instagram/tedarik/`}`, 'from_supplier_verification');
const instagramUrl = `https://www.instagram.com/teyfikgokdemir/?utm_source=website&utm_medium=referral&utm_campaign=instagram_growth&utm_content=supplier_verification`;
const whatsappUrl = `https://wa.me/${site.whatsapp}?text=${encodeURIComponent(strings.whatsappText)}`;
const pageSchema = { '@type': 'HowTo', '@id': siteUrl(locale) + '#howto', name: strings.title, description: strings.description, url: siteUrl(locale), inLanguage: locale, isPartOf: { '@id': site.origin + '/#website' }, author: { '@id': site.origin + '/#person' }, step: strings.signals.map(([name, text], index) => ({ '@type': 'HowToStep', position: index + 1, name, text })) };
---

<ContentPage locale={locale} title={strings.title} description={strings.description} pathname={pathnameFor(locale)} alternates={alternates} pageSchema={pageSchema} eyebrow={strings.eyebrow} heading={strings.heading} lead={strings.lead}>
  <div class="supplier-verification" dir={locale === 'fa' ? 'rtl' : 'ltr'}>
    <section class="answer-block supplier-verification__opening">
      <p><strong>{strings.opening[0]}</strong></p>
      <p>{strings.opening[1]}</p>
    </section>
    <section aria-labelledby="supplier-signals-title">
      <div class="section-heading">
        <p class="section-label">{strings.sectionLabel}</p>
        <h2 id="supplier-signals-title">{strings.sectionTitle}</h2>
        <p>{strings.sectionLead}</p>
      </div>
      <div class="supplier-signal-grid">
        {strings.signals.map(([title, text, action], index) => (
          <article class:list={['supplier-signal-card', `supplier-signal-card--${index + 1}`]}>
            <span class="supplier-signal-card__number">{String(index + 1).padStart(2, '0')}</span>
            <h3>{title}</h3>
            <p>{text}</p>
            <span class="supplier-signal-card__action">{action}</span>
          </article>
        ))}
      </div>
    </section>
    <section class="supplier-verification__decision" aria-labelledby="supplier-decision-title">
      <p class="section-label">{strings.decisionLabel}</p>
      <h2 id="supplier-decision-title">{strings.decisionTitle}</h2>
      <p>{strings.decisionText}</p>
      <div class="supplier-verification__actions">
        <a class="button button--primary" href={ctsegUrl} data-supplier-route="ctseg">{strings.ctseg}</a>
        <a class="button button--secondary" href={whatsappUrl} data-supplier-route="whatsapp">{strings.whatsapp}</a>
      </div>
    </section>
    <section class="supplier-verification__related" aria-labelledby="supplier-related-title">
      <p class="section-label">{strings.relatedLabel}</p>
      <h2 id="supplier-related-title">{strings.relatedTitle}</h2>
      <p>{strings.relatedText}</p>
      <div class="supplier-verification__related-links">
        <a class="text-link" href={tradeUrl} data-supplier-route="trade_checklist">{strings.related}</a>
        <a class="text-link" href={instagramUrl} data-supplier-route="instagram_profile">{strings.instagram}</a>
      </div>
    </section>
  </div>
</ContentPage>

<script is:inline>
  document.querySelectorAll('[data-supplier-route]').forEach((link) => {
    link.addEventListener('click', () => {
      const destination = link.getAttribute('data-supplier-route') || 'unknown';
      if (typeof window.gtag === 'function') window.gtag('event', 'instagram_supplier_verification_click', { destination, source: 'instagram', medium: 'post', campaign: 'supplier_verification', content: 'third_post' });
    });
  });
</script>

