---
import Header from './Header.astro';
import Footer from './Footer.astro';
import FloatingActions from './FloatingActions.astro';
import type { Locale } from '../i18n/locales';
import { content } from '../i18n/content';
import { site } from '../data/site';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = content[locale];
---
<Header locale={locale} copy={copy} homePath={locale === 'en' ? '/' : `/${locale}/`} />

<main id="main-content">
  <section class="hero shell" id="top" aria-labelledby="hero-title">
    <div class="hero-copy">
      <p class="section-label">{copy.hero.eyebrow}</p>
      <h1 id="hero-title">{copy.hero.title}</h1>
      <p class="hero-description">{copy.hero.description}</p>
      <div class="hero-actions">
        <a class="button primary" href="#ventures">{copy.hero.primary}</a>
        <a class="button" href="#contact">{copy.hero.secondary}</a>
      </div>
      <p class="hero-summary">{copy.hero.summary}</p>
    </div>
    <div class="hero-media">
      <img
        src={site.images.hero.path}
        srcset={site.images.hero.srcset}
        sizes="(max-width: 760px) 92vw, (max-width: 1180px) 48vw, 665px"
        width={site.images.hero.width}
        height={site.images.hero.height}
        alt={copy.images.hero}
        loading="eager"
        decoding="async"
        fetchpriority="high"
      />
    </div>
  </section>

  <section class="section" aria-labelledby="intro-title">
    <div class="shell intro-grid">
      <div class="editorial-image">
        <img
          src={site.images.profile.path}
          srcset={site.images.profile.srcset}
          sizes="(max-width: 760px) 92vw, (max-width: 1180px) 48vw, 662px"
          width={site.images.profile.width}
          height={site.images.profile.height}
          alt={copy.images.profile}
          loading="lazy"
          decoding="async"
        />
      </div>
      <div>
        <p class="section-label">{copy.intro.label}</p>
        <h2 id="intro-title">{copy.intro.title}</h2>
        <p class="section-lead">{copy.intro.body}</p>
        <div class="focus-list">
          {copy.intro.areas.map((area) => <span>{area}</span>)}
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="ventures" aria-labelledby="ventures-title">
    <div class="shell">
      <div class="section-heading">
        <p class="section-label">{copy.ventures.label}</p>
        <h2 id="ventures-title">{copy.ventures.title}</h2>
        <p class="section-lead">{copy.ventures.lead}</p>
      </div>
      <div class="venture-grid">
        {copy.ventures.items.map((item) => item.url ? (
          <a
            class:list={['venture-card', { 'has-image': item.image === 'commerce' }]}
            href={item.url}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={item.aria + ', ' + copy.a11y.external}
          >
            {item.image === 'commerce' && (
              <img
                src={site.images.commerce.path}
                width={site.images.commerce.width}
                height={site.images.commerce.height}
                alt={copy.images.commerce}
                loading="lazy"
                decoding="async"
              />
            )}
            <div class="venture-meta"><span class="tag">{item.status}</span><span class="tag">{item.region}</span></div>
            <h3>{item.name}</h3>
            <p>{item.description}</p>
            <span class="venture-arrow" aria-hidden="true">↗</span>
          </a>
        ) : (
          <article class="venture-card" aria-label={item.aria}>
            <div class="venture-meta"><span class="tag">{item.status}</span><span class="tag">{item.region}</span></div>
            <h3>{item.name}</h3>
            <p>{item.description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section" id="expertise" aria-labelledby="expertise-title">
    <div class="shell">
      <div class="section-heading">
        <p class="section-label">{copy.expertise.label}</p>
        <h2 id="expertise-title">{copy.expertise.title}</h2>
        <p class="section-lead">{copy.expertise.lead}</p>
      </div>
      <div class="expertise-grid">
        {copy.expertise.groups.map((group) => (
          <article class="expertise-card">
            <h3>{group.title}</h3>
            <ul>{group.items.map((item) => <li>{item}</li>)}</ul>
          </article>
        ))}
      </div>
      <p class="definitions">{copy.expertise.definitions}</p>
    </div>
  </section>

  <section class="section" id="journey" aria-labelledby="journey-title">
    <div class="shell journey-layout">
      <div class="journey-image">
        <img
          src={site.images.executive.path}
          width={site.images.executive.width}
          height={site.images.executive.height}
          alt={copy.images.executive}
          loading="lazy"
          decoding="async"
        />
      </div>
      <div>
        <div class="section-heading">
          <p class="section-label">{copy.journey.label}</p>
          <h2 id="journey-title">{copy.journey.title}</h2>
          <p class="section-lead">{copy.journey.lead}</p>
        </div>
        <ol class="timeline">
          {copy.journey.items.map((item) => (
            <li>
              <time datetime={item.year}>{item.year}</time>
              <div class="timeline-content"><h3>{item.title}</h3><p>{item.description}</p></div>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="method-title">
    <div class="shell">
      <div class="section-heading">
        <p class="section-label">{copy.method.label}</p>
        <h2 id="method-title">{copy.method.title}</h2>
        <p class="section-lead">{copy.method.lead}</p>
      </div>
      <div class="method-grid">
        {copy.method.steps.map((step) => (
          <article class="method-card"><h3>{step.title}</h3><p>{step.description}</p></article>
        ))}
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="regional-title">
    <div class="shell regional-grid">
      <div>
        <p class="section-label">{copy.regional.label}</p>
        <h2 id="regional-title">{copy.regional.title}</h2>
        <p class="section-lead">{copy.regional.body}</p>
      </div>
      <div class="editorial-image">
        <img
          src={site.images.global.path}
          width={site.images.global.width}
          height={site.images.global.height}
          alt={copy.images.regional}
          loading="lazy"
          decoding="async"
        />
      </div>
    </div>
  </section>

  <section class="section contact-section" id="contact" aria-labelledby="contact-title">
    <div class="shell">
      <div class="contact-card">
        <p class="section-label">{copy.contact.label}</p>
        <h2 id="contact-title">{copy.contact.title}</h2>
        <p class="section-lead">{copy.contact.body}</p>
        <a class="button primary" href={'mailto:' + site.email} aria-label={copy.contact.action + ': ' + site.email}>{site.email}</a>
      </div>
    </div>
  </section>
</main>

<Footer copy={copy} />
<FloatingActions locale={locale} />
