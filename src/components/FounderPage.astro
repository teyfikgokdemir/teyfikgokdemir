        { title: 'Strateška nabavka i provera', items: ['Istraživanje proizvođača i dobavljača', 'Provera dobavljača', 'Analiza cena i kapaciteta', 'Kvalitet i dokumentacija', 'RFQ i procesi ponuda'] },
        { title: 'Komercijalni rast i razvoj tržišta', items: ['Strategija ulaska na tržište', 'Istraživanje proizvoda i tržišta', 'Koordinacija komercijalnih operacija', 'B2B digitalna trgovina', 'Sistemi direktne prodaje'] },
        { title: 'Digitalni i AI sistemi', items: ['Tokovi istraživanja dobavljača', 'Prodajna inteligencija', 'Analiza kompanija i prilika', 'Upravljanje znanjem', 'Standardizacija operacija'] },
      ],
    },
    method: {
      label: 'Model rada',
      title: 'Direktan, zasnovan na dokazima i vezan za operativnu stvarnost.',
      lead: 'Svaki angažman smanjuje pretpostavke, razjašnjava učesnike i čini sledeću primenljivu odluku vidljivom.',
      steps: [
        { title: 'Istraživanje', description: 'Mapiranje proizvoda, tržišta, proizvođača i signala potražnje.' },
        { title: 'Provera', description: 'Poređenje dobavljača, kapaciteta, kvaliteta, dokumentacije, cena i uslova.' },
        { title: 'Strukturiranje', description: 'Ponude, rizik, plaćanje, logistika i ulazak na tržište postaju okvir za odluku.' },
        { title: 'Koordinacija', description: 'Kritični koraci između učesnika i operacija vode se direktno i transparentno.' },
      ],
    },
    regional: {
      label: 'Međunarodna perspektiva',
      title: 'Povezivanje komercijalnih kapaciteta Turske sa međunarodnim tržištima.',
      body: 'Povezujem proizvodne i nabavne kapacitete u Turskoj sa regionalnom i međunarodnom potražnjom. Svaku priliku procenjujem kroz proizvod, učesnike, usklađenost, plaćanje, rizik i logistiku.',
    },
    contact: {
      label: 'Strateški komercijalni razgovor',
      title: 'Razjasnimo odluku o proizvodu, tržištu ili nabavci.',
      body: 'Javite se za stratešku procenu na nivou osnivača, međunarodni razvoj poslovanja ili direktan model saradnje. Operativni zahtevi za nabavku i trgovinu strukturiraju se kroz CTSEG.',
      action: 'Pošaljite e-poštu',
    },
    ctseg: {
      label: 'Glavna komercijalna kompanija',
      kicker: 'Strateška trgovinska platforma koju vodi osnivač',
      title: 'CTSEG',
      body: 'CTSEG je platforma za stratešku nabavku i međunarodnu trgovinu koja kompanijama pomaže da donose bolje informisane odluke o proizvodima, proizvođačima, dobavljačima i tržištima.',
      founder: 'Kao osnivač, Teyfik Gökdemir objedinjuje istraživanje, proveru, komercijalno strukturiranje i koordinaciju operacija u jedan okvir za odlučivanje.',
      services: ['Strateška nabavka', 'Pronalaženje i provera dobavljača', 'Savetovanje za međunarodnu trgovinu', 'Istraživanje proizvoda i tržišta', 'Koordinacija komercijalnih operacija', 'Razvoj poslovanja između Turske i međunarodnih tržišta'],
      primary: 'Istražite CTSEG usluge',
      secondary: 'Razgovarajte o zahtevu za nabavku',
    },
    journey: { year: '2026', title: 'CTSEG', description: 'Glavna komercijalna kompanija za stratešku nabavku, proveru dobavljača i međunarodne trgovinske operacije.' },
    ecosystem: {
      label: 'Prateći poduhvati',
      title: 'Digitalne sposobnosti i nezavisni poduhvati.',
      text: 'QCT Studio i QCT Commerce razvijaju sisteme digitalne trgovine i rasta; Mythborn je nezavisan potrošački poduhvat. Ove strukture podržavaju širu stručnost bez konkurisanja glavnoj komercijalnoj ulozi CTSEG-a.',
    },
  },
  sq: {
    hero: {
      eyebrow: 'Themelues · Tregti ndërkombëtare · Furnizim strategjik',
      title: 'Zhvilloj sisteme për tregti ndërkombëtare, furnizim strategjik dhe rritje digjitale.',
      description: 'Mes Turqisë dhe tregjeve ndërkombëtare lidh rrjetet e furnitorëve, operacionet tregtare, tregtinë digjitale dhe kërkimin e mbështetur nga inteligjenca artificiale me këndvështrimin e një themeluesi dhe vendimmarrësi.',
      primary: 'Eksploroni CTSEG',
      secondary: 'Bisedoni me Teyfik Gökdemir',
      summary: 'Teyfik Gökdemir është themeluesi i CTSEG. Ai strukturon mundësitë tregtare përmes kërkimit, verifikimit, koordinimit dhe sistemeve praktike të rritjes.',
    },
    intro: {
      label: 'Qasja e themeluesit',
      title: 'Një model i drejtpërdrejtë që e çon mundësinë tregtare nga kërkimi në operim.',
      body: 'Kërkimin e produktit dhe tregut, verifikimin e furnitorëve, menaxhimin e ofertave, negociatat, pagesën, logjistikën dhe dukshmërinë digjitale i trajtoj si një sistem të lidhur.',
      areas: ['Tregti ndërkombëtare', 'Furnizim strategjik', 'Verifikim furnitorësh', 'Zhvillim tregu', 'Tregti digjitale', 'Kërkim me AI'],
    },
    ventures: {
      label: 'Struktura tregtare dhe sipërmarrjet',
      title: 'CTSEG është kompania kryesore tregtare; sipërmarrjet e tjera ofrojnë aftësi mbështetëse.',
      lead: 'CTSEG është platforma operative për furnizim strategjik dhe tregti ndërkombëtare. QCT Studio, QCT Commerce dhe Mythborn mbështesin aftësitë digjitale, rritjen dhe zhvillimin e pavarur të produkteve.',
    },
    expertise: {
      title: 'Ekspertizë që lidh vendimet tregtare me kërkimin, verifikimin dhe realizimin.',
      lead: 'Ky nuk është katalog shërbimesh agjencie, por disiplinë profesionale për vlerësimin dhe drejtimin e mundësive tregtare ndërkombëtare.',
      groups: [
        { title: 'Tregti ndërkombëtare', items: ['Mundësi importi dhe eksporti', 'Përputhje produkt–treg', 'Koordinim blerës–prodhues', 'Negociata tregtare', 'Zhvillim biznesi ndërkufitar'] },
        { title: 'Furnizim strategjik dhe verifikim', items: ['Kërkim prodhuesish dhe furnitorësh', 'Verifikim furnitorësh', 'Analizë çmimi dhe kapaciteti', 'Cilësi dhe dokumentacion', 'Procese RFQ dhe ofertash'] },
        { title: 'Rritje tregtare dhe zhvillim tregu', items: ['Strategji hyrjeje në treg', 'Kërkim produkti dhe tregu', 'Koordinim operacionesh tregtare', 'Tregti digjitale B2B', 'Sisteme shitjeje direkte'] },
        { title: 'Sisteme digjitale dhe AI', items: ['Procese kërkimi furnitorësh', 'Inteligjencë shitjesh', 'Analizë kompanish dhe mundësish', 'Menaxhim njohurish', 'Standardizim operacionesh'] },
      ],
    },
    method: {
      label: 'Modeli i punës',
      title: 'I drejtpërdrejtë, i bazuar në prova dhe i lidhur me realitetin operacional.',
      lead: 'Çdo angazhim redukton supozimet, qartëson palët dhe e bën të dukshëm vendimin e ardhshëm të zbatueshëm.',
      steps: [
        { title: 'Kërkim', description: 'Hartëzim i produktit, tregut, prodhuesve dhe sinjaleve të kërkesës.' },
        { title: 'Verifikim', description: 'Krahasim i furnitorëve, kapacitetit, cilësisë, dokumentacionit, çmimeve dhe kushteve.' },
        { title: 'Strukturim', description: 'Ofertat, rreziku, pagesa, logjistika dhe hyrja në treg kthehen në kornizë vendimmarrjeje.' },
        { title: 'Koordinim', description: 'Hapat kritikë mes palëve dhe operacioneve menaxhohen drejtpërdrejt dhe në mënyrë transparente.' },
      ],
    },
    regional: {
      label: 'Perspektivë ndërkombëtare',
      title: 'Lidhja e kapaciteteve tregtare të Turqisë me tregjet ndërkombëtare.',
      body: 'Lidh kapacitetet prodhuese dhe furnizuese në Turqi me kërkesën rajonale dhe ndërkombëtare. Çdo mundësi vlerësohet sipas produktit, palëve, përputhshmërisë, pagesës, rrezikut dhe logjistikës.',
    },
    contact: {
      label: 'Bisedë strategjike tregtare',
      title: 'Le të qartësojmë një vendim për produktin, tregun ose furnizimin.',
      body: 'Kontaktoni për vlerësim strategjik në nivel themeluesi, zhvillim biznesi ndërkombëtar ose bashkëpunim të drejtpërdrejtë. Kërkesat operative për furnizim dhe tregti strukturohen përmes CTSEG.',
      action: 'Dërgo email',
    },
    ctseg: {
      label: 'Kompania kryesore tregtare',
      kicker: 'Platformë strategjike tregtare e drejtuar nga themeluesi',
      title: 'CTSEG',
      body: 'CTSEG është platformë për furnizim strategjik dhe tregti ndërkombëtare që ndihmon kompanitë të marrin vendime më të informuara për produkte, prodhues, furnitorë dhe tregje.',
      founder: 'Si themelues, Teyfik Gökdemir bashkon kërkimin, verifikimin, strukturimin tregtar dhe koordinimin operacional në një kornizë vendimmarrjeje.',
      services: ['Furnizim strategjik', 'Gjetje dhe verifikim furnitorësh', 'Këshillim për tregti ndërkombëtare', 'Kërkim produkti dhe tregu', 'Koordinim operacionesh tregtare', 'Zhvillim biznesi mes Turqisë dhe tregjeve ndërkombëtare'],
      primary: 'Eksploroni shërbimet e CTSEG',
      secondary: 'Diskutoni një kërkesë furnizimi',
    },
    journey: { year: '2026', title: 'CTSEG', description: 'Kompania kryesore tregtare për furnizim strategjik, verifikim furnitorësh dhe operacione ndërkombëtare.' },
    ecosystem: {
      label: 'Sipërmarrje mbështetëse',
      title: 'Aftësi digjitale dhe sipërmarrje të pavarura.',
      text: 'QCT Studio dhe QCT Commerce zhvillojnë sisteme të tregtisë digjitale dhe rritjes; Mythborn është sipërmarrje e pavarur konsumatore. Këto struktura mbështesin ekspertizën më të gjerë pa konkurruar rolin kryesor tregtar të CTSEG.',
    },
  },
} as const;

const localPositioning = positioning[locale] ?? positioning.en;
const localeCtsegLinks = ctsegLinks[locale] ?? ctsegLinks.en;
const ventureItems = baseCopy.ventures.items.filter((item) => item.url);
const operationalSystems = baseCopy.ventures.items.filter((item) => !item.url);
const operationalSystemsLabel = {
  tr: 'Dijital ve AI destekli operasyon sistemleri',
  en: 'Digital and AI-assisted operating systems',
  mk: 'Дигитални и оперативни системи поддржани од AI',
  sr: 'Digitalni i operativni sistemi podržani AI tehnologijom',
  sq: 'Sisteme digjitale dhe operacionale të asistuara nga AI',
} as const;
const journeyItems = [localPositioning.journey, ...baseCopy.journey.items]
  .sort((left, right) => {
    const leftYear = left.title === 'QCT Studio' || left.title === 'QCT Commerce'
      ? 2025
      : Number(left.year);
    const rightYear = right.title === 'QCT Studio' || right.title === 'QCT Commerce'
      ? 2025
      : Number(right.year);
    return leftYear - rightYear;
  });

const copy = {
  ...baseCopy,
  hero: { ...baseCopy.hero, ...localPositioning.hero },
  intro: { ...baseCopy.intro, ...localPositioning.intro },
  ventures: {
    ...baseCopy.ventures,
    ...localPositioning.ventures,
    items: ventureItems,
  },
  expertise: {
    ...baseCopy.expertise,
    ...localPositioning.expertise,
    definitions: baseCopy.expertise.definitions,
  },
  method: { ...baseCopy.method, ...localPositioning.method },
  regional: { ...baseCopy.regional, ...localPositioning.regional },
  contact: { ...baseCopy.contact, ...localPositioning.contact },
  journey: {
    ...baseCopy.journey,
    items: journeyItems,
  },
};

const legalCopy = {
  tr: { privacy: 'Gizlilik ve Çerez Politikası', kvkk: 'KVKK Aydınlatma Metni', terms: 'Kullanım Koşulları' },
  en: { privacy: 'Privacy & Cookie Policy', kvkk: 'Data Protection Notice', terms: 'Terms of Use' },
  mk: { privacy: 'Политика за приватност и колачиња', kvkk: 'Известување за заштита на податоци', terms: 'Услови за користење' },
  sr: { privacy: 'Politika privatnosti i kolačića', kvkk: 'Obaveštenje o zaštiti podataka', terms: 'Uslovi korišćenja' },
  sq: { privacy: 'Politika e Privatësisë dhe Cookies', kvkk: 'Njoftim për Mbrojtjen e të Dhënave', terms: 'Kushtet e Përdorimit' },
} as const;

const legal = legalCopy[locale] ?? legalCopy.en;
const displayedYear = (title: string, year: string) =>
  title === 'QCT Studio' || title === 'QCT Commerce' ? '2025' : year;
---
<link rel="stylesheet" href="/styles/ventures-compact.css" />
<Header locale={locale} copy={copy} homePath={`/${locale}/`} />
<main id="main-content">
  <section class="hero shell" id="top" aria-labelledby="hero-title">
    <div class="hero-copy">
      <p class="section-label" data-reveal="hero-part" style="--reveal-order:0">{copy.hero.eyebrow}</p>
      <h1 id="hero-title" data-reveal="hero-part" style="--reveal-order:1">{copy.hero.title}</h1>
      <p class="hero-description" data-reveal="hero-part" style="--reveal-order:2">{copy.hero.description}</p>
      <div class="hero-actions" data-reveal="hero-part" style="--reveal-order:3">
        <a class="button primary" href={localeCtsegLinks.home}>{copy.hero.primary}</a>
        <a class="button" href="#contact">{copy.hero.secondary}</a>
      </div>
      <p class="hero-summary" data-reveal="hero-part" style="--reveal-order:4">{copy.hero.summary}</p>
    </div>
    <div class="hero-media" data-reveal="hero-media">
      <img src={site.images.hero.path} srcset={site.images.hero.srcset} sizes="(max-width: 760px) 92vw, (max-width: 1180px) 48vw, 665px" width={site.images.hero.width} height={site.images.hero.height} alt={copy.images.hero} loading="eager" decoding="async" fetchpriority="high" />
    </div>
  </section>

  <section class="section ctseg-featured" id="ctseg" aria-labelledby="ctseg-title">
    <div class="shell ctseg-featured__panel" data-reveal="scene">
      <div class="ctseg-featured__identity" data-ctseg-layer="identity">
        <img src={site.images.ctseg.path} width={site.images.ctseg.width} height={site.images.ctseg.height} alt="CTSEG" loading="lazy" decoding="async" />
        <p class="section-label">{localPositioning.ctseg.label}</p>
        <p class="ctseg-featured__kicker">{localPositioning.ctseg.kicker}</p>
        <h2 id="ctseg-title">{localPositioning.ctseg.title}</h2>
        <p class="section-lead">{localPositioning.ctseg.body}</p>
        <p class="ctseg-featured__founder">{localPositioning.ctseg.founder}</p>
        <div class="ctseg-featured__actions">
          <a class="button primary" href={localeCtsegLinks.services}>{localPositioning.ctseg.primary}</a>
          <a class="button" href={localeCtsegLinks.contact}>{localPositioning.ctseg.secondary}</a>
        </div>
      </div>
      <ul class="ctseg-featured__services" data-ctseg-layer="services">
        {localPositioning.ctseg.services.map((service) => <li>{service}</li>)}
      </ul>
    </div>
  </section>

  <section class="section story-stage story-stage--light story-stage--mineral story-stage--intro" aria-labelledby="intro-title">
    <div class="shell intro-grid">
      <div class="editorial-image" data-reveal="portrait">
        <img src={site.images.profile.path} srcset={site.images.profile.srcset} sizes="(max-width: 760px) 92vw, (max-width: 1180px) 48vw, 662px" width={site.images.profile.width} height={site.images.profile.height} alt={copy.images.profile} loading="lazy" decoding="async" />
      </div>
      <div data-reveal="section">
        <p class="section-label">{copy.intro.label}</p>
        <h2 id="intro-title">{copy.intro.title}</h2>
        <p class="section-lead">{copy.intro.body}</p>
        <div class="focus-list">{copy.intro.areas.map((area) => <span>{area}</span>)}</div>
      </div>
    </div>
  </section>

  <section class="section story-stage story-stage--light story-stage--sage story-stage--ventures" id="ventures" aria-labelledby="ventures-title">
    <div class="shell">
      <div class="section-heading" data-reveal="heading">
        <p class="section-label">{copy.ventures.label}</p>
        <h2 id="ventures-title">{copy.ventures.title}</h2>
        <p class="section-lead">{copy.ventures.lead}</p>
      </div>
      <div class="venture-grid">
        {copy.ventures.items.map((item, index) => item.url ? (
          <a class:list={['venture-card', { 'has-image': item.image === 'commerce', 'venture-card--ctseg': item.image === 'ctseg' }]} href={item.url} target="_blank" rel="noopener noreferrer" aria-label={item.aria + ', ' + copy.a11y.external} data-reveal="item" style={`--reveal-order:${index}`}>
            {item.image === 'commerce' && <img src={site.images.commerce.path} width={site.images.commerce.width} height={site.images.commerce.height} alt={copy.images.commerce} loading="lazy" decoding="async" />}
            {item.image === 'ctseg' && <img class="venture-card__ctseg-logo" src={site.images.ctseg.path} width={site.images.ctseg.width} height={site.images.ctseg.height} alt="" loading="lazy" decoding="async" />}
            <div class="venture-meta"><span class="tag">{item.status}</span><span class="tag">{item.region}</span></div>
            <h3>{item.name}</h3>
            <p>{item.description}</p>
            <span class="venture-arrow" aria-hidden="true">↗</span>
          </a>
        ) : (
          <article class="venture-card" aria-label={item.aria} data-reveal="item" style={`--reveal-order:${index}`}>
            <div class="venture-meta"><span class="tag">{item.status}</span><span class="tag">{item.region}</span></div>
            <h3>{item.name}</h3>
            <p>{item.description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section story-stage story-stage--dark story-stage--smoke" id="expertise" aria-labelledby="expertise-title">
    <div class="shell">
      <div class="section-heading" data-reveal="heading">
        <p class="section-label">{copy.expertise.label}</p>
        <h2 id="expertise-title">{copy.expertise.title}</h2>
        <p class="section-lead">{copy.expertise.lead}</p>
      </div>
      <div class="expertise-grid">
        {copy.expertise.groups.map((group, index) => <article class="expertise-card" data-reveal="item" style={`--reveal-order:${index}`}><h3>{group.title}</h3><ul>{group.items.map((item) => <li>{item}</li>)}</ul></article>)}
      </div>
      <p class="definitions">{copy.expertise.definitions}</p>
    </div>
  </section>

  <section class="section story-stage story-stage--light story-stage--mineral" id="journey" aria-labelledby="journey-title">
    <div class="shell journey-layout">
      <div class="journey-image" data-reveal="portrait"><img src={site.images.executive.path} width={site.images.executive.width} height={site.images.executive.height} alt={copy.images.executive} loading="lazy" decoding="async" /></div>
      <div>
        <div class="section-heading" data-reveal="heading"><p class="section-label">{copy.journey.label}</p><h2 id="journey-title">{copy.journey.title}</h2><p class="section-lead">{copy.journey.lead}</p></div>
        <ol class="timeline" data-reveal="timeline">{copy.journey.items.map((item, index) => <li style={`--reveal-order:${index}`}><time datetime={displayedYear(item.title, item.year)}>{displayedYear(item.title, item.year)}</time><div class="timeline-content"><h3>{item.title}</h3><p>{item.description}</p></div></li>)}</ol>
      </div>
    </div>
  </section>

  <section class="section story-stage story-stage--dark story-stage--smoke story-stage--method" aria-labelledby="method-title">
    <div class="shell">
      <div class="section-heading" data-reveal="heading"><p class="section-label">{copy.method.label}</p><h2 id="method-title">{copy.method.title}</h2><p class="section-lead">{copy.method.lead}</p></div>
      <div class="method-grid">{copy.method.steps.map((step, index) => <article class="method-card" data-reveal="item" style={`--reveal-order:${index}`}><h3>{step.title}</h3><p>{step.description}</p></article>)}</div>
      <div class="operational-systems" data-reveal="section">
        <p class="section-label">{operationalSystemsLabel[locale] ?? operationalSystemsLabel.en}</p>
        {operationalSystems.map((system) => (
          <article>
            <h3>{system.name}</h3>
            <p>{system.description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section story-stage story-stage--light story-stage--stone story-stage--regional" aria-labelledby="regional-title">
    <div class="shell regional-grid">
      <div data-reveal="section"><p class="section-label">{copy.regional.label}</p><h2 id="regional-title">{copy.regional.title}</h2><p class="section-lead">{copy.regional.body}</p></div>
      <div class="editorial-image" data-reveal="portrait"><img src={site.images.global.path} width={site.images.global.width} height={site.images.global.height} alt={copy.images.regional} loading="lazy" decoding="async" /></div>
    </div>
  </section>

  <section class="section contact-section story-stage--olive" id="contact" aria-labelledby="contact-title">
    <div class="shell">
      <div class="contact-card" data-reveal="section">
        <p class="section-label">{copy.contact.label}</p>
        <h2 id="contact-title">{copy.contact.title}</h2>
        <p class="section-lead">{copy.contact.body}</p>
        <a class="button primary" href={'mailto:' + site.email} aria-label={copy.contact.action + ': ' + site.email}>{site.email}</a>
      </div>
    </div>
  </section>
</main>
<VentureMarquee />
<Footer copy={copy} locale={locale} />
<nav class="legal-links" aria-label="Legal"><a href="/privacy-policy/">{legal.privacy}</a><a href="/kvkk/">{legal.kvkk}</a><a href="/terms/">{legal.terms}</a></nav>
<FloatingActions locale={locale} />

<style>
  .story-stage {
    position: relative;
