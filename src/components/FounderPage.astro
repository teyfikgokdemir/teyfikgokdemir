---
import Header from './Header.astro';
import Footer from './Footer.astro';
import VentureMarquee from './VentureMarquee.astro';
import FloatingActions from './FloatingActions.astro';
import CookieBanner from './CookieBanner.astro';
import type { Locale } from '../i18n/locales';
import { content } from '../i18n/content';
import { site } from '../data/site';

interface Props { locale: Locale; }

const { locale } = Astro.props;
const baseCopy = content[locale];

const positioning = {
  tr: {
    hero: {
      eyebrow: 'Uluslararası ticaret · Stratejik tedarik · İş geliştirme',
      title: 'Uluslararası ticaret ve stratejik tedarik sistemleri kuruyorum.',
      description: 'Üretici araştırmasından fiyat ve kapasite doğrulamasına, alıcı-satıcı koordinasyonundan lojistik ve pazara giriş planına kadar ticari süreci uçtan uca yapılandırıyorum.',
      primary: 'Çalışma alanlarını incele', secondary: 'İletişime geç',
      summary: 'Teyfik Gökdemir; uluslararası ticaret, stratejik tedarik, tedarikçi araştırması, iş geliştirme ve AI destekli ticari operasyonlar üzerine çalışan Türkiye merkezli bir girişimcidir.',
    },
    intro: {
      label: 'Ticari yaklaşım', title: 'Ticari fırsatı araştırmadan uygulamaya taşıyorum.',
      body: 'Ürün ve üretici araştırması, tedarikçi doğrulama, teklif toplama, ticari müzakere, ihracata uygunluk, ödeme, lojistik ve satış kanallarını tek bir ticari sistem olarak ele alıyorum. Amaç yalnızca bağlantı kurmak değil; güvenilir, ölçülebilir ve sürdürülebilir bir iş modeli oluşturmaktır.',
      areas: ['Uluslararası ticaret', 'Stratejik tedarik', 'Tedarikçi araştırması ve doğrulama', 'İş geliştirme ve pazara giriş'],
    },
    expertise: {
      title: 'Ticari fırsatı uçtan uca yöneten uzmanlık alanları.', lead: 'Tedarik, pazar erişimi, müzakere, operasyon ve dijital görünürlük aynı ticari hedef doğrultusunda birlikte yönetilir.',
      groups: [
        { title: 'Uluslararası ticaret', items: ['İhracat ve ithalat fırsatları', 'Ürün-pazar eşleştirme', 'Alıcı ve üretici koordinasyonu', 'Teklif ve RFQ süreçleri', 'Ticari müzakere', 'Sınır ötesi iş geliştirme'] },
        { title: 'Stratejik tedarik', items: ['Üretici ve tedarikçi araştırması', 'Tedarikçi doğrulama', 'Fiyat ve kapasite analizi', 'Ürün spesifikasyonu', 'Kalite ve belge koordinasyonu', 'Lojistik ve sipariş takibi'] },
        { title: 'Pazar geliştirme ve görünürlük', items: ['Pazara giriş stratejisi', 'B2B dijital ticaret', 'Doğrudan satış sistemleri', 'SEO', 'GEO', 'AEO', 'AIO', 'İçerik ve otorite yapılanması'] },
        { title: 'AI destekli ticari sistemler', items: ['Tedarikçi araştırma akışları', 'Satış istihbaratı', 'Şirket ve fırsat analizi', 'Teklif otomasyonu', 'Bilgi yönetimi', 'Operasyon standardizasyonu'] },
      ],
    },
    regional: { label: 'Sınır ötesi bakış', title: 'Türkiye, Balkanlar ve çevre pazarlarda yeni ticaret bağlantıları.', body: 'Türkiye’nin üretim ve tedarik gücünü bölgesel talep ile buluşturan; aynı zamanda çevre pazarlardaki ürün, alıcı ve iş ortaklığı fırsatlarını Türkiye’ye bağlayan ticari yapılar geliştiriyorum. Her fırsatı ürün, taraflar, mevzuat, ödeme, risk ve lojistik gerçekleriyle birlikte değerlendiriyorum.' },
    contact: { label: 'Ticari iş birlikleri için', title: 'Bir ürün, pazar veya tedarik fırsatını birlikte değerlendirelim.', body: 'Uluslararası alım-satım, üretici veya tedarikçi bulma, yeni pazar geliştirme, ticari iş ortaklığı ya da AI destekli ticaret operasyonları üzerinde çalışıyorsanız doğrudan iletişime geçebilirsiniz.', action: 'E-posta gönder' },
  },
  en: {
    hero: {
      eyebrow: 'International trade · Strategic sourcing · Business development',
      title: 'Building international trade and strategic sourcing systems.',
      description: 'I structure the commercial process end to end—from manufacturer research, price and capacity validation to buyer-seller coordination, logistics and market-entry planning.',
      primary: 'Explore focus areas', secondary: 'Get in touch',
      summary: 'Teyfik Gökdemir is a Türkiye-based entrepreneur working across international trade, strategic sourcing, supplier research, business development and AI-assisted commercial operations.',
    },
    intro: {
      label: 'Commercial approach', title: 'Turning commercial opportunities into executable structures.',
      body: 'Product and manufacturer research, supplier verification, quotation management, commercial negotiation, export readiness, payment, logistics and sales channels are managed as one connected commercial system. The objective is not simply to make introductions, but to build reliable, measurable and sustainable trade structures.',
      areas: ['International trade', 'Strategic sourcing', 'Supplier research & verification', 'Business development & market entry'],
    },
    expertise: {
      title: 'Expertise across the full commercial opportunity.', lead: 'Sourcing, market access, negotiation, operations and digital visibility remain connected to the same commercial objective.',
      groups: [
        { title: 'International trade', items: ['Import and export opportunities', 'Product-market matching', 'Buyer and manufacturer coordination', 'RFQ and quotation processes', 'Commercial negotiation', 'Cross-border business development'] },
        { title: 'Strategic sourcing', items: ['Manufacturer and supplier research', 'Supplier verification', 'Price and capacity analysis', 'Product specifications', 'Quality and documentation coordination', 'Logistics and order tracking'] },
        { title: 'Market development & visibility', items: ['Market-entry strategy', 'B2B digital commerce', 'Direct sales systems', 'SEO', 'GEO', 'AEO', 'AIO', 'Content and authority building'] },
        { title: 'AI-assisted commercial systems', items: ['Supplier research workflows', 'Sales intelligence', 'Company and opportunity analysis', 'Proposal automation', 'Knowledge management', 'Operational standardisation'] },
      ],
    },
    regional: { label: 'Cross-border perspective', title: 'Building new commercial links across Türkiye, the Balkans and neighbouring markets.', body: 'I develop structures that connect Türkiye’s production and sourcing capabilities with regional demand, while linking product, buyer and partnership opportunities in neighbouring markets back to Türkiye. Each opportunity is assessed through product, counterpart, compliance, payment, risk and logistics realities.' },
    contact: { label: 'For commercial partnerships', title: 'Let’s evaluate a product, market or sourcing opportunity.', body: 'Get in touch for international buying and selling, manufacturer or supplier sourcing, market development, commercial partnerships or AI-assisted trade operations.', action: 'Send an email' },
  },
  mk: {
    hero: {
      eyebrow: 'Меѓународна трговија · Стратешко снабдување · Деловен развој',
      title: 'Градам системи за меѓународна трговија и стратешко снабдување.',
      description: 'Го структурирам трговскиот процес од почеток до крај — од истражување производители и проверка на цена и капацитет, до координација меѓу купувач и продавач, логистика и влез на пазар.',
      primary: 'Истражете ги областите', secondary: 'Контактирајте ме',
      summary: 'Тејфик Ѓокдемир е претприемач од Турција кој работи во меѓународна трговија, стратешко снабдување, истражување добавувачи, деловен развој и комерцијални операции поддржани со AI.',
    },
    intro: {
      label: 'Трговски пристап', title: 'Ги претворам трговските можности во применливи структури.',
      body: 'Истражувањето на производи и производители, проверката на добавувачи, управувањето со понуди, преговорите, извозната подготвеност, плаќањето, логистиката и продажните канали ги водам како еден поврзан трговски систем.',
      areas: ['Меѓународна трговија', 'Стратешко снабдување', 'Истражување и проверка на добавувачи', 'Деловен развој и влез на пазар'],
    },
    expertise: {
      title: 'Експертиза низ целата трговска можност.', lead: 'Снабдувањето, пристапот до пазар, преговорите, операциите и дигиталната видливост се управуваат кон иста трговска цел.',
      groups: [
        { title: 'Меѓународна трговија', items: ['Увозни и извозни можности', 'Поврзување производ и пазар', 'Координација купувач–производител', 'RFQ и понудбени процеси', 'Комерцијални преговори', 'Прекуграничен деловен развој'] },
        { title: 'Стратешко снабдување', items: ['Истражување производители и добавувачи', 'Проверка на добавувачи', 'Анализа на цена и капацитет', 'Спецификации на производ', 'Квалитет и документација', 'Логистика и следење на нарачки'] },
        { title: 'Развој на пазар и видливост', items: ['Стратегија за влез на пазар', 'B2B дигитална трговија', 'Системи за директна продажба', 'SEO', 'GEO', 'AEO', 'AIO', 'Содржина и авторитет'] },
        { title: 'AI-поддржани трговски системи', items: ['Текови за истражување добавувачи', 'Продажна интелигенција', 'Анализа на компании и можности', 'Автоматизација на понуди', 'Управување со знаење', 'Стандардизација на операции'] },
      ],
    },
    regional: { label: 'Прекуграничен поглед', title: 'Нови трговски врски меѓу Турција, Балканот и соседните пазари.', body: 'Развивам структури што ги поврзуваат производствените и снабдувачките капацитети на Турција со регионалната побарувачка. Секоја можност ја оценувам според производ, партнери, усогласеност, плаќање, ризик и логистика.' },
    contact: { label: 'За трговски партнерства', title: 'Да оцениме производ, пазар или можност за снабдување.', body: 'Контактирајте ме за меѓународна купопродажба, пронаоѓање производители или добавувачи, развој на пазар, трговски партнерства или AI-поддржани операции.', action: 'Испратете е-пошта' },
  },
  sr: {
    hero: {
      eyebrow: 'Međunarodna trgovina · Strateški sourcing · Razvoj poslovanja',
      title: 'Gradim sisteme za međunarodnu trgovinu i strateški sourcing.',
      description: 'Komercijalni proces strukturiram od početka do kraja — od istraživanja proizvođača i provere cena i kapaciteta do koordinacije kupca i prodavca, logistike i planiranja ulaska na tržište.',
      primary: 'Pogledajte oblasti rada', secondary: 'Kontaktirajte me',
      summary: 'Teyfik Gökdemir je preduzetnik iz Turske koji radi u međunarodnoj trgovini, strateškom sourcingu, istraživanju dobavljača, razvoju poslovanja i komercijalnim operacijama podržanim veštačkom inteligencijom.',
    },
    intro: {
      label: 'Komercijalni pristup', title: 'Komercijalne prilike pretvaram u primenljive strukture.',
      body: 'Istraživanje proizvoda i proizvođača, provera dobavljača, upravljanje ponudama, komercijalni pregovori, izvozna spremnost, plaćanje, logistika i prodajni kanali vode se kao jedan povezan trgovinski sistem.',
      areas: ['Međunarodna trgovina', 'Strateški sourcing', 'Istraživanje i provera dobavljača', 'Razvoj poslovanja i ulazak na tržište'],
    },
    expertise: {
      title: 'Stručnost kroz ceo komercijalni proces.', lead: 'Sourcing, pristup tržištu, pregovori, operacije i digitalna vidljivost povezani su sa istim komercijalnim ciljem.',
      groups: [
        { title: 'Međunarodna trgovina', items: ['Uvozne i izvozne prilike', 'Usklađivanje proizvoda i tržišta', 'Koordinacija kupca i proizvođača', 'RFQ i procesi ponuda', 'Komercijalni pregovori', 'Prekogranični razvoj poslovanja'] },
        { title: 'Strateški sourcing', items: ['Istraživanje proizvođača i dobavljača', 'Provera dobavljača', 'Analiza cena i kapaciteta', 'Specifikacije proizvoda', 'Koordinacija kvaliteta i dokumentacije', 'Logistika i praćenje porudžbina'] },
        { title: 'Razvoj tržišta i vidljivost', items: ['Strategija ulaska na tržište', 'B2B digitalna trgovina', 'Sistemi direktne prodaje', 'SEO', 'GEO', 'AEO', 'AIO', 'Sadržaj i izgradnja autoriteta'] },
        { title: 'AI podržani komercijalni sistemi', items: ['Tokovi istraživanja dobavljača', 'Prodajna inteligencija', 'Analiza kompanija i prilika', 'Automatizacija ponuda', 'Upravljanje znanjem', 'Standardizacija operacija'] },
      ],
    },
    regional: { label: 'Prekogranična perspektiva', title: 'Nove trgovinske veze između Turske, Balkana i susednih tržišta.', body: 'Razvijam strukture koje povezuju proizvodne i sourcing kapacitete Turske sa regionalnom tražnjom. Svaku priliku procenjujem kroz proizvod, partnere, usklađenost, plaćanje, rizik i logistiku.' },
    contact: { label: 'Za komercijalna partnerstva', title: 'Hajde da procenimo proizvod, tržište ili sourcing priliku.', body: 'Javite se za međunarodnu kupovinu i prodaju, pronalaženje proizvođača ili dobavljača, razvoj tržišta, komercijalna partnerstva ili AI podržane trgovinske operacije.', action: 'Pošaljite e-poštu' },
  },
  sq: {
    hero: {
      eyebrow: 'Tregti ndërkombëtare · Furnizim strategjik · Zhvillim biznesi',
      title: 'Ndërtoj sisteme për tregti ndërkombëtare dhe furnizim strategjik.',
      description: 'E strukturoj procesin tregtar nga fillimi në fund — nga kërkimi i prodhuesve dhe verifikimi i çmimit e kapacitetit, te koordinimi blerës–shitës, logjistika dhe hyrja në treg.',
      primary: 'Shiko fushat e punës', secondary: 'Kontakto',
      summary: 'Teyfik Gökdemir është sipërmarrës me bazë në Turqi, i fokusuar në tregtinë ndërkombëtare, furnizimin strategjik, kërkimin e furnitorëve, zhvillimin e biznesit dhe operacionet tregtare të mbështetura nga AI.',
    },
    intro: {
      label: 'Qasje tregtare', title: 'I kthej mundësitë tregtare në struktura të zbatueshme.',
      body: 'Kërkimi i produkteve dhe prodhuesve, verifikimi i furnitorëve, menaxhimi i ofertave, negociatat tregtare, gatishmëria për eksport, pagesat, logjistika dhe kanalet e shitjes trajtohen si një sistem i vetëm tregtar.',
      areas: ['Tregti ndërkombëtare', 'Furnizim strategjik', 'Kërkim dhe verifikim furnitorësh', 'Zhvillim biznesi dhe hyrje në treg'],
    },
    expertise: {
      title: 'Ekspertizë në të gjithë mundësinë tregtare.', lead: 'Furnizimi, hyrja në treg, negociatat, operacionet dhe dukshmëria digjitale lidhen me të njëjtin objektiv tregtar.',
      groups: [
        { title: 'Tregti ndërkombëtare', items: ['Mundësi importi dhe eksporti', 'Përputhje produkt–treg', 'Koordinim blerës–prodhues', 'Procese RFQ dhe ofertash', 'Negociata tregtare', 'Zhvillim biznesi ndërkufitar'] },
        { title: 'Furnizim strategjik', items: ['Kërkim prodhuesish dhe furnitorësh', 'Verifikim furnitorësh', 'Analizë çmimi dhe kapaciteti', 'Specifikime produkti', 'Koordinim cilësie dhe dokumentacioni', 'Logjistikë dhe ndjekje porosish'] },
        { title: 'Zhvillim tregu dhe dukshmëri', items: ['Strategji hyrjeje në treg', 'Tregti digjitale B2B', 'Sisteme shitjeje direkte', 'SEO', 'GEO', 'AEO', 'AIO', 'Përmbajtje dhe autoritet'] },
        { title: 'Sisteme tregtare të mbështetura nga AI', items: ['Procese kërkimi furnitorësh', 'Inteligjencë shitjesh', 'Analizë kompanish dhe mundësish', 'Automatizim ofertash', 'Menaxhim njohurish', 'Standardizim operacionesh'] },
      ],
    },
    regional: { label: 'Perspektivë ndërkufitare', title: 'Lidhje të reja tregtare mes Turqisë, Ballkanit dhe tregjeve fqinje.', body: 'Zhvilloj struktura që lidhin kapacitetet prodhuese dhe të furnizimit të Turqisë me kërkesën rajonale. Çdo mundësi vlerësohet sipas produktit, palëve, përputhshmërisë, pagesës, rrezikut dhe logjistikës.' },
    contact: { label: 'Për partneritete tregtare', title: 'Le të vlerësojmë një produkt, treg ose mundësi furnizimi.', body: 'Kontaktoni për blerje dhe shitje ndërkombëtare, gjetje prodhuesish ose furnitorësh, zhvillim tregu, partneritete tregtare ose operacione të mbështetura nga AI.', action: 'Dërgo email' },
  },
} as const;

const localPositioning = positioning[locale] ?? positioning.en;
const copy = {
  ...baseCopy,
  hero: { ...baseCopy.hero, ...localPositioning.hero },
  intro: { ...baseCopy.intro, ...localPositioning.intro },
  expertise: { ...baseCopy.expertise, ...localPositioning.expertise, definitions: baseCopy.expertise.definitions },
  regional: { ...baseCopy.regional, ...localPositioning.regional },
  contact: { ...baseCopy.contact, ...localPositioning.contact },
};

const ecosystemCopy = {
  tr: { label: 'QCT ekosistemi', title: 'Ticaret, teknoloji ve pazar geliştirme için bağlantılı girişimler.', text: 'Teyfik Gökdemir, 2025 yılında başlayan QCT yapılanması kapsamında Türkiye’de QCT Commerce’i, Balkanlar’da QCT Studio’yu ve uluslararası pazara yönelik Mythborn girişimini geliştirmektedir.' },
  en: { label: 'QCT ecosystem', title: 'Connected ventures for commerce, technology and market development.', text: 'Teyfik Gökdemir develops QCT Commerce for Türkiye, QCT Studio for the Balkans and Mythborn for international markets within the QCT structure established in 2025.' },
  mk: { label: 'QCT екосистем', title: 'Поврзани потфати за трговија, технологија и развој на пазар.', text: 'Тејфик Ѓокдемир ги развива QCT Commerce за Турција, QCT Studio за Балканот и Mythborn за меѓународните пазари во рамките на QCT структурата започната во 2025 година.' },
  sr: { label: 'QCT ekosistem', title: 'Povezani poduhvati za trgovinu, tehnologiju i razvoj tržišta.', text: 'Teyfik Gökdemir razvija QCT Commerce za Tursku, QCT Studio za Balkan i Mythborn za međunarodna tržišta u okviru QCT strukture pokrenute 2025. godine.' },
  sq: { label: 'Ekosistemi QCT', title: 'Sipërmarrje të lidhura për tregti, teknologji dhe zhvillim tregu.', text: 'Teyfik Gökdemir zhvillon QCT Commerce për Turqinë, QCT Studio për Ballkanin dhe Mythborn për tregjet ndërkombëtare brenda strukturës QCT të nisur në vitin 2025.' },
} as const;
const legalCopy = {
  tr: { privacy: 'Gizlilik ve Çerez Politikası', kvkk: 'KVKK Aydınlatma Metni', terms: 'Kullanım Koşulları' },
  en: { privacy: 'Privacy & Cookie Policy', kvkk: 'Data Protection Notice', terms: 'Terms of Use' },
  mk: { privacy: 'Политика за приватност и колачиња', kvkk: 'Известување за заштита на податоци', terms: 'Услови за користење' },
  sr: { privacy: 'Politika privatnosti i kolačića', kvkk: 'Obaveštenje o zaštiti podataka', terms: 'Uslovi korišćenja' },
  sq: { privacy: 'Politika e Privatësisë dhe Cookies', kvkk: 'Njoftim për Mbrojtjen e të Dhënave', terms: 'Kushtet e Përdorimit' },
} as const;
const ecosystem = ecosystemCopy[locale] ?? ecosystemCopy.en;
const legal = legalCopy[locale] ?? legalCopy.en;
const displayedYear = (title: string, year: string) => title === 'QCT Studio' || title === 'QCT Commerce' ? '2025' : year;
---
<Header locale={locale} copy={copy} homePath={locale === 'en' ? '/' : `/${locale}/`} />
<main id="main-content">
  <section class="hero shell" id="top" aria-labelledby="hero-title">
    <div class="hero-copy"><p class="section-label">{copy.hero.eyebrow}</p><h1 id="hero-title">{copy.hero.title}</h1><p class="hero-description">{copy.hero.description}</p><div class="hero-actions"><a class="button primary" href="#expertise">{copy.hero.primary}</a><a class="button" href="#contact">{copy.hero.secondary}</a></div><p class="hero-summary">{copy.hero.summary}</p></div>
    <div class="hero-media"><img src={site.images.hero.path} srcset={site.images.hero.srcset} sizes="(max-width: 760px) 92vw, (max-width: 1180px) 48vw, 665px" width={site.images.hero.width} height={site.images.hero.height} alt={copy.images.hero} loading="eager" decoding="async" fetchpriority="high" /></div>
  </section>
  <section class="section" aria-labelledby="intro-title"><div class="shell intro-grid"><div class="editorial-image"><img src={site.images.profile.path} srcset={site.images.profile.srcset} sizes="(max-width: 760px) 92vw, (max-width: 1180px) 48vw, 662px" width={site.images.profile.width} height={site.images.profile.height} alt={copy.images.profile} loading="lazy" decoding="async" /></div><div><p class="section-label">{copy.intro.label}</p><h2 id="intro-title">{copy.intro.title}</h2><p class="section-lead">{copy.intro.body}</p><div class="focus-list">{copy.intro.areas.map((area) => <span>{area}</span>)}</div></div></div></section>
