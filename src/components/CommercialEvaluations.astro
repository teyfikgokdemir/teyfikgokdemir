      { market: '欧洲及中东 · 大宗粮油', title: '商务接洽与标准化报价框架', text: '在初次评估阶段明确买家核心诉求、包装规格、基准价格假设及国际贸易术语 (Incoterms) 交付条件。', signals: ['采购方核心诉求', '报价与核算纪律', '商务执行推进'] },
    ],
    cta: '与 CTSEG 沟通您的采购或贸易需求',
  },
  vi: {
    label: 'Các đánh giá thương mại đang tiến hành',
    title: 'Các tuyến dự án phát triển kết nối các thị trường.',
    lead: 'Các lĩnh vực này đại diện cho các dự án thương mại quốc tế đang triển khai, tích hợp toàn diện các yếu tố sản phẩm, đối tác, chứng từ, báo giá và giao nhận thực tế.',
    status: 'Đang trong giai đoạn đánh giá',
    disclaimer: 'Bu bölüm sonuçlanmış anlaşma, garanti edilen tedarik veya kamuya açıklanmış müşteri listesi değildir. Phần này không cấu thành thỏa thuận đã ký kết, cam kết cung ứng bảo đảm hoặc danh sách khách hàng công khai. Thương mại bảo mật được tôn trọng tối đa.',
    evaluations: [
      {
        market: 'Châu Á · Năng lượng & Nguyên liệu',
        title: 'Hành lang cung ứng nhiên liệu sinh học',
        text: 'Đánh giá sản lượng nguyên liệu năng lượng, tính tương thích kỹ thuật, nguồn gốc xuất xứ, mô hình giao hàng và tính sẵn sàng của đối tác trong một khung thương mại thống nhất.',
        signals: ['Khung kỹ thuật & Sản phẩm', 'Hành lang cung ứng', 'Mô hình giao hàng'],
      },
      {
        market: 'Thị trường tuyển chọn · Dầu thực vật',
        title: 'Xuất khẩu dầu hướng dương đóng gói',
        text: 'Kết nối thông số kỹ thuật, nhãn mác, MOQ, cơ cấu báo giá và điều kiện thị trường đích cho sản phẩm đóng chai PET hoặc thùng thiếc.',
        signals: ['Bao bì & Nhãn mác', 'RFQ & Báo giá', 'Tính phù hợp thị trường'],
      },
      {
        market: 'Iran ↔ Thổ Nhĩ Kỳ · Thương mại thực phẩm',
        title: 'Nhập khẩu hạt và trái cây sấy khô',
        text: 'Thiết lập luồng cung ứng khả thi dựa trên phân hạng sản phẩm, nguồn gốc, cỡ hạt, mẫu đối chứng, phân tích lô hàng, bao bì và chứng từ nhập khẩu.',
        signals: ['Chất lượng & Phân tích', 'Truy xuất nguồn gốc', 'Điều phối nhập khẩu'],
      },
      {
        market: 'Thổ Nhĩ Kỳ → Thị trường khu vực · Vệ sinh y tế',
        title: 'Phân phối găng tay dùng một lần',
        text: 'Cấu trúc ứng dụng sản phẩm, hồ sơ chứng từ, hồ sơ người mua, mô hình phân phối và các tiếp xúc thương mại ban đầu cho danh mục REFLEX.',
        signals: ['Ứng dụng sản phẩm', 'Chứng chỉ chất lượng', 'Mô hình phân phối'],
      },
      {
        market: 'Châu Âu · Dầu thực vật',
        title: 'Tiếp xúc ban đầu & Khung báo giá',
        text: 'Làm rõ nhu cầu của người mua, quy cách đóng gói, giả định giá và điều kiện giao hàng trong đánh giá ban đầu cho xuất khẩu dầu hướng dương.',
        signals: ['Nhu cầu người mua', 'Kỷ luật báo giá', 'Bước hành động thương mại tiếp theo'],
      },
    ],
    cta: 'Trao đổi về một cơ hội thương mại',
  },
};

const contactLinks: Record<Lang, string> = {
  tr: 'https://ctseg.com.tr/tr/iletisim/',
  en: 'https://ctseg.com.tr/en/contact/',
  ru: 'https://ctseg.com.tr/en/contact/',
  mk: 'https://ctseg.com.tr/en/contact/',
  sr: 'https://ctseg.com.tr/en/contact/',
  sq: 'https://ctseg.com.tr/en/contact/',
  fa: 'https://ctseg.com.tr/fa/contact/',
  zh: 'https://ctseg.com.tr/en/contact/',
  vi: 'https://ctseg.com.tr/vi/contact/',
};

const text = copy[locale];
---

<section class="commercial-evaluations" data-locale={locale} data-commercial-evaluations aria-labelledby="commercial-evaluations-title">
  <div class="shell">
    <header class="commercial-evaluations__heading" data-reveal="section">
      <p class="section-label">{text.label}</p>
      <div>
        <h2 id="commercial-evaluations-title">{text.title}</h2>
        <p class="section-lead">{text.lead}</p>
      </div>
    </header>

    <div class="evaluation-grid">
      {text.evaluations.map((evaluation, index) => (
        <article class:list={['evaluation-card', index === 0 && 'evaluation-card--lead']} data-commercial-evaluation data-reveal="item">
          <div class="evaluation-card__meta"><span>0{index + 1}</span><b>{text.status}</b></div>
          <p class="evaluation-card__market">{evaluation.market}</p>
          <h3>{evaluation.title}</h3>
          <p class="evaluation-card__text">{evaluation.text}</p>
          <ul>{evaluation.signals.map((signal) => <li>{signal}</li>)}</ul>
        </article>
      ))}
    </div>

    <footer class="commercial-evaluations__footer" data-reveal="section">
      <p data-commercial-disclaimer>{text.disclaimer}</p>
      <a class="commercial-evaluations__cta" href={contactLinks[locale]} target="_blank" rel="noopener noreferrer">{text.cta}<span aria-hidden="true">↗</span></a>
    </footer>
  </div>
</section>

<style>
  .commercial-evaluations {
    padding-block: clamp(4.5rem, 8vw, 8rem);
    background: #242b25;
    color: #f4eee5;
  }
  .commercial-evaluations .section-label { color: #dfad8e; }
  .commercial-evaluations__heading {
    display: grid;
    grid-template-columns: minmax(11rem, .45fr) minmax(0, 1.55fr);
    gap: clamp(1.25rem, 5vw, 5rem);
    align-items: start;
    margin-bottom: clamp(2rem, 5vw, 4rem);
  }
  .commercial-evaluations__heading .section-label { margin-top: .55rem; }
  .commercial-evaluations__heading h2 {
    max-width: 17ch;
    margin: 0;
    color: #f5f0e8;
    font-size: clamp(2.25rem, 4.25vw, 4.75rem);
    line-height: 1.05;
  }
  .commercial-evaluations__heading .section-lead {
    max-width: 67ch;
    margin: 1.35rem 0 0;
    color: #d9d0c3;
    font-size: clamp(1.02rem, 1.4vw, 1.2rem);
    line-height: 1.75;
  }
  .evaluation-grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    border-block: 1px solid rgba(235, 222, 207, .23);
  }
  .evaluation-card {
    display: flex;
    grid-column: span 3;
    flex-direction: column;
    min-height: 22rem;
    padding: clamp(1.25rem, 2.4vw, 2.2rem);
    border-inline-end: 1px solid rgba(235, 222, 207, .23);
  }
  .evaluation-card--lead {
    grid-column: span 4;
    background: #303c31;
  }
  .evaluation-card:nth-child(2) { grid-column: span 4; }
  .evaluation-card:nth-child(3) { grid-column: span 4; border-inline-end: 0; }
  .evaluation-card:nth-child(n + 4) {
    grid-column: span 6;
    min-height: 19rem;
    border-top: 1px solid rgba(235, 222, 207, .23);
  }
  .evaluation-card:nth-child(5) { border-inline-end: 0; }
  .evaluation-card__meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .evaluation-card__meta span {
    color: #dfad8e;
    font-size: .72rem;
    font-weight: 850;
    letter-spacing: .1em;
  }
  .evaluation-card__meta b {
    padding: .25rem .5rem;
    border: 1px solid rgba(235, 222, 207, .28);
    color: #d7cfc3;
    font-size: .6rem;
    font-weight: 800;
    letter-spacing: .08em;
    text-transform: uppercase;
  }
  .evaluation-card__market {
    margin: clamp(2.5rem, 4vw, 4rem) 0 .7rem;
    color: #c5bbae;
    font-size: .72rem;
    font-weight: 800;
    letter-spacing: .075em;
    text-transform: uppercase;
  }
  .evaluation-card h3 {
    max-width: 15ch;
    margin: 0;
    color: #f4eee5;
    font-size: clamp(1.45rem, 2vw, 2rem);
    line-height: 1.12;
  }
  .evaluation-card__text {
    max-width: 47ch;
    margin: 1rem 0 0;
    color: #d2c9bd;
    font-size: .95rem;
    line-height: 1.7;
  }
  .evaluation-card ul {
    display: flex;
    flex-wrap: wrap;
    gap: .45rem;
    margin: auto 0 0;
    padding: 1.5rem 0 0;
    list-style: none;
  }
  .evaluation-card li {
    padding: .38rem .55rem;
    border: 1px solid rgba(235, 222, 207, .23);
    color: #e3dbd0;
    font-size: .7rem;
    line-height: 1.25;
  }
  .commercial-evaluations__footer {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 2rem;
    align-items: end;
    padding-top: clamp(2rem, 4vw, 3rem);
  }
  .commercial-evaluations__footer p {
    max-width: 75ch;
    margin: 0;
    color: #c7bdb0;
    font-size: .88rem;
    line-height: 1.7;
  }
  .commercial-evaluations__cta {
    display: inline-flex;
    align-items: center;
    gap: .65rem;
    min-height: 44px;
    border-bottom: 1px solid #dfad8e;
    color: #f1b28e;
    font-weight: 800;
    text-decoration: none;
    white-space: nowrap;
  }
  .commercial-evaluations__cta:hover { color: #fff3e9; }
  @media (max-width: 950px) {
    .commercial-evaluations__heading { grid-template-columns: 1fr; gap: 1.5rem; }
    .commercial-evaluations__heading .section-label { margin-top: 0; }
    .evaluation-card, .evaluation-card--lead, .evaluation-card:nth-child(2), .evaluation-card:nth-child(3) { grid-column: span 6; }
    .evaluation-card:nth-child(2) { border-inline-end: 0; }
    .evaluation-card:nth-child(3) { border-top: 1px solid rgba(235, 222, 207, .23); }
  }
  @media (max-width: 620px) {
    .commercial-evaluations { padding-block: 4rem; }
    .evaluation-grid { grid-template-columns: 1fr; }
    .evaluation-card, .evaluation-card--lead, .evaluation-card:nth-child(2), .evaluation-card:nth-child(3), .evaluation-card:nth-child(n + 4) {
      grid-column: auto;
      min-height: 0;
      border-inline-end: 0;
      border-top: 1px solid rgba(235, 222, 207, .23);
    }
    .evaluation-card:first-child { border-top: 0; }
    .evaluation-card__market { margin-top: 2.25rem; }
    .commercial-evaluations__footer { grid-template-columns: 1fr; gap: 1.25rem; }
    .commercial-evaluations__cta { justify-self: start; }
  }
</style>
