---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import FloatingActions from './FloatingActions.astro';
import { content } from '../i18n/content';
import { localizedGlassGuides, glassGuideSlugs, type GlassGuideLocale, type GlassGuideSlug } from '../data/glass-guides-localized';
const { locale, slug }=Astro.props as {locale:GlassGuideLocale;slug:GlassGuideSlug};
const c=localizedGlassGuides[locale][slug];
const path=`/${locale}/blog/glass-guide/${slug}/`; const canonical='https://teyfikgokdemir.com'+path;
const alt={tr:`https://teyfikgokdemir.com/blog/cam-rehberi/${slug==='glass-types-guide'?'cam-turleri-secim-rehberi':slug==='glass-rfq-checklist'?'cam-rfq-checklist':slug==='glass-logistics-guide'?'cam-konteyner-paketleme-lojistik':'turkiyede-cam-tedarikci-bulma'}/`,en:`https://teyfikgokdemir.com/en/blog/glass-guide/${slug==='glass-types-guide'?'cam-turleri-secim-rehberi':slug==='glass-rfq-checklist'?'cam-rfq-checklist':slug==='glass-logistics-guide'?'cam-konteyner-paketleme-lojistik':'turkiyede-cam-tedarikci-bulma'}/`,fa:`https://teyfikgokdemir.com/fa/blog/glass-guide/${slug}/`,ru:`https://teyfikgokdemir.com/ru/blog/glass-guide/${slug}/`,mk:`https://teyfikgokdemir.com/mk/blog/glass-guide/${slug}/`,sr:`https://teyfikgokdemir.com/sr/blog/glass-guide/${slug}/`,sq:`https://teyfikgokdemir.com/sq/blog/glass-guide/${slug}/`,zh:`https://teyfikgokdemir.com/zh/blog/glass-guide/${slug}/`,vi:`https://teyfikgokdemir.com/vi/blog/glass-guide/${slug}/`,'x-default':`https://teyfikgokdemir.com/en/blog/glass-guide/${slug==='glass-types-guide'?'cam-turleri-secim-rehberi':slug==='glass-rfq-checklist'?'cam-rfq-checklist':slug==='glass-logistics-guide'?'cam-konteyner-paketleme-lojistik':'turkiyede-cam-tedarikci-bulma'}/`};
const copy=content[locale];
const labels={
fa:{home:'خانه',guides:'راهنماهای صنعت شیشه',cta:'اگر نیاز خرید یا صادرات فعال دارید، از راهنمای اطلاعاتی به مرحله RFQ تجاری بروید.'},
ru:{home:'Главная',guides:'Гиды по стекольной отрасли',cta:'Если у вас есть активный запрос на закупку или экспорт, перейдите от информационного материала к коммерческому RFQ.'},
mk:{home:'Почетна',guides:'Водичи за индустријата на стакло',cta:'Ако имате активно барање за набавка или извоз, преминете од информативниот водич кон комерцијален RFQ.'},
sr:{home:'Početna',guides:'Vodiči za industriju stakla',cta:'Ako imate aktivan zahtev za nabavku ili izvoz, pređite sa informativnog vodiča na komercijalni RFQ.'},
sq:{home:'Kryefaqja',guides:'Udhëzues për industrinë e xhamit',cta:'Nëse keni një kërkesë aktive për prokurim ose eksport, kaloni nga udhëzuesi informues te RFQ-ja komerciale.'},
zh:{home:'首页',guides:'玻璃行业指南',cta:'如有实际采购或出口需求，可从信息指南进入商业RFQ阶段。'},
vi:{home:'Trang chủ',guides:'Hướng dẫn ngành kính',cta:'Nếu bạn có nhu cầu mua hàng hoặc xuất khẩu thực tế, hãy chuyển từ hướng dẫn thông tin sang RFQ thương mại.'}
}[locale];
const schema=[{'@type':'BlogPosting','@id':canonical+'#article',headline:c.metaTitle,description:c.description,inLanguage:locale,mainEntityOfPage:canonical,author:{'@type':'Person',name:'Teyfik Gökdemir',url:'https://teyfikgokdemir.com/'}},{'@type':'BreadcrumbList',itemListElement:[{'@type':'ListItem',position:1,name:labels.home,item:`https://teyfikgokdemir.com/${locale}/`},{'@type':'ListItem',position:2,name:labels.guides,item:`https://teyfikgokdemir.com/${locale}/blog/glass-guide/`},{'@type':'ListItem',position:3,name:c.title,item:canonical}]}];
---
<BaseLayout locale={locale} copy={copy} title={c.metaTitle} description={c.description} pathname={path} alternates={alt} ogType="article" pageSchema={schema}>
<Header locale={locale} copy={copy} homePath={`/${locale}/`} languageUrls={alt}/>
<main id="main-content" class="glass-article"><article id="top" class="shell"><p class="label">{c.eyebrow}</p><h1>{c.title}</h1><p class="lead">{c.intro}</p><div class="body">{c.sections.map(([h,p])=><section><h2>{h}</h2><p>{p}</p></section>)}</div><aside class="commercial"><p>{labels.cta}</p><a href={c.ctaHref} rel="noopener">{c.ctaText} ↗</a></aside><nav class="related"><h2>{labels.guides}</h2>{glassGuideSlugs.filter(x=>x!==slug).map(x=><a href={`/${locale}/blog/glass-guide/${x}/`}>{localizedGlassGuides[locale][x].title}<span>↗</span></a>)}</nav></article></main>
<Footer copy={copy} locale={locale}/><FloatingActions locale={locale}/></BaseLayout>
<style>
.glass-article{background:var(--scene-paper);min-height:70vh;padding:clamp(4rem,8vw,7rem) 0}.shell{width:min(1040px,calc(100% - 3rem));margin:auto}.label{text-align:center;color:var(--accent);font-size:.78rem;font-weight:800;letter-spacing:.09em}.shell>h1{max-width:1000px;margin:.7rem auto 1.2rem;text-align:center;font-size:clamp(2.45rem,5.2vw,5rem);line-height:var(--leading-display);letter-spacing:var(--tracking-display);text-wrap:balance}.lead{max-width:800px;margin:0 auto clamp(3rem,6vw,5rem);text-align:center;color:var(--text-muted);font-size:clamp(1.05rem,1.6vw,1.25rem);line-height:1.7}.body{max-width:800px;margin:auto}.body section{padding:2rem 0;border-top:1px solid var(--border)}.body h2{margin:0 0 1rem;font-size:clamp(1.6rem,3vw,2.45rem);line-height:1.15}.body p{margin:0;color:var(--text-muted);font-size:1.05rem;line-height:1.8}.commercial{max-width:800px;margin:3rem auto;padding:1.5rem;border:1px solid var(--border);background:var(--surface)}.commercial p{margin:0 0 1rem;color:var(--text-muted);line-height:1.7}.commercial a{color:var(--accent);font-weight:800;text-decoration:none}.related{max-width:800px;margin:3rem auto 0}.related h2{font-size:1.4rem}.related a{display:flex;justify-content:space-between;gap:1rem;padding:1rem 0;border-top:1px solid var(--border);color:inherit;text-decoration:none}.related a:last-child{border-bottom:1px solid var(--border)}@media(max-width:640px){.shell{width:min(100% - 2rem,1040px)}.shell>h1{font-size:clamp(2.05rem,9.5vw,3.05rem)}}
</style>
