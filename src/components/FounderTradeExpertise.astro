    'https://ctseg.com.tr/en/sourcing/wholesale-textile-sourcing/',
  ],
  sq: [
    'https://ctseg.com.tr/en/sourcing/iranian-carpets/',
    'https://ctseg.com.tr/en/sourcing/hand-knotted-silk-carpets/',
    'https://ctseg.com.tr/en/sourcing/wholesale-textile-sourcing/',
  ],
  fa: [
    'https://ctseg.com.tr/fa/sourcing/فرش-ایرانی/',
    'https://ctseg.com.tr/fa/sourcing/فرش-ابریشم-دستباف/',
    'https://ctseg.com.tr/fa/sourcing/تامین-عمده-منسوجات/',
  ],
};

const text = copy[locale];
const guideLinks = guides[locale === 'tr' ? 'tr' : 'default'];
---

<section class="founder-trade" data-locale={locale} aria-labelledby="founder-trade-title">
  <div class="shell">
    <header class="founder-trade__heading" data-reveal="section">
      <p class="section-label">{text.label}</p>
      <div>
        <h2 id="founder-trade-title">{text.title}</h2>
        <p class="section-lead">{text.lead}</p>
      </div>
    </header>

    <div class="trade-focus-grid">
      <article class="trade-focus-card trade-focus-card--oil" data-reveal="item">
        <div class="trade-focus-card__media">
          <img src="/images/ctseg-vegetable-oils-food-editorial.webp" width="1536" height="1024" loading="lazy" decoding="async" alt={text.oil.alt} />
        </div>
        <div class="trade-focus-card__body">
          <p class="trade-focus-card__eyebrow">01 · {text.oil.eyebrow}</p>
          <h3>{text.oil.title}</h3>
          <p>{text.oil.text}</p>
          <ul>{text.oil.checks.map((check) => <li>{check}</li>)}</ul>
          <a class="trade-focus-card__link" href={guideLinks[0]} target="_blank" rel="noopener noreferrer" data-trade-focus-link="oil">{text.oil.cta}<span aria-hidden="true">↗</span></a>
        </div>
      </article>

      <article class="trade-focus-card trade-focus-card--nuts" data-reveal="item">
        <div class="trade-focus-card__media">
          <img src="/images/ctseg-iranian-pistachios-premium.webp" width="1536" height="1024" loading="lazy" decoding="async" alt={text.nuts.alt} />
        </div>
        <div class="trade-focus-card__body">
          <p class="trade-focus-card__eyebrow">02 · {text.nuts.eyebrow}</p>
          <h3>{text.nuts.title}</h3>
          <p>{text.nuts.text}</p>
          <ul>{text.nuts.checks.map((check) => <li>{check}</li>)}</ul>
          <a class="trade-focus-card__link" href={guideLinks[1]} target="_blank" rel="noopener noreferrer" data-trade-focus-link="nuts">{text.nuts.cta}<span aria-hidden="true">↗</span></a>
        </div>
      </article>
    </div>

    <section class="specialist-areas" aria-labelledby="specialist-areas-title" data-reveal="section">
      <div class="specialist-areas__intro">
        <p class="section-label">{text.specialistLabel}</p>
        <h3 id="specialist-areas-title">{text.specialistTitle}</h3>
        <p>{text.specialistLead}</p>
      </div>
      <div class="specialist-areas__links">
        {text.specialists.map((specialist, index) => (
          <a href={specialistLinks[locale][index]} target="_blank" rel="noopener noreferrer" data-specialist-link={['carpet', 'silk', 'textile'][index]}>
            <span>0{index + 1}</span>
            <b>{specialist.title}</b>
            <em>{specialist.cta} <i aria-hidden="true">↗</i></em>
          </a>
        ))}
      </div>
    </section>

    <p class="founder-trade__note">{text.note}</p>
  </div>
</section>

<style>
  .founder-trade {
    padding-block: clamp(4.5rem, 8vw, 8rem);
    background: #e7e0d4;
    color: #1d1b18;
  }
  .founder-trade__heading {
    display: grid;
    grid-template-columns: minmax(11rem, .45fr) minmax(0, 1.55fr);
    gap: clamp(1.25rem, 5vw, 5rem);
    align-items: start;
    margin-bottom: clamp(2rem, 5vw, 4rem);
  }
  .founder-trade__heading .section-label { margin-top: .55rem; }
  .founder-trade__heading h2 {
    max-width: 20ch;
    margin: 0;
    font-size: clamp(2.25rem, 4.25vw, 4.75rem);
    line-height: 1.05;
  }
  .founder-trade__heading .section-lead {
    max-width: 65ch;
    margin: 1.35rem 0 0;
    color: #544d45;
    font-size: clamp(1.03rem, 1.4vw, 1.22rem);
    line-height: 1.75;
  }
  .trade-focus-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    overflow: hidden;
    border: 1px solid #b8aea1;
    background: #b8aea1;
  }
  .trade-focus-card {
    display: grid;
    grid-template-rows: minmax(13rem, 23vw) 1fr;
    min-width: 0;
  }
  .trade-focus-card--oil { background: #2e382d; color: #f4efe7; }
  .trade-focus-card--nuts { background: #f4efe7; color: #24201c; }
  .trade-focus-card__media { overflow: hidden; }
  .trade-focus-card__media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(.76) contrast(1.04);
    transition: transform .8s cubic-bezier(.2,.75,.25,1), filter .45s ease;
  }
  .trade-focus-card:hover .trade-focus-card__media img { transform: scale(1.035); filter: saturate(.95) contrast(1.04); }
  .trade-focus-card__body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    min-height: 25rem;
    padding: clamp(1.5rem, 3.5vw, 3rem);
  }
  .trade-focus-card__eyebrow {
    margin: 0;
    color: #7e3d27;
    font-size: .72rem;
    font-weight: 800;
    letter-spacing: .095em;
    line-height: 1.4;
    text-transform: uppercase;
  }
  .trade-focus-card--oil .trade-focus-card__eyebrow { color: #e3ab88; }
  .trade-focus-card h3 {
    max-width: 13ch;
    margin: 2.75rem 0 1rem;
    font-size: clamp(1.8rem, 2.65vw, 2.85rem);
    line-height: 1.08;
  }
  .trade-focus-card__body > p:not(.trade-focus-card__eyebrow) {
    max-width: 50ch;
    margin: 0;
    color: #625a52;
    line-height: 1.7;
  }
  .trade-focus-card--oil .trade-focus-card__body > p:not(.trade-focus-card__eyebrow) { color: #ddd5c8; }
  .trade-focus-card ul {
    display: grid;
    gap: .65rem;
    margin: 1.75rem 0 0;
    padding: 0;
    list-style: none;
  }
  .trade-focus-card li {
    position: relative;
    padding-inline-start: 1.15rem;
    color: #4e473f;
    font-size: .9rem;
    line-height: 1.45;
  }
  .trade-focus-card--oil li { color: #d7cec2; }
  .trade-focus-card li::before {
    position: absolute;
    inset-inline-start: 0;
    top: .56em;
    width: .42rem;
    height: .42rem;
    border-radius: 50%;
    background: #a65332;
    content: '';
  }
  .trade-focus-card--oil li::before { background: #e3ab88; }
  .trade-focus-card__link {
    display: inline-flex;
    align-items: center;
    gap: .6rem;
    margin-top: auto;
    padding-top: 2rem;
    color: #994a2e;
    font-weight: 800;
    text-decoration: none;
  }
  .trade-focus-card__link span { font-size: 1.15em; }
  .trade-focus-card--oil .trade-focus-card__link { color: #efb18f; }
  .trade-focus-card__link:hover { text-decoration: underline; text-underline-offset: .3em; }
  .specialist-areas {
    display: grid;
    grid-template-columns: minmax(0, .78fr) minmax(0, 1.22fr);
    gap: clamp(2rem, 7vw, 7rem);
    margin-top: clamp(3rem, 7vw, 7rem);
    padding-top: clamp(2rem, 4vw, 3rem);
    border-top: 1px solid #b8aea1;
  }
  .specialist-areas__intro h3 {
    max-width: 18ch;
    margin: .7rem 0 1rem;
    font-size: clamp(1.65rem, 2.7vw, 2.6rem);
    line-height: 1.12;
  }
  .specialist-areas__intro p:not(.section-label) {
    max-width: 48ch;
    margin: 0;
    color: #625c54;
    line-height: 1.7;
  }
  .specialist-areas__links {
    display: grid;
    border-top: 1px solid #b8aea1;
  }
  .specialist-areas__links a {
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr) auto;
    align-items: center;
    gap: 1rem;
    min-height: 4.9rem;
    border-bottom: 1px solid #b8aea1;
    color: inherit;
    text-decoration: none;
  }
  .specialist-areas__links a:hover { color: #8e452d; }
  .specialist-areas__links span {
    color: #8a432c;
    font-size: .7rem;
    font-weight: 800;
  }
  .specialist-areas__links b { font-size: 1.08rem; }
  .specialist-areas__links em {
    color: #625c54;
    font-size: .84rem;
    font-style: normal;
    white-space: nowrap;
  }
  .specialist-areas__links i { color: #8a432c; font-size: 1.15em; font-style: normal; }
  .founder-trade__note {
    max-width: 68ch;
    margin: clamp(2.5rem, 5vw, 5rem) 0 0;
    padding-inline-start: 1rem;
    border-inline-start: 2px solid #a65332;
    color: #625c54;
    font-size: .94rem;
    line-height: 1.7;
  }
  @media (max-width: 860px) {
    .founder-trade__heading, .specialist-areas { grid-template-columns: 1fr; gap: 1.75rem; }
    .founder-trade__heading .section-label { margin-top: 0; }
    .trade-focus-card__body { min-height: 0; }
  }
  @media (max-width: 650px) {
    .founder-trade { padding-block: 4rem; }
    .trade-focus-grid { grid-template-columns: 1fr; }
    .trade-focus-card { grid-template-rows: minmax(13rem, 60vw) 1fr; }
    .trade-focus-card__body { padding: 1.45rem 1.25rem 1.75rem; }
    .trade-focus-card h3 { margin-top: 2rem; }
    .trade-focus-card__link { margin-top: 1rem; padding-top: 1.35rem; }
    .specialist-areas__links a { grid-template-columns: 2rem minmax(0, 1fr); gap: .75rem; padding: .7rem 0; }
    .specialist-areas__links em { grid-column: 2; font-size: .78rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .trade-focus-card__media img { transition: none; }
    .trade-focus-card:hover .trade-focus-card__media img { transform: none; }
  }
</style>
