---
type Lang='tr'|'en'|'mk'|'sr'|'sq'|'fa';
type TradeCopy={label:string;title:string;lead:string;sectors:{title:string;text:string;cta:string}[];caption:string;note:string};
const {locale}=Astro.props as {locale:Lang};
const copy:Record<Lang,TradeCopy>={
  tr:{label:'Kurucu uzmanlığı · CTSEG operasyonu',title:'İran halısı ve tekstilde uluslararası ticari koordinasyon',lead:'Teyfik Gökdemir; kurucu, uluslararası ticari koordinatör ve pazar sistemleri kurucusu olarak ürün ile pazar arasındaki ticari yapıyı kurar. RFQ, numune, teklif, üretici doğrulama, kalite, paketleme, belge ve lojistik uygulaması CTSEG üzerinden yürütülür.',caption:'İran halısı ve tekstil uzmanlığını temsil eden editoryal görsel.',note:'Bu kişisel site bir halı mağazası veya ürün kataloğu değildir. Kurucu uzmanlığını açıklar; teklif, numune ve operasyon CTSEG tarafından yapılandırılır.',sectors:[
    {title:'İran halısı',text:'El dokuması, ipek, yün, yün-ipek ve makine halıları; yolluk, küçük halı, özel ölçü ve proje bazlı tedarik.',cta:'İran halısı alanını incele'},
    {title:'El dokuması ipek halı',text:'İpek halı; menşe, lif yapısı, düğüm inceliği, işçilik, ölçü ve taşıma koşulları ayrı incelenen görünür bir uzmanlık alanıdır.',cta:'İpek halı alanını incele'},
    {title:'Toptan tekstil',text:'Kumaş, havlu, bornoz, ev tekstili ve hazır giyim; private label, numune, RFQ, üretici doğrulama, kalite, paketleme ve lojistik.',cta:'Toptan tekstil alanını incele'}]},
  en:{label:'Founder expertise · CTSEG execution',title:'International commercial coordination for Iranian carpets and textiles',lead:'As founder, international commercial coordinator and market-systems builder, Teyfik Gökdemir structures the commercial path between product and market. CTSEG executes RFQs, samples, quotations, producer verification, quality, packaging, documents and logistics.',caption:'Editorial representation of Iranian carpet and textile expertise.',note:'This personal site is not a carpet shop or product catalogue. It explains founder expertise; CTSEG structures quotations, samples and execution.',sectors:[
    {title:'Iranian carpets',text:'Hand-knotted, silk, wool, wool-silk and machine-made carpets, runners, small rugs, custom dimensions and project sourcing.',cta:'Explore Iranian carpets'},
    {title:'Hand-knotted silk carpets',text:'A distinct field where origin, fibre, knot fineness, workmanship, dimensions and transport are assessed separately.',cta:'Explore silk carpets'},
    {title:'Wholesale textiles',text:'Fabric, towels, bathrobes, home textiles and apparel with private label, samples, RFQ, producer verification, quality, packaging and logistics.',cta:'Explore wholesale textiles'}]},
  mk:{label:'Експертиза на основачот · извршување преку CTSEG',title:'Меѓународна трговска координација за ирански теписи и текстил',lead:'Како основач, меѓународен трговски координатор и градител на пазарни системи, Тејфик Ѓокдемир ја поставува трговската врска меѓу производот и пазарот. CTSEG ги спроведува RFQ, примероците, понудите, проверката на производителот, квалитетот, пакувањето, документите и логистиката.',caption:'Уреднички приказ на експертизата за ирански теписи и текстил.',note:'Оваа лична страница не е продавница за теписи ниту каталог. Таа ја објаснува експертизата на основачот; CTSEG ги води понудите, примероците и извршувањето.',sectors:[
    {title:'Ирански теписи',text:'Рачно ткаени, свилени, волнени, волнено-свилени и машински теписи, патеки, мали теписи, посебни димензии и проектно снабдување.',cta:'Истражете ги иранските теписи'},
    {title:'Рачно ткаени свилени теписи',text:'Посебна област во која одделно се проверуваат потеклото, влакното, густината на јазлите, изработката, димензиите и транспортот.',cta:'Истражете ги свилените теписи'},
    {title:'Текстил на големо',text:'Ткаенини, крпи, бањарки, домашен текстил и облека; private label, примероци, RFQ, проверка на производител, квалитет, пакување и логистика.',cta:'Истражете го текстилот на големо'}]},
  sr:{label:'Ekspertiza osnivača · realizacija kroz CTSEG',title:'Međunarodna komercijalna koordinacija za iranske tepihe i tekstil',lead:'Kao osnivač, međunarodni komercijalni koordinator i graditelj tržišnih sistema, Teyfik Gökdemir postavlja poslovnu vezu između proizvoda i tržišta. CTSEG sprovodi RFQ, uzorke, ponude, proveru proizvođača, kvalitet, pakovanje, dokumentaciju i logistiku.',caption:'Urednički prikaz ekspertize za iranske tepihe i tekstil.',note:'Ovaj lični sajt nije prodavnica tepiha niti katalog proizvoda. Objašnjava ekspertizu osnivača; CTSEG vodi ponude, uzorke i realizaciju.',sectors:[
    {title:'Iranski tepisi',text:'Ručno čvorovani, svileni, vuneni, vuneno-svileni i mašinski tepisi, staze, mali tepisi, posebne dimenzije i projektna nabavka.',cta:'Istražite iranske tepihe'},
    {title:'Ručno čvorovani svileni tepisi',text:'Posebna oblast u kojoj se odvojeno proveravaju poreklo, vlakno, finoća čvora, izrada, dimenzije i transport.',cta:'Istražite svilene tepihe'},
    {title:'Tekstil na veliko',text:'Tkanine, peškiri, bade-mantili, kućni tekstil i odeća; private label, uzorci, RFQ, provera proizvođača, kvalitet, pakovanje i logistika.',cta:'Istražite tekstil na veliko'}]},
  sq:{label:'Ekspertiza e themeluesit · zbatimi nga CTSEG',title:'Koordinim tregtar ndërkombëtar për qilimat iranianë dhe tekstilet',lead:'Si themelues, koordinator tregtar ndërkombëtar dhe ndërtues sistemesh tregu, Teyfik Gökdemir strukturon lidhjen tregtare mes produktit dhe tregut. CTSEG zbaton RFQ-të, mostrat, ofertat, verifikimin e prodhuesit, cilësinë, paketimin, dokumentet dhe logjistikën.',caption:'Paraqitje editoriale e ekspertizës për qilimat iranianë dhe tekstilet.',note:'Kjo faqe personale nuk është dyqan qilimash apo katalog produktesh. Ajo shpjegon ekspertizën e themeluesit; CTSEG strukturon ofertat, mostrat dhe zbatimin.',sectors:[
    {title:'Qilima iranianë',text:'Qilima të punuar me dorë, mëndafshi, leshi, lesh-mëndafsh dhe të prodhuar me makinë, rrugica, formate të vogla, masa të posaçme dhe projekte.',cta:'Shikoni qilimat iranianë'},
    {title:'Qilima mëndafshi të punuar me dorë',text:'Fushë e veçantë ku origjina, fibra, imtësia e nyjës, punimi, përmasat dhe transporti verifikohen më vete.',cta:'Shikoni qilimat e mëndafshit'},
    {title:'Tekstile me shumicë',text:'Pëlhura, peshqirë, rrobëbanjo, tekstile shtëpie dhe veshje; private label, mostra, RFQ, verifikim prodhuesi, cilësi, paketim dhe logjistikë.',cta:'Shikoni tekstilet me shumicë'}]},
  fa:{label:'تخصص بنیان‌گذار · اجرا از طریق CTSEG',title:'هماهنگی تجاری بین‌المللی برای فرش ایرانی و منسوجات',lead:'تیفیک گوکدمیر در جایگاه بنیان‌گذار، هماهنگ‌کننده تجاری بین‌المللی و طراح ساختار ورود به بازار، مسیر تجاری میان تولیدکنندگان ایرانی و خریداران مناسب را شکل می‌دهد. مدیریت RFQ، نمونه، پیشنهاد قیمت، اعتبارسنجی تولیدکننده، کیفیت، بسته‌بندی، اسناد و لجستیک از طریق ساختار عملیاتی CTSEG انجام می‌شود.',caption:'تصویر تحریریه‌ای برای معرفی حوزه تخصصی فرش ایرانی و منسوجات.',note:'این وب‌سایت شخصی فروشگاه فرش یا کاتالوگ محصول نیست. نقش تیفیک، ایجاد و هماهنگی ارتباط تجاری است و CTSEG ساختار عملیاتی بررسی آمادگی صادرات، ارتباط با خریدار و فرایند فروش بین‌المللی را فراهم می‌کند؛ CTSEG کارخانه یا خریدار تضمینی نیست.',sectors:[
    {title:'فرش ایرانی',text:'فرش دستباف، ابریشم، پشم، پشم‌وابریشم و ماشینی، کناره، قالیچه، ابعاد سفارشی و تأمین پروژه‌ای؛ همراه با ارزیابی آمادگی کارگاه‌ها و صادرکنندگان برای بازار بین‌المللی.',cta:'مشاهده فرش ایرانی در CTSEG'},
    {title:'فرش ابریشم دستباف',text:'حوزه‌ای مستقل که در آن اصالت، نوع الیاف، ظرافت گره، کیفیت بافت، ابعاد، بسته‌بندی و آمادگی عرضه بین‌المللی جداگانه بررسی می‌شود.',cta:'مشاهده فرش ابریشم دستباف در CTSEG'},
    {title:'منسوجات عمده',text:'پارچه، حوله، حوله تن‌پوش، منسوجات خانگی و پوشاک؛ برند اختصاصی، نمونه، RFQ، اعتبارسنجی تولیدکننده، کیفیت، بسته‌بندی، اسناد و لجستیک.',cta:'مشاهده منسوجات عمده در CTSEG'}]}
};
const sectorLinks:Record<Lang,string[]>={
  tr:['https://ctseg.com.tr/tr/sourcing/iran-halisi/','https://ctseg.com.tr/tr/sourcing/el-dokumasi-ipek-hali/','https://ctseg.com.tr/tr/sourcing/toptan-tekstil-tedariki/'],
  en:['https://ctseg.com.tr/en/sourcing/iranian-carpets/','https://ctseg.com.tr/en/sourcing/hand-knotted-silk-carpets/','https://ctseg.com.tr/en/sourcing/wholesale-textile-sourcing/'],
  mk:['https://ctseg.com.tr/en/sourcing/iranian-carpets/','https://ctseg.com.tr/en/sourcing/hand-knotted-silk-carpets/','https://ctseg.com.tr/en/sourcing/wholesale-textile-sourcing/'],
  sr:['https://ctseg.com.tr/en/sourcing/iranian-carpets/','https://ctseg.com.tr/en/sourcing/hand-knotted-silk-carpets/','https://ctseg.com.tr/en/sourcing/wholesale-textile-sourcing/'],
  sq:['https://ctseg.com.tr/en/sourcing/iranian-carpets/','https://ctseg.com.tr/en/sourcing/hand-knotted-silk-carpets/','https://ctseg.com.tr/en/sourcing/wholesale-textile-sourcing/'],
  fa:['https://ctseg.com.tr/fa/sourcing/فرش-ایرانی/','https://ctseg.com.tr/fa/sourcing/فرش-ابریشم-دستباف/','https://ctseg.com.tr/fa/sourcing/تامین-عمده-منسوجات/']
};
const faStrategy=locale==='fa'?{
  title:'برای تولیدکنندگان و صادرکنندگان ایرانی',
  intro:'تیفیک گوکدمیر در جایگاه بنیان‌گذار و هماهنگ‌کننده تجاری، به تولیدکنندگان، کارگاه‌ها و صادرکنندگان ایرانی کمک می‌کند تا محصولات خود را برای ورود سنجیده به بازارهای بین‌المللی آماده کنند و با خریداران مناسب ارتباط بگیرند.',
  ctseg:'CTSEG ساختار عملیاتی این همکاری است و آماده‌سازی محصول و پیشنهاد تجاری، مدیریت RFQ، ارتباط اولیه با خریدار، هماهنگی نمونه، بررسی کیفیت، اسناد، بسته‌بندی، برچسب‌گذاری و لجستیک را در یک فرایند قابل پیگیری مدیریت می‌کند.',
  markets:'محصولات مناسب برای بازار ترکیه، اروپا، آمریکا و سایر بازارهای هدف ارزیابی می‌شوند.',
  audiences:['کارگاه‌های فرش دستباف','تولیدکنندگان فرش ابریشم دستباف','تولیدکنندگان فرش ماشینی','صادرکنندگان فرش','تولیدکنندگان پارچه','تولیدکنندگان حوله و حوله تن‌پوش','تولیدکنندگان منسوجات خانگی','تولیدکنندگان پوشاک','برندهای دارای تولید با نام تجاری اختصاصی'],
  activities:['ارزیابی تجاری محصول','تعیین بازار هدف','آماده‌سازی پیشنهاد تجاری','ارتباط و مذاکره اولیه با خریداران','مدیریت RFQ','هماهنگی نمونه','بررسی قیمت، MOQ و ظرفیت تولید','هماهنگی بسته‌بندی و برچسب‌گذاری','بررسی آمادگی اسناد صادراتی','هماهنگی ورود به بازار و توسعه کانال فروش'],
  reality:'هر محصول پیش از معرفی به بازار باید از نظر کیفیت، ظرفیت تولید، قیمت‌گذاری، حداقل سفارش، بسته‌بندی، اسناد و امکان اجرای تجاری بررسی شود.'
}:null;
const text=copy[locale];
---
<section class="founder-trade" data-locale={locale} aria-labelledby="founder-trade-title"><div class="shell">
  <p class="section-label">{text.label}</p>
  <div class="founder-trade__heading"><h2 id="founder-trade-title">{text.title}</h2><p>{text.lead}</p></div>
  <figure class="founder-trade__editorial"><img src="/images/ctseg-iranian-carpets-editorial.webp" width="1536" height="1024" loading="lazy" decoding="async" alt={text.caption} /><figcaption>{text.caption}</figcaption></figure>
  <div class="founder-trade__grid">{text.sectors.map((sector,index)=><article class={index===1?'silk':undefined}><span dir="ltr">{String(index+1).padStart(2,'0')}</span><h3>{sector.title}</h3><p>{sector.text}</p><a class="sector-link" href={sectorLinks[locale][index]} data-sector-link={['carpet','silk','textile'][index]} data-fa-sector-link={locale==='fa'?['carpet','silk','textile'][index]:undefined}>{sector.cta} <bdi dir="ltr" aria-hidden="true">↗</bdi></a></article>)}</div>
  {faStrategy&&<div class="fa-producer-strategy" data-fa-producer-strategy><div class="fa-producer-strategy__intro"><div><p class="section-label">CTSEG · هماهنگی تجاری بین‌المللی</p><h3>{faStrategy.title}</h3></div><div><p>{faStrategy.intro}</p><p>{faStrategy.ctseg}</p><p><strong>{faStrategy.markets}</strong></p></div></div><div class="fa-producer-strategy__lists"><section><h4>مخاطبان همکاری</h4><ul>{faStrategy.audiences.map(item=><li>{item}</li>)}</ul></section><section><h4>دامنه هماهنگی تجاری</h4><ul>{faStrategy.activities.map(item=><li>{item}</li>)}</ul></section></div><p class="fa-producer-strategy__reality">{faStrategy.reality}</p><div class="fa-producer-strategy__actions"><a class="button primary" href="https://ctseg.com.tr/fa/tamin-beynolmelali-iran/#contact" data-fa-primary-cta>معرفی محصول برای ارزیابی تجاری <bdi dir="ltr" aria-hidden="true">↗</bdi></a><a class="button" href="mailto:info@ctseg.com.tr?subject=International%20Market%20Discussion" data-fa-secondary-cta>آغاز گفت‌وگو درباره بازارهای بین‌المللی <bdi dir="ltr" aria-hidden="true">↗</bdi></a></div></div>}
  <div class="founder-trade__footer"><p>{text.note}</p></div>
</div></section>
<style>
.founder-trade{padding-block:clamp(4.5rem,8vw,8rem);color:#1d1b18;background:#e7e0d4}.founder-trade__heading{display:grid;grid-template-columns:1.1fr .9fr;gap:clamp(2rem,6vw,6rem);align-items:end}.founder-trade__heading h2{font-size:clamp(2.7rem,5vw,5.5rem);line-height:.98}.founder-trade__heading p,.founder-trade article p,.founder-trade__footer p,.fa-producer-strategy p{color:#625c54;line-height:1.7}.founder-trade__editorial{position:relative;margin:clamp(2.5rem,5vw,4.5rem) 0 0;overflow:hidden;border-block:1px solid #b8aea1}.founder-trade__editorial img{width:100%;height:clamp(220px,31vw,430px);object-fit:cover;filter:saturate(.68) contrast(1.04)}.founder-trade__editorial figcaption{position:absolute;inset-inline-end:0;inset-block-end:0;max-width:min(430px,80%);padding:.75rem 1rem;background:rgba(29,27,24,.86);color:#eee8de;font-size:.76rem}.founder-trade__grid{display:grid;grid-template-columns:repeat(3,1fr);border-top:1px solid #b8aea1}.founder-trade article{display:flex;flex-direction:column;min-height:310px;padding:1.6rem;border-inline-end:1px solid #b8aea1;border-bottom:1px solid #b8aea1}.founder-trade article.silk{background:#293029;color:#f3eee6}.founder-trade article.silk p{color:#d1c9be}.founder-trade article>span{color:#a65332;font-size:.72rem;font-weight:800}.founder-trade h3{margin-top:3rem;font-size:1.55rem}.sector-link{display:inline-flex;align-items:center;gap:.45rem;margin-top:auto;padding-top:1rem;color:#8e452d;font-weight:800}.silk .sector-link{color:#efb18f}.fa-producer-strategy{margin-top:clamp(3rem,6vw,6rem);padding:clamp(1.5rem,4vw,3rem);border:1px solid #a79d90;background:#f0ebe2}.fa-producer-strategy__intro{display:grid;grid-template-columns:.8fr 1.2fr;gap:clamp(2rem,5vw,5rem)}.fa-producer-strategy__intro h3{margin:0;font-size:clamp(2.3rem,4vw,4.5rem);line-height:1.15}.fa-producer-strategy__lists{display:grid;grid-template-columns:1fr 1fr;gap:1px;margin-top:2.5rem;background:#b8aea1}.fa-producer-strategy__lists section{padding:clamp(1.3rem,3vw,2rem);background:#faf7f1}.fa-producer-strategy__lists h4{margin:0 0 1rem;font-size:1.2rem}.fa-producer-strategy__lists ul{display:grid;gap:.55rem;margin:0;padding-inline-start:1.2rem}.fa-producer-strategy__reality{margin:2rem 0 0;padding:1.2rem;border-inline-start:3px solid #a65332;background:#e4ddd2;font-weight:700}.fa-producer-strategy__actions{display:flex;flex-wrap:wrap;gap:.8rem;margin-top:1.5rem}.fa-producer-strategy__actions .button{display:inline-flex;align-items:center;gap:.5rem}.founder-trade__footer{margin-top:2rem}.founder-trade__footer p{max-width:760px}@media(max-width:850px){.founder-trade__heading,.fa-producer-strategy__intro,.fa-producer-strategy__lists{grid-template-columns:1fr}.founder-trade__grid{grid-template-columns:1fr}.founder-trade article{min-height:0}.fa-producer-strategy__actions .button{width:100%;justify-content:center}.fa-producer-strategy__actions{display:grid}.founder-trade__editorial figcaption{max-width:90%}}
@media(max-width:620px){.founder-trade[data-locale="fa"],.founder-trade[data-locale="fa"] *{box-sizing:border-box}.founder-trade[data-locale="fa"]{padding-block:3.75rem}.founder-trade[data-locale="fa"]>.shell{width:calc(100% - 40px);margin-inline:auto}.founder-trade[data-locale="fa"] h2,.founder-trade[data-locale="fa"] h3,.founder-trade[data-locale="fa"] h4{max-width:100%;overflow-wrap:anywhere;text-wrap:balance}.founder-trade[data-locale="fa"] .founder-trade__heading{gap:1.25rem}.founder-trade[data-locale="fa"] .founder-trade__heading h2{font-size:clamp(2rem,10vw,2.7rem);line-height:1.28}.founder-trade[data-locale="fa"] .founder-trade__heading p,.founder-trade[data-locale="fa"] article p,.founder-trade[data-locale="fa"] .founder-trade__footer p,.founder-trade[data-locale="fa"] .fa-producer-strategy p{max-width:40ch}.founder-trade[data-locale="fa"] .founder-trade__editorial{margin-top:2rem}.founder-trade[data-locale="fa"] .founder-trade__editorial img{max-width:100%;height:clamp(210px,72vw,290px)}.founder-trade[data-locale="fa"] .founder-trade__editorial figcaption{max-width:calc(100% - 16px);padding:.65rem .8rem;line-height:1.55}.founder-trade[data-locale="fa"] article{width:100%;padding:1.35rem}.founder-trade[data-locale="fa"] h3{margin-top:2rem;line-height:1.35}.founder-trade[data-locale="fa"] .sector-link{width:100%;justify-content:space-between;overflow-wrap:anywhere}.founder-trade[data-locale="fa"] .fa-producer-strategy{margin-top:3rem;padding:1.25rem}.founder-trade[data-locale="fa"] .fa-producer-strategy__intro{gap:1.25rem}.founder-trade[data-locale="fa"] .fa-producer-strategy__intro h3{font-size:clamp(1.85rem,9vw,2.45rem);line-height:1.35}.founder-trade[data-locale="fa"] .fa-producer-strategy__lists{margin-top:1.75rem}.founder-trade[data-locale="fa"] .fa-producer-strategy__lists section{padding:1.15rem}.founder-trade[data-locale="fa"] .fa-producer-strategy__reality{margin-top:1.5rem;padding:1rem}.founder-trade[data-locale="fa"] .fa-producer-strategy__actions .button{max-width:100%;padding-inline:1rem;text-align:center;white-space:normal;overflow-wrap:anywhere}}
</style>
