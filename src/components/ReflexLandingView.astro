  sr: { badge: 'Reflex proizvodi', title: '7 specijalizovanih kategorija proizvoda', lead: 'Profesionalna rešenja za rukavice za jednokratnu upotrebu razvijena za posebne higijenske standarde, materijale i preciznost.', whyBadge: 'Osnovne prednosti', appsBadge: 'Industrije i upotreba' },
  sq: { badge: 'Linja e Produkteve Reflex', title: '7 Familje Specializuara Produktesh', lead: 'Zgjidhje profesionale dorezash me një përdorim të projektuara për standarde të veçanta higjienike, materiale dhe ndjeshmëri.', whyBadge: 'Avantazhet kryesore', appsBadge: 'Industritë dhe përdorimi' },
  fa: { badge: 'سبد محصولات رفلکس', title: '۷ خانواده محصول تخصصی', lead: 'دستکش‌های یک‌بارمصرف حرفه‌ای طراحی‌شده برای استانداردهای بهداشتی، متریال و ضخامت‌های مختلف.', whyBadge: 'مزایای اصلی', appsBadge: 'صنایع و کاربردها' },
  zh: { badge: 'Reflex 产品系列', title: '7 大专业产品家族', lead: '针对严苛卫生标准、特定材料厚度与操作手感量身定制的专业一次性防护手套解决方案。', whyBadge: '核心竞争优势', appsBadge: '应用行业与场景' },
  vi: { badge: 'Dòng sản phẩm Reflex', title: '7 Dòng sản phẩm Chuyên biệt', lead: 'Giải pháp găng tay dùng một lần chuyên dụng được thiết kế cho các tiêu chuẩn vệ sinh, vật liệu và độ chính xác thao tác cao.', whyBadge: 'Ưu thế Cốt lõi', appsBadge: 'Ngành nghề & Lĩnh vực Ứng dụng' },
};
const sectionTitles = sectionTitlesMap[lang] || sectionTitlesMap.en;

const heroMainProduct = reflexProducts.find(p => p.slug === 'florex') || reflexProducts[0];
---

<div class="reflex-landing">
  <!-- HERO SECTION -->
  <section class="reflex-hero">
    <div class="shell">
      <div class="hero-editorial-grid">
        <div class="hero-left">
          <span class="black-pill hero-eyebrow">{landingText.heroTag}</span>
          <h1 class="hero-editorial-title">{landingText.heroTitle}</h1>
          <p class="hero-editorial-lead">{landingText.heroLead}</p>
          <div class="hero-actions">
            <a href="#product-families" class="button dark-btn">{landingText.primaryCta}</a>
            <a href="#quote-section" class="button amber-btn">{landingText.secondaryCta}</a>
          </div>
        </div>

        <div class="hero-right">
          <div class="hero-image-card">
            <img
              src={heroMainProduct.images.main}
              alt="Reflex Plastik Portfolio Showcase"
              width="600"
              height="450"
              decoding="async"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- PRODUCT FAMILIES GRID -->
  <section id="product-families" class="section">
    <div class="shell">
      <div class="editorial-section-heading">
        <span class="section-badge">{sectionTitles.badge}</span>
        <h2>{sectionTitles.title}</h2>
        <p class="section-lead">
          {sectionTitles.lead}
        </p>
      </div>

      <div class="reflex-grid-custom">
        <div class="reflex-row-top">
          {reflexProducts.slice(0, 4).map((product) => (
            <ReflexProductCard product={product} locale={locale} />
          ))}
        </div>
        <div class="reflex-row-bottom">
          {reflexProducts.slice(4).map((product) => (
            <ReflexProductCard product={product} locale={locale} />
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- WHY REFLEX SECTION -->
  <section class="section why-reflex-section">
    <div class="shell">
      <div class="editorial-section-heading">
        <span class="section-badge">{sectionTitles.whyBadge}</span>
        <h2>{landingText.whyTitle}</h2>
        <p class="section-lead">{landingText.whyLead}</p>
      </div>

      <div class="why-grid">
        {whyCards.map((card) => (
          <div class="why-card">
            <div class="why-card__icon">{card.icon}</div>
            <h3>{card.title}</h3>
            <p>{card.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- APPLICATIONS SECTION -->
  <section class="section applications-section">
    <div class="shell">
      <div class="editorial-section-heading">
        <span class="section-badge">{sectionTitles.appsBadge}</span>
        <h2>{landingText.applicationsTitle}</h2>
      </div>

      <div class="apps-grid">
        {applications.map((app) => (
          <div class="app-card">
            <span class="app-card__icon">{app.icon}</span>
            <span class="app-card__name">{app.name}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- QUOTE SECTION -->
  <section id="quote-section" class="section quote-section">
    <div class="shell">
      <div class="quote-card">
        <div class="quote-card__content">
          <h2>{landingText.quoteTitle}</h2>
          <p>{landingText.quoteDesc}</p>
        </div>
        <div class="quote-card__action">
          <a href="mailto:info@teyfikgokdemir.com?subject=Reflex%20B2B%20Glove%20Quotation" class="quote-btn">
            {landingText.quoteBtn}
          </a>
        </div>
      </div>
    </div>
  </section>
</div>

<style>
  .reflex-landing {
    background-color: #F6F3EC;
    color: #1A1815;
    min-height: 100vh;
  }
  .reflex-hero {
    padding-block: clamp(3.5rem, 6vw, 6rem);
    border-bottom: 1px solid #E6E1D7;
  }
  .hero-editorial-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    gap: clamp(2.5rem, 5vw, 5rem);
    align-items: center;
  }
  .hero-eyebrow {
    margin-bottom: 1.25rem;
  }
  .hero-editorial-title {
    font-family: Georgia, Cambria, 'Times New Roman', serif;
    font-size: clamp(2.4rem, 4.5vw, 4rem);
    line-height: 1.12;
    font-weight: 700;
    margin: 0 0 1.25rem;
    color: #1A1815;
  }
  .hero-editorial-lead {
    font-size: clamp(1.05rem, 1.5vw, 1.25rem);
    color: #2E2A25;
    line-height: 1.65;
    margin-bottom: 2rem;
  }
  .hero-actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .black-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.45rem 1rem;
    border-radius: 999px;
    background: #1A1815;
    color: #FFFFFF;
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.02em;
  }
  .dark-btn {
    background: #1A1815 !important;
    color: #FFFFFF !important;
    padding: 0.85rem 1.6rem;
    border-radius: 10px;
    font-weight: 700;
    text-decoration: none;
  }
  .amber-btn {
    background: #D45D35 !important;
    color: #FFFFFF !important;
    padding: 0.85rem 1.6rem;
    border-radius: 10px;
    font-weight: 700;
    text-decoration: none;
  }
  .dark-btn:hover {
    background: #D45D35 !important;
  }
  .amber-btn:hover {
    background: #B84A25 !important;
  }

  .hero-image-card {
    background: #FFFFFF;
    border: 1px solid #E6E1D7;
    border-radius: 20px;
    padding: 1.5rem;
    box-shadow: 0 10px 30px rgba(26, 24, 21, 0.05);
    overflow: hidden;
  }
  .hero-image-card img {
    width: 100%;
    height: auto;
    object-fit: cover;
    border-radius: 12px;
  }

  .editorial-section-heading {
    margin-bottom: 2.5rem;
  }
  .section-badge {
    display: inline-block;
    color: #D45D35;
    font-size: 0.82rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 0.5rem;
  }
  .editorial-section-heading h2 {
    font-family: Georgia, Cambria, 'Times New Roman', serif;
    font-size: clamp(2rem, 3.5vw, 2.8rem);
    font-weight: 700;
    color: #1A1815;
    margin: 0 0 0.75rem;
  }
  .section-lead {
    font-size: 1.05rem;
    color: #4A453E;
    max-width: 680px;
    line-height: 1.6;
    margin: 0;
  }

  .reflex-grid-custom {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }
  .reflex-row-top,
  .reflex-row-bottom {
    display: grid;
    gap: 1.75rem;
  }
  .reflex-row-top {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }
  .reflex-row-bottom {
    grid-template-columns: repeat(3, minmax(0, 1fr));
    max-width: 85%;
    margin-inline: auto;
    width: 100%;
  }

  @media (max-width: 1200px) {
    .reflex-row-top {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .reflex-row-bottom {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      max-width: 100%;
    }
  }

  @media (max-width: 768px) {
    .reflex-row-top,
    .reflex-row-bottom {
      grid-template-columns: 1fr;
    }
  }

  .why-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
  }
  .why-card {
    padding: 2rem;
    border: 1px solid #E6E1D7;
    border-radius: 18px;
    background: #FFFFFF;
    color: #1A1815;
    box-shadow: 0 4px 20px rgba(26, 24, 21, 0.03);
  }
  .why-card__icon {
    font-size: 2.2rem;
    margin-bottom: 1rem;
  }
  .why-card h3 {
    font-family: Georgia, Cambria, 'Times New Roman', serif;
    font-size: 1.35rem;
    margin: 0 0 0.75rem;
    color: #1A1815;
    font-weight: 700;
  }
  .why-card p {
    margin: 0;
    color: #4A453E;
    font-size: 0.95rem;
    line-height: 1.6;
  }

  .apps-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1rem;
  }
  .app-card {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding: 1.2rem 1.4rem;
    border: 1px solid #E6E1D7;
    border-radius: 14px;
    background: #FFFFFF;
    color: #1A1815;
    font-weight: 700;
    box-shadow: 0 2px 10px rgba(26, 24, 21, 0.02);
  }
  .app-card__icon {
    font-size: 1.5rem;
  }

  .quote-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    padding: clamp(2rem, 4vw, 3.5rem);
    border: 1px solid #2D2722;
    border-radius: 20px;
    background: #1A1815;
    color: #FFFFFF;
    flex-wrap: wrap;
    margin-top: 2rem;
  }
  .quote-card__content h2 {
    font-family: Georgia, Cambria, 'Times New Roman', serif;
    font-size: clamp(1.8rem, 3vw, 2.5rem);
    margin: 0 0 0.75rem;
    color: #FFFFFF;
  }
  .quote-card__content p {
    margin: 0;
    max-width: 600px;
    color: #D6CFCE;
    line-height: 1.6;
  }
  .quote-btn {
    background: #D45D35 !important;
    color: #FFFFFF !important;
    padding: 0.85rem 1.6rem;
    font-weight: 700;
    border-radius: 10px;
    text-decoration: none;
    display: inline-block;
  }
  .quote-btn:hover {
    background: #B84A25 !important;
  }

  @media (max-width: 900px) {
    .hero-editorial-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
