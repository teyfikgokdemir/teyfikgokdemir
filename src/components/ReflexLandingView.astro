---
import { reflexProducts } from '../data/reflexProducts';
import ReflexProductCard from './ReflexProductCard.astro';
import type { Locale } from '../i18n/locales';

interface Props {
  locale: Locale | 'fa';
}

const { locale } = Astro.props;
const lang = (locale || 'tr') as 'tr' | 'en' | 'mk' | 'sr' | 'sq' | 'fa';

const landingText = {
  tr: {
    heroTag: 'Reflex Plastik · B2B Eldiven Çözümleri',
    heroTitle: 'Profesyonel Eldiven Sistemleri & Hijyen Teknolojileri',
    heroLead: 'Endüstriyel mutfaklar, gıda üretim hatları, sağlık, kişisel bakım ve hijyen operasyonları için 7 farklı uzman ürün ailesi ile yüksek hacimli güvenilir tedarik.',
    primaryCta: 'Ürün Portföyünü İncele',
    secondaryCta: 'Teklif & Tedarik Talebi',
    whyTitle: 'Neden Reflex Ürün Portföyü?',
    whyLead: 'Geleneksel nitril ve vinil eldivenlere yüksek performanslı, ekonomik ve gıda uyumlu yeni nesil elastomer alternatifler.',
    applicationsTitle: 'Sektörel Uygulama Alanları',
    quoteTitle: 'B2B Toplu Tedarik ve Özel Teklif İsteği',
    quoteDesc: 'Reflex eldiven ürün grupları için koli ve palet bazlı kurumsal tedarik talepleriniz, distribütörlük ve ihracat iş birlikleri için doğrudan iletişime geçin.',
    quoteBtn: 'Ticari İletişime Geç',
  },
  en: {
    heroTag: 'Reflex Plastik · B2B Disposable Glove Systems',
    heroTitle: 'Professional B2B Glove Systems & Hygiene Solutions',
    heroLead: 'Delivering reliable high-volume supply across 7 specialized product lines engineered for food manufacturing, ho-re-ca, healthcare, beauty, and industrial maintenance.',
    primaryCta: 'Explore Product Portfolio',
    secondaryCta: 'Request B2B Quotation',
    whyTitle: 'Why Choose Reflex Portfolio?',
    whyLead: 'High-performance, cost-effective, and food-safe next-generation elastomer alternatives to traditional Nitrile and Vinyl gloves.',
    applicationsTitle: 'Industry Application Sectors',
    quoteTitle: 'Request B2B Wholesale Quote & Export Inquiries',
    quoteDesc: 'Connect directly with our commercial team for container/pallet load inquiries, private label options, or regional distribution partnerships.',
    quoteBtn: 'Contact Commercial Team',
  },
  mk: {
    heroTag: 'Reflex Plastik · Професионални Ракавици',
    heroTitle: 'Професионални B2B Ракавици и Хигиенски Решенија',
    heroLead: 'Сигурна снабденост низ 7 специјализирани серии на ракавици развиени за прехранбена индустрија, угостителство, козметика и општа заштита.',
    primaryCta: 'Прегледај Портфолио',
    secondaryCta: 'Побарај Понуда',
    whyTitle: 'Зошто Reflex Ракавици?',
    whyLead: 'Високо-перформансни, економични и безбедни за храна еластомерни алтернативи на нитрилни и винилни ракавици.',
    applicationsTitle: 'Индустриски Сектори',
    quoteTitle: 'Побарај B2B Големопродажна Понуда',
    quoteDesc: 'Контактирајте го нашиот комерцијален тим за палетна испорака, регионална дистрибуција и извоз.',
    quoteBtn: 'Контактирај Комерција',
  },
  sr: {
    heroTag: 'Reflex Plastik · B2B Sistem Rukavica',
    heroTitle: 'Profesionalni B2B Portfolijo Rukavica i Higijenskih Sistema',
    heroLead: 'Pouzdano snabdevanje kroz 7 specijalizovanih linija rukavica razvijenih za prehrambenu industriju, ugostiteljstvo, lepoticu i industrijsko održavanje.',
    primaryCta: 'Istraži Portfolijo',
    secondaryCta: 'Zatraži B2B Ponudu',
    whyTitle: 'Zašto Odabrati Reflex Rukavice?',
    whyLead: 'Ekonomične, rastegljive i bezbedne elastomerne alternative tradicionalnim nitrilnim i vinilnim rukavicama.',
    applicationsTitle: 'Sektori Primene',
    quoteTitle: 'Zatražite B2B Veleprodajnu Ponudu',
    quoteDesc: 'Stupite u kontakt sa našim timom za paletne isporuke, distribuciju i izvozne aranžmane.',
    quoteBtn: 'Kontaktirajte Komercijalu',
  },
  sq: {
    heroTag: 'Reflex Plastik · Zgjidhje B2B të Dorezave',
    heroTitle: 'Zgjidhje Profesionale B2B për Doreza dhe Higjienë',
    heroLead: 'Furnizim i besueshëm në volum të lartë në 7 linja të specializuara të dorezave për industrinë ushqimore, restorante, kozmetikë dhe mirëmbajtje.',
    primaryCta: 'Shiko Portofolin',
    secondaryCta: 'Kërko Ofertë B2B',
    whyTitle: 'Pse të Zgjidhni Portofolin Reflex?',
    whyLead: 'Alternativa elastomere të gjeneratës së re, ekonomike dhe të sigurta për ushqimin ndaj dorezave nitrile dhe vinil.',
    applicationsTitle: 'Sektorët e Përdorimit',
    quoteTitle: 'Kërkoni Ofertë me Shumicë B2B',
    quoteDesc: 'Kontaktoni drejtpërdrejt ekipin tonë tregtar për porosi me paleta, shpërndarje rajonale dhe eksport.',
    quoteBtn: 'Kontakto Ekipin Tregtar',
  },
  fa: {
    heroTag: 'رفلکس پلاستیک · سیستم‌های دستکش B2B',
    heroTitle: 'سیستم‌های حرفه‌ای دستکش و راهکارهای بهداشتی B2B',
    heroLead: 'تامین مطمئن در حجم بالا در ۷ سبد محصول تخصصی برای صنایع غذایی، رستوران‌ها، مراکز بهداشتی و آرایشی.',
    primaryCta: 'بررسی محصولات',
    secondaryCta: 'درخواست پیش‌فاکتور B2B',
    whyTitle: 'چرا محصولات رفلکس؟',
    whyLead: 'جایگزین‌های الاستومری نسل جدید با کارایی بالا، اقتصادی و ایمن برای مواد غذایی در مقایسه با دستکش‌های نیتریل و وینیل.',
    applicationsTitle: 'صنایع و کاربردها',
    quoteTitle: 'استعلام قیمت عمده B2B و صادرات',
    quoteDesc: 'برای سفارش‌های عمده، پالت و همکاری‌های توزیع منطقه‌ای مستقیماً با تیم تجاری ما تماس بگیرید.',
    quoteBtn: 'تماس با تیم تجاری',
  }
}[lang] || landingText.tr;

const whyCards = [
  {
    icon: '⚡',
    title: lang === 'tr' ? 'Hibrit TPE Teknolojisi' : 'Hybrid TPE Technology',
    desc: lang === 'tr' ? 'PVC ve Nitril eldivenlere kıyasla daha fazla esneklik, pürüzsüz doku ve üstün çevre dostu yapı.' : 'Greater elasticity and smooth texture compared to vinyl and nitrile.'
  },
  {
    icon: '🛡️',
    title: lang === 'tr' ? '%100 Gıda Uyumu & Hipoalerjenik' : '100% Food Safe & Hypoallergenic',
    desc: lang === 'tr' ? 'Kokusuz, tatsız, silikon ve lateks içermeyen yapısı ile alerji riskini sıfıra indiren güvenli temas.' : 'Odorless, tasteless, latex-free & silicone-free formula for zero allergy risk.'
  },
  {
    icon: '💰',
    title: lang === 'tr' ? 'Maliyet & Tedarik Avantajı' : 'Cost & Supply Efficiency',
    desc: lang === 'tr' ? 'Muadillerine göre yüksek maliyet avantajı, hızlı üretim ve yüksek hacimli B2B stok sürekliliği.' : 'High cost advantage over traditional gloves with robust B2B inventory readiness.'
  }
];

const applications = [
  { name: lang === 'tr' ? 'Gıda Üretimi & Servis' : 'Food Processing & Service', icon: '🍽️' },
  { name: lang === 'tr' ? 'Muayene & Sıhhi Temas' : 'Examination & Hygiene', icon: '🩺' },
  { name: lang === 'tr' ? 'Temizlik & Hijyen' : 'Cleaning & Maintenance', icon: '🧹' },
  { name: lang === 'tr' ? 'Güzellik & Bakım Salonları' : 'Beauty & Wellness', icon: '✨' },
  { name: lang === 'tr' ? 'Endüstriyel & Genel Temas' : 'Industrial & General Purpose', icon: '⚙️' }
];

const heroMainProduct = reflexProducts.find(p => p.slug === 'florex') || reflexProducts[0];
---

<div class="reflex-landing">
  <!-- HERO SECTION -->
  <section class="reflex-hero">
    <div class="shell">
      <div class="hero-editorial-grid">
        <div class="hero-left">
          <span class="black-pill hero-eyebrow">{landingText.heroTag}</span>
          <h1 class="hero-editorial-title">{landingText.heroTitle}</h1>
          <p class="hero-editorial-lead">{landingText.heroLead}</p>
          <div class="hero-actions">
            <a href="#product-families" class="button dark-btn">{landingText.primaryCta}</a>
            <a href="#quote-section" class="button amber-btn">{landingText.secondaryCta}</a>
          </div>
        </div>

        <div class="hero-right">
          <div class="hero-image-card">
            <img
              src={heroMainProduct.images.main}
              alt="Reflex Plastik Portfolio Showcase"
              width="600"
              height="450"
              decoding="async"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- PRODUCT FAMILIES GRID -->
  <section id="product-families" class="section">
    <div class="shell">
      <div class="editorial-section-heading">
        <span class="section-badge">Reflex Product Line</span>
        <h2>{lang === 'tr' ? '7 Uzman Ürün Ailesi' : '7 Specialized Product Families'}</h2>
        <p class="section-lead">
          {lang === 'tr'
            ? 'Her biri belirli kullanım ihtiyaçları, hijyen standartları ve et kalınlığı için geliştirilmiş profesyonel eldiven çözümleri.'
            : 'Professional disposable glove solutions engineered for specialized hygiene standards, materials, and tactile requirements.'}
        </p>
      </div>

      <div class="reflex-grid">
        {reflexProducts.map((product) => (
          <ReflexProductCard product={product} locale={locale} />
        ))}
      </div>
    </div>
  </section>

  <!-- WHY REFLEX SECTION -->
  <section class="section why-reflex-section">
    <div class="shell">
      <div class="editorial-section-heading">
        <span class="section-badge">Core Advantages</span>
        <h2>{landingText.whyTitle}</h2>
        <p class="section-lead">{landingText.whyLead}</p>
      </div>

      <div class="why-grid">
        {whyCards.map((card) => (
          <div class="why-card">
            <div class="why-card__icon">{card.icon}</div>
            <h3>{card.title}</h3>
            <p>{card.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- APPLICATIONS SECTION -->
  <section class="section applications-section">
    <div class="shell">
      <div class="editorial-section-heading">
        <span class="section-badge">Industries & Use Cases</span>
        <h2>{landingText.applicationsTitle}</h2>
      </div>

      <div class="apps-grid">
        {applications.map((app) => (
          <div class="app-card">
            <span class="app-card__icon">{app.icon}</span>
            <span class="app-card__name">{app.name}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- QUOTE SECTION -->
  <section id="quote-section" class="section quote-section">
    <div class="shell">
      <div class="quote-card">
        <div class="quote-card__content">
          <h2>{landingText.quoteTitle}</h2>
          <p>{landingText.quoteDesc}</p>
        </div>
        <div class="quote-card__action">
          <a href="mailto:info@teyfikgokdemir.com?subject=Reflex%20B2B%20Glove%20Quotation" class="quote-btn">
            {landingText.quoteBtn}
          </a>
        </div>
      </div>
    </div>
  </section>
</div>

<style>
  .reflex-landing {
    background-color: #F6F3EC;
    color: #1A1815;
    min-height: 100vh;
  }
  .reflex-hero {
    padding-block: clamp(3.5rem, 6vw, 6rem);
    border-bottom: 1px solid #E6E1D7;
  }
  .hero-editorial-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    gap: clamp(2.5rem, 5vw, 5rem);
    align-items: center;
  }
  .hero-eyebrow {
    margin-bottom: 1.25rem;
  }
  .hero-editorial-title {
    font-family: Georgia, Cambria, 'Times New Roman', serif;
    font-size: clamp(2.4rem, 4.5vw, 4rem);
    line-height: 1.12;
    font-weight: 700;
    margin: 0 0 1.25rem;
    color: #1A1815;
  }
  .hero-editorial-lead {
    font-size: clamp(1.05rem, 1.5vw, 1.25rem);
    color: #2E2A25;
    line-height: 1.65;
    margin-bottom: 2rem;
  }
  .hero-actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .black-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.45rem 1rem;
    border-radius: 999px;
    background: #1A1815;
    color: #FFFFFF;
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.02em;
  }
  .dark-btn {
    background: #1A1815 !important;
    color: #FFFFFF !important;
    padding: 0.85rem 1.6rem;
    border-radius: 10px;
    font-weight: 700;
    text-decoration: none;
  }
  .amber-btn {
    background: #D45D35 !important;
    color: #FFFFFF !important;
    padding: 0.85rem 1.6rem;
    border-radius: 10px;
    font-weight: 700;
    text-decoration: none;
  }
  .dark-btn:hover {
    background: #D45D35 !important;
  }
  .amber-btn:hover {
    background: #B84A25 !important;
  }

  .hero-image-card {
    background: #FFFFFF;
    border: 1px solid #E6E1D7;
    border-radius: 20px;
    padding: 1.5rem;
    box-shadow: 0 10px 30px rgba(26, 24, 21, 0.05);
    overflow: hidden;
  }
  .hero-image-card img {
    width: 100%;
    height: auto;
    object-fit: cover;
    border-radius: 12px;
  }

  .editorial-section-heading {
    margin-bottom: 2.5rem;
  }
  .section-badge {
    display: inline-block;
    color: #D45D35;
    font-size: 0.82rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 0.5rem;
  }
  .editorial-section-heading h2 {
    font-family: Georgia, Cambria, 'Times New Roman', serif;
    font-size: clamp(2rem, 3.5vw, 2.8rem);
    font-weight: 700;
    color: #1A1815;
    margin: 0 0 0.75rem;
  }
  .section-lead {
    font-size: 1.05rem;
    color: #4A453E;
    max-width: 680px;
    line-height: 1.6;
    margin: 0;
  }

  .reflex-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 1.75rem;
  }

  .why-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
  }
  .why-card {
    padding: 2rem;
    border: 1px solid #E6E1D7;
    border-radius: 18px;
    background: #FFFFFF;
    color: #1A1815;
    box-shadow: 0 4px 20px rgba(26, 24, 21, 0.03);
  }
  .why-card__icon {
    font-size: 2.2rem;
    margin-bottom: 1rem;
  }
  .why-card h3 {
    font-family: Georgia, Cambria, 'Times New Roman', serif;
    font-size: 1.35rem;
    margin: 0 0 0.75rem;
    color: #1A1815;
    font-weight: 700;
  }
  .why-card p {
    margin: 0;
    color: #4A453E;
    font-size: 0.95rem;
    line-height: 1.6;
  }

  .apps-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1rem;
  }
  .app-card {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding: 1.2rem 1.4rem;
    border: 1px solid #E6E1D7;
    border-radius: 14px;
    background: #FFFFFF;
    color: #1A1815;
    font-weight: 700;
    box-shadow: 0 2px 10px rgba(26, 24, 21, 0.02);
  }
  .app-card__icon {
    font-size: 1.5rem;
  }

  .quote-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    padding: clamp(2rem, 4vw, 3.5rem);
    border: 1px solid #2D2722;
    border-radius: 20px;
    background: #1A1815;
    color: #FFFFFF;
    flex-wrap: wrap;
    margin-top: 2rem;
  }
  .quote-card__content h2 {
    font-family: Georgia, Cambria, 'Times New Roman', serif;
    font-size: clamp(1.8rem, 3vw, 2.5rem);
    margin: 0 0 0.75rem;
    color: #FFFFFF;
  }
  .quote-card__content p {
    margin: 0;
    max-width: 600px;
    color: #D6CFCE;
    line-height: 1.6;
  }
  .quote-btn {
    background: #D45D35 !important;
    color: #FFFFFF !important;
    padding: 0.85rem 1.6rem;
    font-weight: 700;
    border-radius: 10px;
    text-decoration: none;
    display: inline-block;
  }
  .quote-btn:hover {
    background: #B84A25 !important;
  }

  @media (max-width: 900px) {
    .hero-editorial-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
