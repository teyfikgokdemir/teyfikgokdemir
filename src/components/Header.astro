---
import { localeNames, locales, type Locale } from '../i18n/locales';
import type { SiteContent } from '../i18n/content';

interface Props {
  locale: Locale | 'fa';
  copy: SiteContent;
  homePath?: string;
  languageUrls?: Partial<Record<Locale | 'fa', string>>;
}

const { locale, copy, homePath, languageUrls } = Astro.props;

const localeUrl = (item: Locale | 'fa') => item === 'tr' ? '/' : `/${item}/`;
const currentHomePath = homePath ?? localeUrl(locale);
const sectionUrl = (section: string) => `${currentHomePath}#${section}`;

const aiVisibilityUrls: Record<Locale | 'fa', string> = {
  en: '/ai-search-visibility/',
  tr: '/yapay-zeka-arama-gorunurlugu/',
  sq: '/sq/dukshmeria-ne-kerkimin-ai/',
  mk: '/mk/vidlivost-vo-ai-prebaruvanje/',
  sr: '/sr/vidljivost-u-ai-pretrazi/',
  fa: '/fa/مشاهده-پذیری-در-جستجوی-هوش-مصنوعی/',
};

const blogUrls: Record<Locale | 'fa', string> = {
  en: '/blog/',
  tr: '/blog/',
  sq: '/sq/blog/',
  mk: '/mk/blog/',
  sr: '/sr/blog/',
  fa: '/fa/blog/',
};

const reflexUrls: Record<Locale | 'fa', string> = {
  en: '/en/reflex/',
  tr: '/reflex/',
  sq: '/sq/reflex/',
  mk: '/mk/reflex/',
  sr: '/sr/reflex/',
  fa: '/fa/reflex/',
};

const reflexUrl = reflexUrls[locale];
const isReflexPage = Astro.url.pathname.includes('/reflex/');
const aiVisibilityUrl = aiVisibilityUrls[locale];
const blogUrl = blogUrls[locale];

const blogLabels: Record<Locale | 'fa', string> = {
  en: 'Insights',
  tr: 'İçgörüler',
  sq: 'Analiza',
  mk: 'Увид',
  sr: 'Uvidi',
  fa: 'بینش‌ها',
};

const aboutLabels: Record<Locale | 'fa', string> = {
  en: 'About',
  tr: 'Hakkımda',
  sq: 'Rreth meje',
  mk: 'За мене',
  sr: 'O meni',
  fa: 'درباره من',
};

const aiVisibilityLabels: Record<Locale | 'fa', string> = {
  en: 'AI Search Visibility',
  tr: 'AI Arama Görünürlüğü',
  sq: 'Dukshmëri AI',
  mk: 'АИ Пребарување',
  sr: 'AI Vidljivost',
  fa: 'دیده‌شدن در هوش مصنوعی',
};

const nativeLanguageNames: Record<Locale | 'fa', string> = {
  tr: 'Türkçe',
  en: 'English',
  mk: 'Македонски',
  sr: 'Српски',
  sq: 'Shqip',
  fa: 'فارسی',
};

const blogLabel = blogLabels[locale];
const aboutLabel = aboutLabels[locale];
const aiVisibilityLabel = aiVisibilityLabels[locale];

const navLabels = locale === 'fa'
  ? {
      ventures: 'ساختارها',
      expertise: 'تخصص',
      journey: 'درباره من',
      contact: 'تماس',
    }
  : {
      ventures: copy.nav?.ventures || 'Girişimler',
      expertise: copy.nav?.expertise || 'Uzmanlık',
      journey: aboutLabel,
      contact: copy.nav?.contact || 'İletişim',
    };
const a11y = locale === 'fa'
  ? { language:'انتخاب زبان', menuOpen:'باز کردن منو', menuClose:'بستن منو' }
  : copy.a11y;

const ctsegUrl = locale === 'tr'
  ? 'https://ctseg.com.tr/'
  : locale === 'fa'
    ? 'https://ctseg.com.tr/fa/tamin-beynolmelali-iran/'
    : 'https://ctseg.com.tr/en/';

const ventureSubItems = [
  { name: 'CTSEG', desc: 'Principal Trade & Sourcing', url: ctsegUrl, external: true },
  { name: 'QCT Studio', desc: 'Digital & Technology', url: 'https://qctstudio.com', external: true },
  { name: 'QCT Commerce', desc: 'Digital Commerce', url: 'https://qctcommerce.com', external: true },
  { name: 'Mythborn', desc: 'Consumer Brand', url: 'https://mythborn.co', external: true },
];

const expertiseSubItems = [
  { name: locale === 'tr' ? 'Uluslararası Ticaret' : 'International Trade', url: sectionUrl('expertise') },
  { name: locale === 'tr' ? 'Stratejik Tedarik' : 'Strategic Sourcing', url: sectionUrl('expertise') },
  { name: locale === 'tr' ? 'Dijital Ticaret & Büyüme' : 'Digital Commerce & Growth', url: sectionUrl('expertise') },
  { name: aiVisibilityLabel, url: aiVisibilityUrl },
];

---
<header class="site-header">
  <a class="brand" href={currentHomePath} aria-label="Teyfik Gökdemir">
    <picture class="brand__mark">
      <source media="(max-width: 760px)" srcset="/brand/teyfik-gokdemir-monogram.webp" type="image/webp" />
      <source media="(max-width: 760px)" srcset="/brand/teyfik-gokdemir-monogram.png" type="image/png" />
      <source srcset="/brand/teyfik-gokdemir-primary.webp" type="image/webp" />
      <img
        src="/brand/teyfik-gokdemir-primary.png"
        width="705"
        height="203"
        alt="Teyfik Gökdemir"
        decoding="async"
      />
    </picture>
  </a>

  <button
    class="menu-toggle"
    type="button"
    aria-expanded="false"
    aria-controls="site-navigation"
    data-open-label={a11y.menuOpen}
    data-close-label={a11y.menuClose}
    aria-label={a11y.menuOpen}
  >
    <span></span><span></span><span></span>
  </button>

  <div class="header-panel" id="site-navigation">
    <nav aria-label="Main Navigation">
      <div class="nav-item-dropdown" data-dropdown>
        <button class="dropdown-trigger" type="button" aria-expanded="false">
          <span>{navLabels.ventures}</span>
          <svg class="dropdown-arrow" width="9" height="5" viewBox="0 0 9 5" fill="none" aria-hidden="true">
            <path d="M1 1L4.5 4L8 1" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
        <div class="dropdown-menu">
          {ventureSubItems.map((item) => (
            <a href={item.url} target={item.external ? '_blank' : undefined} rel={item.external ? 'noopener noreferrer' : undefined} class="dropdown-link">
              <span class="dropdown-link__title">{item.name}</span>
              <span class="dropdown-link__desc">{item.desc}</span>
            </a>
          ))}
        </div>
      </div>

      <div class="nav-item-dropdown" data-dropdown>
        <button class="dropdown-trigger" type="button" aria-expanded="false">
          <span>{navLabels.expertise}</span>
          <svg class="dropdown-arrow" width="9" height="5" viewBox="0 0 9 5" fill="none" aria-hidden="true">
            <path d="M1 1L4.5 4L8 1" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
        <div class="dropdown-menu">
          {expertiseSubItems.map((item) => (
            <a href={item.url} class="dropdown-link">
              <span class="dropdown-link__title">{item.name}</span>
            </a>
          ))}
        </div>
      </div>

      <a href={reflexUrl} aria-current={isReflexPage ? 'page' : undefined}>Reflex</a>
      <a href={blogUrl}>{blogLabel}</a>
      <a href={sectionUrl('journey')}>{aboutLabel}</a>
      <a href={sectionUrl('contact')}>{navLabels.contact}</a>
    </nav>

    <div class="nav-item-dropdown lang-dropdown" data-dropdown>
      <button class="dropdown-trigger lang-trigger" type="button" aria-expanded="false" aria-label={a11y.language}>
        <span class="lang-trigger__code">{locale.toUpperCase()}</span>
        <svg class="dropdown-arrow" width="9" height="5" viewBox="0 0 9 5" fill="none" aria-hidden="true">
          <path d="M1 1L4.5 4L8 1" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
      <div class="dropdown-menu lang-menu">
        {locales.map((item) => (
          <a
            href={languageUrls?.[item] ?? localeUrl(item)}
            lang={item}
            hreflang={item}
            aria-current={item === locale ? 'page' : undefined}
            class:list={['dropdown-link', 'lang-link', { 'is-active': item === locale }]}
            title={localeNames[item]}
          >
            <span class="lang-link__name">{nativeLanguageNames[item]}</span>
            <span class="lang-link__code">{item.toUpperCase()}</span>
          </a>
        ))}
      </div>
    </div>
  </div>
</header>

<script is:inline>
  const toggle = document.querySelector('.menu-toggle');
  const panel = document.querySelector('.header-panel');

  if (toggle && panel) {
    toggle.addEventListener('click', () => {
      const open = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded', String(!open));
      panel.classList.toggle('is-open', !open);
      toggle.setAttribute('aria-label', open ? toggle.dataset.openLabel : toggle.dataset.closeLabel);
    });
  }

  // Dropdown interactivity
  document.querySelectorAll('[data-dropdown]').forEach((dropdown) => {
    const trigger = dropdown.querySelector('.dropdown-trigger');
    if (!trigger) return;

    trigger.addEventListener('click', (e) => {
      e.stopPropagation();
      const open = trigger.getAttribute('aria-expanded') === 'true';
      
      // Close other dropdowns
      document.querySelectorAll('[data-dropdown] .dropdown-trigger').forEach((other) => {
        if (other !== trigger) other.setAttribute('aria-expanded', 'false');
      });

      trigger.setAttribute('aria-expanded', String(!open));
    });
  });

  document.addEventListener('click', () => {
    document.querySelectorAll('[data-dropdown] .dropdown-trigger').forEach((trigger) => {
      trigger.setAttribute('aria-expanded', 'false');
    });
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      document.querySelectorAll('[data-dropdown] .dropdown-trigger').forEach((trigger) => {
        trigger.setAttribute('aria-expanded', 'false');
      });
    }
  });
</script>

<style is:global>
  .site-header {
    height: 86px !important;
    min-height: 86px !important;
    padding-inline: clamp(1.5rem, 4vw, 3.5rem) !important;
    background: #211c18 !important;
    border-bottom: 1px solid rgba(201, 191, 178, 0.15) !important;
    display: flex !important;
    align-items: center !important;
    justify-content: space-between !important;
    position: sticky !important;
    top: 0 !important;
    z-index: 1000 !important;
  }
  
  /* Compact branding area */
  .brand {
    display: inline-flex !important;
    align-items: center !important;
    max-width: 230px !important;
    height: auto !important;
    text-decoration: none !important;
  }
  .brand__mark img {
    max-width: 220px !important;
    height: auto !important;
    display: block !important;
    object-fit: contain !important;
  }

  .header-panel {
    display: flex !important;
    align-items: center !important;
    gap: clamp(1.5rem, 3vw, 3rem) !important;
  }
  .header-panel nav {
    display: flex !important;
    align-items: center !important;
    gap: clamp(1.2rem, 2.2vw, 2rem) !important;
  }
  .header-panel nav a,
  .dropdown-trigger {
    font-size: 0.9rem !important;
    font-weight: 500 !important;
    letter-spacing: 0.02em !important;
    color: #c9bfb2 !important;
    background: transparent !important;
    border: none !important;
    cursor: pointer !important;
    text-decoration: none !important;
    transition: color 180ms ease !important;
    display: inline-flex !important;
    align-items: center !important;
    gap: 0.35rem !important;
    padding: 0 !important;
    text-transform: none !important;
  }
  .header-panel nav a:hover,
  .dropdown-trigger:hover,
  .dropdown-trigger[aria-expanded="true"] {
    color: #f3eee6 !important;
  }
  .dropdown-arrow {
    transition: transform 180ms ease !important;
    opacity: 0.7 !important;
  }
  .dropdown-trigger[aria-expanded="true"] .dropdown-arrow {
    transform: rotate(180deg) !important;
  }
  .nav-item-dropdown {
    position: relative !important;
  }
  .dropdown-menu {
    position: absolute !important;
    top: calc(100% + 0.85rem) !important;
    left: 50% !important;
    transform: translateX(-50%) !important;
    min-width: 210px !important;
    padding: 0.4rem 0 !important;
    background: #211c18 !important;
    border: 1px solid rgba(201, 191, 178, 0.25) !important;
    border-radius: 6px !important;
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.4) !important;
    display: none;
    flex-direction: column !important;
    z-index: 100 !important;
  }
  .dropdown-trigger[aria-expanded="true"] + .dropdown-menu,
  .nav-item-dropdown:hover .dropdown-menu {
    display: flex !important;
  }
  .dropdown-link {
    padding: 0.55rem 1rem !important;
    display: flex !important;
    flex-direction: column !important;
    gap: 0.15rem !important;
    text-align: left !important;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05) !important;
    transition: background 150ms ease !important;
  }
  .dropdown-link:last-child {
    border-bottom: none !important;
  }
  .dropdown-link:hover {
    background: rgba(201, 191, 178, 0.08) !important;
  }
  .dropdown-link__title {
    font-size: 0.86rem !important;
    font-weight: 600 !important;
    color: #f3eee6 !important;
  }
  .dropdown-link__desc {
    font-size: 0.73rem !important;
    font-weight: 400 !important;
    color: #a99d8f !important;
  }

  /* Language Selector Dropdown */
  .lang-dropdown {
    position: relative !important;
  }
  .lang-trigger {
    display: inline-flex !important;
    align-items: center !important;
    gap: 0.35rem !important;
    padding: 0.35rem 0.65rem !important;
    font-size: 0.82rem !important;
    font-weight: 600 !important;
    letter-spacing: 0.06em !important;
    color: #f3eee6 !important;
    background: transparent !important;
    border: 1px solid rgba(201, 191, 178, 0.25) !important;
    border-radius: 4px !important;
    cursor: pointer !important;
    transition: all 180ms ease !important;
  }
  .lang-trigger:hover,
  .lang-trigger[aria-expanded="true"] {
    border-color: #a65332 !important;
    color: #f3eee6 !important;
  }
  .lang-menu {
    right: 0 !important;
    left: auto !important;
    transform: none !important;
    min-width: 150px !important;
  }
  .lang-link {
    display: flex !important;
    flex-direction: row !important;
    align-items: center !important;
    justify-content: space-between !important;
    padding: 0.5rem 0.85rem !important;
    text-decoration: none !important;
  }
  .lang-link__name {
    font-size: 0.85rem !important;
    font-weight: 500 !important;
    color: #c9bfb2 !important;
  }
  .lang-link__code {
    font-size: 0.72rem !important;
    font-weight: 600 !important;
    letter-spacing: 0.05em !important;
    color: #8c8275 !important;
  }
  .lang-link:hover .lang-link__name,
  .lang-link.is-active .lang-link__name {
    color: #f3eee6 !important;
  }
  .lang-link.is-active {
    background: rgba(166, 83, 50, 0.2) !important;
  }
  .lang-link.is-active .lang-link__code {
    color: #d78263 !important;
  }

  @media (max-width: 990px) {
    .site-header {
      height: 72px !important;
      min-height: 72px !important;
    }
    .brand__mark img {
      max-width: 160px !important;
    }
    .header-panel nav {
      flex-direction: column;
      align-items: flex-start;
      gap: 1.25rem;
    }
    .dropdown-menu {
      position: static !important;
      transform: none !important;
      box-shadow: none !important;
      border: none !important;
      background: transparent !important;
      padding-left: 1rem !important;
    }
  }
</style>
