---
import type { Locale } from '../i18n/locales';
import type { SiteContent } from '../i18n/content';
import { site } from '../data/site';

interface Props {
  locale: Locale | 'fa';
  copy: SiteContent;
  homePath?: string;
  languageUrls?: Partial<Record<Locale | 'fa', string>>;
}

const { locale, copy, homePath, languageUrls } = Astro.props;
const localeUrl = (item: Locale | 'fa') => item === 'tr' ? '/' : `/${item}/`;
const currentHomePath = homePath ?? localeUrl(locale);
const sectionUrl = (section: string) => `${currentHomePath}#${section}`;

const allLocales: (Locale | 'fa')[] = ['tr','en','ru','mk','sr','sq','fa','zh','vi'];
const nativeLanguageNames: Record<string,string> = {
  tr:'Türkçe', en:'English', ru:'Русский', mk:'Македонски', sr:'Srpski', sq:'Shqip', fa:'فارسی', zh:'中文', vi:'Tiếng Việt'
};
const labels = ({
  tr:{ ecosystem:'Ekosistem', work:'Çalışma modeli', insights:'İçgörüler', contact:'İletişim', menu:'Menü', close:'Menüyü kapat', language:'Dil seçimi', owned:'Ana yapılar', assets:'Dijital varlıklar', collaboration:'Ortak proje' },
  en:{ ecosystem:'Ecosystem', work:'Operating model', insights:'Insights', contact:'Contact', menu:'Menu', close:'Close menu', language:'Language', owned:'Core businesses', assets:'Digital assets', collaboration:'Collaboration' },
  ru:{ ecosystem:'Экосистема', work:'Модель работы', insights:'Аналитика', contact:'Контакты', menu:'Меню', close:'Закрыть меню', language:'Язык', owned:'Основные структуры', assets:'Цифровые активы', collaboration:'Партнерство' },
  mk:{ ecosystem:'Екосистем', work:'Модел на работа', insights:'Увиди', contact:'Контакт', menu:'Мени', close:'Затвори мени', language:'Јазик', owned:'Главни структури', assets:'Дигитални средства', collaboration:'Соработка' },
  sr:{ ecosystem:'Ekosistem', work:'Model rada', insights:'Uvidi', contact:'Kontakt', menu:'Meni', close:'Zatvori meni', language:'Jezik', owned:'Glavne strukture', assets:'Digitalna imovina', collaboration:'Saradnja' },
  sq:{ ecosystem:'Ekosistemi', work:'Modeli i punës', insights:'Analiza', contact:'Kontakt', menu:'Menu', close:'Mbyll menunë', language:'Gjuha', owned:'Strukturat kryesore', assets:'Asetet digjitale', collaboration:'Bashkëpunim' },
  fa:{ ecosystem:'اکوسیستم', work:'مدل عملیاتی', insights:'بینش‌ها', contact:'تماس', menu:'منو', close:'بستن منو', language:'زبان', owned:'ساختارهای اصلی', assets:'دارایی‌های دیجیتال', collaboration:'همکاری' },
  zh:{ ecosystem:'业务生态', work:'运营方式', insights:'洞察', contact:'联系', menu:'菜单', close:'关闭菜单', language:'语言', owned:'核心业务', assets:'数字资产', collaboration:'合作项目' },
  vi:{ ecosystem:'Hệ sinh thái', work:'Mô hình vận hành', insights:'Góc nhìn', contact:'Liên hệ', menu:'Menu', close:'Đóng menu', language:'Ngôn ngữ', owned:'Cấu trúc chính', assets:'Tài sản số', collaboration:'Hợp tác' },
}[locale] ?? { ecosystem:'Ecosystem', work:'Operating model', insights:'Insights', contact:'Contact', menu:'Menu', close:'Close menu', language:'Language', owned:'Core businesses', assets:'Digital assets', collaboration:'Collaboration' });

const blogUrls: Record<string,string> = {
  tr:'/blog/', en:'/en/blog/', ru:'/ru/blog/', mk:'/mk/blog/', sr:'/sr/blog/', sq:'/sq/blog/', fa:'/fa/blog/', zh:'/zh/blog/', vi:'/vi/blog/'
};
const ctsegUrl = locale === 'tr' ? 'https://ctseg.com.tr/' : locale === 'fa' ? 'https://ctseg.com.tr/fa/' : locale === 'zh' ? 'https://ctseg.com.tr/zh/' : locale === 'vi' ? 'https://ctseg.com.tr/vi/' : 'https://ctseg.com.tr/en/';
const ecosystemLinks = [
  { name:'QCT Studio', detail:'Technology & Digital Products', href:site.links.qctStudio, group:labels.owned },
  { name:'QCT Commerce', detail:'E-commerce & Growth', href:site.links.qctCommerce, group:labels.owned },
  { name:'CTSEG', detail:'Global Trade & Strategic Sourcing', href:ctsegUrl, group:labels.owned },
  { name:'Growth OS', detail:'Growth Intelligence', href:'https://growth.teyfikgokdemir.com', group:labels.assets },
  { name:'Mythborn', detail:'Digital Media & Organic Asset', href:site.links.mythborn, group:labels.assets },
  { name:'Olivon', detail:'Joint Venture / Collaboration', href:'https://olivon.com.tr', group:labels.collaboration },
];
---
<header class="site-header" data-site-header>
  <div class="header-inner">
    <a class="brand" href={currentHomePath} aria-label="Teyfik Gökdemir">
      <picture>
        <source media="(max-width:720px)" srcset="/brand/teyfik-gokdemir-monogram.webp" type="image/webp" />
        <source srcset="/brand/teyfik-gokdemir-primary.webp" type="image/webp" />
        <img src="/brand/teyfik-gokdemir-primary.png" width="705" height="203" alt="Teyfik Gökdemir" decoding="async" />
      </picture>
    </a>

    <nav class="desktop-nav" aria-label="Primary navigation">
      <div class="nav-dropdown" data-nav-dropdown>
        <button type="button" class="nav-button" aria-expanded="false" data-dropdown-trigger>
          {labels.ecosystem}<svg class="nav-chevron" aria-hidden="true" viewBox="0 0 12 8" width="12" height="8"><path d="M1 1.25 6 6.25 11 1.25" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        <div class="dropdown-panel" data-dropdown-panel>
          {ecosystemLinks.map((item) => (
            <a href={item.href} target="_blank" rel="noopener noreferrer">
              <span class="dropdown-group">{item.group}</span>
              <strong>{item.name}</strong>
              <small>{item.detail}</small>
            </a>
          ))}
        </div>
      </div>
      <a href={sectionUrl('journey')}>{labels.work}</a>
      <a href={blogUrls[locale]}>{labels.insights}</a>
      <a href={sectionUrl('contact')}>{labels.contact}</a>
    </nav>

    <div class="header-actions">
      <div class="language-dropdown" data-language-dropdown>
        <button type="button" class="language-button" aria-expanded="false" aria-label={`${labels.language}: ${String(locale).toUpperCase()}`} data-language-trigger>
          {String(locale).toUpperCase()}<svg class="nav-chevron" aria-hidden="true" viewBox="0 0 12 8" width="12" height="8"><path d="M1 1.25 6 6.25 11 1.25" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        <div class="language-panel" data-language-panel>
          {allLocales.map((item) => (
            <a href={languageUrls?.[item] ?? localeUrl(item)} lang={item} aria-current={item === locale ? 'page' : undefined}>
              <span>{nativeLanguageNames[item]}</span><small>{String(item).toUpperCase()}</small>
            </a>
          ))}
        </div>
      </div>
      <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-navigation" aria-label={labels.menu} data-menu-toggle>
        <span class="menu-toggle__label">{labels.menu}</span>
        <span class="menu-toggle__icon" aria-hidden="true"><i></i><i></i></span>
      </button>
    </div>
  </div>

  <div class="mobile-menu" id="mobile-navigation" data-mobile-menu hidden>
    <div class="mobile-menu-inner">
      <div class="mobile-menu-head">
        <span>TEYFİK GÖKDEMİR</span>
        <button type="button" class="mobile-menu-close" aria-label={labels.close} data-mobile-close>×</button>
      </div>

      <nav class="mobile-command-nav" aria-label={labels.menu}>
        <a href={sectionUrl('journey')}><span>{labels.work}</span><span aria-hidden="true">↗</span></a>
        <a href={blogUrls[locale]}><span>{labels.insights}</span><span aria-hidden="true">↗</span></a>
        <a href={sectionUrl('contact')}><span>{labels.contact}</span><span aria-hidden="true">↗</span></a>
        <a href={currentHomePath}><span>{labels.ecosystem}</span><span aria-hidden="true">↗</span></a>
      </nav>

      <section class="mobile-ecosystem-section" aria-labelledby="mobile-ecosystem-title">
        <div class="mobile-section-head">
          <span id="mobile-ecosystem-title">{labels.ecosystem}</span>
          <small>{labels.owned}</small>
        </div>
        <div class="mobile-ecosystem-grid">
          {ecosystemLinks.map((item) => (
            <a href={item.href} target="_blank" rel="noopener noreferrer">
              <strong>{item.name}</strong>
              <small>{item.detail}</small>
              <span aria-hidden="true">↗</span>
            </a>
          ))}
        </div>
      </section>

      <div class="mobile-menu-utility">
        <details class="mobile-language-picker">
          <summary><span>{String(locale).toUpperCase()}</span><small>{labels.language}</small></summary>
          <div class="mobile-language-panel">
            {allLocales.map((item) => (
              <a class={item === locale ? 'active' : ''} href={languageUrls?.[item] ?? localeUrl(item)}>
                <span>{nativeLanguageNames[item]}</span><small>{String(item).toUpperCase()}</small>
              </a>
            ))}
          </div>
        </details>
        <a class="mobile-contact-cta" href={sectionUrl('contact')}>
          <span>{labels.contact}</span><span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </div>
</header>

<script>
  const header = document.querySelector('[data-site-header]');
  const menuButton = header?.querySelector('[data-menu-toggle]');
  const mobileMenu = header?.querySelector('[data-mobile-menu]');
  const setMenu = (open) => {
    if (!(menuButton instanceof HTMLButtonElement) || !(mobileMenu instanceof HTMLElement)) return;
    menuButton.setAttribute('aria-expanded', String(open));
    mobileMenu.hidden = !open;
    document.documentElement.classList.toggle('menu-open', open);
  };
  menuButton?.addEventListener('click', () => setMenu(menuButton.getAttribute('aria-expanded') !== 'true'));
  mobileMenu?.querySelector('[data-mobile-close]')?.addEventListener('click', () => setMenu(false));
  mobileMenu?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => setMenu(false)));

  const setupPopover = (rootSelector, triggerSelector, panelSelector) => {
    const root = header?.querySelector(rootSelector);
    const trigger = root?.querySelector(triggerSelector);
    const panel = root?.querySelector(panelSelector);
    if (!(trigger instanceof HTMLButtonElement) || !(panel instanceof HTMLElement)) return;
    const close = () => { trigger.setAttribute('aria-expanded','false'); panel.classList.remove('open'); };
    trigger.addEventListener('click', (event) => {
      event.stopPropagation();
      const open = trigger.getAttribute('aria-expanded') !== 'true';
      trigger.setAttribute('aria-expanded', String(open));
      panel.classList.toggle('open', open);
    });
    document.addEventListener('click', (event) => { if (!root?.contains(event.target)) close(); });
    document.addEventListener('keydown', (event) => { if (event.key === 'Escape') close(); });
  };
  setupPopover('[data-nav-dropdown]','[data-dropdown-trigger]','[data-dropdown-panel]');
  setupPopover('[data-language-dropdown]','[data-language-trigger]','[data-language-panel]');
  header?.querySelectorAll('.language-panel a, .mobile-language-panel a').forEach((link) => {
    if (!(link instanceof HTMLAnchorElement)) return;
    try {
      const target = new URL(link.href, location.origin);
      if (location.search) target.search = location.search;
      if (location.hash) target.hash = location.hash;
      link.href = target.pathname + target.search + target.hash;
      link.dataset.languageStatePreserved = 'true';
    } catch {}
  });
</script>

<style>
  .site-header{position:sticky;top:0;z-index:80;border-bottom:1px solid rgba(255,255,255,.08);background:rgba(11,11,10,.88);backdrop-filter:blur(18px);-webkit-backdrop-filter:blur(18px)}
  .header-inner{width:min(1440px,calc(100% - 56px));height:78px;margin:auto;display:flex;align-items:center;justify-content:space-between;gap:28px}
  .brand{display:block;width:196px;line-height:0}.brand picture,.brand img{display:block;width:100%;height:auto}.desktop-nav{display:flex;align-items:center;gap:30px;margin-left:auto}.desktop-nav>a,.nav-button{color:#ddd6cb;text-decoration:none;font:600 .87rem/1.2 system-ui,sans-serif;letter-spacing:.01em;background:none;border:0;padding:12px 0;cursor:pointer}.desktop-nav>a:hover,.nav-button:hover{color:#fff}.nav-button{display:flex;align-items:center;gap:8px}.nav-chevron{display:block;flex:0 0 auto;transition:transform .2s ease;transform-origin:center}.nav-button[aria-expanded="true"] .nav-chevron,.language-button[aria-expanded="true"] .nav-chevron{transform:rotate(180deg)}.nav-dropdown,.language-dropdown{position:relative}.dropdown-panel,.language-panel{position:absolute;top:calc(100% + 14px);right:0;opacity:0;visibility:hidden;transform:translateY(-8px);transition:.18s ease;background:#11110f;border:1px solid #302e29;border-radius:18px;box-shadow:0 24px 70px rgba(0,0,0,.38)}.dropdown-panel.open,.language-panel.open{opacity:1;visibility:visible;transform:none}.dropdown-panel{width:410px;padding:10px;display:grid;grid-template-columns:1fr 1fr;gap:6px}.dropdown-panel a{display:flex;flex-direction:column;gap:5px;padding:14px;border-radius:12px;color:#eee8df;text-decoration:none}.dropdown-panel a:hover{background:#1b1a17}.dropdown-group{color:#a68a65;font-size:.62rem;letter-spacing:.1em;text-transform:uppercase}.dropdown-panel strong{font-size:.94rem}.dropdown-panel small{color:#8f8b83;font-size:.74rem;line-height:1.4}.header-actions{display:flex;align-items:center;gap:12px}.language-button{display:flex;align-items:center;gap:7px;background:none;border:1px solid #302e29;border-radius:999px;color:#c8c0b5;padding:9px 12px;font-size:.73rem;cursor:pointer}.language-panel{width:190px;padding:8px}.language-panel a{display:flex;align-items:center;justify-content:space-between;padding:10px;border-radius:10px;color:#d8d2c8;text-decoration:none;font-size:.82rem}.language-panel a:hover,.language-panel a[aria-current=page]{background:#1d1c19}.language-panel small{color:#756f67}.menu-toggle{display:none;width:42px;height:42px;border:1px solid #302e29;border-radius:50%;background:none;padding:11px;flex-direction:column;justify-content:center;gap:4px}.menu-toggle span{display:block;width:100%;height:1px;background:#eee8df}.mobile-menu{border-top:1px solid #25231f;background:#0d0d0b;max-height:calc(100vh - 78px);overflow:auto}.mobile-menu-inner{padding:20px 18px 34px}.mobile-section{padding:16px 0;border-bottom:1px solid #24231f}.mobile-label{display:block;color:#987c59;font-size:.68rem;letter-spacing:.12em;text-transform:uppercase;margin-bottom:12px}.mobile-ecosystem{display:flex;justify-content:space-between;gap:20px;padding:12px 0;color:#eee8df;text-decoration:none}.mobile-ecosystem span:first-child{display:flex;flex-direction:column;gap:4px}.mobile-ecosystem small{color:#827e76;font-size:.73rem}.mobile-links{display:grid;gap:4px}.mobile-links a{padding:12px 0;color:#eee8df;text-decoration:none;font-weight:600}.mobile-languages{display:flex;flex-wrap:wrap;gap:8px}.mobile-languages a{padding:8px 10px;border:1px solid #2b2925;border-radius:999px;color:#9f9a91;text-decoration:none;font-size:.75rem}.mobile-languages a.active{color:#f1ece3;border-color:#806a4f;background:#171511}.menu-open{overflow:hidden}@media(max-width:900px){.header-inner{width:calc(100% - 32px);height:70px}.brand{width:42px}.desktop-nav{display:none}.menu-toggle{display:flex}.language-button{padding:8px 10px}.dropdown-panel{display:none}.language-panel{right:-48px}.site-header{backdrop-filter:blur(14px)}}@media(min-width:901px){.mobile-menu{display:none!important}}
</style>

<style>
@media(max-width:900px){
  .mobile-menu{
    position:fixed;
    inset:0;
    z-index:120;
    max-height:100dvh;
    overflow:auto;
    border-top:0;
    background:#0b0b09;
    color:#efe8dc;
    overscroll-behavior:contain;
  }

  .mobile-menu-inner{
    min-height:100dvh;
    display:flex;
    flex-direction:column;
    gap:18px;
    padding:14px 16px 0;
  }

  .mobile-menu-head{
    position:sticky;
    top:0;
    z-index:5;
    display:flex;
    align-items:center;
    justify-content:space-between;
    min-height:54px;
    padding:0 0 10px;
    border-bottom:1px solid rgba(220,191,137,.12);
    background:linear-gradient(180deg,#0b0b09 82%,rgba(11,11,9,0));
  }

  .mobile-menu-head>span{
    color:#d4ae6f;
    font:800 .72rem/1 system-ui,sans-serif;
    letter-spacing:.15em;
  }

  .mobile-menu-close{
    width:38px;
    height:38px;
    display:grid;
    place-items:center;
    border:1px solid rgba(220,191,137,.16);
    border-radius:999px;
    background:#12110f;
    color:#efe8dc;
    font-size:18px;
    cursor:pointer;
  }

  .mobile-command-nav{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:8px;
  }

  .mobile-command-nav a{
    min-height:56px;
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:14px;
    padding:12px 13px;
    border:1px solid rgba(220,191,137,.12);
    border-radius:14px;
    background:#11110f;
    color:#e7d3ad;
    text-decoration:none;
    font:750 .96rem/1.15 system-ui,sans-serif;
  }

  .mobile-command-nav a span:last-child{
    color:#d4ae6f;
    font-size:.74rem;
  }

  .mobile-ecosystem-section{
    display:grid;
    gap:10px;
  }

  .mobile-section-head{
    display:flex;
    align-items:flex-end;
    justify-content:space-between;
    gap:12px;
  }

  .mobile-section-head>span{
    color:#b88f54;
    font:850 .62rem/1 system-ui,sans-serif;
    letter-spacing:.14em;
    text-transform:uppercase;
  }

  .mobile-section-head small{
    color:#756e64;
    font:500 .62rem/1 system-ui,sans-serif;
  }

  .mobile-ecosystem-grid{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:7px;
  }

  .mobile-ecosystem-grid a{
    position:relative;
    min-height:72px;
    display:flex;
    flex-direction:column;
    justify-content:flex-end;
    gap:4px;
    padding:11px 12px;
    border:1px solid rgba(220,191,137,.10);
    border-radius:13px;
    background:#11110f;
    color:#eee5d8;
    text-decoration:none;
  }

  .mobile-ecosystem-grid strong{
    max-width:85%;
    font:800 .79rem/1.15 system-ui,sans-serif;
  }

  .mobile-ecosystem-grid small{
    color:#81786c;
    font:500 .64rem/1.25 system-ui,sans-serif;
  }

  .mobile-ecosystem-grid a>span{
    position:absolute;
    top:10px;
    right:11px;
    color:#d4ae6f;
    font-size:.68rem;
  }

  .mobile-menu-utility{
    position:sticky;
    bottom:0;
    z-index:6;
    display:grid;
    grid-template-columns:auto 1fr;
    align-items:end;
    gap:9px;
    margin-top:auto;
    padding:10px 0 calc(10px + env(safe-area-inset-bottom,0px));
    border-top:1px solid rgba(220,191,137,.12);
    background:linear-gradient(180deg,rgba(11,11,9,.88),#0b0b09 24%);
    backdrop-filter:blur(16px);
    -webkit-backdrop-filter:blur(16px);
  }

  .mobile-language-picker{
    position:relative;
  }

  .mobile-language-picker summary{
    min-width:74px;
    height:44px;
    display:flex;
    align-items:center;
    justify-content:center;
    gap:6px;
    padding:0 10px;
    border:1px solid rgba(220,191,137,.18);
    border-radius:12px;
    background:#11110f;
    color:#d4ae6f;
    list-style:none;
    cursor:pointer;
  }

  .mobile-language-picker summary::-webkit-details-marker{display:none}

  .mobile-language-picker summary span{
    font:850 .7rem/1 system-ui,sans-serif;
  }

  .mobile-language-picker summary small{
    color:#756e64;
    font:600 .58rem/1 system-ui,sans-serif;
  }

  .mobile-language-panel{
    position:absolute;
    left:0;
    bottom:calc(100% + 8px);
    width:min(276px,calc(100vw - 32px));
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:6px;
    padding:8px;
    border:1px solid rgba(220,191,137,.16);
    border-radius:14px;
    background:#11110f;
    box-shadow:0 18px 46px rgba(0,0,0,.38);
  }

  .mobile-language-panel a{
    min-height:42px;
    display:flex;
    flex-direction:column;
    justify-content:center;
    gap:2px;
    padding:7px 8px;
    border:1px solid rgba(220,191,137,.10);
    border-radius:9px;
    color:#d7d0c5;
    text-decoration:none;
    font-size:.66rem;
  }

  .mobile-language-panel a small{color:#746d63;font-size:.55rem}
  .mobile-language-panel a.active{border-color:#806a4f;background:#191610;color:#f2e8d8}

  .mobile-contact-cta{
    min-height:44px;
    display:flex;
    align-items:center;
    justify-content:space-between;
    padding:0 15px;
    border-radius:12px;
    background:linear-gradient(90deg,#d4ae6f,#8d6c3f);
    color:#0b0b09;
    text-decoration:none;
    font:850 .78rem/1 system-ui,sans-serif;
  }

  .mobile-contact-cta span:last-child{font-size:1rem}

  .menu-toggle[aria-expanded="true"]{opacity:0;pointer-events:none}

  @media(max-height:700px){
    .mobile-menu-inner{gap:13px}
    .mobile-command-nav a{min-height:49px;font-size:.88rem}
    .mobile-ecosystem-grid a{min-height:62px}
    .mobile-menu-utility{padding-top:8px}
  }
}
</style>

<style>
@media(max-width:900px){
  .header-actions{
    gap:8px;
  }

  .menu-toggle{
    width:auto!important;
    min-width:78px!important;
    height:40px!important;
    padding:0 12px!important;
    border-radius:999px!important;
    display:flex!important;
    flex-direction:row!important;
    align-items:center!important;
    justify-content:center!important;
    gap:8px!important;
    border:1px solid rgba(212,174,111,.22)!important;
    background:#11110f!important;
    color:#d4ae6f!important;
  }

  .menu-toggle__label{
    display:block!important;
    width:auto!important;
    height:auto!important;
    background:none!important;
    color:#d4ae6f!important;
    font:800 .68rem/1 system-ui,sans-serif!important;
    letter-spacing:.08em!important;
    text-transform:uppercase!important;
  }

  .menu-toggle__icon{
    display:flex!important;
    flex-direction:column!important;
    gap:4px!important;
    width:14px!important;
  }

  .menu-toggle__icon i{
    display:block!important;
    width:14px!important;
    height:1px!important;
    background:#d4ae6f!important;
  }

  .mobile-menu{
