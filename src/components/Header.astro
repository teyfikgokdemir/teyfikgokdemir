---
import { localeNames, locales, type Locale } from '../i18n/locales';
import type { SiteContent } from '../i18n/content';
import { site } from '../data/site';

interface Props {
  locale: Locale | 'fa';
  copy: SiteContent;
  homePath?: string;
  languageUrls?: Partial<Record<Locale | 'fa', string>>;
}

const { locale, copy, homePath, languageUrls } = Astro.props;

const localeUrl = (item: Locale | 'fa') => item === 'tr' ? '/' : `/${item}/`;
const currentHomePath = homePath ?? localeUrl(locale);
const sectionUrl = (section: string) => `${currentHomePath}#${section}`;

const aiVisibilityUrls: Record<Locale | 'fa', string> = {
  en: '/ai-search-visibility/',
  tr: '/yapay-zeka-arama-gorunurlugu/',
  ru: '/ru/ai-search-visibility/',
  sq: '/sq/dukshmeria-ne-kerkimin-ai/',
  mk: '/mk/vidlivost-vo-ai-prebaruvanje/',
  sr: '/sr/vidljivost-u-ai-pretrazi/',
  fa: '/fa/مشاهده-پذیری-در-جستجوی-هوش-مصنوعی/',
};

const blogUrls: Record<Locale | 'fa', string> = {
  en: '/blog/',
  tr: '/blog/',
  ru: '/ru/blog/',
  sq: '/sq/blog/',
  mk: '/mk/blog/',
  sr: '/sr/blog/',
  fa: '/fa/blog/',
};

const reflexUrls: Record<Locale | 'fa', string> = {
  en: '/en/reflex/',
  tr: '/reflex/',
  ru: '/ru/reflex/',
  sq: '/sq/reflex/',
  mk: '/mk/reflex/',
  sr: '/sr/reflex/',
  fa: '/fa/reflex/',
};

const reflexUrl = reflexUrls[locale];
const isReflexPage = Astro.url.pathname.includes('/reflex/');
const aiVisibilityUrl = aiVisibilityUrls[locale];
const blogUrl = blogUrls[locale];

const blogLabels: Record<Locale | 'fa', string> = {
  en: 'Insights',
  tr: 'İçgörüler',
  ru: 'Аналитика',
  sq: 'Analiza',
  mk: 'Увид',
  sr: 'Uvidi',
  fa: 'بینش‌ها',
};

const aboutLabels: Record<Locale | 'fa', string> = {
  en: 'About',
  tr: 'Hakkımda',
  ru: 'Обо мне',
  sq: 'Rreth meje',
  mk: 'За мене',
  sr: 'O meni',
  fa: 'درباره من',
};

const aiVisibilityLabels: Record<Locale | 'fa', string> = {
  en: 'AI Search Visibility',
  tr: 'AI Arama Görünürlüğü',
  ru: 'Видимость в AI поиске',
  sq: 'Dukshmëri AI',
  mk: 'АИ Пребарување',
  sr: 'AI Vidljivost',
  fa: 'دیده‌شدن در هوش مصنوعی',
};

const nativeLanguageNames: Record<Locale | 'fa', string> = {
  tr: 'Türkçe',
  en: 'English',
  ru: 'Русский',
  mk: 'Македонски',
  sr: 'Srpski',
  sq: 'Shqip',
  fa: 'فارسی',
};

const blogLabel = blogLabels[locale];
const aboutLabel = aboutLabels[locale];
const aiVisibilityLabel = aiVisibilityLabels[locale];

const navLabels = locale === 'fa'
  ? {
      ventures: 'ساختارها',
      expertise: 'تخصص',
      journey: 'درباره من',
      contact: 'تماس',
    }
  : {
      ventures: copy.nav?.ventures || 'Girişimler',
      expertise: copy.nav?.expertise || 'Uzmanlık',
      journey: aboutLabel,
      contact: copy.nav?.contact || 'İletişim',
    };
const a11y = locale === 'fa'
  ? { language:'انتخاب زبان', menuOpen:'باز کردن منو', menuClose:'بستن منو' }
  : copy.a11y;

const panelLabels = ({
  tr: { services: 'Hizmetler', approach: 'Yaklaşım', start: 'Birlikte çalışalım', email: 'E-posta gönder' },
  en: { services: 'Services', approach: 'Approach', start: 'Start a conversation', email: 'Send an email' },
  ru: { services: 'Проекты', approach: 'Подход', start: 'Обсудить задачу', email: 'Написать по email' },
  mk: { services: 'Потфати', approach: 'Пристап', start: 'Да разговараме', email: 'Испрати email' },
  sr: { services: 'Poduhvati', approach: 'Pristup', start: 'Započnimo razgovor', email: 'Pošalji email' },
  sq: { services: 'Sipërmarrjet', approach: 'Qasja', start: 'Nisni një bisedë', email: 'Dërgo email' },
  fa: { services: 'ساختارها', approach: 'رویکرد', start: 'شروع گفتگو', email: 'ارسال ایمیل' },
}[locale] || { services: 'Services', approach: 'Approach', start: 'Start a conversation', email: 'Send an email' });

const ctsegUrl = locale === 'tr'
  ? 'https://ctseg.com.tr/'
  : locale === 'fa'
    ? 'https://ctseg.com.tr/fa/tamin-beynolmelali-iran/'
    : 'https://ctseg.com.tr/en/';

const ventureSubItems = {
  tr: [
    { name: 'CTSEG', desc: 'Ana Ticaret ve Tedarik', url: ctsegUrl, external: true },
    { name: 'QCT Studio', desc: 'Dijital ve Teknoloji', url: 'https://qctstudio.com', external: true },
    { name: 'QCT Commerce', desc: 'Dijital Ticaret', url: 'https://qctcommerce.com', external: true },
    { name: 'Mythborn', desc: 'Tüketici Markası', url: 'https://mythborn.co', external: true },
  ],
  en: [
    { name: 'CTSEG', desc: 'Principal Trade & Sourcing', url: ctsegUrl, external: true },
    { name: 'QCT Studio', desc: 'Digital & Technology', url: 'https://qctstudio.com', external: true },
    { name: 'QCT Commerce', desc: 'Digital Commerce', url: 'https://qctcommerce.com', external: true },
    { name: 'Mythborn', desc: 'Consumer Brand', url: 'https://mythborn.co', external: true },
  ],
  ru: [
    { name: 'CTSEG', desc: 'Торговля и закупки', url: ctsegUrl, external: true },
    { name: 'QCT Studio', desc: 'Цифровые технологии', url: 'https://qctstudio.com', external: true },
    { name: 'QCT Commerce', desc: 'Цифровая коммерция', url: 'https://qctcommerce.com', external: true },
    { name: 'Mythborn', desc: 'Потребительский бренд', url: 'https://mythborn.co', external: true },
  ],
  mk: [
    { name: 'CTSEG', desc: 'Главна трговија и снабдување', url: ctsegUrl, external: true },
    { name: 'QCT Studio', desc: 'Дигитална технологија', url: 'https://qctstudio.com', external: true },
    { name: 'QCT Commerce', desc: 'Дигитална трговија', url: 'https://qctcommerce.com', external: true },
    { name: 'Mythborn', desc: 'Потрошувачки бренд', url: 'https://mythborn.co', external: true },
  ],
  sr: [
    { name: 'CTSEG', desc: 'Glavna trgovina i nabavka', url: ctsegUrl, external: true },
    { name: 'QCT Studio', desc: 'Digitalne tehnologije', url: 'https://qctstudio.com', external: true },
    { name: 'QCT Commerce', desc: 'Digitalna trgovina', url: 'https://qctcommerce.com', external: true },
    { name: 'Mythborn', desc: 'Potrošački brend', url: 'https://mythborn.co', external: true },
  ],
  sq: [
    { name: 'CTSEG', desc: 'Tregti & Furnizim Kryesor', url: ctsegUrl, external: true },
    { name: 'QCT Studio', desc: 'Teknologji & Digjitale', url: 'https://qctstudio.com', external: true },
    { name: 'QCT Commerce', desc: 'Tregti Digjitale', url: 'https://qctcommerce.com', external: true },
    { name: 'Mythborn', desc: 'Markë Konsumatore', url: 'https://mythborn.co', external: true },
  ],
  fa: [
    { name: 'CTSEG', desc: 'تجارت و تأمین اصلی', url: ctsegUrl, external: true },
    { name: 'QCT Studio', desc: 'فناوری و دیجیتال', url: 'https://qctstudio.com', external: true },
    { name: 'QCT Commerce', desc: 'تجارت دیجیتال', url: 'https://qctcommerce.com', external: true },
    { name: 'Mythborn', desc: 'برند مصرف‌کننده', url: 'https://mythborn.co', external: true },
  ]
}[locale] || ventureSubItems.en;

const expertiseSubItems = {
  tr: [
    { name: 'Uluslararası Ticaret', url: sectionUrl('expertise') },
    { name: 'Stratejik Tedarik', url: sectionUrl('expertise') },
    { name: 'Dijital Ticaret & Büyüme', url: sectionUrl('expertise') },
    { name: aiVisibilityLabel, url: aiVisibilityUrl },
  ],
  en: [
    { name: 'International Trade', url: sectionUrl('expertise') },
    { name: 'Strategic Sourcing', url: sectionUrl('expertise') },
    { name: 'Digital Commerce & Growth', url: sectionUrl('expertise') },
    { name: aiVisibilityLabel, url: aiVisibilityUrl },
  ],
  ru: [
    { name: 'Международная торговля', url: sectionUrl('expertise') },
    { name: 'Стратегические закупки', url: sectionUrl('expertise') },
    { name: 'Цифровая коммерция и рост', url: sectionUrl('expertise') },
    { name: aiVisibilityLabel, url: aiVisibilityUrl },
  ],
  mk: [
    { name: 'Меѓународна трговија', url: sectionUrl('expertise') },
    { name: 'Стратешко снабдување', url: sectionUrl('expertise') },
    { name: 'Дигитална трговија и раст', url: sectionUrl('expertise') },
    { name: aiVisibilityLabel, url: aiVisibilityUrl },
  ],
  sr: [
    { name: 'Međunarodna trgovina', url: sectionUrl('expertise') },
    { name: 'Strateška nabavka', url: sectionUrl('expertise') },
    { name: 'Digitalna trgovina i rast', url: sectionUrl('expertise') },
    { name: aiVisibilityLabel, url: aiVisibilityUrl },
  ],
  sq: [
    { name: 'Tregti Ndërkombëtare', url: sectionUrl('expertise') },
    { name: 'Furnizim Strategjik', url: sectionUrl('expertise') },
    { name: 'Tregti Digjitale & Rritje', url: sectionUrl('expertise') },
    { name: aiVisibilityLabel, url: aiVisibilityUrl },
  ],
  fa: [
    { name: 'تجارت بین‌المللی', url: sectionUrl('expertise') },
    { name: 'تأمین راهبردی', url: sectionUrl('expertise') },
    { name: 'تجارت دیجیتال و رشد', url: sectionUrl('expertise') },
    { name: aiVisibilityLabel, url: aiVisibilityUrl },
  ]
}[locale] || expertiseSubItems.en;

const allLocales: (Locale | 'fa')[] = ['tr', 'en', 'ru', 'sq', 'mk', 'sr', 'fa'];
---

<div class="mobile-menu-backdrop" data-menu-backdrop hidden></div>

<header class="site-header">
  <div class="header-container">
    <a class="brand" href={currentHomePath} aria-label="Teyfik Gökdemir">
      <picture class="brand__mark">
        <source media="(max-width: 760px)" srcset="/brand/teyfik-gokdemir-monogram.webp" type="image/webp" />
        <source media="(max-width: 760px)" srcset="/brand/teyfik-gokdemir-monogram.png" type="image/png" />
        <source srcset="/brand/teyfik-gokdemir-primary.webp" type="image/webp" />
        <img
          src="/brand/teyfik-gokdemir-primary.png"
          width="705"
          height="203"
          alt="Teyfik Gökdemir"
          decoding="async"
        />
      </picture>
    </a>

    <button
      class="menu-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="site-navigation"
      data-open-label={a11y.menuOpen}
      data-close-label={a11y.menuClose}
      aria-label={a11y.menuOpen}
      data-menu-toggle
    >
      <span></span><span></span><span></span>
    </button>

    <div class="header-panel" id="site-navigation" aria-hidden="true">
      <div class="mobile-nav-head">
        <div class="mobile-nav-brand">
          <span class="mobile-nav-title">TEYFİK GÖKDEMİR</span>
          <span class="mobile-nav-subtitle">{locale === 'en' ? 'MAIN MENU' : 'ANA MENÜ'}</span>
        </div>
        <button class="mobile-nav-close" type="button" aria-label={a11y.menuClose} data-mobile-close>
          <span aria-hidden="true">✕</span>
        </button>
      </div>

      <nav class="main-nav-content" aria-label="Main Navigation">
        <!-- Card Section 1: Language Switcher (Mythborn Grid Style) -->
        <div class="myth-card myth-card--lang">
          <div class="myth-card__head">
            <span class="myth-card__title">🌐 {a11y.language.toUpperCase()}</span>
            <span class="myth-card__badge">GLOBAL</span>
          </div>
          <div class="myth-lang-grid">
            {allLocales.map((item) => (
              <a
                href={languageUrls?.[item] ?? localeUrl(item)}
                lang={item}
                hreflang={item}
                aria-current={item === locale ? 'page' : undefined}
                class:list={['myth-lang-item', { 'is-active': item === locale }]}
              >
                <span class="myth-lang-code">{item.toUpperCase()}</span>
                <span class="myth-lang-name">{nativeLanguageNames[item]}</span>
              </a>
            ))}
          </div>
        </div>

        <!-- Card Section 2: Services / Yapılanma -->
        <div class="myth-card" data-dropdown>
          <button class="myth-card__trigger dropdown-trigger" type="button" aria-expanded="false">
            <span>{panelLabels.services}</span>
            <svg class="dropdown-arrow" width="10" height="6" viewBox="0 0 10 6" fill="none">
              <path d="M1 1L5 5L9 1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
          <div class="myth-card__body dropdown-menu">
            <div class="myth-grid-2">
              {ventureSubItems.map((item) => (
                <a href={item.url} target={item.external ? '_blank' : undefined} rel={item.external ? 'noopener noreferrer' : undefined} class="myth-grid-item">
                  <span class="myth-grid-item__name">{item.name}</span>
                  <span class="myth-grid-item__desc">{item.desc}</span>
                </a>
              ))}
            </div>
          </div>
        </div>

        <!-- Card Section 3: Approach / Uzmanlık -->
        <div class="myth-card" data-dropdown>
          <button class="myth-card__trigger dropdown-trigger" type="button" aria-expanded="false">
            <span>{panelLabels.approach}</span>
            <svg class="dropdown-arrow" width="10" height="6" viewBox="0 0 10 6" fill="none">
              <path d="M1 1L5 5L9 1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
          <div class="myth-card__body dropdown-menu">
            <div class="myth-list">
              {expertiseSubItems.map((item) => (
                <a href={item.url} class="myth-list-item">
                  <span>{item.name}</span>
                </a>
              ))}
            </div>
          </div>
        </div>

        <!-- Card Section 4: Navigation Links -->
        <div class="myth-card myth-card--links">
          <div class="myth-card__head">
            <span class="myth-card__title">{locale === 'tr' ? 'HIZLI ERİŞİM' : 'NAVIGATION'}</span>
          </div>
          <div class="myth-grid-2">
            <a href={reflexUrl} class="myth-grid-item myth-grid-item--highlight" aria-current={isReflexPage ? 'page' : undefined}>
              <span class="myth-grid-item__name">Reflex</span>
              <span class="myth-grid-item__desc">Medical Sourcing</span>
            </a>
            <a href={blogUrl} class="myth-grid-item">
              <span class="myth-grid-item__name">{blogLabel}</span>
              <span class="myth-grid-item__desc">Analysis & Articles</span>
            </a>
            <a href={sectionUrl('journey')} class="myth-grid-item">
              <span class="myth-grid-item__name">{aboutLabel}</span>
              <span class="myth-grid-item__desc">Background</span>
            </a>
            <a href={sectionUrl('contact')} class="myth-grid-item">
              <span class="myth-grid-item__name">{navLabels.contact}</span>
              <span class="myth-grid-item__desc">Direct Connect</span>
            </a>
          </div>
        </div>
      </nav>
    </div>
  </div>
</header>

<script is:inline>
  const toggle = document.querySelector('.menu-toggle');
  const panel = document.querySelector('.header-panel');
  const closeButton = document.querySelector('[data-mobile-close]');
  const backdrop = document.querySelector('[data-menu-backdrop], .mobile-menu-backdrop');
  let previousFocus = null;
  let previousScroll = 0;

  const focusable = () => panel ? [...panel.querySelectorAll('a[href], button:not([disabled])')].filter(el => !el.closest('[hidden]')) : [];

  const closeMobileMenu = () => {
    if (!panel || !panel.classList.contains('is-open')) return;
    toggle?.setAttribute('aria-expanded', 'false');
    panel.classList.remove('is-open');
    panel.setAttribute('aria-hidden', 'true');
    if (toggle?.dataset?.openLabel) toggle.setAttribute('aria-label', toggle.dataset.openLabel);
    if (backdrop) backdrop.hidden = true;
    document.body.classList.remove('has-open-menu', 'menu-is-open');
    window.scrollTo(0, previousScroll);
    if (previousFocus instanceof HTMLElement) previousFocus.focus({ preventScroll: true });
  };

  const openMobileMenu = () => {
    if (!toggle || toggle.getAttribute('aria-expanded') === 'true') return;
    previousScroll = window.scrollY;
    previousFocus = document.activeElement;
    toggle.setAttribute('aria-expanded', 'true');
    panel?.classList.add('is-open');
    panel?.setAttribute('aria-hidden', 'false');
    if (backdrop) backdrop.hidden = false;
    document.body.classList.add('has-open-menu', 'menu-is-open');
    if (toggle?.dataset?.closeLabel) toggle.setAttribute('aria-label', toggle.dataset.closeLabel);
    closeButton?.focus();
  };

  if (toggle && panel) {
    toggle.addEventListener('click', () => {
      const open = toggle.getAttribute('aria-expanded') === 'true';
      if (open) closeMobileMenu();
      else openMobileMenu();
    });
  }

  closeButton?.addEventListener('click', closeMobileMenu);
  backdrop?.addEventListener('click', closeMobileMenu);

  // Dropdown interactivity
  let lastOpenTrigger = null;
  document.querySelectorAll('[data-dropdown]').forEach((dropdown) => {
    const trigger = dropdown.querySelector('.dropdown-trigger');
    if (!trigger) return;

    trigger.addEventListener('click', (e) => {
      e.stopPropagation();
      const open = trigger.getAttribute('aria-expanded') === 'true';
      
      // Close other dropdowns
      document.querySelectorAll('[data-dropdown] .dropdown-trigger').forEach((other) => {
        if (other !== trigger) other.setAttribute('aria-expanded', 'false');
      });

      trigger.setAttribute('aria-expanded', String(!open));
      lastOpenTrigger = open ? null : trigger;
    });
  });

  document.querySelectorAll('.header-panel a').forEach((link) => {
    link.addEventListener('click', () => closeMobileMenu());
  });

  document.addEventListener('click', () => {
    document.querySelectorAll('[data-dropdown] .dropdown-trigger').forEach((trigger) => {
      trigger.setAttribute('aria-expanded', 'false');
    });
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && panel?.classList.contains('is-open')) {
      document.querySelectorAll('[data-dropdown] .dropdown-trigger').forEach((trigger) => {
        trigger.setAttribute('aria-expanded', 'false');
      });
      closeMobileMenu();
    }
    if (e.key === 'Tab' && panel?.classList.contains('is-open')) {
      const items = focusable();
      if (items.length > 0) {
        const first = items[0];
        const last = items[items.length - 1];
        if (e.shiftKey && document.activeElement === first) {
          e.preventDefault();
          last.focus();
        } else if (!e.shiftKey && document.activeElement === last) {
          e.preventDefault();
          first.focus();
        }
      }
    }
  });
</script>

<style is:global>
  .mobile-menu-backdrop {
    position: fixed !important;
    inset: 0 !important;
    z-index: 135 !important;
    background: rgba(0, 0, 0, 0.65) !important;
    backdrop-filter: blur(4px) !important;
  }
  .mobile-menu-backdrop[hidden] {
    display: none !important;
  }

  body.has-open-menu {
    overflow: hidden !important;
    overscroll-behavior: none !important;
  }

  /* Desktop Header Styling */
  .site-header {
    height: 80px;
    background: rgba(25, 21, 18, 0.94);
    backdrop-filter: blur(16px);
    border-bottom: 1px solid rgba(201, 191, 178, 0.12);
    position: sticky;
    top: 0;
    z-index: 110;
    display: flex;
    align-items: center;
  }

  .header-container {
    width: 100%;
    max-width: 1320px;
    margin-inline: auto;
    padding-inline: clamp(1.25rem, 3vw, 2.5rem);
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
    line-height: 1;
  }

  .brand__mark img {
    height: 38px !important;
    width: auto !important;
    max-width: 220px !important;
    object-fit: contain !important;
    display: block !important;
  }

  .menu-toggle {
    display: none;
  }

  .header-panel {
    display: flex;
    align-items: center;
  }

  .main-nav-content {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  /* Mythborn Card System */
  .myth-card {
    background: transparent;
    position: relative;
  }

  .myth-card__trigger {
    background: transparent;
    border: none;
    color: #e5ded4;
    font-size: 0.92rem;
    font-weight: 600;
    padding: 8px 12px;
    border-radius: 8px;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 6px;
    transition: all 180ms ease;
  }

  .myth-card__trigger:hover,
  .myth-card__trigger[aria-expanded="true"] {
    color: #ffffff;
    background: rgba(201, 191, 178, 0.08);
  }

  .dropdown-arrow {
    transition: transform 200ms ease;
  }

  .myth-card__trigger[aria-expanded="true"] .dropdown-arrow {
    transform: rotate(180deg);
  }

  .myth-card__body {
    position: absolute;
    top: calc(100% + 10px);
    left: 0;
    min-width: 320px;
    background: rgba(22, 18, 15, 0.98);
    backdrop-filter: blur(20px);
    border: 1px solid rgba(201, 191, 178, 0.15);
    border-radius: 16px;
    padding: 12px;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.5);
    display: none;
    z-index: 120;
  }

  .myth-card__trigger[aria-expanded="true"] + .myth-card__body {
    display: block;
  }

  .myth-grid-2 {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 8px;
  }

  .myth-grid-item {
    display: flex;
    flex-direction: column;
    padding: 10px 12px;
    border-radius: 10px;
    background: rgba(201, 191, 178, 0.04);
    border: 1px solid rgba(201, 191, 178, 0.08);
    text-decoration: none;
    transition: all 180ms ease;
  }

  .myth-grid-item:hover {
    background: rgba(201, 191, 178, 0.12);
    border-color: rgba(215, 130, 99, 0.4);
  }

  .myth-grid-item__name {
    font-size: 0.88rem;
    font-weight: 700;
    color: #ffffff;
  }

  .myth-grid-item__desc {
