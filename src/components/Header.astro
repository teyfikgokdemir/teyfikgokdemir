---
import { localeNames, locales, type Locale } from '../i18n/locales';
import type { SiteContent } from '../i18n/content';

interface Props {
  locale: Locale | 'fa';
  copy: SiteContent;
  homePath?: string;
  languageUrls?: Partial<Record<Locale | 'fa', string>>;
}

const { locale, copy, homePath, languageUrls } = Astro.props;

const localeUrl = (item: Locale | 'fa') => `/${item}/`;
const currentHomePath = homePath ?? localeUrl(locale);
const sectionUrl = (section: string) => `${currentHomePath}#${section}`;

const aiVisibilityUrls: Record<Locale | 'fa', string> = {
  en: '/ai-search-visibility/',
  tr: '/tr/yapay-zeka-arama-gorunurlugu/',
  sq: '/sq/dukshmeria-ne-kerkimin-ai/',
  mk: '/mk/vidlivost-vo-ai-prebaruvanje/',
  sr: '/sr/vidljivost-u-ai-pretrazi/',
  fa: '/fa/مشاهده-پذیری-در-جستجوی-هوش-مصنوعی/',
};

const blogUrls: Record<Locale | 'fa', string> = {
  en: '/blog/',
  tr: '/tr/blog/',
  sq: '/sq/blog/',
  mk: '/mk/blog/',
  sr: '/sr/blog/',
  fa: '/fa/blog/',
};

const reflexUrls: Record<Locale | 'fa', string> = {
  en: '/en/reflex/',
  tr: '/tr/reflex/',
  sq: '/sq/reflex/',
  mk: '/mk/reflex/',
  sr: '/sr/reflex/',
  fa: '/fa/reflex/',
};

const reflexUrl = reflexUrls[locale];
const isReflexPage = Astro.url.pathname.includes('/reflex/');
const aiVisibilityUrl = aiVisibilityUrls[locale];
const blogUrl = blogUrls[locale];

const aiVisibilityLabels: Record<Locale | 'fa', string> = {
  en: 'AI Visibility',
  tr: 'AI Görünürlüğü',
  sq: 'Dukshmëri AI',
  mk: 'АИ Видливост',
  sr: 'AI Vidljivost',
  fa: 'دیده‌شدن در هوش مصنوعی',
};

const blogLabels: Record<Locale | 'fa', string> = {
  en: 'Insights',
  tr: 'Blog',
  sq: 'Artikuj',
  mk: 'Блог',
  sr: 'Blog',
  fa: 'بینش‌ها',
};

const aiVisibilityLabel = aiVisibilityLabels[locale];
const blogLabel = blogLabels[locale];
const navLabels = locale === 'fa'
  ? {
      ventures: 'ساختارها',
      expertise: 'تخصص',
      journey: 'مسیر',
      contact: 'تماس',
    }
  : copy.nav;
const a11y = locale === 'fa'
  ? { language:'انتخاب زبان', menuOpen:'باز کردن منو', menuClose:'بستن منو' }
  : copy.a11y;

---
<header class="site-header">
  <a class="brand" href={currentHomePath} aria-label="Teyfik Gökdemir">
    <picture class="brand__mark">
      <source media="(max-width: 760px)" srcset="/brand/teyfik-gokdemir-monogram.webp" type="image/webp" />
      <source media="(max-width: 760px)" srcset="/brand/teyfik-gokdemir-monogram.png" type="image/png" />
      <source srcset="/brand/teyfik-gokdemir-primary.webp" type="image/webp" />
      <img
        src="/brand/teyfik-gokdemir-primary.png"
        width="705"
        height="203"
        alt="Teyfik Gökdemir"
        decoding="async"
      />
    </picture>
  </a>

  <button
    class="menu-toggle"
    type="button"
    aria-expanded="false"
    aria-controls="site-navigation"
    data-open-label={a11y.menuOpen}
    data-close-label={a11y.menuClose}
    aria-label={a11y.menuOpen}
  >
    <span></span><span></span><span></span>
  </button>

  <div class="header-panel" id="site-navigation">
    <nav aria-label={navLabels.ventures}>
      <a href={sectionUrl('ventures')}>{navLabels.ventures}</a>
      <a href={sectionUrl('expertise')}>{navLabels.expertise}</a>
      <a href={reflexUrl} aria-current={isReflexPage ? 'page' : undefined}>Reflex</a>
      <a href={aiVisibilityUrl}>{aiVisibilityLabel}</a>
      <a href={blogUrl}>{blogLabel}</a>
      <a href={sectionUrl('journey')}>{navLabels.journey}</a>
      <a href={sectionUrl('contact')}>{navLabels.contact}</a>
    </nav>

    <div class="language-switcher" aria-label={a11y.language}>
      {locales.map((item) => (
        <a
          href={languageUrls?.[item] ?? localeUrl(item)}
          lang={item}
          hreflang={item}
          aria-current={item === locale ? 'page' : undefined}
          title={localeNames[item]}
        >
          {item.toUpperCase()}
        </a>
      ))}
    </div>
  </div>
</header>

<script is:inline>
  const toggle = document.querySelector('.menu-toggle');
  const panel = document.querySelector('.header-panel');
  const header = document.querySelector('.site-header');

  if (header) {
    const updateHeader = () => header.classList.toggle('is-scrolled', window.scrollY > 12);
    updateHeader();
    window.addEventListener('scroll', updateHeader, { passive: true });
  }

  if (toggle && panel) {
    const closeMenu = () => {
      toggle.setAttribute('aria-expanded', 'false');
      toggle.setAttribute('aria-label', toggle.dataset.openLabel);
      panel.classList.remove('is-open');
    };

    toggle.addEventListener('click', () => {
      const expanded = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded', String(!expanded));
      toggle.setAttribute(
        'aria-label',
        expanded ? toggle.dataset.openLabel : toggle.dataset.closeLabel
      );
      panel.classList.toggle('is-open', !expanded);
    });

    panel.querySelectorAll('a').forEach((link) =>
      link.addEventListener('click', closeMenu)
    );

    document.addEventListener('keydown', (event) => {
      if (
        event.key === 'Escape' &&
        toggle.getAttribute('aria-expanded') === 'true'
      ) {
        closeMenu();
        toggle.focus();
      }
    });
  }
</script>

<style>
  .brand__mark {
    display: block;
    width: clamp(10.5rem, 13.2vw, 11.5rem);
    flex: 0 0 auto;
    direction: ltr;
    unicode-bidi: isolate;
  }

  .brand__mark img {
    width: 100%;
    height: auto;
    aspect-ratio: 705 / 203;
    object-fit: contain;
  }

  @media (max-width: 760px) {
    .brand__mark {
      width: 46px;
      height: 46px;
    }

    .brand__mark img {
      width: 46px;
      height: 46px;
      aspect-ratio: 1;
    }
  }
</style>
