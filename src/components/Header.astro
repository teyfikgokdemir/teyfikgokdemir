---
import { localeNames, locales, type Locale } from '../i18n/locales';
import type { SiteContent } from '../i18n/content';
import { site } from '../data/site';

interface Props {
  locale: Locale | 'fa';
  copy: SiteContent;
  homePath?: string;
  languageUrls?: Partial<Record<Locale | 'fa', string>>;
}

const { locale, copy, homePath, languageUrls } = Astro.props;

const localeUrl = (item: Locale | 'fa') => item === 'tr' ? '/' : `/${item}/`;
const currentHomePath = homePath ?? localeUrl(locale);
const sectionUrl = (section: string) => `${currentHomePath}#${section}`;

const aiVisibilityUrls: Record<Locale | 'fa', string> = {
  en: '/ai-search-visibility/',
  tr: '/yapay-zeka-arama-gorunurlugu/',
  ru: '/ru/ai-search-visibility/',
  sq: '/sq/dukshmeria-ne-kerkimin-ai/',
  mk: '/mk/vidlivost-vo-ai-prebaruvanje/',
  sr: '/sr/vidljivost-u-ai-pretrazi/',
  fa: '/fa/مشاهده-پذیری-در-جستجوی-هوش-مصنوعی/',
};

const blogUrls: Record<Locale | 'fa', string> = {
  en: '/blog/',
  tr: '/blog/',
  ru: '/ru/blog/',
  sq: '/sq/blog/',
  mk: '/mk/blog/',
  sr: '/sr/blog/',
  fa: '/fa/blog/',
};

const reflexUrls: Record<Locale | 'fa', string> = {
  en: '/en/reflex/',
  tr: '/reflex/',
  ru: '/ru/reflex/',
  sq: '/sq/reflex/',
  mk: '/mk/reflex/',
  sr: '/sr/reflex/',
  fa: '/fa/reflex/',
};

const reflexUrl = reflexUrls[locale];
const isReflexPage = Astro.url.pathname.includes('/reflex/');
const aiVisibilityUrl = aiVisibilityUrls[locale];
const blogUrl = blogUrls[locale];

const blogLabels: Record<Locale | 'fa', string> = {
  en: 'Insights',
  tr: 'İçgörüler',
  ru: 'Аналитика',
  sq: 'Analiza',
  mk: 'Увид',
  sr: 'Uvidi',
  fa: 'بینش‌ها',
};

const aboutLabels: Record<Locale | 'fa', string> = {
  en: 'About',
  tr: 'Hakkımda',
  ru: 'Обо мне',
  sq: 'Rreth meje',
  mk: 'За мене',
  sr: 'O meni',
  fa: 'درباره من',
};

const aiVisibilityLabels: Record<Locale | 'fa', string> = {
  en: 'AI Search Visibility',
  tr: 'AI Arama Görünürlüğü',
  ru: 'Видимость в AI поиске',
  sq: 'Dukshmëri AI',
  mk: 'АИ Пребарување',
  sr: 'AI Vidljivost',
  fa: 'دیده‌شدن در هوش مصنوعی',
};

const nativeLanguageNames: Record<Locale | 'fa', string> = {
  tr: 'Türkçe',
  en: 'English',
  ru: 'Русский',
  mk: 'Македонски',
  sr: 'Srpski',
  sq: 'Shqip',
  fa: 'فارسی',
};

const blogLabel = blogLabels[locale];
const aboutLabel = aboutLabels[locale];
const aiVisibilityLabel = aiVisibilityLabels[locale];

const navLabels = locale === 'fa'
  ? { ventures: 'ساختارها', expertise: 'تخصص', journey: 'درباره من', contact: 'تماس' }
  : { ventures: copy.nav?.ventures || 'Girişimler', expertise: copy.nav?.expertise || 'Uzmanlık', journey: aboutLabel, contact: copy.nav?.contact || 'İletişim' };

const a11y = locale === 'fa'
  ? { language:'انتخاب زبان', menuOpen:'باز کردن منو', menuClose:'بستن منو' }
  : copy.a11y;

const panelLabels = ({
  tr: { services: 'Hizmetler', approach: 'Uzmanlık', start: 'Birlikte çalışalım', email: 'E-posta gönder' },
  en: { services: 'Services', approach: 'Expertise', start: 'Start a conversation', email: 'Send an email' },
  ru: { services: 'Проекты', approach: 'Подход', start: 'Обсудить задачу', email: 'Написать по email' },
  mk: { services: 'Потфати', approach: 'Пристап', start: 'Да разговараме', email: 'Испрати email' },
  sr: { services: 'Poduhvati', approach: 'Pristup', start: 'Započnimo razgovor', email: 'Pošalji email' },
  sq: { services: 'Sipërmarrjet', approach: 'Qasja', start: 'Nisni një bisedë', email: 'Dërgo email' },
  fa: { services: 'ساختارها', approach: 'رویکرد', start: 'شروع گفتگو', email: 'ارسال ایمیل' },
}[locale] || { services: 'Services', approach: 'Expertise', start: 'Start a conversation', email: 'Send an email' });

const ctsegUrl = locale === 'tr'
  ? 'https://ctseg.com.tr/'
  : locale === 'fa'
    ? 'https://ctseg.com.tr/fa/tamin-beynolmelali-iran/'
    : 'https://ctseg.com.tr/en/';

const ventureSubItems = [
  { name: 'CTSEG', desc: locale === 'tr' ? 'Uluslararası Ticaret ve Tedarik' : 'International Trade & Sourcing', url: ctsegUrl, external: true },
  { name: 'QCT Studio', desc: locale === 'tr' ? 'Balkanlar Dijital ve Yazılım' : 'Balkan Digital & Software', url: 'https://qctstudio.com', external: true },
  { name: 'QCT Commerce', desc: locale === 'tr' ? 'E-Ticaret ve Büyüme Sistemleri' : 'E-Commerce & Digital Growth', url: 'https://qctcommerce.com', external: true },
  { name: 'Reflex Medical', desc: locale === 'tr' ? 'Medikal Tedarik ve İhracat' : 'Medical Sourcing & Export', url: reflexUrl, external: false },
];

const expertiseSubItems = [
  { name: locale === 'tr' ? 'Uluslararası Ticaret' : 'International Trade', url: sectionUrl('expertise') },
  { name: locale === 'tr' ? 'Stratejik Tedarik' : 'Strategic Sourcing', url: sectionUrl('expertise') },
  { name: locale === 'tr' ? 'Dijital Ticaret & Büyüme' : 'Digital Commerce & Growth', url: sectionUrl('expertise') },
  { name: aiVisibilityLabel, url: aiVisibilityUrl },
];

const allLocales: (Locale | 'fa')[] = ['tr', 'en', 'ru', 'sq', 'mk', 'sr', 'fa'];
---

<div class="mobile-menu-backdrop" data-menu-backdrop hidden></div>

<header class="site-header">
  <div class="header-container">
    <!-- Brand Logo -->
    <a class="brand" href={currentHomePath} aria-label="Teyfik Gökdemir">
      <picture class="brand__mark">
        <source media="(max-width: 760px)" srcset="/brand/teyfik-gokdemir-monogram.webp" type="image/webp" />
        <source media="(max-width: 760px)" srcset="/brand/teyfik-gokdemir-monogram.png" type="image/png" />
        <source srcset="/brand/teyfik-gokdemir-primary.webp" type="image/webp" />
        <img
          src="/brand/teyfik-gokdemir-primary.png"
          width="705"
          height="203"
          alt="Teyfik Gökdemir"
          decoding="async"
        />
      </picture>
    </a>

    <!-- Hamburger Toggle (Mobile Only) -->
    <button
      class="menu-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="mobile-navigation"
      data-menu-toggle
      aria-label={a11y.menuOpen}
    >
      <span></span><span></span><span></span>
    </button>

    <!-- Desktop Navigation Bar (Desktop Only) -->
    <nav class="desktop-nav" aria-label="Desktop Navigation">
      <div class="desktop-nav-item" data-dropdown>
        <button class="desktop-nav-btn dropdown-trigger" type="button" aria-expanded="false">
          <span>{panelLabels.services}</span>
          <svg width="9" height="5" viewBox="0 0 9 5" fill="none"><path d="M1 1L4.5 4L8 1" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        <div class="desktop-dropdown-menu dropdown-menu">
          {ventureSubItems.map((item) => (
            <a href={item.url} target={item.external ? '_blank' : undefined} rel={item.external ? 'noopener noreferrer' : undefined} class="desktop-dropdown-link">
              <strong>{item.name}</strong>
              <small>{item.desc}</small>
            </a>
          ))}
        </div>
      </div>

      <div class="desktop-nav-item" data-dropdown>
        <button class="desktop-nav-btn dropdown-trigger" type="button" aria-expanded="false">
          <span>{panelLabels.approach}</span>
          <svg width="9" height="5" viewBox="0 0 9 5" fill="none"><path d="M1 1L4.5 4L8 1" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        <div class="desktop-dropdown-menu dropdown-menu">
          {expertiseSubItems.map((item) => (
            <a href={item.url} class="desktop-dropdown-link">
              <strong>{item.name}</strong>
            </a>
          ))}
        </div>
      </div>

      <a href={reflexUrl} class="desktop-nav-link" aria-current={isReflexPage ? 'page' : undefined}>Reflex</a>
      <a href={blogUrl} class="desktop-nav-link">{blogLabel}</a>
      <a href={sectionUrl('journey')} class="desktop-nav-link">{aboutLabel}</a>
      <a href={sectionUrl('contact')} class="desktop-nav-link">{navLabels.contact}</a>

      <!-- Desktop Language Dropdown -->
      <div class="desktop-nav-item lang-item" data-dropdown>
        <button class="desktop-nav-btn lang-btn dropdown-trigger" type="button" aria-expanded="false">
          <span>{locale.toUpperCase()}</span>
          <svg width="9" height="5" viewBox="0 0 9 5" fill="none"><path d="M1 1L4.5 4L8 1" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        <div class="desktop-dropdown-menu lang-menu dropdown-menu">
          {locales.map((item) => (
            <a href={languageUrls?.[item] ?? localeUrl(item)} class:list={['desktop-lang-link', { active: item === locale }]}>
              <span>{nativeLanguageNames[item]}</span>
              <strong>{item.toUpperCase()}</strong>
            </a>
          ))}
        </div>
      </div>
    </nav>
  </div>

  <!-- Mobile Navigation Panel (Mobile Only) -->
  <div class="mobile-panel" id="mobile-navigation" aria-hidden="true">
    <div class="mobile-panel-head">
      <div class="mobile-panel-brand">
        <span class="mobile-panel-title">TEYFİK GÖKDEMİR</span>
        <span class="mobile-panel-subtitle">{locale === 'en' ? 'MAIN MENU' : 'ANA MENÜ'}</span>
      </div>
      <button class="mobile-panel-close" type="button" aria-label={a11y.menuClose} data-mobile-close>
        <span aria-hidden="true">✕</span>
      </button>
    </div>

    <div class="mobile-panel-body">
      <!-- Mythborn Card 1: Language Switcher -->
      <div class="myth-card">
        <div class="myth-card-header">
          <span class="myth-card-title">🌐 {a11y.language.toUpperCase()}</span>
          <span class="myth-card-tag">GLOBAL</span>
        </div>
        <div class="myth-lang-grid">
          {allLocales.map((item) => (
            <a
              href={languageUrls?.[item] ?? localeUrl(item)}
              lang={item}
              hreflang={item}
              aria-current={item === locale ? 'page' : undefined}
              class:list={['myth-lang-btn', { active: item === locale }]}
            >
              <span class="code">{item.toUpperCase()}</span>
              <span class="name">{nativeLanguageNames[item]}</span>
            </a>
          ))}
        </div>
      </div>

      <!-- Mythborn Card 2: Services / Yapılanma -->
      <div class="myth-card" data-dropdown>
        <button class="myth-card-trigger dropdown-trigger" type="button" aria-expanded="false">
          <span>{panelLabels.services}</span>
          <svg width="10" height="6" viewBox="0 0 10 6" fill="none"><path d="M1 1L5 5L9 1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        <div class="myth-card-content dropdown-menu">
          <div class="myth-sub-grid">
            {ventureSubItems.map((item) => (
              <a href={item.url} target={item.external ? '_blank' : undefined} rel={item.external ? 'noopener noreferrer' : undefined} class="myth-sub-item">
                <strong class="title">{item.name}</strong>
                <span class="desc">{item.desc}</span>
              </a>
            ))}
          </div>
        </div>
      </div>

      <!-- Mythborn Card 3: Approach / Uzmanlık -->
      <div class="myth-card" data-dropdown>
        <button class="myth-card-trigger dropdown-trigger" type="button" aria-expanded="false">
          <span>{panelLabels.approach}</span>
          <svg width="10" height="6" viewBox="0 0 10 6" fill="none"><path d="M1 1L5 5L9 1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        <div class="myth-card-content dropdown-menu">
          <div class="myth-sub-list">
            {expertiseSubItems.map((item) => (
              <a href={item.url} class="myth-sub-link">
                <span>{item.name}</span>
              </a>
            ))}
          </div>
        </div>
      </div>

      <!-- Mythborn Card 4: Quick Navigation -->
      <div class="myth-card">
        <div class="myth-card-header">
          <span class="myth-card-title">{locale === 'tr' ? 'HIZLI ERİŞİM' : 'NAVIGATION'}</span>
        </div>
        <div class="myth-sub-grid">
          <a href={reflexUrl} class="myth-sub-item myth-sub-item--highlight" aria-current={isReflexPage ? 'page' : undefined}>
            <strong class="title">Reflex</strong>
            <span class="desc">Medical Sourcing</span>
          </a>
          <a href={blogUrl} class="myth-sub-item">
            <strong class="title">{blogLabel}</strong>
            <span class="desc">Analysis & Articles</span>
          </a>
          <a href={sectionUrl('journey')} class="myth-sub-item">
            <strong class="title">{aboutLabel}</strong>
            <span class="desc">Background</span>
          </a>
          <a href={sectionUrl('contact')} class="myth-sub-item">
            <strong class="title">{navLabels.contact}</strong>
            <span class="desc">Direct Connect</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</header>

<script is:inline>
  const toggle = document.querySelector('[data-menu-toggle]');
  const panel = document.querySelector('.mobile-panel');
  const closeButton = document.querySelector('[data-mobile-close]');
  const backdrop = document.querySelector('[data-menu-backdrop]');
  let previousFocus = null;
  let previousScroll = 0;

  const focusable = () => panel ? [...panel.querySelectorAll('a[href], button:not([disabled])')].filter(el => !el.closest('[hidden]')) : [];

  const closeMobileMenu = () => {
    if (!panel || !panel.classList.contains('is-open')) return;
    toggle?.setAttribute('aria-expanded', 'false');
    panel.classList.remove('is-open');
    panel.setAttribute('aria-hidden', 'true');
    if (backdrop) backdrop.hidden = true;
    document.body.classList.remove('has-open-menu');
    window.scrollTo(0, previousScroll);
    if (previousFocus instanceof HTMLElement) previousFocus.focus({ preventScroll: true });
  };

  const openMobileMenu = () => {
    if (!toggle || toggle.getAttribute('aria-expanded') === 'true') return;
    previousScroll = window.scrollY;
    previousFocus = document.activeElement;
    toggle.setAttribute('aria-expanded', 'true');
    panel?.classList.add('is-open');
    panel?.setAttribute('aria-hidden', 'false');
    if (backdrop) backdrop.hidden = false;
    document.body.classList.add('has-open-menu');
    closeButton?.focus();
  };

  if (toggle && panel) {
    toggle.addEventListener('click', () => {
      const open = toggle.getAttribute('aria-expanded') === 'true';
      if (open) closeMobileMenu();
      else openMobileMenu();
    });
  }

  closeButton?.addEventListener('click', closeMobileMenu);
  backdrop?.addEventListener('click', closeMobileMenu);

  // Dropdowns (Desktop & Mobile)
  document.querySelectorAll('[data-dropdown]').forEach((dropdown) => {
    const trigger = dropdown.querySelector('.dropdown-trigger');
    if (!trigger) return;

    trigger.addEventListener('click', (e) => {
      e.stopPropagation();
      const open = trigger.getAttribute('aria-expanded') === 'true';
      document.querySelectorAll('[data-dropdown] .dropdown-trigger').forEach((other) => {
        if (other !== trigger) other.setAttribute('aria-expanded', 'false');
      });
      trigger.setAttribute('aria-expanded', String(!open));
    });
  });

  document.querySelectorAll('.mobile-panel a').forEach((link) => {
    link.addEventListener('click', () => closeMobileMenu());
  });

  document.addEventListener('click', () => {
    document.querySelectorAll('[data-dropdown] .dropdown-trigger').forEach((trigger) => {
      trigger.setAttribute('aria-expanded', 'false');
    });
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      document.querySelectorAll('[data-dropdown] .dropdown-trigger').forEach((trigger) => {
        trigger.setAttribute('aria-expanded', 'false');
      });
      if (panel?.classList.contains('is-open')) closeMobileMenu();
    }
    if (e.key === 'Tab' && panel?.classList.contains('is-open')) {
      const items = focusable();
      if (items.length > 0) {
        const first = items[0];
        const last = items[items.length - 1];
        if (e.shiftKey && document.activeElement === first) {
          e.preventDefault();
          last.focus();
        } else if (!e.shiftKey && document.activeElement === last) {
          e.preventDefault();
          first.focus();
        }
      }
    }
  });
</script>

<style is:global>
  /* Backdrop & Scroll Lock */
  .mobile-menu-backdrop {
    position: fixed !important;
    inset: 0 !important;
    z-index: 135 !important;
    background: rgba(0, 0, 0, 0.72) !important;
    backdrop-filter: blur(6px) !important;
  }
  .mobile-menu-backdrop[hidden] {
    display: none !important;
  }

  body.has-open-menu {
    overflow: hidden !important;
    overscroll-behavior: none !important;
  }

  /* Sticky Desktop Header */
  .site-header {
    height: 80px;
    background: #191512;
    border-bottom: 1px solid rgba(201, 191, 178, 0.15);
    position: sticky;
    top: 0;
    z-index: 110;
    display: flex;
    align-items: center;
  }

  .header-container {
    width: 100%;
    max-width: 1320px;
    margin-inline: auto;
    padding-inline: clamp(1.25rem, 3vw, 2.5rem);
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
  }

  .brand__mark img {
    height: 38px !important;
    width: auto !important;
    max-width: 220px !important;
    object-fit: contain !important;
    display: block !important;
  }

  .menu-toggle {
    display: none;
  }

  /* Desktop Navigation Styling */
  .desktop-nav {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .desktop-nav-link {
    color: #c9bfb2;
    font-size: 0.9rem;
    font-weight: 600;
    text-decoration: none;
    transition: color 180ms ease;
  }

  .desktop-nav-link:hover,
  .desktop-nav-link[aria-current="page"] {
    color: #ffffff;
  }

  .desktop-nav-item {
    position: relative;
  }

  .desktop-nav-btn {
    background: transparent;
    border: none;
    color: #c9bfb2;
    font-size: 0.9rem;
    font-weight: 600;
    padding: 6px 10px;
    border-radius: 8px;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 5px;
    transition: all 180ms ease;
  }

  .desktop-nav-btn:hover,
  .desktop-nav-btn[aria-expanded="true"] {
    color: #ffffff;
    background: rgba(201, 191, 178, 0.08);
  }

  .desktop-dropdown-menu {
    position: absolute;
    top: calc(100% + 10px);
    left: 0;
    min-width: 260px;
    background: #1c1815;
    border: 1px solid rgba(201, 191, 178, 0.2);
    border-radius: 14px;
    padding: 10px;
    box-shadow: 0 20px 48px rgba(0, 0, 0, 0.5);
    display: none;
    flex-direction: column;
    gap: 4px;
    z-index: 120;
  }

  .desktop-nav-btn[aria-expanded="true"] + .desktop-dropdown-menu {
    display: flex;
  }

  .desktop-dropdown-link {
    display: flex;
    flex-direction: column;
    padding: 8px 12px;
    border-radius: 8px;
    text-decoration: none;
    background: transparent;
    transition: background 150ms ease;
  }

  .desktop-dropdown-link:hover {
    background: rgba(201, 191, 178, 0.1);
  }

  .desktop-dropdown-link strong {
    font-size: 0.88rem;
    color: #ffffff;
  }

  .desktop-dropdown-link small {
    font-size: 0.75rem;
    color: rgba(201, 191, 178, 0.7);
  }

  .lang-item .desktop-dropdown-menu {
    min-width: 180px;
    right: 0;
    left: auto;
  }

  .desktop-lang-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 8px 12px;
    border-radius: 8px;
    color: #c9bfb2;
    text-decoration: none;
    font-size: 0.84rem;
    transition: background 150ms ease, color 150ms ease;
  }

  .desktop-lang-link:hover,
  .desktop-lang-link.active {
    background: rgba(215, 130, 99, 0.2);
    color: #d78263;
  }

  /* Mobile Panel Styling (Mobile Only) */
  .mobile-panel {
    display: none;
  }

  @media (max-width: 1000px) {
    .desktop-nav {
      display: none !important;
    }

    .menu-toggle {
      display: grid !important;
      place-items: center !important;
      width: 44px !important;
      height: 44px !important;
      padding: 8px !important;
      border: 1px solid rgba(201, 191, 178, 0.25) !important;
      border-radius: 10px !important;
      background: rgba(201, 191, 178, 0.08) !important;
      cursor: pointer !important;
    }

    .menu-toggle span {
      display: block !important;
      width: 20px !important;
      height: 2px !important;
      margin: 2px 0 !important;
      background: #ffffff !important;
      border-radius: 2px !important;
    }

    .mobile-panel {
      position: fixed !important;
      inset: 0 !important;
      z-index: 140 !important;
      width: 100% !important;
      height: 100dvh !important;
      background: #14110e !important;
      overflow-y: auto !important;
      overscroll-behavior: contain !important;
      padding: 16px 16px 36px !important;
      display: flex !important;
      flex-direction: column !important;
      gap: 16px !important;
      opacity: 0 !important;
      visibility: hidden !important;
      pointer-events: none !important;
      transform: translateY(-8px) !important;
      transition: opacity 200ms ease, transform 200ms ease, visibility 200ms ease !important;
    }

    .mobile-panel.is-open {
      opacity: 1 !important;
      visibility: visible !important;
      pointer-events: auto !important;
      transform: translateY(0) !important;
    }

    .mobile-panel-head {
      display: flex !important;
      align-items: center !important;
      justify-content: space-between !important;
      padding-bottom: 12px !important;
      border-bottom: 1px solid rgba(201, 191, 178, 0.2) !important;
    }

    .mobile-panel-brand {
      display: flex;
      flex-direction: column;
    }

    .mobile-panel-title {
      font-size: 0.9rem !important;
      font-weight: 800 !important;
      letter-spacing: 0.06em !important;
      color: #ffffff !important;
    }

    .mobile-panel-subtitle {
      font-size: 0.7rem !important;
      font-weight: 600 !important;
      letter-spacing: 0.1em !important;
      color: #d78263 !important;
    }

    .mobile-panel-close {
      width: 44px !important;
      height: 44px !important;
