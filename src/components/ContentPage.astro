---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import FloatingActions from './FloatingActions.astro';
import type { Locale } from '../i18n/locales';
import { content } from '../i18n/content';

interface Props {
  locale: Locale | 'fa';
  title: string;
  description: string;
  pathname: string;
  eyebrow: string;
  heading: string;
  lead: string;
  alternates?: Partial<Record<Locale | 'fa' | 'x-default', string>>;
  ogType?: 'website' | 'article';
  pageSchema?: Record<string, unknown>;
  articleMeta?: {
    published: string;
    modified: string;
    readingTime: string;
    label: string;
  };
}

const {
  locale,
  title,
  description,
  pathname,
  eyebrow,
  heading,
  lead,
  alternates,
  ogType = 'website',
  pageSchema,
  articleMeta,
} = Astro.props;

const copy = content[locale as Locale] ?? content.en;
const homePath = `/${locale}/`;
---
<BaseLayout
  locale={locale as Locale}
  copy={copy}
  title={title}
  description={description}
  pathname={pathname}
  alternates={alternates}
  ogType={ogType}
  pageSchema={pageSchema}
>
  <Header locale={locale as Locale} copy={copy} homePath={homePath} languageUrls={alternates} />

  <main id="main-content" class="content-page">
    <header class="content-hero" id="top">
      <div class="content-shell">
        <nav class="content-breadcrumb" aria-label="Breadcrumb">
          <a href={homePath}>{locale === 'tr' ? 'Ana sayfa' : locale === 'fa' ? 'خانه' : 'Home'}</a>
          <span aria-hidden="true">/</span>
          <span>{eyebrow}</span>
        </nav>

        <p class="section-label">{eyebrow}</p>
        <h1>{heading}</h1>
        <p class="content-lead">{lead}</p>

        {articleMeta && (
          <div class="article-meta">
            <span>{articleMeta.label}</span>
            <time datetime={articleMeta.published}>{articleMeta.published}</time>
            <span>{articleMeta.readingTime}</span>
          </div>
        )}
      </div>
    </header>

    <div class="content-shell content-body">
      <slot />
    </div>
  </main>

  <Footer copy={copy} locale={locale} />
  <FloatingActions locale={locale as Locale} />
</BaseLayout>

<style>
  .content-page { min-height: 70vh; background: var(--bg-alt); }
  .content-shell { width: min(840px, calc(100% - 3rem)); margin-inline: auto; }
  .content-hero .content-shell { width: min(1080px, calc(100% - 3rem)); }
  .content-hero {
    padding: clamp(4.5rem, 8vw, 7.25rem) 0 clamp(3rem, 5vw, 4.5rem);
    border-bottom: 1px solid var(--border);
    background: color-mix(in srgb, var(--bg) 72%, #d7dbd1);
  }
  .content-breadcrumb { display: flex; gap: .55rem; align-items: center; margin-bottom: 2rem; color: var(--muted); font-size: .82rem; }
  .content-breadcrumb a:hover { color: var(--text); }
  .content-hero h1 { max-width: 1080px; margin: .65rem 0 1.65rem; font-size: clamp(2.8rem, 6.3vw, 5.45rem); line-height: var(--leading-title); letter-spacing: var(--tracking-title); }
  .content-lead { max-width: 760px; margin: 0; color: var(--muted); font-size: clamp(1.05rem, 2vw, 1.35rem); line-height: 1.75; }
  .article-meta { display: flex; flex-wrap: wrap; gap: .7rem 1.2rem; margin-top: 2rem; color: var(--muted); font-size: .82rem; }
  .content-body { padding-block: clamp(3.5rem, 7vw, 6rem); }
  .content-body :global(h2) { margin: 4rem 0 1.1rem; font-size: clamp(2rem, 4vw, 3.2rem); line-height: 1.08; letter-spacing: var(--tracking-heading); }
  .content-body :global(h2:first-child) { margin-top: 0; }
  .content-body :global(h3) { margin: 2.2rem 0 .75rem; font-size: 1.35rem; }
  .content-body :global(p), .content-body :global(li) { color: var(--muted); font-size: 1.02rem; line-height: 1.8; }
  .content-body :global(strong) { color: var(--text); }
  .content-body :global(ul), .content-body :global(ol) { padding-left: 1.35rem; }
  .content-body :global(a) { color: var(--accent); text-decoration: underline; text-underline-offset: .2em; }
  .content-body :global(.answer-block) {
    margin: 2.2rem 0;
    padding: clamp(1.5rem, 4vw, 2.25rem);
    border: 1px solid #5b6259;
    border-radius: 7px;
    background: var(--surface-olive);
  }
  .content-body :global(.answer-block p) { margin: 0; color: #f3eee6; font-size: 1.05rem; }
  .content-body :global(.answer-block strong) { color: #fff; }
  .content-body :global(.content-grid) { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; margin: 2rem 0; }
  .content-body :global(.content-card) { padding: 1.5rem 0; border: 0; border-top: 1px solid var(--border); border-radius: 0; background: transparent; }
  .content-body :global(.content-card h3) { margin-top: 0; }
  .content-body :global(.content-card p) { margin-bottom: 0; font-size: .94rem; }
  .content-body :global(.faq-list) { display: grid; gap: 0; margin-top: 2rem; border-top: 1px solid var(--border); }
  .content-body :global(.faq-list details) { padding: 1.15rem 0; border: 0; border-bottom: 1px solid var(--border); border-radius: 0; background: transparent; }
  .content-body :global(.faq-list summary) { color: var(--text); font-weight: 750; cursor: pointer; }
  .content-body :global(.faq-list details p) { margin-bottom: 0; }
  .content-body :global(.content-cta) {
    margin-top: 4rem;
    padding: clamp(2rem, 5vw, 3.5rem);
    border: 1px solid #5b6259;
    border-radius: 7px;
    color: #f3eee6;
    background: var(--surface-olive);
  }
  .content-body :global(.content-cta h2) { margin-top: 0; }
  .content-body :global(.content-cta p) { color: #d2c8bc; }
  .content-body :global(.content-cta a) { color: #d78263; }
  @media (max-width: 680px) { .content-shell { width: min(900px, calc(100% - 2rem)); } .content-hero .content-shell { width: min(1080px, calc(100% - 1.25rem)); } .content-body :global(.content-grid) { grid-template-columns: 1fr; } }
</style>
