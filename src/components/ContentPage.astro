---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import FloatingActions from './FloatingActions.astro';
import type { Locale } from '../i18n/locales';
import { content } from '../i18n/content';

interface Props {
  locale: Locale | 'fa';
  title: string;
  description: string;
  pathname: string;
  eyebrow: string;
  heading: string;
  lead: string;
  alternates?: Partial<Record<Locale | 'fa' | 'x-default', string>>;
  ogType?: 'website' | 'article';
  pageSchema?: Record<string, unknown>;
  articleMeta?: {
    published: string;
    modified: string;
    readingTime: string;
    label: string;
  };
}

const {
  locale,
  title,
  description,
  pathname,
  eyebrow,
  heading,
  lead,
  alternates,
  ogType = 'website',
  pageSchema,
  articleMeta,
} = Astro.props;

const copy = content[locale as Locale] ?? content.en;
const homePath = locale === 'en' ? '/' : `/${locale}/`;
---
<BaseLayout
  locale={locale as Locale}
  copy={copy}
  title={title}
  description={description}
  pathname={pathname}
  alternates={alternates}
  ogType={ogType}
  pageSchema={pageSchema}
>
  <Header locale={locale as Locale} copy={copy} homePath={homePath} languageUrls={alternates} />

  <main id="main-content" class="content-page">
    <header class="content-hero" id="top">
      <div class="content-shell">
        <nav class="content-breadcrumb" aria-label="Breadcrumb">
          <a href={homePath}>{locale === 'tr' ? 'Ana sayfa' : locale === 'fa' ? 'خانه' : 'Home'}</a>
          <span aria-hidden="true">/</span>
          <span>{eyebrow}</span>
        </nav>

        <p class="section-label">{eyebrow}</p>
        <h1>{heading}</h1>
        <p class="content-lead">{lead}</p>

        {articleMeta && (
          <div class="article-meta">
            <span>{articleMeta.label}</span>
            <time datetime={articleMeta.published}>{articleMeta.published}</time>
            <span>{articleMeta.readingTime}</span>
          </div>
        )}
      </div>
    </header>

    <div class="content-shell content-body">
      <slot />
    </div>
  </main>

  <Footer copy={copy} />
  <FloatingActions locale={locale as Locale} />
</BaseLayout>

<style>
  .content-page { min-height: 70vh; }
  .content-shell { width: min(900px, calc(100% - 3rem)); margin-inline: auto; }
  .content-hero { padding: clamp(5.5rem, 10vw, 9rem) 0 clamp(3.5rem, 7vw, 6rem); border-bottom: 1px solid var(--line); background: radial-gradient(circle at 78% 16%, rgba(226, 118, 98, .16), transparent 24rem), linear-gradient(180deg, rgba(16, 28, 43, .72), rgba(9, 17, 29, .1)); }
  .content-breadcrumb { display: flex; gap: .55rem; align-items: center; margin-bottom: 2rem; color: var(--muted); font-size: .82rem; }
  .content-breadcrumb a:hover { color: var(--text); }
  .content-hero h1 { max-width: 850px; margin: .55rem 0 1.4rem; font-size: clamp(2.8rem, 7vw, 5.8rem); line-height: .98; letter-spacing: -.055em; }
  .content-lead { max-width: 760px; margin: 0; color: var(--muted); font-size: clamp(1.05rem, 2vw, 1.35rem); line-height: 1.75; }
  .article-meta { display: flex; flex-wrap: wrap; gap: .7rem 1.2rem; margin-top: 2rem; color: var(--muted); font-size: .82rem; }
  .content-body { padding-block: clamp(3.5rem, 7vw, 6rem); }
  .content-body :global(h2) { margin: 4rem 0 1.1rem; font-size: clamp(2rem, 4vw, 3.2rem); line-height: 1.08; letter-spacing: -.035em; }
  .content-body :global(h2:first-child) { margin-top: 0; }
  .content-body :global(h3) { margin: 2.2rem 0 .75rem; font-size: 1.35rem; }
  .content-body :global(p), .content-body :global(li) { color: var(--muted); font-size: 1.02rem; line-height: 1.8; }
  .content-body :global(strong) { color: var(--text); }
  .content-body :global(ul), .content-body :global(ol) { padding-left: 1.35rem; }
  .content-body :global(a) { color: var(--accent-soft); text-decoration: underline; text-underline-offset: .2em; }
  .content-body :global(.answer-block) { margin: 2.2rem 0; padding: 1.5rem; border: 1px solid var(--line-strong); border-radius: 18px; background: rgba(20, 34, 53, .72); }
  .content-body :global(.answer-block p) { margin: 0; color: var(--text); font-size: 1.05rem; }
  .content-body :global(.content-grid) { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; margin: 2rem 0; }
  .content-body :global(.content-card) { padding: 1.5rem; border: 1px solid var(--line); border-radius: 18px; background: rgba(16, 28, 43, .72); }
  .content-body :global(.content-card h3) { margin-top: 0; }
  .content-body :global(.content-card p) { margin-bottom: 0; font-size: .94rem; }
  .content-body :global(.faq-list) { display: grid; gap: .8rem; margin-top: 2rem; }
  .content-body :global(.faq-list details) { padding: 1.15rem 1.25rem; border: 1px solid var(--line); border-radius: 14px; background: rgba(16, 28, 43, .55); }
  .content-body :global(.faq-list summary) { color: var(--text); font-weight: 750; cursor: pointer; }
  .content-body :global(.faq-list details p) { margin-bottom: 0; }
  .content-body :global(.content-cta) { margin-top: 4rem; padding: clamp(1.6rem, 4vw, 2.5rem); border: 1px solid rgba(226, 118, 98, .48); border-radius: 22px; background: radial-gradient(circle at 90% 0%, rgba(226, 118, 98, .16), transparent 16rem), var(--panel); }
  .content-body :global(.content-cta h2) { margin-top: 0; }
  @media (max-width: 680px) { .content-shell { width: min(900px, calc(100% - 2rem)); } .content-body :global(.content-grid) { grid-template-columns: 1fr; } }
</style>