---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import FloatingActions from './FloatingActions.astro';
import { content } from '../i18n/content';
import type { Locale } from '../i18n/locales';
import {
  blogLocales,
  localeMeta,
  posts,
  blogPath,
  postPath,
  homePath,
  legacySeoArticle,
  type BlogLocale,
  type BlogPost,
} from '../data/blog';

interface Props { locale: BlogLocale; post?: BlogPost }

const { locale, post } = Astro.props;
const meta = localeMeta[locale];
const copy = content[locale as Locale] ?? content.en;
const origin = 'https://teyfikgokdemir.com';
const canonicalPath = post ? postPath(locale, post.slug) : blogPath(locale);
const canonical = origin + canonicalPath;
const title = post
  ? `${post.title[locale]} | Teyfik Gökdemir`
  : `${meta.blog} | Teyfik Gökdemir`;
const description = post ? post.description[locale] : meta.description;
const alternates = Object.fromEntries([
  ...blogLocales.map((item) => [
    item,
    origin + (post ? postPath(item, post.slug) : blogPath(item)),
  ]),
  ['x-default', origin + (post ? postPath('en', post.slug) : blogPath('en'))],
]);
const legacy = legacySeoArticle[locale];
const indexArticles = [
  ...(legacy
    ? [{
        href: legacy.path,
        title: legacy.title,
        description: legacy.description,
        eyebrow: 'SEO · GEO · AEO · AIO',
        date: '',
      }]
    : []),
  ...posts.map((item) => ({
    href: postPath(locale, item.slug),
    title: item.title[locale],
    description: item.description[locale],
    eyebrow: meta.eyebrow,
    date: item.date,
  })),
];
const featured = indexArticles[0];
const remaining = indexArticles.slice(1);
const indexItems = indexArticles.map((item) => ({
  url: origin + item.href,
  name: item.title,
}));
const postFaqs = post
  ? (post.sections[locale] ?? []).flatMap((s) => s.faq ?? [])
  : [];

const graph = post
  ? [
      {
        '@type': 'BlogPosting',
        '@id': canonical + '#article',
        headline: post.title[locale],
        description: post.description[locale],
        datePublished: post.date,
        dateModified: post.updated,
        inLanguage: locale,
        mainEntityOfPage: canonical,
        author: { '@type': 'Person', '@id': origin + '/#person', name: 'Teyfik Gökdemir', url: origin },
        publisher: { '@type': 'Person', '@id': origin + '/#person', name: 'Teyfik Gökdemir' },
        isPartOf: { '@type': 'Blog', '@id': origin + blogPath(locale) + '#blog', name: meta.blog, url: origin + blogPath(locale) },
      },
      {
        '@type': 'BreadcrumbList',
        itemListElement: [
          { '@type': 'ListItem', position: 1, name: meta.home, item: origin + homePath(locale) },
          { '@type': 'ListItem', position: 2, name: meta.blog, item: origin + blogPath(locale) },
          { '@type': 'ListItem', position: 3, name: post.title[locale], item: canonical },
        ],
      },
      ...(postFaqs.length > 0
        ? [
            {
              '@type': 'FAQPage',
              '@id': canonical + '#faq',
              mainEntity: postFaqs.map((f) => ({
                '@type': 'Question',
                name: f.question,
                acceptedAnswer: { '@type': 'Answer', text: f.answer },
              })),
            },
          ]
        : []),
    ]
  : [
      {
        '@type': 'Blog',
        '@id': canonical + '#blog',
        name: meta.blog,
        url: canonical,
        inLanguage: locale,
        author: { '@type': 'Person', '@id': origin + '/#person', name: 'Teyfik Gökdemir', url: origin },
        description: meta.description,
      },
      {
        '@type': 'ItemList',
        itemListElement: indexItems.map((item, index) => ({
          '@type': 'ListItem',
          position: index + 1,
          url: item.url,
          name: item.name,
        })),
      },
      {
        '@type': 'BreadcrumbList',
        itemListElement: [
          { '@type': 'ListItem', position: 1, name: meta.home, item: origin + homePath(locale) },
          { '@type': 'ListItem', position: 2, name: meta.blog, item: canonical },
        ],
      },
    ];
const related = post ? posts.filter((item) => item.slug !== post.slug) : [];
---

<BaseLayout
  locale={locale}
  copy={copy}
  title={title}
  description={description}
  pathname={canonicalPath}
  alternates={alternates}
  ogType={post ? 'article' : 'website'}
  pageSchema={graph}
>
  <Header
    locale={locale}
    copy={copy}
    homePath={homePath(locale)}
    languageUrls={alternates}
  />

  <main id="main-content" class="blog-page">
    {!post ? (
      <>
        <header class="blog-hero" id="top">
          <div class="blog-shell" data-reveal="content-hero">
            <p class="section-label">Teyfik Gökdemir · {meta.eyebrow}</p>
            <h1>{meta.blog}</h1>
            <p>{description}</p>
            <a class="text-link" href={`${homePath(locale)}#expertise`}>{meta.expertise} →</a>
          </div>
        </header>

        <section class="blog-index blog-shell" aria-label={meta.blog}>
          <a class="featured-article" href={featured.href} data-reveal="featured">
            <div>
              <p class="article-meta-line">
                <span>{featured.eyebrow}</span>
                {featured.date && <time datetime={featured.date}>{featured.date}</time>}
              </p>
              <h2>{featured.title}</h2>
            </div>
            <div>
              <p>{featured.description}</p>
              <span class="text-link">{meta.read} →</span>
            </div>
          </a>

          <div class="article-list">
            {remaining.map((item, index) => (
              <a href={item.href} data-reveal="content-row" style={`--reveal-order:${index}`}>
                <p class="article-meta-line">
                  <span>{item.eyebrow}</span>
                  {item.date && <time datetime={item.date}>{item.date}</time>}
                </p>
                <h2>{item.title}</h2>
                <p>{item.description}</p>
                <span class="article-arrow" aria-hidden="true">↗</span>
              </a>
            ))}
          </div>
        </section>
      </>
    ) : (
      <article class="blog-article blog-shell" id="top">
        <nav class="crumbs" aria-label="Breadcrumb">
          <a href={homePath(locale)}>{meta.home}</a>
          <span>/</span>
          <a href={blogPath(locale)}>{meta.blog}</a>
        </nav>

        <header class="article-head" data-reveal="content-hero">
          <p class="section-label">{meta.eyebrow}</p>
          <h1>{post.title[locale]}</h1>
          <p class="article-lead">{post.intro[locale]}</p>
          <p class="article-date">
            {meta.published}: <time datetime={post.date}>{post.date}</time>
            <span>·</span>
            {post.readingMinutes} min
          </p>
        </header>

        <div class="article-content">
          {post.sections[locale].map((section, index) => (
            <section data-reveal="content-section" style={`--reveal-order:${Math.min(index, 3)}`}>
              <h2>{section.heading}</h2>
              {section.paragraphs.map((paragraph) => <p set:html={paragraph} />)}
              {section.bullets && <ul>{section.bullets.map((bullet) => <li set:html={bullet} />)}</ul>}
              {section.table && (
                <div class="article-table-wrapper">
                  <table class="article-table">
                    <thead>
                      <tr>
                        {section.table.headers.map((h) => <th set:html={h} />)}
                      </tr>
                    </thead>
                    <tbody>
                      {section.table.rows.map((row) => (
                        <tr>
                          {row.map((cell) => <td set:html={cell} />)}
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              )}
              {section.callout && (
                <div class="article-callout" set:html={section.callout} />
              )}
              {section.faq && section.faq.length > 0 && (
                <div class="article-faq-container">
                  <div class="article-faq-accordion">
                    {section.faq.map((item) => (
                      <details class="article-faq-item">
                        <summary class="article-faq-question">
                          <span>{item.question}</span>
                          <span class="faq-icon" aria-hidden="true">+</span>
                        </summary>
                        <div class="article-faq-answer"><p>{item.answer}</p></div>
                      </details>
                    ))}
                  </div>
                </div>
              )}
            </section>
          ))}
        </div>

        <aside class="related-insights" data-reveal="content-section">
          <p class="section-label">{meta.related}</p>
          <div>
            {related.map((item) => (
              <a href={postPath(locale, item.slug)}>
                <strong>{item.title[locale]}</strong>
                <span>{item.description[locale]}</span>
                <b aria-hidden="true">↗</b>
              </a>
            ))}
          </div>
        </aside>
      </article>
    )}
  </main>

  <Footer copy={copy} locale={locale} />
  <FloatingActions locale={locale} />
</BaseLayout>

<style>
  .blog-page { min-height: 70vh; background: var(--scene-paper); }
  .blog-shell { width: min(1180px, calc(100% - 3rem)); margin-inline: auto; }
  .blog-hero {
    padding: clamp(4.5rem, 8vw, 7.5rem) 0 clamp(3rem, 5vw, 4.5rem);
    border-bottom: 1px solid var(--border);
    background: var(--scene-stone);
  }
  .blog-hero h1,
  .article-head h1 {
    max-width: 1120px;
    margin: .45rem 0 1.35rem;
    font-size: clamp(3.25rem, 7vw, 6.8rem);
    line-height: var(--leading-display);
    letter-spacing: var(--tracking-display);
  }
  .blog-hero > div > p:not(.section-label) {
    max-width: 760px;
    margin: 0;
    color: var(--text-muted);
    font-size: clamp(1.05rem, 1.7vw, 1.3rem);
    line-height: 1.7;
  }
  .text-link {
    display: inline-flex;
    margin-top: 1.5rem;
    color: var(--accent);
    font-weight: 800;
  }
  .blog-index { padding-block: clamp(3rem, 6vw, 6rem); }
  .featured-article {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(260px, .8fr);
    gap: clamp(2rem, 7vw, 7rem);
    padding: clamp(2rem, 5vw, 4.5rem);
    border: 1px solid #5b6259;
    border-radius: 7px;
    color: #f3eee6;
    background: var(--scene-olive);
  }
  .featured-article h2 {
    margin: 1rem 0 0;
    font-size: clamp(2.2rem, 4.5vw, 4.35rem);
    line-height: var(--leading-heading);
    letter-spacing: var(--tracking-heading);
  }
  .featured-article p { margin: 0; color: #d2c8bc; font-size: 1rem; line-height: 1.7; }
  .featured-article .text-link { color: #d78263; }
  .article-meta-line {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: .5rem 1rem;
    margin: 0;
    color: var(--accent);
    font-size: .75rem;
    font-weight: 800;
    letter-spacing: .08em;
    text-transform: uppercase;
  }
  .featured-article .article-meta-line { color: #d78263; }
  .article-list { margin-top: clamp(2.5rem, 5vw, 4.5rem); border-top: 1px solid var(--border); }
  .article-list > a {
    position: relative;
    display: grid;
    grid-template-columns: minmax(160px, .45fr) minmax(260px, .8fr) minmax(0, 1.25fr) 32px;
    gap: clamp(1rem, 3vw, 3rem);
    align-items: start;
    padding: 1.65rem 0;
    border-bottom: 1px solid var(--border);
    transition: background-color 180ms ease;
  }
  .article-list > a:hover,
  .article-list > a:focus-visible { background: color-mix(in srgb, var(--scene-mineral) 58%, transparent); }
  :global(.motion-ready) .blog-page [data-reveal] {
    opacity: 0;
    transform: translate3d(0, var(--reveal-distance), 0);
    transition:
      opacity var(--motion-slow) var(--ease-editorial),
      transform var(--motion-slow) var(--ease-editorial);
    transition-delay: calc(var(--reveal-order, 0) * var(--stagger-step));
  }
  :global(.motion-ready) .blog-page [data-reveal].is-visible {
    opacity: 1;
    transform: none;
  }
  .featured-article,
  .article-list > a,
  .text-link,
  .article-arrow {
    transition:
      color var(--motion-fast) ease,
      background-color var(--motion-fast) ease,
      transform var(--motion-fast) ease;
  }
  .featured-article:hover .text-link,
  .featured-article:focus-visible .text-link,
  .article-list > a:hover .article-arrow,
  .article-list > a:focus-visible .article-arrow {
    transform: translateX(4px);
  }
  html[dir="rtl"] .featured-article:hover .text-link,
  html[dir="rtl"] .featured-article:focus-visible .text-link,
  html[dir="rtl"] .article-list > a:hover .article-arrow,
  html[dir="rtl"] .article-list > a:focus-visible .article-arrow {
    transform: translateX(-4px);
  }
  .article-list h2 { margin: 0; font-size: clamp(1.5rem, 2.3vw, 2.35rem); line-height: 1.08; }
  .article-list > a > p:not(.article-meta-line) { margin: 0; color: var(--text-muted); line-height: 1.7; }
  .article-arrow { color: var(--accent); font-size: 1.2rem; }
  .blog-article { padding-block: clamp(2.5rem, 6vw, 5.5rem); }
  .crumbs { display: flex; gap: .55rem; margin-bottom: clamp(2rem, 5vw, 4rem); color: var(--text-muted); font-size: .85rem; }
  .article-head {
    max-width: 1120px;
    padding-bottom: clamp(2.5rem, 5vw, 4rem);
    border-bottom: 1px solid var(--border);
  }
  .article-head h1 { font-size: clamp(2.8rem, 6vw, 5.9rem); line-height: var(--leading-title); letter-spacing: var(--tracking-title); }
  .article-lead { max-width: 780px; margin: 0; color: var(--text-muted); font-size: clamp(1.1rem, 1.8vw, 1.35rem); line-height: 1.7; }
  .article-date { display: flex; flex-wrap: wrap; gap: .5rem; margin: 1.5rem 0 0; color: var(--text-muted); font-size: .85rem; }
  .article-content { width: min(720px, 100%); margin: clamp(3rem, 6vw, 5rem) auto; }
  .article-content section { padding-block: .5rem 2rem; }
  .article-content h2 { margin: 2.5rem 0 1rem; font-size: clamp(1.85rem, 3.5vw, 2.8rem); line-height: 1.12; letter-spacing: var(--tracking-heading); }
  .article-content p,
  .article-content li { color: var(--text-muted); font-size: 1.06rem; line-height: 1.82; }
  .article-content li + li { margin-top: .55rem; }
  .related-insights { padding-top: 2rem; border-top: 1px solid var(--border); }
  .related-insights > div { border-top: 1px solid var(--border); }
  .related-insights a {
    display: grid;
    grid-template-columns: minmax(220px, .8fr) minmax(0, 1.2fr) 28px;
    gap: 1.5rem;
    padding: 1.35rem 0;
    border-bottom: 1px solid var(--border);
  }
  .related-insights span { color: var(--text-muted); line-height: 1.6; }
  .related-insights b { color: var(--accent); }
  .article-content a {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 3px;
    font-weight: 600;
  }
  .article-content a:hover {
    color: var(--text);
  }
  .article-table-wrapper {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    margin-block: 1.75rem;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--scene-paper);
  }
  .article-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.94rem;
    text-align: left;
  }
  html[dir="rtl"] .article-table {
    text-align: right;
  }
  .article-table th {
    background: var(--scene-mineral);
    color: var(--text);
    font-weight: 700;
    padding: 0.85rem 1rem;
    border-bottom: 2px solid var(--border);
    white-space: nowrap;
  }
  .article-table td {
    padding: 0.8rem 1rem;
    border-bottom: 1px solid var(--border);
    color: var(--text-muted);
    line-height: 1.5;
  }
  .article-table tr:last-child td {
    border-bottom: none;
  }
  .article-callout {
    padding: 1.25rem 1.5rem;
    border-left: 3px solid var(--accent);
    background: var(--scene-stone);
    margin-block: 1.75rem;
    border-radius: 6px;
    color: var(--text);
    font-size: 1.02rem;
    line-height: 1.7;
  }
  html[dir="rtl"] .article-callout {
    border-left: none;
    border-right: 3px solid var(--accent);
  }
  .article-faq-container {
    margin-block: 2rem;
  }
  .article-faq-accordion {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .article-faq-item {
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--scene-paper);
    overflow: hidden;
  }
  .article-faq-item[open] {
    border-color: var(--accent);
  }
  .article-faq-question {
    padding: 1rem 1.25rem;
    font-weight: 700;
    font-size: 1.02rem;
    color: var(--text);
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    align-items: center;
    list-style: none;
    user-select: none;
  }
  .article-faq-question::-webkit-details-marker {
    display: none;
  }
  .article-faq-answer {
    padding: 0 1.25rem 1.25rem;
    color: var(--text-muted);
    line-height: 1.7;
  }
  .article-faq-answer p {
    margin: 0;
  }
  @media (max-width: 900px) {
    .featured-article { grid-template-columns: 1fr; gap: 1.5rem; }
    .article-list > a { grid-template-columns: minmax(130px, .45fr) minmax(220px, .8fr) minmax(0, 1.2fr) 28px; gap: 1rem; }
  }
  @media (max-width: 680px) {
    .blog-shell { width: min(100% - 1.25rem, 1180px); }
    .article-list > a { grid-template-columns: 1fr auto; }
    .article-list .article-meta-line,
    .article-list > a > p:not(.article-meta-line) { grid-column: 1 / -1; }
    .article-list h2 { grid-column: 1; }
    .article-arrow { grid-column: 2; grid-row: 2; }
    .related-insights a { grid-template-columns: 1fr auto; gap: .65rem 1rem; }
    .related-insights span { grid-column: 1 / -1; }
    .related-insights b { grid-column: 2; grid-row: 1; }
  }
  @media (prefers-reduced-motion: reduce) {
    .blog-page [data-reveal] {
      opacity: 1;
      transform: none;
      transition: none;
    }
    .article-list > a { transition: none; }
  }
</style>
