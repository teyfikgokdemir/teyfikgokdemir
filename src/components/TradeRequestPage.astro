---
import ContentPage from './ContentPage.astro';
import { site } from '../data/site';
import type { Locale } from '../i18n/locales';

interface Props { locale: Locale; }
const { locale } = Astro.props;
const locales: Locale[] = ['tr', 'en', 'ru', 'fa', 'mk', 'sr', 'sq', 'zh'];
const pathnameFor = (item: Locale) => item === 'tr' ? '/instagram/trade-request/' : `/${item}/instagram/trade-request/`;
const siteUrl = (item: Locale) => site.origin + pathnameFor(item);
const alternates = Object.fromEntries([...locales.map((item) => [item, siteUrl(item)]), ['x-default', siteUrl('en')]]);
const ctsegLocale = locale === 'tr' ? 'tr' : locale === 'fa' ? 'fa' : 'en';
const ctsegBase = `https://ctseg.com.tr/${ctsegLocale}`;

const copy = {
  tr: { title: 'Ticari Talep Merkezi | Teyfik Gökdemir', description: 'Türkiye ile ticaret için doğru ticari talep yolunu seçin: tedarikçi arayın veya ürününüz için alıcı ve pazar bulun.', eyebrow: 'Instagram’dan gelenler için · Ticari talep', heading: 'Türkiye ile ticaret yapmak istiyorsanız doğru taleple başlayın.', lead: 'İki farklı ticari ihtiyaç, iki farklı başlangıç noktası. İhtiyacınızı seçin; ürün, pazar ve karşı taraf için doğru CTSEG akışına geçin.', intro: 'Tedarikçi mi arıyorsun, yoksa ürünün için alıcı ve pazar mı? Kısa ve açık bir talep, doğru ticari görüşmenin ilk adımıdır.', buyerTitle: 'Tedarikçi arıyorum', buyerText: 'Türkiye’den belirli bir ürün, üretici veya tedarikçi arıyorsan ürün, miktar, hedef pazar ve teslim beklentini paylaş.', buyerCta: 'Tedarikçi talebi gönder ↗', supplierTitle: 'Alıcı ve pazar arıyorum', supplierText: 'Üretici veya ihracatçıysan ürünün, kapasiten, belgelerin ve hedef pazarlarınla uygun alıcıları ve pazara giriş fırsatlarını anlat.', supplierCta: 'Alıcı ve pazar talebi gönder ↗', proofTitle: 'İyi bir ticari talep ne içerir?', proofText: 'Ürünü, miktarı, hedef ülkeyi, mevcut belgeleri, teslim beklentisini ve bir sonraki adımı açıkça yaz. Eksik bilgi, yanlış eşleşme ve zaman kaybı yaratır.', proofItems: ['Ürün veya kategori', 'Miktar ve teknik beklenti', 'Kaynak veya hedef ülke', 'Belge ve kalite ihtiyacı', 'Tercih edilen teslim modeli'], finalTitle: 'Talebini seç ve ilk adımı at.', finalText: 'Doğru niyetle başlayan kısa bir mesaj, ticari değerlendirmeyi hızlandırır.', whatsappBuyer: 'Merhaba CTSEG, Türkiye’den tedarikçi arıyorum. Ürün/kategori: … Hedef pazar: … Kısa detay: …', whatsappSupplier: 'Merhaba CTSEG, ürünüm için alıcı ve pazar arıyorum. Ürün: … Kaynak ülke: … Hedef pazar: …', instagram: 'Instagram’a dön ↗' },
  en: { title: 'Trade Request Centre | Teyfik Gökdemir', description: 'Choose the right trade request path: find a supplier in Türkiye or find buyers and markets for your product.', eyebrow: 'For visitors from Instagram · Trade request', heading: 'If you want to trade with Türkiye, start with the right request.', lead: 'Two commercial needs require two different starting points. Choose yours and move to the right CTSEG flow for product, market and counterparty coordination.', intro: 'Are you looking for a supplier, or buyers and markets for your product? A clear request is the first step to a useful commercial conversation.', buyerTitle: 'I need a supplier', buyerText: 'Looking for a product, producer or supplier from Türkiye? Share the product, quantity, target market and delivery expectations.', buyerCta: 'Send a supplier request ↗', supplierTitle: 'I need buyers and markets', supplierText: 'Are you a producer or exporter? Share your product, capacity, documents and target markets to explore suitable buyers and market-entry paths.', supplierCta: 'Send a buyer/market request ↗', proofTitle: 'What makes a useful trade request?', proofText: 'State the product, quantity, target country, available documents, delivery expectations and next step. Missing inputs create wrong matches and delay.', proofItems: ['Product or category', 'Quantity and specification', 'Origin or target country', 'Quality and document needs', 'Preferred delivery model'], finalTitle: 'Choose your path and take the first step.', finalText: 'A short message with the right intent makes commercial assessment faster.', whatsappBuyer: 'Hello CTSEG, I am looking for a supplier from Türkiye. Product/category: … Target market: … Brief details: …', whatsappSupplier: 'Hello CTSEG, I am looking for buyers and markets for my product. Product: … Origin country: … Target market: …', instagram: 'Return to Instagram ↗' },
  ru: { title: 'Коммерческий запрос для Турции | Teyfik Gökdemir', description: 'Выберите коммерческий путь: найти поставщика в Турции или найти покупателей и рынки для своего продукта.', eyebrow: 'Для посетителей из Instagram · Коммерческий запрос', heading: 'Хотите работать с Турцией? Начните с правильного запроса.', lead: 'Две разные задачи — два разных первых шага. Выберите свой путь, чтобы передать CTSEG понятный запрос по продукту, рынку и контрагенту.', intro: 'Вам нужен поставщик в Турции или покупатели и рынок для вашего продукта? Чёткий запрос ускоряет первый полезный разговор.', buyerTitle: 'Я ищу поставщика в Турции', buyerText: 'Укажите продукт, объём, целевой рынок и условия поставки. CTSEG поможет структурировать запрос к подходящим производителям и поставщикам.', buyerCta: 'Запросить поставщика ↗', supplierTitle: 'Я ищу покупателей и рынок', supplierText: 'Если вы производитель или экспортёр, опишите продукт, мощность, документы и рынки, на которые хотите выйти. Так проще найти подходящий путь развития.', supplierCta: 'Запросить покупателей и рынок ↗', proofTitle: 'Что должно быть в хорошем запросе?', proofText: 'Название продукта, объём, целевая страна, документы, условия поставки и следующий шаг. Неполные данные создают неверные совпадения и задержки.', proofItems: ['Продукт или категория', 'Объём и спецификация', 'Страна происхождения или цель', 'Качество и документы', 'Предпочтительная доставка'], finalTitle: 'Выберите направление и отправьте первый запрос.', finalText: 'Короткое сообщение с правильным намерением помогает быстрее перейти к коммерческой оценке.', whatsappBuyer: 'Здравствуйте, CTSEG. Я ищу поставщика в Турции. Продукт/категория: … Целевой рынок: … Кратко: …', whatsappSupplier: 'Здравствуйте, CTSEG. Я ищу покупателей и рынок для продукта. Продукт: … Страна происхождения: … Целевой рынок: …', instagram: 'Вернуться в Instagram ↗' },
  fa: { title: 'مرکز درخواست تجاری برای ترکیه | Teyfik Gökdemir', description: 'مسیر تجاری مناسب را انتخاب کنید: تأمین‌کننده در ترکیه پیدا کنید یا برای محصول خود خریدار و بازار بیابید.', eyebrow: 'برای بازدیدکنندگان اینستاگرام · درخواست تجاری', heading: 'برای تجارت با ترکیه، درخواست درست را از همین‌جا شروع کنید.', lead: 'دو نیاز تجاری، دو نقطه شروع متفاوت. مسیر خود را انتخاب کنید تا درخواست شما به جریان درست CTSEG برای محصول، بازار و طرف تجاری برسد.', intro: 'به دنبال تأمین‌کننده در ترکیه هستید یا برای محصول خود خریدار و بازار می‌خواهید؟ یک درخواست روشن، اولین قدم برای گفت‌وگوی تجاری مفید است.', buyerTitle: 'به دنبال تأمین‌کننده هستم', buyerText: 'محصول، مقدار، بازار هدف و شرایط تحویل را بنویسید. CTSEG به ساختاردهی درخواست و هماهنگی با تولیدکننده یا تأمین‌کننده مناسب کمک می‌کند.', buyerCta: 'ارسال درخواست تأمین‌کننده ↗', supplierTitle: 'به دنبال خریدار و بازار هستم', supplierText: 'اگر تولیدکننده یا صادرکننده هستید، محصول، ظرفیت، اسناد و بازارهای هدف خود را معرفی کنید تا مسیر مناسب برای یافتن خریدار و ورود به بازار بررسی شود.', supplierCta: 'ارسال درخواست خریدار و بازار ↗', proofTitle: 'یک درخواست تجاری خوب چه چیزهایی دارد؟', proofText: 'محصول، مقدار، کشور هدف، اسناد موجود، شرایط تحویل و گام بعدی را روشن بنویسید. اطلاعات ناقص باعث تطبیق اشتباه و اتلاف زمان می‌شود.', proofItems: ['محصول یا گروه کالا', 'مقدار و مشخصات', 'کشور مبدأ یا هدف', 'نیازهای کیفیت و اسناد', 'مدل تحویل ترجیحی'], finalTitle: 'مسیر خود را انتخاب و اولین قدم را بردارید.', finalText: 'یک پیام کوتاه با نیت تجاری روشن، ارزیابی را سریع‌تر می‌کند.', whatsappBuyer: 'سلام CTSEG، به دنبال تأمین‌کننده در ترکیه هستم. محصول/حوزه: … بازار هدف: … توضیح کوتاه: …', whatsappSupplier: 'سلام CTSEG، برای محصول خود به دنبال خریدار و بازار هستم. محصول: … کشور مبدأ: … بازار هدف: …', instagram: 'بازگشت به اینستاگرام ↗' },
  mk: { title: 'Центар за трговско барање | Teyfik Gökdemir', description: 'Изберете трговски пат: добавувач во Турција или купувачи и пазари за вашиот производ.', eyebrow: 'За посетители од Instagram · Трговско барање', heading: 'Сакате трговија со Турција? Започнете со јасно барање.', lead: 'Изберете дали барате добавувач или купувачи и пазари за вашиот производ.', intro: 'Јасното барање е првиот чекор кон корисен комерцијален разговор.', buyerTitle: 'Барам добавувач', buyerText: 'Споделете производ, количина, целен пазар и услови за испорака.', buyerCta: 'Испратете барање за добавувач ↗', supplierTitle: 'Барам купувачи и пазари', supplierText: 'Споделете производ, капацитет, документи и целни пазари.', supplierCta: 'Испратете барање за купувачи ↗', proofTitle: 'Што содржи добро барање?', proofText: 'Производ, количина, целна земја, документи, испорака и следен чекор.', proofItems: ['Производ или категорија', 'Количина и спецификација', 'Земја на потекло или цел', 'Квалитет и документи', 'Модел на испорака'], finalTitle: 'Изберете пат и направете прв чекор.', finalText: 'Кратка порака со јасна цел го забрзува процесот.', whatsappBuyer: 'Здраво CTSEG, барам добавувач од Турција. Производ: … Пазар: …', whatsappSupplier: 'Здраво CTSEG, барам купувачи и пазар за мојот производ. Производ: … Пазар: …', instagram: 'Назад на Instagram ↗' },
  sr: { title: 'Centar za trgovinski zahtev | Teyfik Gökdemir', description: 'Izaberite trgovinski put: dobavljač u Turskoj ili kupci i tržišta za vaš proizvod.', eyebrow: 'Za posetioce sa Instagrama · Trgovinski zahtev', heading: 'Želite trgovinu sa Turskom? Počnite jasnim zahtevom.', lead: 'Izaberite da li tražite dobavljača ili kupce i tržišta za svoj proizvod.', intro: 'Jasan zahtev je prvi korak ka korisnom poslovnom razgovoru.', buyerTitle: 'Tražim dobavljača', buyerText: 'Podelite proizvod, količinu, ciljno tržište i uslove isporuke.', buyerCta: 'Pošaljite zahtev za dobavljača ↗', supplierTitle: 'Tražim kupce i tržišta', supplierText: 'Podelite proizvod, kapacitet, dokumenta i ciljna tržišta.', supplierCta: 'Pošaljite zahtev za kupce ↗', proofTitle: 'Šta sadrži dobar zahtev?', proofText: 'Proizvod, količina, ciljna zemlja, dokumenti, isporuka i sledeći korak.', proofItems: ['Proizvod ili kategorija', 'Količina i specifikacija', 'Zemlja porekla ili cilj', 'Kvalitet i dokumenta', 'Model isporuke'], finalTitle: 'Izaberite put i napravite prvi korak.', finalText: 'Kratka poruka sa jasnom namerom ubrzava proces.', whatsappBuyer: 'Zdravo CTSEG, tražim dobavljača iz Turske. Proizvod: … Tržište: …', whatsappSupplier: 'Zdravo CTSEG, tražim kupce i tržište za svoj proizvod. Proizvod: … Tržište: …', instagram: 'Nazad na Instagram ↗' },
  sq: { title: 'Qendra e kërkesës tregtare | Teyfik Gökdemir', description: 'Zgjidhni rrugën tregtare: furnizues në Turqi ose blerës dhe tregje për produktin tuaj.', eyebrow: 'Për vizitorët nga Instagrami · Kërkesë tregtare', heading: 'Dëshironi të tregtoni me Turqinë? Filloni me kërkesë të qartë.', lead: 'Zgjidhni nëse kërkoni furnizues apo blerës dhe tregje për produktin tuaj.', intro: 'Një kërkesë e qartë është hapi i parë drejt një bisede të dobishme tregtare.', buyerTitle: 'Kërkoj furnizues', buyerText: 'Ndani produktin, sasinë, tregun e synuar dhe kushtet e dorëzimit.', buyerCta: 'Dërgoni kërkesë për furnizues ↗', supplierTitle: 'Kërkoj blerës dhe tregje', supplierText: 'Ndani produktin, kapacitetin, dokumentet dhe tregjet e synuara.', supplierCta: 'Dërgoni kërkesë për blerës ↗', proofTitle: 'Çfarë përmban një kërkesë e mirë?', proofText: 'Produkt, sasi, vend i synuar, dokumente, dorëzim dhe hapi tjetër.', proofItems: ['Produkt ose kategori', 'Sasi dhe specifikim', 'Vend origjine ose synimi', 'Cilësi dhe dokumente', 'Model dorëzimi'], finalTitle: 'Zgjidhni rrugën dhe bëni hapin e parë.', finalText: 'Një mesazh i shkurtër me qëllim të qartë e shpejton procesin.', whatsappBuyer: 'Përshëndetje CTSEG, po kërkoj furnizues nga Turqia. Produkti: … Tregu: …', whatsappSupplier: 'Përshëndetje CTSEG, po kërkoj blerës dhe treg për produktin tim. Produkti: … Tregu: …', instagram: 'Kthehuni në Instagram ↗' },
  zh: {
    title: '跨境商业需求对接中心 | Teyfik Gökdemir',
    description: '选择精准的商业对接路径：寻找土耳其优质制造商与供应商，或为您的产品拓展土耳其及周边分销市场。',
    eyebrow: '来自 Instagram 读者 · 商业对接需求',
    heading: '开展与土耳其的跨境贸易：从一份结构化的商业需求开始。',
    lead: '不同的商业目标对应不同的起点。选择您的业务类型，进入 CTSEG 对应的产品评估、供应链核验与买家对接流程。',
    intro: '您是在寻找土耳其可靠的生产商，还是在为自有优势产品寻找买家与渠道？清晰的需求是高效商业对话的第一步。',
    buyerTitle: '我正在寻找供应商 / 生产商',
    buyerText: '如果您希望从土耳其采购特定产品、定制代工或寻找源头工厂，请提供具体品类、采购量、目标市场及交付期望。',
    buyerCta: '提交采购与寻源需求 ↗',
    supplierTitle: '我正在寻找买家与分销渠道',
    supplierText: '如果您是优质制造商或出口企业，请说明您的产品规格、产能规模、合规证书及目标市场，共同探索可落地的分销路径。',
    supplierCta: '提交市场拓展需求 ↗',
    proofTitle: '一份专业高效的商业需求应包含哪些内容？',
    proofText: '明确写出品类名称、预期数量、目标国家、现有合规单证、交付模型及后续沟通计划。信息越完整，商务对接越精准。',
    proofItems: ['具体产品或品类', '采购规模与技术指标', '原产国或目标销售国', '质量标准与认证证书', '期望的贸易交付模型'],
    finalTitle: '选择您的合作方向，迈出实质第一步。',
    finalText: '一条清晰专业的沟通信息，能大幅提升商业评估与项目推进效率。',
    whatsappBuyer: '您好 CTSEG，我希望在土耳其寻找供应商。品类：… 目标市场：… 简要说明：…',
    whatsappSupplier: '您好 CTSEG，我希望为产品开拓海外市场/寻找买家。产品：… 原产国：… 目标市场：…',
    instagram: '返回 Instagram ↗'
  },
} as const;

const strings = copy[locale];
const campaign = 'trade_intent';
const tracked = (url: string, content: string) => { const target = new URL(url); target.searchParams.set('utm_source', 'instagram'); target.searchParams.set('utm_medium', 'post'); target.searchParams.set('utm_campaign', campaign); target.searchParams.set('utm_content', content); return target.toString(); };
const baseContact = `${ctsegBase}/contact/`;
const buyerUrl = tracked(`${baseContact}?intent=buyer_request`, `${locale}_buyer`);
const supplierUrl = tracked(`${baseContact}?intent=supplier_market_entry`, `${locale}_supplier`);
const whatsapp = (text: string, content: string) => `https://wa.me/${site.whatsapp}?text=${encodeURIComponent(text)}&utm_source=instagram&utm_medium=post&utm_campaign=${campaign}&utm_content=${content}`;
const instagramUrl = `https://www.instagram.com/teyfikgokdemir/?utm_source=website&utm_medium=referral&utm_campaign=instagram_growth&utm_content=trade_intent_${locale}`;
const pageSchema = { '@type': 'CollectionPage', '@id': siteUrl(locale) + '#trade-request', name: strings.title, description: strings.description, url: siteUrl(locale), inLanguage: locale, isPartOf: { '@id': site.origin + '/#website' }, about: { '@id': site.origin + '/#person' } };
---

<ContentPage locale={locale} title={strings.title} description={strings.description} pathname={pathnameFor(locale)} alternates={alternates} pageSchema={pageSchema} eyebrow={strings.eyebrow} heading={strings.heading} lead={strings.lead}>
  <div class="trade-request" dir={locale === 'fa' ? 'rtl' : 'ltr'}>
    <section class="answer-block trade-request__intro"><p><strong>{strings.intro}</strong></p></section>
    <section aria-labelledby="trade-intent-title">
      <div class="trade-request__intent-grid">
        <a class="trade-intent-card trade-intent-card--buyer" href={buyerUrl} data-intent="buyer">
          <span class="trade-intent-card__eyebrow">01 · {locale === 'fa' ? 'برای خریداران' : locale === 'ru' ? 'ДЛЯ ПОКУПАТЕЛЕЙ' : 'FOR BUYERS'}</span>
          <h2 id="trade-intent-title">{strings.buyerTitle}</h2>
          <p>{strings.buyerText}</p>
          <span class="trade-intent-card__cta">{strings.buyerCta}</span>
        </a>
        <a class="trade-intent-card trade-intent-card--supplier" href={supplierUrl} data-intent="supplier">
          <span class="trade-intent-card__eyebrow">02 · {locale === 'fa' ? 'برای تولیدکنندگان' : locale === 'ru' ? 'ДЛЯ ПРОИЗВОДИТЕЛЕЙ' : 'FOR PRODUCERS'}</span>
          <h2>{strings.supplierTitle}</h2>
          <p>{strings.supplierText}</p>
          <span class="trade-intent-card__cta">{strings.supplierCta}</span>
        </a>
      </div>
    </section>
    <section class="trade-request__proof" aria-labelledby="trade-proof-title">
      <p class="section-label">{locale === 'fa' ? 'درخواست قابل بررسی' : locale === 'ru' ? 'ПРОВЕРЯЕМЫЙ ЗАПРОС' : 'A CLEAR REQUEST'}</p>
      <h2 id="trade-proof-title">{strings.proofTitle}</h2>
      <p>{strings.proofText}</p>
      <div class="trade-request__proof-grid">{strings.proofItems.map((item, index) => <span><b>{String(index + 1).padStart(2, '0')}</b>{item}</span>)}</div>
    </section>
    <section class="trade-request__final" aria-labelledby="trade-final-title">
      <p class="section-label">{locale === 'fa' ? 'گام بعدی' : locale === 'ru' ? 'СЛЕДУЮЩИЙ ШАГ' : 'NEXT STEP'}</p>
      <h2 id="trade-final-title">{strings.finalTitle}</h2>
      <p>{strings.finalText}</p>
      <div class="trade-request__actions">
        <a class="button button--primary" href={whatsapp(strings.whatsappBuyer, `${locale}_buyer`)} data-intent="whatsapp_buyer">{strings.buyerCta}</a>
        <a class="button button--secondary" href={whatsapp(strings.whatsappSupplier, `${locale}_supplier`)} data-intent="whatsapp_supplier">{strings.supplierCta}</a>
      </div>
      <a class="text-link" href={instagramUrl} data-intent="instagram_profile">{strings.instagram}</a>
    </section>
  </div>
</ContentPage>

<script is:inline>
  document.querySelectorAll('[data-intent]').forEach((link) => {
    link.addEventListener('click', () => {
      const intent = link.getAttribute('data-intent') || 'unknown';
      if (typeof window.gtag === 'function') window.gtag('event', 'trade_intent_click', { intent, source: 'instagram', medium: 'post', campaign: 'trade_intent' });
    });
  });
</script>

<style>
  .trade-request { display: grid; gap: 4rem; }
  .trade-request__intro p { margin: 0; max-width: 780px; }
  .trade-request__intent-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; }
