};
const t=L[locale]||L.en;
const title=kind==='privacy'?t.p:t.t;
const sections=kind==='privacy'?t.ps:t.ts;
const pathname=kind==='privacy'?privacyPath:termsPath;
const legalPath = (code) => {
  const suffix = kind === 'privacy' ? 'privacy-policy/' : 'terms/';
  return code === 'tr' ? '/' + suffix : '/' + code + '/' + suffix;
};
const alternates = {
  tr: site.origin + legalPath('tr'),
  en: site.origin + legalPath('en'),
  ru: site.origin + legalPath('ru'),
  fa: site.origin + legalPath('fa'),
  mk: site.origin + legalPath('mk'),
  sr: site.origin + legalPath('sr'),
  sq: site.origin + legalPath('sq'),
  zh: site.origin + legalPath('zh'),
  vi: site.origin + legalPath('vi'),
  'x-default': site.origin + legalPath('tr'),
};
---
<BaseLayout alternates={alternates} locale={locale} copy={copy} title={title+' | Teyfik Gökdemir'} description={title+' — teyfikgokdemir.com'} pathname={pathname}>
<Header locale={locale} copy={copy} homePath={homePath}/>
<main id="main-content" class="legal-page"><article class="shell legal-card" data-reveal="legal-content">
<p class="section-label">{t.l}</p><h1>{title}</h1><p class="legal-updated">{t.u}</p>
{sections.map(([h,b],i)=><section><h2>{i+1}. {h}</h2><p>{b}</p></section>)}
<nav class="legal-nav" aria-label={t.l}><a href={privacyPath}>{t.p}</a><a href={termsPath}>{t.t}</a></nav><a class="button" href={homePath}>{t.b}</a>
</article></main><Footer copy={copy} locale={locale}/><FloatingActions locale={locale}/></BaseLayout>
<style>.legal-page{padding:clamp(3rem,7vw,6rem) 0}.legal-card{max-width:860px}.legal-card h1{margin:0 0 1.25rem;font-size:clamp(2.5rem,7vw,5.5rem);line-height:var(--leading-title);letter-spacing:var(--tracking-title)}.legal-updated{margin-bottom:3rem;color:var(--muted)}.legal-card section{padding:1.5rem 0;border-top:1px solid var(--line)}.legal-card h2{margin:0 0 .85rem;font-size:clamp(1.45rem,3vw,2rem)}.legal-card p{color:var(--muted);line-height:1.75}.legal-card a:not(.button){color:var(--accent-soft);text-decoration:underline;text-underline-offset:3px}.legal-nav{display:flex;flex-wrap:wrap;gap:1rem;padding-top:2rem;border-top:1px solid var(--line)}.legal-card .button{display:inline-flex;margin-top:1.5rem}</style>