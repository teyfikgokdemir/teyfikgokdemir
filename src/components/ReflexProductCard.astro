---
import type { ReflexProduct } from '../data/reflexProducts';
import type { Locale } from '../i18n/locales';

interface Props {
  product: ReflexProduct;
  locale: Locale | 'fa';
}

const { product, locale } = Astro.props;
const lang = (locale || 'tr') as 'tr' | 'en' | 'ru' | 'mk' | 'sr' | 'sq' | 'fa';
const i18n = product.i18n[lang] || product.i18n.tr;
const detailUrl = locale === 'tr' ? `/reflex/${product.slug}/` : `/${locale}/reflex/${product.slug}/`;

const buttonTextMap: Record<string, string> = {
  tr: 'Ürünü İncele',
  en: 'View Product',
  ru: 'Подробнее',
  mk: 'Прегледај Производ',
  sr: 'Pogledaj Proizvod',
  sq: 'Shiko Produktin',
  fa: 'مشاهده محصول',
};

const labelMap: Record<string, { colors: string; sizes: string }> = {
  tr: { colors: 'Renkler', sizes: 'Bedenler' },
  en: { colors: 'Colors', sizes: 'Sizes' },
  ru: { colors: 'Цвета', sizes: 'Размеры' },
  mk: { colors: 'Бои', sizes: 'Димензии' },
  sr: { colors: 'Boje', sizes: 'Veličine' },
  sq: { colors: 'Ngjyrat', sizes: 'Përmasat' },
  fa: { colors: 'رنگ‌ها', sizes: 'سایزها' },
};

const translateColor = (col: string) => {
  const map: Record<string, Record<string, string>> = {
    'Siyah': { tr: 'Siyah', en: 'Black', ru: 'Черный', mk: 'Црна', sr: 'Crna', sq: 'E Zezë', fa: 'مشکی' },
    'Şeffaf': { tr: 'Şeffaf', en: 'Clear', ru: 'Прозрачный', mk: 'Проѕирна', sr: 'Providna', sq: 'Transparente', fa: 'شفاف' },
    'Mavi': { tr: 'Mavi', en: 'Blue', ru: 'Синий', mk: 'Сина', sr: 'Plava', sq: 'Blu', fa: 'آبی' },
    'Mor': { tr: 'Mor', en: 'Purple', ru: 'Фиолетовый', mk: 'Виолетова', sr: 'Ljubičasta', sq: 'Vjollcë', fa: 'بنفش' },
    'Yeşil': { tr: 'Yeşil', en: 'Green', ru: 'Зеленый', mk: 'Зелена', sr: 'Zelena', sq: 'Jeshile', fa: 'سبز' },
    'Pembe': { tr: 'Pembe', en: 'Pink', ru: 'Розовый', mk: 'Розева', sr: 'Roze', sq: 'Rozë', fa: 'صورتی' },
    'Krem': { tr: 'Krem', en: 'Cream', ru: 'Кремовый', mk: 'Крем', sr: 'Krem', sq: 'Krem', fa: 'کرم' }
  };
  return map[col]?.[lang] || col;
};

const translateSize = (sz: string) => {
  const map: Record<string, Record<string, string>> = {
    'Çocuk Standart': { tr: 'Çocuk Standart', en: 'Kids Standard', mk: 'Детски стандард', sr: 'Dečiji standard', sq: 'Fëmijë Standard', fa: 'استاندارد کودک' }
  };
  return map[sz]?.[lang] || sz;
};

const labels = labelMap[locale] || labelMap.tr;
const buttonText = buttonTextMap[locale] || 'Ürünü İncele';
const displayColors = (i18n.colors || product.colors).map(translateColor).join(', ');
const displaySizes = (i18n.sizes || product.sizes).map(translateSize).join(', ');
---

<article class="reflex-card">
  <a href={detailUrl} class="reflex-card__image-link" aria-label={i18n.name}>
    <img
      src={product.images.main}
      alt={`${i18n.name} - ${i18n.materialName}`}
      width="450"
      height="315"
      loading="lazy"
      decoding="async"
    />
    <div class="reflex-card__badge-row">
      <span class="reflex-card__badge">{i18n.materialName}</span>
      {i18n.powderStatus && <span class="reflex-card__badge alt">{i18n.powderStatus}</span>}
    </div>
  </a>

  <div class="reflex-card__body">
    <h3 class="reflex-card__title">
      <a href={detailUrl}>{i18n.name}</a>
    </h3>
    <p class="reflex-card__tagline">{i18n.tagline}</p>
    
    <div class="reflex-card__specs">
      <div class="spec-item">
        <span class="spec-label">{labels.colors}:</span>
        <span class="spec-val">{displayColors}</span>
      </div>
      <div class="spec-item">
        <span class="spec-label">{labels.sizes}:</span>
        <span class="spec-val">{displaySizes}</span>
      </div>
    </div>

    <div class="reflex-card__footer">
      <a href={detailUrl} class="reflex-card__btn">
        <span>{buttonText}</span>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </a>
    </div>
  </div>
</article>

<style>
  .reflex-card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid #E6E1D7;
    border-radius: 18px;
    background: #FFFFFF;
    color: #1A1815;
    box-shadow: 0 4px 20px rgba(26, 24, 21, 0.04);
    transition: transform 0.3s cubic-bezier(0.2, 0.8, 0.2, 1), border-color 0.3s ease, box-shadow 0.3s ease;
  }
  .reflex-card:hover {
    transform: translateY(-6px);
    border-color: #D45D35;
    box-shadow: 0 16px 36px rgba(26, 24, 21, 0.1);
  }
  .reflex-card__image-link {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    aspect-ratio: 450 / 300;
    overflow: hidden;
    background: #FFFFFF;
    padding: 1.25rem;
    border-bottom: 1px solid #E6E1D7;
  }
  .reflex-card__image-link img {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
    object-position: center;
    transition: transform 0.5s ease;
  }
  .reflex-card:hover .reflex-card__image-link img {
    transform: scale(1.04);
  }
  .reflex-card__badge-row {
    position: absolute;
    top: 0.9rem;
    left: 0.9rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    z-index: 2;
  }
  .reflex-card__badge {
    padding: 0.35rem 0.75rem;
    border-radius: 999px;
    background: #1A1815;
    color: #FFFFFF;
    font-size: 0.72rem;
    font-weight: 750;
    letter-spacing: 0.02em;
  }
  .reflex-card__badge.alt {
    background: #EFECE5;
    color: #1A1815;
    border: 1px solid #DED9CE;
  }
  .reflex-card__body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 1.6rem;
  }
  .reflex-card__title {
    margin: 0 0 0.6rem;
    font-family: Georgia, Cambria, 'Times New Roman', serif;
    font-size: 1.45rem;
    line-height: 1.25;
    font-weight: 700;
  }
  .reflex-card__title a {
    color: #1A1815;
    transition: color 0.2s ease;
    text-decoration: none;
  }
  .reflex-card__title a:hover {
    color: #D45D35;
  }
  .reflex-card__tagline {
    margin: 0 0 1.25rem;
    color: #4A453E;
    font-size: 0.93rem;
    line-height: 1.55;
    flex: 1;
  }
  .reflex-card__specs {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    padding: 0.85rem 1rem;
    margin-bottom: 1.25rem;
    border-radius: 12px;
    background: #F6F3EC;
    border: 1px solid #E8E3D8;
    font-size: 0.84rem;
  }
  .spec-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem;
  }
  .spec-label {
    color: #635D55;
    font-weight: 600;
  }
  .spec-val {
    color: #1A1815;
    font-weight: 700;
  }
  .reflex-card__footer {
    margin-top: auto;
  }
  .reflex-card__btn {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    font-size: 0.9rem;
    font-weight: 700;
    min-height: 48px;
    padding: 0.75rem 1.25rem;
    border-radius: 10px;
    background: #1A1815;
    color: #FFFFFF;
    text-decoration: none;
    transition: background 0.2s ease, transform 0.2s ease;
    touch-action: manipulation;
  }
  .reflex-card__btn:hover {
    background: #D45D35;
    color: #FFFFFF;
  }

  @media (max-width: 480px) {
    .reflex-card__body {
      padding: 1.25rem;
    }
  }
</style>
