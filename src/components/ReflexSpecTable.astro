    material: 'Hammadde / Malzeme',
    powder: 'Pudra Durumu',
    latex: 'Lateks Durumu',
    silicone: 'Silikon Durumu',
    sterility: 'Sterilite',
    foodContact: 'Gıda İletim Uyumu',
    yes: 'Evet / Tam Uyumlu',
    no: 'Hayır',
    colors: 'Mevcut Renkler',
    sizes: 'Mevcut Bedenler',
    variantsTitle: 'Ambalaj & Lojistik Bilgileri',
    color: 'Renk',
    size: 'Beden',
    productCode: 'Ürün Kodu',
    boxQty: 'Kutu İçeriği',
    cartonQty: 'Koli İçeriği',
    palletQty: 'Palet Miktarı',
    boxDim: 'Kutu Ebatı',
    cartonDim: 'Koli Ebatı',
    boxBarcode: 'Kutu Barkodu',
    cartonBarcode: 'Koli Barkodu',
