    colors: 'Available Colors',
    sizes: 'Available Sizes',
    variantsTitle: 'Packaging & Logistics Data',
    color: 'Color',
    size: 'Size',
    productCode: 'Product Code',
    boxQty: 'Box Count',
    cartonQty: 'Carton Count',
    palletQty: 'Pallet Load',
    boxDim: 'Box Dimensions',
    cartonDim: 'Carton Dimensions',
    boxBarcode: 'Box Barcode (EAN)',
    cartonBarcode: 'Carton Barcode (EAN)',
  },
  mk: {
    specsTitle: 'Технички Спецификации',
    material: 'Материјал',
    powder: 'Статус на Пудра',
    latex: 'Латекс',
    silicone: 'Силикон',
    sterility: 'Стерилност',
    foodContact: 'Контакт со храна',
    yes: 'Да / Соодветно',
    no: 'Не',
    colors: 'Бои',
    sizes: 'Димензии',
    variantsTitle: 'Пакување и Логистика',
    color: 'Боја',
    size: 'Размер',
    productCode: 'Код на Производ',
    boxQty: 'Кутија',
    cartonQty: 'Коли',
    palletQty: 'Палета',
    boxDim: 'Димензии на кутија',
    cartonDim: 'Димензии на коли',
    boxBarcode: 'Баркод кутија',
    cartonBarcode: 'Баркод коли',
  },
  sr: {
    specsTitle: 'Tehničke Specifikacije',
    material: 'Materijal',
    powder: 'Puder',
    latex: 'Lateks',
    silicone: 'Silikon',
    sterility: 'Sterilnost',
    foodContact: 'Kontakt sa hranom',
    yes: 'Da / Bezbedno',
    no: 'Ne',
    colors: 'Boje',
    sizes: 'Veličine',
    variantsTitle: 'Pakovanje i Logistika',
    color: 'Boja',
    size: 'Veličina',
    productCode: 'Kod Proizvoda',
    boxQty: 'Sadržaj Kutije',
    cartonQty: 'Sadržaj Kartona',
    palletQty: 'Paletno Pakovanje',
    boxDim: 'Dimenzije Kutije',
    cartonDim: 'Dimenzije Kartona',
    boxBarcode: 'Barkod Kutije',
    cartonBarcode: 'Barkod Kartona',
  },
  sq: {
    specsTitle: 'Specifikimet Teknike',
    material: 'Lënda e Parë',
    powder: 'Pluhuri',
    latex: 'Lateksi',
    silicone: 'Silikoni',
    sterility: 'Steriliteti',
    foodContact: 'Kontakti me ushqimin',
    yes: 'Po / Plotësisht konform',
    no: 'Jo',
    colors: 'Ngjyrat',
    sizes: 'Përmasat',
    variantsTitle: 'Paketimi dhe Logjistika',
    color: 'Ngjyra',
    size: 'Përmasa',
    productCode: 'Kodi i Produktit',
    boxQty: 'Përmbajtja e Kutisë',
    cartonQty: 'Përmbajtja e Kartonit',
    palletQty: 'Masia në Paletë',
    boxDim: 'Përmasat e Kutisë',
    cartonDim: 'Përmasat e Kartonit',
    boxBarcode: 'Barkodi i Kutisë',
    cartonBarcode: 'Barkodi i Kartonit',
  },
  fa: {
    specsTitle: 'مشخصات فنی',
    material: 'ماده اولیه',
    powder: 'وضعیت پودر',
    latex: 'وضعیت لاتکس',
    silicone: 'وضعیت سیلیکون',
    sterility: 'استریل بودن',
    foodContact: 'تاییدیه تماس با غذا',
    yes: 'بله / کاملاً مناسب',
    no: 'خیر',
    colors: 'رنگ‌های موجود',
    sizes: 'سایزهای موجود',
    variantsTitle: 'اطلاعات بسته‌بندی و لوگستیک',
    color: 'رنگ',
    size: 'سایز',
    productCode: 'کد محصول',
    boxQty: 'محتویات جعبه',
    cartonQty: 'محتویات کارتن',
    palletQty: 'مقدار پالت',
    boxDim: 'ابعاد جعبه',
    cartonDim: 'ابعاد کارتن',
    boxBarcode: 'بارکد جعبه',
    cartonBarcode: 'بارکد کارتن',
  }
}[lang] || labels.tr;

const i18n = product.i18n[lang] || product.i18n.tr;

const translateColor = (col: string) => {
  const map: Record<string, Record<string, string>> = {
    'Siyah': { tr: 'Siyah', en: 'Black', mk: 'Црна', sr: 'Crna', sq: 'E Zezë', fa: 'مشکی' },
    'Şeffaf': { tr: 'Şeffaf', en: 'Clear', mk: 'Проѕирна', sr: 'Providna', sq: 'Transparente', fa: 'شفاف' },
    'Mavi': { tr: 'Mavi', en: 'Blue', mk: 'Сина', sr: 'Plava', sq: 'Blu', fa: 'آبی' },
    'Mor': { tr: 'Mor', en: 'Purple', mk: 'Виолетова', sr: 'Ljubičasta', sq: 'Vjollcë', fa: 'بنفش' },
    'Yeşil': { tr: 'Yeşil', en: 'Green', mk: 'Зелена', sr: 'Zelena', sq: 'Jeshile', fa: 'سبز' },
    'Pembe': { tr: 'Pembe', en: 'Pink', mk: 'Розева', sr: 'Roze', sq: 'Rozë', fa: 'صورتی' },
    'Krem': { tr: 'Krem', en: 'Cream', mk: 'Крем', sr: 'Krem', sq: 'Krem', fa: 'کرم' }
  };
  return map[col]?.[lang] || col;
};

const translateSize = (sz: string) => {
  const map: Record<string, Record<string, string>> = {
    'Çocuk Standart': { tr: 'Çocuk Standart', en: 'Kids Standard', mk: 'Детски стандард', sr: 'Dečiji standard', sq: 'Fëmijë Standard', fa: 'استاندارد کودک' }
  };
  return map[sz]?.[lang] || sz;
};

const translateQty = (val: string) => {
  if (!val) return val;
  if (lang === 'en') return val.replace(/Adet/g, 'Pcs').replace(/Kutu/g, 'Boxes').replace(/Koli/g, 'Cartons');
  if (lang === 'mk') return val.replace(/Adet/g, 'парчиња').replace(/Kutu/g, 'кутии').replace(/Koli/g, 'коли');
  if (lang === 'sr') return val.replace(/Adet/g, 'komada').replace(/Kutu/g, 'kutija').replace(/Koli/g, 'kartona');
  if (lang === 'sq') return val.replace(/Adet/g, 'copë').replace(/Kutu/g, 'kuti').replace(/Koli/g, 'kartona');
  if (lang === 'fa') return val.replace(/Adet/g, 'عدد').replace(/Kutu/g, 'جعبه').replace(/Koli/g, 'کارتن');
  return val;
};
const translateSpec = (val: string) => {
  if (!val) return val;
  const map: Record<string, Record<string, string>> = {
    'Pudrasız': { tr: 'Pudrasız', en: 'Powder-Free', mk: 'Без пудра', sr: 'Bez pudera', sq: 'Pa pluhur', fa: 'بدون پودر' },
    'Lateks İçermez': { tr: 'Lateks İçermez', en: 'Latex-Free', mk: 'Без латекс', sr: 'Bez lateksa', sq: 'Pa lateks', fa: 'بدون لاتکس' },
    'Silikon İçermez': { tr: 'Silikon İçermez', en: 'Silicone-Free', mk: 'Без силикон', sr: 'Bez silikona', sq: 'Pa silikon', fa: 'بدون سیلیکون' },
    'Non-Steril': { tr: 'Non-Steril', en: 'Non-Sterile', mk: 'Нон-стерилно', sr: 'Non-sterilno', sq: 'Jo-sterile', fa: 'غیر استریل' },
  };
  return map[val]?.[lang] || val;
};
---

<div class="reflex-specs-wrapper">
  <div class="spec-block">
    <h3 class="spec-block__heading">{labels.specsTitle}</h3>
    <div class="spec-table-container">
      <table class="spec-table">
        <tbody>
          <tr>
            <th>{labels.material}</th>
            <td>{i18n.materialName || product.material}</td>
          </tr>
          <tr>
            <th>{labels.powder}</th>
            <td>{translateSpec(i18n.powderStatus || product.powderStatus)}</td>
          </tr>
          <tr>
            <th>{labels.latex}</th>
            <td>{translateSpec(i18n.latexStatus || product.latexStatus)}</td>
          </tr>
          <tr>
            <th>{labels.silicone}</th>
            <td>{translateSpec(i18n.siliconeStatus || product.siliconeStatus)}</td>
          </tr>
          <tr>
            <th>{labels.sterility}</th>
            <td>{translateSpec(i18n.sterilityStatus || product.sterilityStatus)}</td>
          </tr>
          <tr>
            <th>{labels.foodContact}</th>
            <td>{product.foodContact ? (i18n.foodContactLabel || labels.yes) : labels.no}</td>
          </tr>
          <tr>
            <th>{labels.colors}</th>
            <td>{(i18n.colors || product.colors).map(translateColor).join(', ')}</td>
          </tr>
          <tr>
            <th>{labels.sizes}</th>
            <td>{(i18n.sizes || product.sizes).map(translateSize).join(', ')}</td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>

  {product.variants.length > 0 && (
    <div class="spec-block">
      <h3 class="spec-block__heading">{labels.variantsTitle}</h3>
      <div class="spec-table-container responsive">
        <table class="spec-table variants">
          <thead>
            <tr>
              <th>{labels.color}</th>
              <th>{labels.size}</th>
              <th>{labels.productCode}</th>
              <th>{labels.boxQty}</th>
              <th>{labels.cartonQty}</th>
              <th>{labels.palletQty}</th>
              <th>{labels.boxBarcode}</th>
            </tr>
          </thead>
          <tbody>
            {product.variants.map((v) => (
              <tr>
                <td><strong>{translateColor(v.color)}</strong></td>
                <td>{translateSize(v.size)}</td>
                <td><code>{v.productCode}</code></td>
                <td>{translateQty(v.boxQuantity)}</td>
                <td>{translateQty(v.cartonQuantity)}</td>
                <td>{translateQty(v.palletQuantity)}</td>
                <td><code>{v.boxBarcode}</code></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  )}
</div>

<style>
  .reflex-specs-wrapper {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
    margin-block: 2rem;
  }
  .spec-block__heading {
    margin: 0 0 1rem;
    font-family: Georgia, Cambria, 'Times New Roman', serif;
    font-size: 1.6rem;
    font-weight: 700;
    color: #1A1815;
  }
  .spec-table-container {
    overflow-x: auto;
    border: 1px solid #E6E1D7;
    border-radius: 16px;
    background: #FFFFFF;
    box-shadow: 0 4px 20px rgba(26, 24, 21, 0.03);
  }
  .spec-table {
    width: 100%;
    border-collapse: collapse;
    text-align: left;
    color: #1A1815;
    font-size: 0.93rem;
  }
  .spec-table th,
  .spec-table td {
    padding: 0.95rem 1.3rem;
    border-bottom: 1px solid #E6E1D7;
  }
  .spec-table tbody tr:last-child th,
  .spec-table tbody tr:last-child td {
    border-bottom: none;
  }
  .spec-table th {
    width: 35%;
    color: #1A1815;
    font-weight: 700;
    background: #F6F3EC;
  }
  .spec-table.variants th {
    width: auto;
    color: #1A1815;
    font-size: 0.82rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    background: #F0ECE4;
  }
  .spec-table.variants code {
    background: #F4F0E8;
    color: #1A1815;
    padding: 0.2rem 0.45rem;
    border-radius: 6px;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.85rem;
    border: 1px solid #E0DBCE;
  }
</style>
