---
import type { ReflexProduct } from '../data/reflexProducts';
import type { Locale } from '../i18n/locales';

interface Props {
  product: ReflexProduct;
  locale: Locale | 'fa';
}

const { product, locale } = Astro.props;
const lang = (locale === 'fa' ? 'tr' : locale) as 'tr' | 'en' | 'mk' | 'sr' | 'sq';

const labels = {
  tr: {
    specsTitle: 'Teknik Özellikler',
    material: 'Hammadde / Malzeme',
    powder: 'Pudra Durumu',
    latex: 'Lateks Durumu',
    silicone: 'Silikon Durumu',
    sterility: 'Sterilite',
    foodContact: 'Gıda İletim Uyumu',
    yes: 'Evet / Tam Uyumlu',
    no: 'Hayır',
    colors: 'Mevcut Renkler',
    sizes: 'Mevcut Bedenler',
    variantsTitle: 'Ambalaj & Lojistik Bilgileri',
    color: 'Renk',
    size: 'Beden',
    productCode: 'Ürün Kodu',
    boxQty: 'Kutu İçeriği',
    cartonQty: 'Koli İçeriği',
    palletQty: 'Palet Miktarı',
    boxDim: 'Kutu Ebatı',
    cartonDim: 'Koli Ebatı',
    boxBarcode: 'Kutu Barkodu',
    cartonBarcode: 'Koli Barkodu',
  },
  en: {
    specsTitle: 'Technical Specifications',
    material: 'Raw Material',
    powder: 'Powder Status',
    latex: 'Latex Status',
    silicone: 'Silicone Status',
    sterility: 'Sterility',
    foodContact: 'Food Contact Compliance',
    yes: 'Yes / Fully Compliant',
    no: 'No',
    colors: 'Available Colors',
    sizes: 'Available Sizes',
    variantsTitle: 'Packaging & Logistics Data',
    color: 'Color',
    size: 'Size',
    productCode: 'Product Code',
    boxQty: 'Box Count',
    cartonQty: 'Carton Count',
    palletQty: 'Pallet Load',
    boxDim: 'Box Dimensions',
    cartonDim: 'Carton Dimensions',
    boxBarcode: 'Box Barcode (EAN)',
    cartonBarcode: 'Carton Barcode (EAN)',
  },
  mk: {
    specsTitle: 'Технички Спецификации',
    material: 'Материјал',
    powder: 'Статус на Пудра',
    latex: 'Латекс',
    silicone: 'Силикон',
    sterility: 'Стерилност',
    foodContact: 'Контакт со храна',
    yes: 'Да / Соодветно',
    no: 'Не',
    colors: 'Бои',
    sizes: 'Димензии',
    variantsTitle: 'Пакување и Логистика',
    color: 'Боја',
    size: 'Размер',
    productCode: 'Код на Производ',
    boxQty: 'Кутија',
    cartonQty: 'Коли',
    palletQty: 'Палета',
    boxDim: 'Димензии на кутија',
    cartonDim: 'Димензии на коли',
    boxBarcode: 'Баркод кутија',
    cartonBarcode: 'Баркод коли',
  },
  sr: {
    specsTitle: 'Tehničke Specifikacije',
    material: 'Materijal',
    powder: 'Puder',
    latex: 'Lateks',
    silicone: 'Silikon',
    sterility: 'Sterilnost',
    foodContact: 'Kontakt sa hranom',
    yes: 'Da / Bezbedno',
    no: 'Ne',
    colors: 'Boje',
    sizes: 'Veličine',
    variantsTitle: 'Pakovanje i Logistika',
    color: 'Boja',
    size: 'Veličina',
    productCode: 'Kod Proizvoda',
    boxQty: 'Sadržaj Kutije',
    cartonQty: 'Sadržaj Kartona',
    palletQty: 'Paletno Pakovanje',
    boxDim: 'Dimenzije Kutije',
    cartonDim: 'Dimenzije Kartona',
    boxBarcode: 'Barkod Kutije',
    cartonBarcode: 'Barkod Kartona',
  },
  sq: {
    specsTitle: 'Specifikimet Teknike',
    material: 'Lënda e Parë',
    powder: 'Pluhuri',
    latex: 'Lateksi',
    silicone: 'Silikoni',
    sterility: 'Steriliteti',
    foodContact: 'Kontakti me ushqimin',
    yes: 'Po / Plotësisht konform',
    no: 'Jo',
    colors: 'Ngjyrat',
    sizes: 'Përmasat',
    variantsTitle: 'Paketimi dhe Logjistika',
    color: 'Ngjyra',
    size: 'Përmasa',
    productCode: 'Kodi i Produktit',
    boxQty: 'Përmbajtja e Kutisë',
    cartonQty: 'Përmbajtja e Kartonit',
    palletQty: 'Masia në Paletë',
    boxDim: 'Përmasat e Kutisë',
    cartonDim: 'Përmasat e Kartonit',
    boxBarcode: 'Barkodi i Kutisë',
    cartonBarcode: 'Barkodi i Kartonit',
  }
}[lang] || labels.tr;

const i18n = product.i18n[lang] || product.i18n.tr;
---

<div class="reflex-specs-wrapper">
  <div class="spec-block">
    <h3 class="spec-block__heading">{labels.specsTitle}</h3>
    <div class="spec-table-container">
      <table class="spec-table">
        <tbody>
          <tr>
            <th>{labels.material}</th>
            <td>{i18n.materialName || product.material}</td>
          </tr>
          <tr>
            <th>{labels.powder}</th>
            <td>{product.powderStatus || 'Belirtilmemiş'}</td>
          </tr>
          <tr>
            <th>{labels.latex}</th>
            <td>{product.latexStatus || 'Belirtilmemiş'}</td>
          </tr>
          <tr>
            <th>{labels.silicone}</th>
            <td>{product.siliconeStatus || 'Belirtilmemiş'}</td>
          </tr>
          <tr>
            <th>{labels.sterility}</th>
            <td>{product.sterilityStatus || 'Belirtilmemiş'}</td>
          </tr>
          <tr>
            <th>{labels.foodContact}</th>
            <td>{product.foodContact ? labels.yes : labels.no}</td>
          </tr>
          <tr>
            <th>{labels.colors}</th>
            <td>{product.colors.join(', ')}</td>
          </tr>
          <tr>
            <th>{labels.sizes}</th>
            <td>{product.sizes.join(', ')}</td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>

  {product.variants.length > 0 && (
    <div class="spec-block">
      <h3 class="spec-block__heading">{labels.variantsTitle}</h3>
      <div class="spec-table-container responsive">
        <table class="spec-table variants">
          <thead>
            <tr>
              <th>{labels.color}</th>
              <th>{labels.size}</th>
              <th>{labels.productCode}</th>
              <th>{labels.boxQty}</th>
              <th>{labels.cartonQty}</th>
              <th>{labels.palletQty}</th>
              <th>{labels.boxBarcode}</th>
            </tr>
          </thead>
          <tbody>
            {product.variants.map((v) => (
              <tr>
                <td><strong>{v.color}</strong></td>
                <td>{v.size}</td>
                <td><code>{v.productCode}</code></td>
                <td>{v.boxQuantity}</td>
                <td>{v.cartonQuantity}</td>
                <td>{v.palletQuantity}</td>
                <td><code>{v.boxBarcode}</code></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  )}
</div>

<style>
  .reflex-specs-wrapper {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
    margin-block: 2rem;
  }
  .spec-block__heading {
    margin: 0 0 1rem;
    font-size: 1.5rem;
    color: var(--text-primary);
  }
  .spec-table-container {
    overflow-x: auto;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface-dark);
  }
  .spec-table {
    width: 100%;
    border-collapse: collapse;
    text-align: left;
    color: #f3eee6;
    font-size: 0.92rem;
  }
  .spec-table th,
  .spec-table td {
    padding: 0.9rem 1.25rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }
  .spec-table tbody tr:last-child th,
  .spec-table tbody tr:last-child td {
    border-bottom: none;
  }
  .spec-table th {
    width: 35%;
    color: var(--accent-coral);
    font-weight: 700;
    background: rgba(0, 0, 0, 0.15);
  }
  .spec-table.variants th {
    width: auto;
    color: #ffffff;
    font-size: 0.84rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    background: rgba(33, 28, 24, 0.95);
  }
  .spec-table.variants code {
    background: rgba(255, 255, 255, 0.1);
    padding: 0.2rem 0.4rem;
    border-radius: 4px;
    font-family: monospace;
    font-size: 0.85rem;
  }
</style>
