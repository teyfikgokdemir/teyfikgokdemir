---
const ventures = [
  { name: 'CTSEG', href: 'https://ctseg.com.tr', tone: 'ctseg', logo: '/images/ctseg-logo-transparent.png' },
  { name: 'QCT Studio', href: 'https://qctstudio.com', tone: 'studio' },
  { name: 'QCT Commerce', href: 'https://qctcommerce.com', tone: 'commerce' },
  { name: 'Mythborn', href: 'https://mythborn.co', tone: 'mythborn' },
] as const;

const repeatedVentures = ventures;
---

<div class="venture-marquee" aria-label="Teyfik Gökdemir venture ecosystem">
  <div class="venture-marquee__track">
    {repeatedVentures.map((venture) => (
      <a
        class:list={['venture-marquee__item', `venture-marquee__item--${venture.tone}`]}
        href={venture.href}
        target="_blank"
        rel="noopener noreferrer"
      >
        <span class="venture-marquee__mark" aria-hidden="true"></span>
        <span>{venture.name}</span>
      </a>
    ))}
  </div>
</div>

<style>
  .venture-marquee {
    width: 100%;
    max-width: 100vw;
    overflow: hidden;
    contain: inline-size;
    border-top: 1px solid #51483f;
    border-bottom: 1px solid #51483f;
    background: var(--surface-dark);
  }

  .venture-marquee__track {
    display: flex;
    width: 100%;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
  }

  .venture-marquee__item {
    min-height: 86px;
    display: inline-flex;
    flex: 0 0 auto;
    align-items: center;
    gap: 18px;
    padding: 0 clamp(24px, 3.5vw, 52px);
    color: #bdb3a8;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: clamp(1.45rem, 2.6vw, 2.7rem);
    font-weight: 400;
    letter-spacing: -0.035em;
    text-decoration: none;
    white-space: nowrap;
    transition: color 180ms ease, opacity 180ms ease;
  }

  .venture-marquee__item:hover,
  .venture-marquee__item:focus-visible {
    color: #f3eee6;
  }

  .venture-marquee__mark {
    width: clamp(14px, 1.6vw, 24px);
    height: clamp(14px, 1.6vw, 24px);
    flex: 0 0 auto;
    border: 1px solid currentColor;
    border-radius: 50%;
  }

  .venture-marquee__item--ctseg { color: #d78263; }
  .venture-marquee__item--studio,
  .venture-marquee__item--commerce,
  .venture-marquee__item--mythborn { color: #bdb3a8; }

  @media (max-width: 760px) {
    .venture-marquee__item {
      min-height: 64px;
      padding-inline: 18px;
      font-size: clamp(1.25rem, 6vw, 2rem);
    }
  }

  @media (max-width: 460px) {
    .venture-marquee__item {
      width: 50%;
      justify-content: center;
      padding-inline: 10px;
      font-size: 1.12rem;
    }
  }
</style>
