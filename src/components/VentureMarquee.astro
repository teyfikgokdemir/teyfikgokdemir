---
const ventures = [
  { name: 'CTSEG', href: 'https://ctseg.com.tr', tone: 'ctseg', logo: '/images/ctseg-logo-transparent.png' },
  { name: 'QCT Studio', href: 'https://qctstudio.com', tone: 'studio' },
  { name: 'QCT Commerce', href: 'https://qctcommerce.com', tone: 'commerce' },
  { name: 'Mythborn', href: 'https://mythborn.co', tone: 'mythborn' },
] as const;

---

<div class="venture-marquee" aria-label="Teyfik Gökdemir venture ecosystem">
  <div class="venture-marquee__track">
    <div class="venture-marquee__group">
      {ventures.map((venture) => (
        <a
          class:list={['venture-marquee__item', `venture-marquee__item--${venture.tone}`]}
          href={venture.href}
          target="_blank"
          rel="noopener noreferrer"
        >
          <span class="venture-marquee__mark" aria-hidden="true"></span>
          <span>{venture.name}</span>
        </a>
      ))}
    </div>
    <div class="venture-marquee__group" aria-hidden="true">
      {ventures.map((venture) => (
        <a
          class:list={['venture-marquee__item', `venture-marquee__item--${venture.tone}`]}
          href={venture.href}
          target="_blank"
          rel="noopener noreferrer"
          tabindex="-1"
        >
          <span class="venture-marquee__mark" aria-hidden="true"></span>
          <span>{venture.name}</span>
        </a>
      ))}
    </div>
  </div>
</div>

<style>
  .venture-marquee {
    width: 100%;
    max-width: 100vw;
    overflow: hidden;
    contain: inline-size;
    border-top: 1px solid #51483f;
    border-bottom: 1px solid #51483f;
    background: var(--surface-dark);
    direction: ltr;
    unicode-bidi: isolate;
  }

  .venture-marquee__track {
    display: flex;
    width: max-content;
    align-items: center;
    animation: ventureMarqueeFlow 46s linear infinite;
    will-change: transform;
  }

  .venture-marquee__group {
    display: flex;
    flex: 0 0 auto;
    align-items: center;
  }

  .venture-marquee__item {
    min-height: 82px;
    display: inline-flex;
    flex: 0 0 auto;
    align-items: center;
    gap: 14px;
    padding: 0 clamp(30px, 4vw, 64px);
    color: #bdb3a8;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: clamp(1.45rem, 2.6vw, 2.7rem);
    font-weight: 400;
    letter-spacing: -0.035em;
    text-decoration: none;
    white-space: nowrap;
    transition: color 180ms ease, opacity 180ms ease;
  }

  .venture-marquee__item:hover,
  .venture-marquee__item:focus-visible {
    color: #f3eee6;
  }

  .venture-marquee:hover .venture-marquee__track,
  .venture-marquee:focus-within .venture-marquee__track {
    animation-play-state: paused;
  }

  .venture-marquee__mark {
    width: 9px;
    height: 9px;
    flex: 0 0 auto;
    border: 1px solid currentColor;
    border-radius: 50%;
  }

  .venture-marquee__item--ctseg { color: #d78263; }
  .venture-marquee__item--studio,
  .venture-marquee__item--commerce,
  .venture-marquee__item--mythborn { color: #bdb3a8; }

  @keyframes ventureMarqueeFlow {
    to { transform: translate3d(-50%, 0, 0); }
  }

  @media (max-width: 760px) {
    .venture-marquee__item {
      min-height: 64px;
      padding-inline: 24px;
      font-size: clamp(1.25rem, 6vw, 2rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .venture-marquee__track {
      width: 100%;
      animation: none;
      transform: none;
      will-change: auto;
    }

    .venture-marquee__group:first-child {
      width: 100%;
      flex-wrap: wrap;
      justify-content: center;
    }

    .venture-marquee__group[aria-hidden="true"] {
      display: none;
    }

    .venture-marquee__item {
      min-height: 64px;
      padding-inline: clamp(16px, 3vw, 34px);
    }
  }
</style>
